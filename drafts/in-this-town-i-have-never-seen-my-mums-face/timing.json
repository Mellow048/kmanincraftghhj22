 "cues": [
  {
   "id": "1.face",
   "start": 0.0,
   "end": 2.4667,
   "text": "In this town, I have never seen my mum's face."
  },
  {
   "id": "1.ender",
   "start": 2.4667,
   "end": 4.5667,
   "text": "She is an enderman. Everyone here is."
  },
  {
   "id": "1.scream",
   "start": 4.5667,
   "end": 6.7667,
   "text": "And if I look her in the eyes, she screams."
  },
  {
   "id": "1.help",
   "start": 6.7667,
   "end": 7.8667,
   "text": "She cannot help it."
  },
  {
   "id": "1.dad",
   "start": 7.8667,
   "end": 10.5,
   "text": "My dad carries things home. Blocks. Flowers."
  },
  {
   "id": "1.me",
   "start": 10.5,
   "end": 12.9333,
   "text": "Once, a baby. That was me."
  },
  {
   "id": "2.knees",
   "start": 12.9333,
   "end": 14.5667,
   "text": "I know my mum by her knees."
  },
  {
   "id": "2.dinner",
   "start": 14.5667,
   "end": 16.5,
   "text": "At dinner, we all look at our plates."
  },
  {
   "id": "2.photo",
   "start": 16.5,
   "end": 18.9,
   "text": "In our family photo, I am looking at my shoes."
  },
  {
   "id": "2.seek",
   "start": 18.9,
   "end": 21.5333,
   "text": "Hide and seek is hard here. Everybody can teleport."
  },
  {
   "id": "2.won",
   "start": 21.5333,
   "end": 22.8667,
   "text": "I have never won."
  },
  {
   "id": "2.rain",
   "start": 22.8667,
   "end": 25.2333,
   "text": "When it rains, the whole town disappears."
  },
  {
   "id": "2.alone",
   "start": 25.2333,
   "end": 27.2333,
   "text": "So I play outside alone."
  },
  {
   "id": "2.kitchen",
   "start": 27.2333,
   "end": 30.9667,
   "text": "And my dad keeps carrying bits of our house away. Yesterday, we had a kitchen."
  },
  {
   "id": "2.want",
   "start": 30.9667,
   "end": 33.6333,
   "text": "All I ever wanted was to look at my mum. Just once."
  },
  {
   "id": "3.tried",
   "start": 33.6333,
   "end": 34.7667,
   "text": "So I tried everything."
  },
  {
   "id": "3.puddle",
   "start": 34.7667,
   "end": 37.3,
   "text": "I looked at her in a puddle. Endermen do not go near puddles."
  },
  {
   "id": "3.fingers",
   "start": 37.3,
   "end": 39.3333,
   "text": "I looked through my fingers. She screamed."
  },
  {
   "id": "3.next",
   "start": 39.3333,
   "end": 40.4333,
   "text": "So did the neighbours."
  },
  {
   "id": "3.behind",
   "start": 40.4333,
   "end": 43.1333,
   "text": "I looked from behind. Now I know the back of her head very well."
  },
  {
   "id": "3.drew",
   "start": 43.1333,
   "end": 45.5667,
   "text": "So I drew her instead. Two purple dots."
  },
  {
   "id": "3.guess",
   "start": 45.5667,
   "end": 46.9667,
   "text": "I had to guess the rest."
  },
  {
   "id": "3.carry",
   "start": 46.9667,
   "end": 48.6333,
   "text": "She has carried it around ever since."
  },
  {
   "id": "4.night",
   "start": 48.6333,
   "end": 50.4333,
   "text": "Then one night, players came."
  },
  {
   "id": "4.six",
   "start": 50.4333,
   "end": 53.2667,
   "text": "Six of them. With swords, and pumpkins on their heads."
  },
  {
   "id": "4.pearls",
   "start": 53.2667,
   "end": 56.0667,
   "text": "They wanted ender pearls. And ender pearls come from endermen."
  },
  {
   "id": "4.stare",
   "start": 56.0667,
   "end": 58.6667,
   "text": "They stared right at my dad. And he did not scream."
  },
  {
   "id": "4.trick",
   "start": 58.6667,
   "end": 59.9,
   "text": "That is the trick."
  },
  {
   "id": "4.pumpkin",
   "start": 59.9,
   "end": 62.6333,
   "text": "If you wear a pumpkin, an enderman cannot tell you are looking."
  },
  {
   "id": "4.stood",
   "start": 62.6333,
   "end": 64.9333,
   "text": "My whole town just stood there, holding their blocks."
  },
  {
   "id": "4.hunted",
   "start": 64.9333,
   "end": 66.6667,
   "text": "Nobody knew they were being hunted."
  },
  {
   "id": "5.small",
   "start": 66.6667,
   "end": 68.9333,
   "text": "I am small. I cannot fight six players."
  },
  {
   "id": "5.holes",
   "start": 68.9333,
   "end": 70.6667,
   "text": "But a pumpkin has very small eye holes."
  },
  {
   "id": "5.kid",
   "start": 70.6667,
   "end": 72.0333,
   "text": "You cannot see a kid behind you."
  },
  {
   "id": "5.ran",
   "start": 72.0333,
   "end": 73.6667,
   "text": "So I ran up, and I knocked them off."
  },
  {
   "id": "5.count",
   "start": 73.6667,
   "end": 75.5333,
   "text": "One pumpkin. Two. All six."
  },
  {
   "id": "5.staring",
   "start": 75.5333,
   "end": 77.5333,
   "text": "Now six players were staring at my whole town."
  },
  {
   "id": "5.heads",
   "start": 77.5333,
   "end": 78.9667,
   "text": "With nothing on their heads."
  },
  {
   "id": "5.scream",
   "start": 78.9667,
   "end": 80.3,
   "text": "And my whole town screamed."
  },
  {
   "id": "5.fast",
   "start": 80.3,
   "end": 82.3667,
   "text": "I have never seen players run so fast."
  },
  {
   "id": "6.left",
   "start": 82.3667,
   "end": 83.8667,
   "text": "They left their pumpkins behind."
  },
  {
   "id": "6.picked",
   "start": 83.8667,
   "end": 86.9667,
   "text": "I picked one up. It was too big. It smelled like pie."
  },
  {
   "id": "6.on",
   "start": 86.9667,
   "end": 88.0667,
   "text": "I put it on anyway."
  },
  {
   "id": "6.knees",
   "start": 88.0667,
   "end": 90.0333,
   "text": "I walked home, and I found her knees."
  },
  {
   "id": "6.up",
   "start": 90.0333,
   "end": 91.4,
   "text": "And I looked up."
  },
  {
   "id": "7.eyes",
   "start": 91.4,
   "end": 92.7,
   "text": "My mum has purple eyes."
  },
  {
   "id": "7.already",
   "start": 92.7,
   "end": 93.9,
   "text": "And she was already looking at me."
  },
  {
   "id": "7.always",
   "start": 93.9,
   "end": 95.2,
   "text": "I think she always was."
  },
  {
   "id": "8.dinner",
   "start": 95.2,
   "end": 98.7,
   "text": "Now I wear it at dinner. I cannot find my food. I do not care."
  },
  {
   "id": "8.photo",
   "start": 98.7,
   "end": 101.3333,
   "text": "We took a new family photo. I am the one looking up."
  },
  {
   "id": "8.kitchen",
   "start": 101.3333,
   "end": 102.8333,
   "text": "And my dad brought the kitchen back."
  },
  {
   "id": "9.sub",
   "start": 102.8333,
   "end": 106.9667,
   "text": "Like and subscribe. But do not stare. My dad is right behind you."
  }
 ],
