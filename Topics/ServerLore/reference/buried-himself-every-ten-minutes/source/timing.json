 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 2.2,
   "text": "Every ten minutes, Milo buried himself in dirt."
  },
  {
   "id": "1.mid",
   "start": 2.2,
   "end": 3.2,
   "text": "Even mid boss fight."
  },
  {
   "id": "1.lid",
   "start": 3.2,
   "end": 5.0667,
   "text": "Three blocks down, dirt roof on top."
  },
  {
   "id": "1.chat",
   "start": 5.0667,
   "end": 7.3,
   "text": "Server chat exploded with laughs and question marks."
  },
  {
   "id": "1.loop",
   "start": 7.3,
   "end": 9.0667,
   "text": "Everyone mocked him until they learned why."
  },
  {
   "id": "2.wood",
   "start": 9.0667,
   "end": 11.3333,
   "text": "At noon, Milo stopped chopping wood on time."
  },
  {
   "id": "2.dig",
   "start": 11.3333,
   "end": 13.4,
   "text": "Three fast clicks, gone underground."
  },
  {
   "id": "2.raid",
   "start": 13.4,
   "end": 15.6333,
   "text": "Mid dungeon raid, he vanished under grass."
  },
  {
   "id": "2.still",
   "start": 15.6333,
   "end": 17.3667,
   "text": "He stood frozen down there for three minutes."
  },
  {
   "id": "2.back",
   "start": 17.3667,
   "end": 19.5,
   "text": "Then he dug out, typed sorry, kept playing."
  },
  {
   "id": "2.mock",
   "start": 19.5,
   "end": 21.3667,
   "text": "Soon bullies started calling him Dirt Boy."
  },
  {
   "id": "2.laugh",
   "start": 21.3667,
   "end": 23.2667,
   "text": "They laughed every ten minutes on the dot."
  },
  {
   "id": "3.lava",
   "start": 23.2667,
   "end": 25.2667,
   "text": "One night, the bully followed Milo outside."
  },
  {
   "id": "3.hole",
   "start": 25.2667,
   "end": 27.1667,
   "text": "Right on cue, Milo dropped into dirt."
  },
  {
   "id": "3.pour",
   "start": 27.1667,
   "end": 29.1333,
   "text": "The bully grinned and poured lava on top."
  },
  {
   "id": "3.burn",
   "start": 29.1333,
   "end": 31.0333,
   "text": "Milo popped up and lost his diamond gear."
  },
  {
   "id": "3.chat2",
   "start": 31.0333,
   "end": 32.7667,
   "text": "In chat he typed, sorry guys."
  },
  {
   "id": "3.quit",
   "start": 32.7667,
   "end": 34.7333,
   "text": "Then Milo logged off without another word."
  },
  {
   "id": "4.desk",
   "start": 34.7333,
   "end": 36.4667,
   "text": "Nobody saw behind his bedroom screen."
  },
  {
   "id": "4.mom",
   "start": 36.4667,
   "end": 38.1,
   "text": "His mom worked long night shifts."
  },
  {
   "id": "4.crib",
   "start": 38.1,
   "end": 40.3333,
   "text": "Beside his desk sat his baby sister's crib."
  },
  {
   "id": "4.cry",
   "start": 40.3333,
   "end": 42.4,
   "text": "Every ten minutes, she woke up crying."
  },
  {
   "id": "4.run",
   "start": 42.4,
   "end": 44.0667,
   "text": "Milo dropped his mouse and ran to her."
  },
  {
   "id": "4.safe",
   "start": 44.0667,
   "end": 45.7667,
   "text": "He buried himself so mobs stayed away."
  },
  {
   "id": "4.sad",
   "start": 45.7667,
   "end": 47.7,
   "text": "He only wanted quiet minutes with friends."
  },
  {
   "id": "5.check",
   "start": 47.7,
   "end": 49.0333,
   "text": "That night, the owner checked his cabin."
  },
  {
   "id": "5.chest",
   "start": 49.0333,
   "end": 50.8,
   "text": "Inside one chest sat a signed book."
  },
  {
   "id": "5.read",
   "start": 50.8,
   "end": 52.6333,
   "text": "The owner opened it and froze completely."
  },
  {
   "id": "5.note",
   "start": 52.6333,
   "end": 54.8333,
   "text": "Sorry I hide. My baby sister needs me."
  },
  {
   "id": "5.ping",
   "start": 54.8333,
   "end": 56.5333,
   "text": "One gold alert pinged the whole server."
  },
  {
   "id": "5.rally",
   "start": 56.5333,
   "end": 58.9667,
   "text": "Within two minutes, twenty players logged on."
  },
  {
   "id": "6.build",
   "start": 58.9667,
   "end": 61.1,
   "text": "All night, the whole server built together."
  },
  {
   "id": "6.wood2",
   "start": 61.1,
   "end": 63.4,
   "text": "Every fifty blocks, warm oak safe booths."
  },
  {
   "id": "6.lamp",
   "start": 63.4,
   "end": 65.5333,
   "text": "Bright lanterns inside, iron door outside."
  },
  {
   "id": "6.golem",
   "start": 65.5333,
   "end": 67.6,
   "text": "By every door stood a friendly iron golem."
  },
  {
   "id": "6.sign",
   "start": 67.6,
   "end": 69.7333,
   "text": "The owner hung a sign: Safe For Milo."
  },
  {
   "id": "6.join",
   "start": 69.7333,
   "end": 71.9333,
   "text": "Next evening, Milo rejoined with empty pockets."
  },
  {
   "id": "6.glow",
   "start": 71.9333,
   "end": 73.7333,
   "text": "He saw glowing lanterns across every hill."
  },
  {
   "id": "6.drop",
   "start": 73.7333,
   "end": 75.6,
   "text": "Friends tossed fresh armor and bright flowers."
  },
  {
   "id": "6.cry2",
   "start": 75.6,
   "end": 77.5333,
   "text": "Milo stood quiet as happy hearts floated up."
  },
  {
   "id": "6.hug",
   "start": 77.5333,
   "end": 79.8,
   "text": "Even the bully typed, sorry, welcome home."
  },
  {
   "id": "6.cta",
   "start": 79.8,
   "end": 82.1,
   "text": "Hit subscribe if you would build one for Milo too!"
  }
 ],
