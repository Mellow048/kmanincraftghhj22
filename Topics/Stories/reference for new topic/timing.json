 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 9.5,
   "text": "This dad punched the same Minecraft tree for an hour just to keep a promise to his son"
  },
  {
   "id": "2.reaction",
   "start": 9.5,
   "end": 14.5,
   "text": "And his son Tom could not stop laughing because his dad had never played a video game"
  },
  {
   "id": "3.catch22",
   "start": 14.5,
   "end": 21.5,
   "text": "Nobody had told him that you have to hold the button down to break a block"
  },
  {
   "id": "4.refusal",
   "start": 21.5,
   "end": 32.5,
   "text": "He had to do this by himself because for years he always said he was too tired"
  },
  {
   "id": "5.promise",
   "start": 32.5,
   "end": 37.5,
   "text": "One night he promised Tom this weekend I will build you a house all by myself"
  },
  {
   "id": "6.grind",
   "start": 37.5,
   "end": 46.5,
   "text": "So he sat at the computer walked to the first tree and started clicking"
  },
  {
   "id": "7.low",
   "start": 46.5,
   "end": 50.5,
   "text": "One hour later he still did not have a single log so Tom stopped laughing"
  },
  {
   "id": "8.rescue",
   "start": 50.5,
   "end": 55.5,
   "text": "Tom ran over and shouted Dad do not click it just hold it down"
  },
  {
   "id": "9.payoff",
   "start": 55.5,
   "end": 67.0,
   "text": "He held it and three seconds later the log popped out and they built it together"
  }
