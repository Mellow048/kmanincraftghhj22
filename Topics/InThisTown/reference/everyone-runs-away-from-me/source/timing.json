 "cues": [
  {
   "id": "1.cat",
   "start": 0.0,
   "end": 1.6333,
   "text": "In this town, I am the only cat."
  },
  {
   "id": "1.all",
   "start": 1.6333,
   "end": 2.7667,
   "text": "Everyone else is a creeper."
  },
  {
   "id": "1.hello",
   "start": 2.7667,
   "end": 4.4333,
   "text": "And every one of them runs when I say hello."
  },
  {
   "id": "1.mum",
   "start": 4.4333,
   "end": 6.5,
   "text": "My mum is a creeper. My dad is a creeper."
  },
  {
   "id": "1.box",
   "start": 6.5,
   "end": 8.1667,
   "text": "They found me in a box, as a kitten."
  },
  {
   "id": "1.love",
   "start": 8.1667,
   "end": 10.7333,
   "text": "They love me very much. From the other side of the room."
  },
  {
   "id": "2.why",
   "start": 10.7333,
   "end": 12.2667,
   "text": "Creepers are scared of cats."
  },
  {
   "id": "2.knows",
   "start": 12.2667,
   "end": 14.3,
   "text": "Nobody knows why. Not even the creepers."
  },
  {
   "id": "2.table",
   "start": 14.3,
   "end": 16.9333,
   "text": "Our dinner table is nine blocks long. I sit at the far end."
  },
  {
   "id": "2.school",
   "start": 16.9333,
   "end": 19.2333,
   "text": "At school, I have my own row. And my own door."
  },
  {
   "id": "2.street",
   "start": 19.2333,
   "end": 21.6,
   "text": "When I walk down the street, it empties. Just like that."
  },
  {
   "id": "2.never",
   "start": 21.6,
   "end": 25.7,
   "text": "I do not scratch. I do not bite. I have never even chased a chicken."
  },
  {
   "id": "2.hug",
   "start": 25.7,
   "end": 27.7667,
   "text": "All I ever wanted was one hug."
  },
  {
   "id": "3.tried",
   "start": 27.7667,
   "end": 29.5333,
   "text": "So I tried everything."
  },
  {
   "id": "3.suit",
   "start": 29.5333,
   "end": 30.6667,
   "text": "I dressed up as a creeper."
  },
  {
   "id": "3.suitran",
   "start": 30.6667,
   "end": 32.0,
   "text": "They ran from the costume."
  },
  {
   "id": "3.back",
   "start": 32.0,
   "end": 34.2,
   "text": "I walked backwards, so nobody could see my face."
  },
  {
   "id": "3.tail",
   "start": 34.2,
   "end": 35.6333,
   "text": "They ran from my tail."
  },
  {
   "id": "3.still",
   "start": 35.6333,
   "end": 37.5333,
   "text": "Once, I sat still for a whole day."
  },
  {
   "id": "3.little",
   "start": 37.5333,
   "end": 39.2667,
   "text": "And a little creeper sat down next to me."
  },
  {
   "id": "3.purr",
   "start": 39.2667,
   "end": 41.1,
   "text": "Then I purred. I could not help it."
  },
  {
   "id": "3.gone",
   "start": 41.1,
   "end": 42.4667,
   "text": "I did not see him for a week."
  },
  {
   "id": "4.night",
   "start": 42.4667,
   "end": 43.8667,
   "text": "Then one night, players came."
  },
  {
   "id": "4.six",
   "start": 43.8667,
   "end": 46.2,
   "text": "Six of them. With swords, and empty sacks."
  },
  {
   "id": "4.powder",
   "start": 46.2,
   "end": 48.7333,
   "text": "They wanted gunpowder. And gunpowder comes from creepers."
  },
  {
   "id": "4.square",
   "start": 48.7333,
   "end": 50.1333,
   "text": "My whole town backed into the square."
  },
  {
   "id": "4.started",
   "start": 50.1333,
   "end": 51.2667,
   "text": "And they started to hiss."
  },
  {
   "id": "4.hiss",
   "start": 51.2667,
   "end": 53.7,
   "text": "When a creeper hisses, it is about to blow up."
  },
  {
   "id": "4.chain",
   "start": 53.7,
   "end": 55.4333,
   "text": "And when one blows up, they all do."
  },
  {
   "id": "4.white",
   "start": 55.4333,
   "end": 58.0333,
   "text": "My mum was flashing white. My dad was flashing white."
  },
  {
   "id": "5.small",
   "start": 58.0333,
   "end": 61.2333,
   "text": "I am small. I cannot fight six players."
  },
  {
   "id": "5.good",
   "start": 61.2333,
   "end": 63.6,
   "text": "But there is one thing I am very, very good at."
  },
  {
   "id": "5.behind",
   "start": 63.6,
   "end": 65.5667,
   "text": "So I walked up behind my whole town."
  },
  {
   "id": "5.said",
   "start": 65.5667,
   "end": 66.4,
   "text": "And I said hello."
  },
  {
   "id": "5.ran",
   "start": 66.4,
   "end": 68.9333,
   "text": "They ran. Every single one. Straight ahead."
  },
  {
   "id": "5.through",
   "start": 68.9333,
   "end": 70.0667,
   "text": "Straight through the players."
  },
  {
   "id": "5.boom",
   "start": 70.0667,
   "end": 71.0,
   "text": "Nobody blew up."
  },
  {
   "id": "5.cant",
   "start": 71.0,
   "end": 73.0333,
   "text": "You cannot hiss and run at the same time."
  },
  {
   "id": "5.left",
   "start": 73.0333,
   "end": 76.1333,
   "text": "The players left their swords, their sacks, and one shoe."
  },
  {
   "id": "6.morning",
   "start": 76.1333,
   "end": 78.5,
   "text": "In the morning, the whole town came back."
  },
  {
   "id": "6.nine",
   "start": 78.5,
   "end": 81.2333,
   "text": "They stopped in front of me. Nine blocks away."
  },
  {
   "id": "6.step",
   "start": 81.2333,
   "end": 83.9333,
   "text": "Then my mum took one step. And one more."
  },
  {
   "id": "6.shake",
   "start": 83.9333,
   "end": 85.2333,
   "text": "She was shaking all over."
  },
  {
   "id": "6.arms",
   "start": 85.2333,
   "end": 87.5667,
   "text": "Creepers have no arms. So she leaned on me."
  },
  {
   "id": "6.second",
   "start": 87.5667,
   "end": 89.7333,
   "text": "It lasted one whole second. Then she ran."
  },
  {
   "id": "6.came",
   "start": 89.7333,
   "end": 90.9333,
   "text": "But she came back."
  },
  {
   "id": "7.turns",
   "start": 90.9333,
   "end": 93.3333,
   "text": "Now I get one hug a day. They take turns."
  },
  {
   "id": "7.table",
   "start": 93.3333,
   "end": 94.8,
   "text": "The table is six blocks long."
  },
  {
   "id": "7.little",
   "start": 94.8,
   "end": 97.8667,
   "text": "And that little creeper sits next to me every day. He lets me purr."
  },
  {
   "id": "8.sub",
   "start": 97.8667,
   "end": 100.4333,
   "text": "Like and subscribe. Or I will come and say hello."
  }
 ],
