 "cues": [
  {
   "id": "1.cats",
   "start": 0.0,
   "end": 1.8,
   "text": "In this town, we are all cats."
  },
  {
   "id": "1.folk",
   "start": 1.8,
   "end": 2.8,
   "text": "Cat villagers."
  },
  {
   "id": "1.golem",
   "start": 2.8,
   "end": 3.8,
   "text": "A cat golem."
  },
  {
   "id": "1.me",
   "start": 3.8,
   "end": 5.5,
   "text": "And cat players, like me."
  },
  {
   "id": "2.sides",
   "start": 5.5,
   "end": 7.7333,
   "text": "We actually have one village, but two sides."
  },
  {
   "id": "2.line",
   "start": 7.7333,
   "end": 9.4333,
   "text": "Because right down the middle, there is a line."
  },
  {
   "id": "2.not",
   "start": 9.4333,
   "end": 11.1333,
   "text": "And on the other side of it, they are not cats."
  },
  {
   "id": "2.dogs",
   "start": 11.1333,
   "end": 12.0,
   "text": "They are dogs!"
  },
  {
   "id": "2.all",
   "start": 12.0,
   "end": 14.5333,
   "text": "Dog players, dog villagers, and a dog golem."
  },
  {
   "id": "2.knew",
   "start": 14.5333,
   "end": 16.8333,
   "text": "Nobody knew who made the line. Nobody knew why."
  },
  {
   "id": "3.noon",
   "start": 16.8333,
   "end": 19.7,
   "text": "But every day at noon, both sides walked up to it, and we fought."
  },
  {
   "id": "3.paws",
   "start": 19.7,
   "end": 20.8,
   "text": "Not with our paws."
  },
  {
   "id": "3.fur",
   "start": 20.8,
   "end": 24.3,
   "text": "We cats spread our fur, arched our backs, and stood sideways."
  },
  {
   "id": "3.bark",
   "start": 24.3,
   "end": 25.3333,
   "text": "And the dogs barked."
  },
  {
   "id": "3.golems",
   "start": 25.3333,
   "end": 28.2,
   "text": "Our golem hissed at their golem. Their golem barked at ours."
  },
  {
   "id": "3.lunch",
   "start": 28.2,
   "end": 30.5,
   "text": "Then everybody went home for lunch."
  },
  {
   "id": "4.on",
   "start": 30.5,
   "end": 32.6667,
   "text": "This went on, and on, and on."
  },
  {
   "id": "4.grandma",
   "start": 32.6667,
   "end": 34.3333,
   "text": "My grandma did it. Her grandma did it."
  },
  {
   "id": "4.grass",
   "start": 34.3333,
   "end": 36.6,
   "text": "The golems stood there so long that grass grew on their feet."
  },
  {
   "id": "4.tired",
   "start": 36.6,
   "end": 38.6,
   "text": "And one day, we cats were just tired of it."
  },
  {
   "id": "4.back",
   "start": 38.6,
   "end": 42.4,
   "text": "My back hurt. My fur would not go down. And I had never even met a dog."
  },
  {
   "id": "5.night",
   "start": 42.4,
   "end": 45.0,
   "text": "So that night, we did something nobody had ever done."
  },
  {
   "id": "5.tiptoe",
   "start": 45.0,
   "end": 46.6667,
   "text": "We tiptoed out to the middle of the village."
  },
  {
   "id": "5.took",
   "start": 46.6667,
   "end": 48.8333,
   "text": "And block by block, we took the line away."
  },
  {
   "id": "5.last",
   "start": 48.8333,
   "end": 50.8,
   "text": "I carried the last block home myself."
  },
  {
   "id": "6.morning",
   "start": 50.8,
   "end": 52.8333,
   "text": "The next morning, both sides walked up to fight."
  },
  {
   "id": "6.gone",
   "start": 52.8333,
   "end": 54.0333,
   "text": "But the line was gone."
  },
  {
   "id": "6.where",
   "start": 54.0333,
   "end": 55.5,
   "text": "The dogs did not know where to bark."
  },
  {
   "id": "6.ours",
   "start": 55.5,
   "end": 57.4667,
   "text": "We cats did not know which grass was ours."
  },
  {
   "id": "6.quiet",
   "start": 57.4667,
   "end": 58.9333,
   "text": "Nobody arched. Nobody barked."
  },
  {
   "id": "6.step",
   "start": 58.9333,
   "end": 61.1667,
   "text": "Then, quietly, we walked toward each other."
  },
  {
   "id": "6.sniff",
   "start": 61.1667,
   "end": 63.3667,
   "text": "A dog kid sniffed me. So I sniffed him back."
  },
  {
   "id": "6.weird",
   "start": 63.3667,
   "end": 64.4,
   "text": "It was weird."
  },
  {
   "id": "7.still",
   "start": 64.4,
   "end": 66.2,
   "text": "The next day, it was still weird."
  },
  {
   "id": "7.time",
   "start": 66.2,
   "end": 68.1667,
   "text": "But over time, it got a little less weird."
  },
  {
   "id": "7.trade",
   "start": 68.1667,
   "end": 70.3667,
   "text": "A dog villager traded a bone for a fish."
  },
  {
   "id": "7.sit",
   "start": 70.3667,
   "end": 71.6667,
   "text": "The two golems finally sat down."
  },
  {
   "id": "7.nap",
   "start": 71.6667,
   "end": 74.6,
   "text": "And the dog kid and I shared the sunny spot by the well."
  },
  {
   "id": "7.noline",
   "start": 74.6,
   "end": 76.0667,
   "text": "Now the whole village has no line in it."
  },
  {
   "id": "7.safe",
   "start": 76.0667,
   "end": 77.6,
   "text": "And we all feel safe and happy."
  },
  {
   "id": "7.block",
   "start": 77.6,
   "end": 80.4,
   "text": "I kept the last block of the line. We use it as a pillow."
  },
  {
   "id": "8.sub",
   "start": 80.4,
   "end": 83.1333,
   "text": "Like and subscribe, from both sides of the village."
  }
 ],
