 "cues": [
  {
   "id": "1.face",
   "start": 0.0,
   "end": 1.8667,
   "text": "In this town, everyone had the same face"
  },
  {
   "id": "1.me",
   "start": 1.8667,
   "end": 2.6333,
   "text": "except me."
  },
  {
   "id": "2.from",
   "start": 2.6333,
   "end": 4.1333,
   "text": "Nobody knew where I had come from."
  },
  {
   "id": "2.black",
   "start": 4.1333,
   "end": 6.4667,
   "text": "Nobody would say why the oldest house was burned black."
  },
  {
   "id": "2.hill",
   "start": 6.4667,
   "end": 8.3333,
   "text": "And nobody would tell me what was behind the hill."
  },
  {
   "id": "3.nose",
   "start": 8.3333,
   "end": 11.0333,
   "text": "Everyone had one long nose, one long eyebrow,"
  },
  {
   "id": "3.arms",
   "start": 11.0333,
   "end": 13.1667,
   "text": "and two arms they kept folded in their sleeves."
  },
  {
   "id": "3.hands",
   "start": 13.1667,
   "end": 14.8333,
   "text": "I never saw one of them use a hand."
  },
  {
   "id": "3.hmm",
   "start": 14.8333,
   "end": 17.5333,
   "text": "They never used words, either. They just said \"hmm.\""
  },
  {
   "id": "3.golem",
   "start": 17.5333,
   "end": 19.2333,
   "text": "An iron golem guarded the square"
  },
  {
   "id": "3.flowers",
   "start": 19.2333,
   "end": 20.6667,
   "text": "and gave flowers to the children."
  },
  {
   "id": "3.wave",
   "start": 20.6667,
   "end": 22.3,
   "text": "I was the only one who could wave hello."
  },
  {
   "id": "3.back",
   "start": 22.3,
   "end": 23.5667,
   "text": "Nobody ever waved back."
  },
  {
   "id": "4.good",
   "start": 23.5667,
   "end": 25.0,
   "text": "It was a good life, honestly."
  },
  {
   "id": "4.why",
   "start": 25.0,
   "end": 26.0,
   "text": "But why was I different?"
  },
  {
   "id": "5.ask",
   "start": 26.0,
   "end": 28.6,
   "text": "So I asked the oldest villager, the one who had found me."
  },
  {
   "id": "5.stare",
   "start": 28.6,
   "end": 30.1,
   "text": "She looked at my hands for a long time,"
  },
  {
   "id": "5.hmm",
   "start": 30.1,
   "end": 32.8667,
   "text": "and said \"hmm\" in a way I had never heard."
  },
  {
   "id": "5.rule",
   "start": 32.8667,
   "end": 34.6667,
   "text": "It meant: never climb that hill."
  },
  {
   "id": "6.plant",
   "start": 34.6667,
   "end": 36.4333,
   "text": "What did my hands have to do with a hill?"
  },
  {
   "id": "6.decide",
   "start": 36.4333,
   "end": 38.0,
   "text": "I decided to go and see."
  },
  {
   "id": "7.walk",
   "start": 38.0,
   "end": 39.9667,
   "text": "The next morning, I just walked up the hill."
  },
  {
   "id": "7.half",
   "start": 39.9667,
   "end": 40.9333,
   "text": "I got halfway."
  },
  {
   "id": "7.golem",
   "start": 40.9333,
   "end": 43.6,
   "text": "Then the iron golem tucked me under its arm, carried me home,"
  },
  {
   "id": "7.flower",
   "start": 43.6,
   "end": 44.6333,
   "text": "and gave me a flower."
  },
  {
   "id": "7.laugh",
   "start": 44.6333,
   "end": 46.9667,
   "text": "The whole town said \"hmm\" at me for a week."
  },
  {
   "id": "8.under",
   "start": 46.9667,
   "end": 48.4333,
   "text": "So I went under the hill instead."
  },
  {
   "id": "8.night",
   "start": 48.4333,
   "end": 50.1333,
   "text": "Every night, I dug under my bed,"
  },
  {
   "id": "8.bed",
   "start": 50.1333,
   "end": 52.7,
   "text": "and every morning, I pushed the bed back over the hole."
  },
  {
   "id": "9.friend",
   "start": 52.7,
   "end": 55.3667,
   "text": "The night I finished, my best friend was waiting by the hole."
  },
  {
   "id": "9.wave",
   "start": 55.3667,
   "end": 56.6667,
   "text": "He tried to wave goodbye."
  },
  {
   "id": "9.sleeves",
   "start": 56.6667,
   "end": 58.2667,
   "text": "His arms stayed in his sleeves."
  },
  {
   "id": "10.out",
   "start": 58.2667,
   "end": 59.8667,
   "text": "I came up just below the top."
  },
  {
   "id": "10.smell",
   "start": 59.8667,
   "end": 61.2333,
   "text": "The air smelled like smoke."
  },
  {
   "id": "10.look",
   "start": 61.2333,
   "end": 62.7,
   "text": "I looked back one more time."
  },
  {
   "id": "10.oneface",
   "start": 62.7,
   "end": 65.8667,
   "text": "A whole town with one face was waking up without me."
  },
  {
   "id": "10.steps",
   "start": 65.8667,
   "end": 67.7333,
   "text": "Then I climbed the last few steps."
  },
  {
   "id": "11.smoke",
   "start": 67.7333,
   "end": 69.7,
   "text": "For a second, I saw nothing but smoke."
  },
  {
   "id": "11.words",
   "start": 69.7,
   "end": 71.9667,
   "text": "Then I heard words. Somebody was laughing."
  },
  {
   "id": "11.them",
   "start": 71.9667,
   "end": 74.8,
   "text": "Down in the next valley, I saw people. Dozens."
  },
  {
   "id": "11.beard",
   "start": 74.8,
   "end": 75.8333,
   "text": "One had a beard."
  },
  {
   "id": "11.hair",
   "start": 75.8333,
   "end": 77.0333,
   "text": "One had green hair."
  },
  {
   "id": "11.pumpkin",
   "start": 77.0333,
   "end": 78.1333,
   "text": "One wore a pumpkin."
  },
  {
   "id": "12.faces",
   "start": 78.1333,
   "end": 79.6,
   "text": "Not one face was the same,"
  },
  {
   "id": "12.hands",
   "start": 79.6,
   "end": 81.2667,
   "text": "and every one of them had hands."
  },
  {
   "id": "12.strange",
   "start": 81.2667,
   "end": 83.5,
   "text": "I wasn't strange. I was just far from home."
  },
  {
   "id": "12.shout",
   "start": 83.5,
   "end": 84.4333,
   "text": "I was about to shout hello"
  },
  {
   "id": "13.clear",
   "start": 84.4333,
   "end": 87.1,
   "text": "when the smoke cleared, and I saw what all those hands were doing."
  },
  {
   "id": "13.burn",
   "start": 87.1,
   "end": 88.3,
   "text": "They were burning a village."
  },
  {
   "id": "13.noses",
   "start": 88.3,
   "end": 91.1667,
   "text": "A village of long noses and folded arms, just like mine."
  },
  {
   "id": "13.black",
   "start": 91.1667,
   "end": 93.3,
   "text": "Now I knew who had burned the black house,"
  },
  {
   "id": "13.from",
   "start": 93.3,
   "end": 94.4333,
   "text": "and where I had come from."
  },
  {
   "id": "13.known",
   "start": 94.4333,
   "end": 96.0667,
   "text": "My town had always known what I was."
  },
  {
   "id": "13.hoped",
   "start": 96.0667,
   "end": 97.9667,
   "text": "They had just hoped I would grow up to be something else."
  },
  {
   "id": "14.seen",
   "start": 97.9667,
   "end": 99.8,
   "text": "Then one of them looked up, and saw me."
  },
  {
   "id": "14.waved",
   "start": 99.8,
   "end": 102.8,
   "text": "And he did the one thing nobody in my town had ever done. He waved."
  },
  {
   "id": "14.sub",
   "start": 102.8,
   "end": 104.6667,
   "text": "Subscribe before I wave back."
  }
 ],
