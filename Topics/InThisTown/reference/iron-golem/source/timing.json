 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.3,
   "text": "In this town, every kid got an iron golem at ten."
  },
  {
   "id": "1.me",
   "start": 2.3,
   "end": 3.5333,
   "text": "Mine was made of snow."
  },
  {
   "id": "2.why",
   "start": 3.5333,
   "end": 6.5,
   "text": "On the hill over our town stood an old black gate."
  },
  {
   "id": "2.lit",
   "start": 6.5,
   "end": 9.7,
   "text": "Once a year, it lit up, and piglins came out to attack our town."
  },
  {
   "id": "2.fight",
   "start": 9.7,
   "end": 12.8333,
   "text": "So every year, we needed our golems to defeat the piglins,"
  },
  {
   "id": "2.gate",
   "start": 12.8333,
   "end": 14.3,
   "text": "and throw every one of them back in."
  },
  {
   "id": "2.need",
   "start": 14.3,
   "end": 16.4333,
   "text": "That is why every kid got a golem at ten."
  },
  {
   "id": "2.build",
   "start": 16.4333,
   "end": 19.7,
   "text": "On your tenth birthday, you got four iron blocks and a pumpkin."
  },
  {
   "id": "2.ran",
   "start": 19.7,
   "end": 22.2,
   "text": "The year I turned ten, the iron ran out."
  },
  {
   "id": "2.dad",
   "start": 22.2,
   "end": 24.5333,
   "text": "So my dad looked outside. It was snowing."
  },
  {
   "id": "2.snow",
   "start": 24.5333,
   "end": 27.1333,
   "text": "Two blocks of snow. One pumpkin. Happy birthday."
  },
  {
   "id": "3.carts",
   "start": 27.1333,
   "end": 28.7667,
   "text": "Iron golems pulled the carts."
  },
  {
   "id": "3.cows",
   "start": 28.7667,
   "end": 30.0333,
   "text": "They carried the cows home."
  },
  {
   "id": "3.roof",
   "start": 30.0333,
   "end": 31.9,
   "text": "One held up a roof while the builder ate lunch."
  },
  {
   "id": "3.mine",
   "start": 31.9,
   "end": 33.0,
   "text": "Mine threw snowballs."
  },
  {
   "id": "3.at",
   "start": 33.0,
   "end": 35.0667,
   "text": "At birds. At the baker. At me."
  },
  {
   "id": "3.trail",
   "start": 35.0667,
   "end": 36.2333,
   "text": "He left snow in the kitchen."
  },
  {
   "id": "3.noon",
   "start": 36.2333,
   "end": 38.0667,
   "text": "And every day at noon, he melted."
  },
  {
   "id": "3.umbrella",
   "start": 38.0667,
   "end": 40.3,
   "text": "So I walked behind him with an umbrella. All summer."
  },
  {
   "id": "3.name",
   "start": 40.3,
   "end": 42.5,
   "text": "I called him Puddle. You can guess why."
  },
  {
   "id": "4.house",
   "start": 42.5,
   "end": 43.9667,
   "text": "The other golems could lift a house."
  },
  {
   "id": "4.bucket",
   "start": 43.9667,
   "end": 45.4667,
   "text": "Puddle could not lift a bucket."
  },
  {
   "id": "5.day",
   "start": 45.4667,
   "end": 47.7,
   "text": "Once a year, the golems had a strength contest."
  },
  {
   "id": "5.rock",
   "start": 47.7,
   "end": 50.4667,
   "text": "The first golem lifted a boulder. The second lifted the first golem."
  },
  {
   "id": "5.turn",
   "start": 50.4667,
   "end": 51.5333,
   "text": "Then it was Puddle's turn."
  },
  {
   "id": "5.arm",
   "start": 51.5333,
   "end": 53.3,
   "text": "He picked up the rock. His arm came off."
  },
  {
   "id": "5.other",
   "start": 53.3,
   "end": 55.6667,
   "text": "He picked it up with his other arm. That one came off too."
  },
  {
   "id": "5.last",
   "start": 55.6667,
   "end": 58.0667,
   "text": "We came last. A chicken beat us."
  },
  {
   "id": "6.want",
   "start": 58.0667,
   "end": 60.2667,
   "text": "That night, I told my dad I wanted a real golem."
  },
  {
   "id": "6.dad",
   "start": 60.2667,
   "end": 62.1,
   "text": "He said, \"Snow is all we had.\""
  },
  {
   "id": "6.heard",
   "start": 62.1,
   "end": 64.5667,
   "text": "Puddle was standing right behind me. He heard every word."
  },
  {
   "id": "7.face",
   "start": 64.5667,
   "end": 67.5667,
   "text": "Every night, every iron golem turned to face the black gate."
  },
  {
   "id": "7.puddle",
   "start": 67.5667,
   "end": 70.2333,
   "text": "Only Puddle faced the other way. He was watching me."
  },
  {
   "id": "8.night",
   "start": 70.2333,
   "end": 72.3333,
   "text": "That year, the gate lit up right on time."
  },
  {
   "id": "8.march",
   "start": 72.3333,
   "end": 75.0,
   "text": "Twenty iron golems marched up the hill. We cheered."
  },
  {
   "id": "8.out",
   "start": 75.0,
   "end": 78.5,
   "text": "But this time, it was not piglins. It was on fire, and it could fly."
  },
  {
   "id": "8.more",
   "start": 78.5,
   "end": 79.4333,
   "text": "Then ten more."
  },
  {
   "id": "9.reach",
   "start": 79.4333,
   "end": 82.1,
   "text": "Iron golems could not fly. These things could."
  },
  {
   "id": "9.red",
   "start": 82.1,
   "end": 84.4333,
   "text": "The fire came down on them. The iron went red."
  },
  {
   "id": "9.count",
   "start": 84.4333,
   "end": 86.7,
   "text": "Twenty golems. Then twelve. Then five."
  },
  {
   "id": "9.sat",
   "start": 86.7,
   "end": 88.1333,
   "text": "The last one sat down in the road."
  },
  {
   "id": "9.roofs",
   "start": 88.1333,
   "end": 89.3667,
   "text": "Then the roofs caught fire."
  },
  {
   "id": "9.end",
   "start": 89.3667,
   "end": 91.2333,
   "text": "I thought our town was finished."
  },
  {
   "id": "10.ball",
   "start": 91.2333,
   "end": 93.2333,
   "text": "Then one snowball flew across the square."
  },
  {
   "id": "10.hit",
   "start": 93.2333,
   "end": 95.8333,
   "text": "It hit one in the face. It went out, like a candle."
  },
  {
   "id": "10.look",
   "start": 95.8333,
   "end": 96.9333,
   "text": "Everyone turned around."
  },
  {
   "id": "10.puddle",
   "start": 96.9333,
   "end": 98.7,
   "text": "It was Puddle. And he had more."
  },
  {
   "id": "11.throw",
   "start": 98.7,
   "end": 101.6,
   "text": "He threw. One went out. He threw. Two more."
  },
  {
   "id": "11.fire",
   "start": 101.6,
   "end": 104.0667,
   "text": "They all turned on him at once. Fire melts snow."
  },
  {
   "id": "11.small",
   "start": 104.0667,
   "end": 107.4333,
   "text": "Every hit made him smaller. Up to my chin. Then my belt."
  },
  {
   "id": "11.umbrella",
   "start": 107.4333,
   "end": 110.4,
   "text": "So I did the only thing I knew. I opened the umbrella."
  },
  {
   "id": "11.held",
   "start": 110.4,
   "end": 113.3333,
   "text": "I held it over him. It caught fire. I kept holding it."
  },
  {
   "id": "11.knee",
   "start": 113.3333,
   "end": 115.1,
   "text": "He was at my knee now. Still throwing."
  },
  {
   "id": "11.last",
   "start": 115.1,
   "end": 118.2,
   "text": "One left. One snowball. He did not miss."
  },
  {
   "id": "12.quiet",
   "start": 118.2,
   "end": 119.7,
   "text": "Then it was quiet."
  },
  {
   "id": "12.left",
   "start": 119.7,
   "end": 121.9667,
   "text": "I looked down. There was a pumpkin, and a puddle."
  },
  {
   "id": "12.name",
   "start": 121.9667,
   "end": 123.8,
   "text": "I had named him that as a joke."
  },
  {
   "id": "13.gate",
   "start": 123.8,
   "end": 126.7333,
   "text": "On the hill, the gate lit up again. Something bigger was coming."
  },
  {
   "id": "13.nose",
   "start": 126.7333,
   "end": 129.0,
   "text": "Then something cold landed on my nose."
  },
  {
   "id": "13.snow",
   "start": 129.0,
   "end": 130.5,
   "text": "It was starting to snow."
  },
  {
   "id": "14.sub",
   "start": 130.5,
   "end": 132.6667,
   "text": "Like and subscribe for part two."
  }
 ],
