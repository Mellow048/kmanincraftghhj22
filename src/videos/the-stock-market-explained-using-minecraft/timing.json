 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 2.2,
   "text": "The stock market, explained using Minecraft."
  },
  {
   "id": "1.sam",
   "start": 2.2,
   "end": 4.6333,
   "text": "Meet Sam. He runs the busiest forge in town."
  },
  {
   "id": "1.want",
   "start": 4.6333,
   "end": 6.5333,
   "text": "Sam wants a second furnace to double his iron."
  },
  {
   "id": "1.cost",
   "start": 6.5333,
   "end": 7.9333,
   "text": "It costs one hundred emeralds."
  },
  {
   "id": "1.broke",
   "start": 7.9333,
   "end": 9.4333,
   "text": "And Sam is completely broke."
  },
  {
   "id": "2.split",
   "start": 9.4333,
   "end": 11.9,
   "text": "So Sam splits his shop into ten share tickets."
  },
  {
   "id": "2.price",
   "start": 11.9,
   "end": 13.5667,
   "text": "Each ticket costs ten emeralds."
  },
  {
   "id": "2.share",
   "start": 13.5667,
   "end": 15.5333,
   "text": "And each one owns ten percent of the forge."
  },
  {
   "id": "2.leo",
   "start": 15.5333,
   "end": 16.7,
   "text": "Leo buys one ticket."
  },
  {
   "id": "2.maya",
   "start": 16.7,
   "end": 19.0667,
   "text": "Maya buys one too, until all ten sell out."
  },
  {
   "id": "2.build",
   "start": 19.0667,
   "end": 21.0333,
   "text": "Sam takes the emeralds and builds furnace two."
  },
  {
   "id": "2.iron",
   "start": 21.0333,
   "end": 23.4,
   "text": "Now his chests overflow with bright iron ingots."
  },
  {
   "id": "3.crowd",
   "start": 23.4,
   "end": 25.2667,
   "text": "Every player in town wants a ticket now."
  },
  {
   "id": "3.jump",
   "start": 25.2667,
   "end": 27.9333,
   "text": "Leo's ten emerald ticket shoots straight to twenty five."
  },
  {
   "id": "3.smile",
   "start": 27.9333,
   "end": 31.0333,
   "text": "Leo never swung a pickaxe, yet his money doubled."
  },
  {
   "id": "4.rich",
   "start": 31.0333,
   "end": 33.4333,
   "text": "Then along walks Sterling, the richest trader here."
  },
  {
   "id": "4.cheap",
   "start": 33.4333,
   "end": 35.8,
   "text": "Sterling wants those shares, not at twenty five."
  },
  {
   "id": "4.type",
   "start": 35.8,
   "end": 38.0667,
   "text": "So Sterling types one sneaky rumor into chat."
  },
  {
   "id": "4.rumor",
   "start": 38.0667,
   "end": 39.9333,
   "text": "\"Heard Sam's iron mine just ran dry.\""
  },
  {
   "id": "4.check",
   "start": 39.9333,
   "end": 41.6333,
   "text": "Nobody walks over to check the forge."
  },
  {
   "id": "4.panic",
   "start": 41.6333,
   "end": 43.2,
   "text": "The whole town panics on the spot."
  },
  {
   "id": "5.dump",
   "start": 43.2,
   "end": 45.1,
   "text": "Everyone sprints to dump their tickets fast."
  },
  {
   "id": "5.crash",
   "start": 45.1,
   "end": 47.5333,
   "text": "In ten seconds, the green chart crashes to six."
  },
  {
   "id": "5.leo",
   "start": 47.5333,
   "end": 49.4667,
   "text": "Leo panics too and sells at a painful loss."
  },
  {
   "id": "5.floor",
   "start": 49.4667,
   "end": 51.9,
   "text": "Guess who quietly buys every cheap ticket?"
  },
  {
   "id": "5.grin",
   "start": 51.9,
   "end": 55.1333,
   "text": "Sterling. Grinning right under his shiny top hat."
  },
  {
   "id": "6.dawn",
   "start": 55.1333,
   "end": 57.8667,
   "text": "The next morning, players walk past Sam's forge."
  },
  {
   "id": "6.hot",
   "start": 57.8667,
   "end": 59.4333,
   "text": "Both furnaces are roaring hot."
  },
  {
   "id": "6.full",
   "start": 59.4333,
   "end": 61.2,
   "text": "Every chest is still packed with iron."
  },
  {
   "id": "6.truth",
   "start": 61.2,
   "end": 62.3667,
   "text": "The forge never broke."
  },
  {
   "id": "6.feel",
   "start": 62.3667,
   "end": 63.7,
   "text": "Only people's feelings broke."
  },
  {
   "id": "6.back",
   "start": 63.7,
   "end": 66.0667,
   "text": "Instantly the ticket shoots back past thirty emeralds."
  },
  {
   "id": "7.real",
   "start": 66.0667,
   "end": 68.3,
   "text": "Real life stock markets work the exact same way."
  },
  {
   "id": "7.hope",
   "start": 68.3,
   "end": 69.4,
   "text": "Prices jump on hope."
  },
  {
   "id": "7.fear",
   "start": 69.4,
   "end": 70.6333,
   "text": "And they crash on fear."
  },
  {
   "id": "7.same",
   "start": 70.6333,
   "end": 72.5333,
   "text": "Even when the shop itself never changed."
  },
  {
   "id": "7.calm",
   "start": 72.5333,
   "end": 73.9333,
   "text": "Calm buyers wait for panic."
  },
  {
   "id": "7.lose",
   "start": 73.9333,
   "end": 75.5,
   "text": "Scared sellers hand them bargains."
  },
  {
   "id": "8.ask",
   "start": 75.5,
   "end": 77.9,
   "text": "So should a stock follow what a shop makes,"
  },
  {
   "id": "8.or",
   "start": 77.9,
   "end": 79.9667,
   "text": "or what a panicked crowd thinks today?"
  },
  {
   "id": "8.loop",
   "start": 79.9667,
   "end": 81.1,
   "text": "And that is"
  }
 ],
