 "cues": [
  {
   "id": "1.if",
   "start": 0.0,
   "end": 1.7333,
   "text": "What if your shadow did what you were thinking,"
  },
  {
   "id": "1.if2",
   "start": 1.7333,
   "end": 3.0667,
   "text": "instead of what you were doing?"
  },
  {
   "id": "1.me",
   "start": 3.0667,
   "end": 4.4333,
   "text": "One morning, mine did."
  },
  {
   "id": "1.day",
   "start": 4.4333,
   "end": 7.1667,
   "text": "I did nothing to get it. It just stopped copying me."
  },
  {
   "id": "1.girl",
   "start": 7.1667,
   "end": 9.3333,
   "text": "The first thing it did was the thing I was trying not to do."
  },
  {
   "id": "2.wave",
   "start": 9.3333,
   "end": 12.0333,
   "text": "It waved at a girl. I was not waving at anyone."
  },
  {
   "id": "2.wave2",
   "start": 12.0333,
   "end": 14.6,
   "text": "She waved back. Now she thinks we are friends."
  },
  {
   "id": "2.cant2",
   "start": 14.6,
   "end": 16.1667,
   "text": "I could not put my arm down."
  },
  {
   "id": "3.same",
   "start": 16.1667,
   "end": 18.6,
   "text": "Whatever I was thinking, it was already doing it."
  },
  {
   "id": "3.sit",
   "start": 18.6,
   "end": 20.7333,
   "text": "In assembly, it sat down while I was standing."
  },
  {
   "id": "3.five",
   "start": 20.7333,
   "end": 23.0,
   "text": "Every shadow on that wall was doing something different."
  },
  {
   "id": "3.cant",
   "start": 23.0,
   "end": 25.3333,
   "text": "It cannot speak. That was going to be a problem."
  },
  {
   "id": "4.punch",
   "start": 25.3333,
   "end": 27.7333,
   "text": "It started a fight with a boy I was not fighting."
  },
  {
   "id": "4.won",
   "start": 27.7333,
   "end": 29.7667,
   "text": "I did not throw one punch. I won."
  },
  {
   "id": "4.said",
   "start": 29.7667,
   "end": 31.1667,
   "text": "Everybody thought I was honest."
  },
  {
   "id": "4.said2",
   "start": 31.1667,
   "end": 33.1,
   "text": "I was the one who never had to lie."
  },
  {
   "id": "4.alone",
   "start": 33.1,
   "end": 35.4,
   "text": "I was the only kid in that school with something in his head."
  },
  {
   "id": "5.art",
   "start": 35.4,
   "end": 37.4333,
   "text": "In a maths test, it drew a house on the wall."
  },
  {
   "id": "5.and",
   "start": 37.4333,
   "end": 38.7,
   "text": "A house I had never been in."
  },
  {
   "id": "5.five2",
   "start": 38.7,
   "end": 40.2333,
   "text": "The same house every day that week."
  },
  {
   "id": "5.five3",
   "start": 40.2333,
   "end": 41.9667,
   "text": "Three windows, one door."
  },
  {
   "id": "6.dance",
   "start": 41.9667,
   "end": 43.9333,
   "text": "While I got told off, it danced."
  },
  {
   "id": "6.read",
   "start": 43.9333,
   "end": 46.3,
   "text": "I thought everybody could read me. They were reading the wrong thing."
  },
  {
   "id": "6.almost",
   "start": 46.3,
   "end": 48.2667,
   "text": "Then it went where I could not follow."
  },
  {
   "id": "7.down",
   "start": 48.2667,
   "end": 50.0667,
   "text": "One morning it walked out of the door."
  },
  {
   "id": "7.down2",
   "start": 50.0667,
   "end": 51.3,
   "text": "I could feel which way."
  },
  {
   "id": "7.hall",
   "start": 51.3,
   "end": 53.8,
   "text": "It is not nice, having a piece of you in another room."
  },
  {
   "id": "7.quiet",
   "start": 53.8,
   "end": 55.5,
   "text": "So I stopped thinking anything."
  },
  {
   "id": "7.quiet2",
   "start": 55.5,
   "end": 57.5,
   "text": "If I think nothing, it does nothing."
  },
  {
   "id": "8.think",
   "start": 57.5,
   "end": 58.9333,
   "text": "You cannot think nothing for a week."
  },
  {
   "id": "8.think2",
   "start": 58.9333,
   "end": 60.5333,
   "text": "Thinking about not thinking counts."
  },
  {
   "id": "8.still",
   "start": 60.5333,
   "end": 62.7333,
   "text": "My shadow spent that week on the floor of the maths room,"
  },
  {
   "id": "8.still2",
   "start": 62.7333,
   "end": 63.5333,
   "text": "doing nothing."
  },
  {
   "id": "9.jo",
   "start": 63.5333,
   "end": 66.5,
   "text": "Jo sat on the floor next to it. Every lunch. Talking to it."
  },
  {
   "id": "9.me",
   "start": 66.5,
   "end": 68.5,
   "text": "I told her it was just a shadow."
  },
  {
   "id": "9.me2",
   "start": 68.5,
   "end": 69.6667,
   "text": "She said, I know."
  },
  {
   "id": "9.ask",
   "start": 69.6667,
   "end": 71.1667,
   "text": "I asked her how she knew it was there."
  },
  {
   "id": "9.she",
   "start": 71.1667,
   "end": 73.7,
   "text": "She said, it is the only thing in this town that turns up."
  },
  {
   "id": "10.window",
   "start": 73.7,
   "end": 76.5667,
   "text": "Then one night I followed it. It went to a house I had never been in."
  },
  {
   "id": "10.up",
   "start": 76.5667,
   "end": 78.6333,
   "text": "It went up the wall and stood in the window."
  },
  {
   "id": "10.open",
   "start": 78.6333,
   "end": 81.2,
   "text": "I climbed up after it. The window was open."
  },
  {
   "id": "11.brother",
   "start": 81.2,
   "end": 82.5,
   "text": "There was a kid in that bed."
  },
  {
   "id": "11.brother2",
   "start": 82.5,
   "end": 84.4333,
   "text": "His name was on the door. My brother's name."
  },
  {
   "id": "11.dead",
   "start": 84.4333,
   "end": 86.6667,
   "text": "My brother had not been in that bed for two years."
  },
  {
   "id": "11.look",
   "start": 86.6667,
   "end": 89.5333,
   "text": "But every night, from that window, he got a shadow back."
  },
  {
   "id": "11.said",
   "start": 89.5333,
   "end": 91.8667,
   "text": "It stood in his window so he would not be on his own."
  },
  {
   "id": "11.mine",
   "start": 91.8667,
   "end": 93.3333,
   "text": "It had never been my shadow."
  },
  {
   "id": "11.mine2",
   "start": 93.3333,
   "end": 95.2,
   "text": "It was his, borrowing mine."
  },
  {
   "id": "11.why",
   "start": 95.2,
   "end": 97.3333,
   "text": "A shadow cannot go where its owner has not been."
  },
  {
   "id": "11.why2",
   "start": 97.3333,
   "end": 98.9,
   "text": "So it borrowed a brother who could."
  },
  {
   "id": "12.wrong",
   "start": 98.9,
   "end": 101.2,
   "text": "Everything I showed people that week was not my head."
  },
  {
   "id": "12.wrong2",
   "start": 101.2,
   "end": 102.3333,
   "text": "It was his window."
  },
  {
   "id": "12.tell",
   "start": 102.3333,
   "end": 105.0333,
   "text": "I sat on the floor of his room and thought it as loudly as I could."
  },
  {
   "id": "12.sub",
   "start": 105.0333,
   "end": 105.9333,
   "text": "Something moved."
  },
  {
   "id": "12.sub2",
   "start": 105.9333,
   "end": 108.7,
   "text": "Subscribe, and I will tell you what he heard."
  }
 ],
