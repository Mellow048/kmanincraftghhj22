 "cues": [
  {
   "id": "1.never",
   "start": 0.0,
   "end": 2.1,
   "text": "This player never used a bed in two hundred days."
  },
  {
   "id": "1.vamp",
   "start": 2.1,
   "end": 4.1667,
   "text": "So everyone laughed and called him the vampire."
  },
  {
   "id": "1.open",
   "start": 4.1667,
   "end": 6.2333,
   "text": "When they learned why, everyone went to bed together."
  },
  {
   "id": "2.three",
   "start": 6.2333,
   "end": 8.6333,
   "text": "Skip sleep three days and Minecraft phantoms swoop down."
  },
  {
   "id": "2.sky",
   "start": 8.6333,
   "end": 10.9333,
   "text": "Green-eyed phantoms dive straight out of the midnight sky."
  },
  {
   "id": "2.fight",
   "start": 10.9333,
   "end": 13.0,
   "text": "Every night at three AM, he fought them alone."
  },
  {
   "id": "2.roof",
   "start": 13.0,
   "end": 15.2667,
   "text": "He guarded one tiny cabin swinging his diamond sword."
  },
  {
   "id": "3.not",
   "start": 15.2667,
   "end": 17.4333,
   "text": "He was never a vampire or sleepless tryhard."
  },
  {
   "id": "3.bro",
   "start": 17.4333,
   "end": 19.6333,
   "text": "He was a big brother protecting his little brother."
  },
  {
   "id": "3.irl",
   "start": 19.6333,
   "end": 21.6667,
   "text": "In real life, his brother feared the dark."
  },
  {
   "id": "3.awake",
   "start": 21.6667,
   "end": 23.9333,
   "text": "Every night, he stayed awake keeping phantoms away."
  },
  {
   "id": "3.safe",
   "start": 23.9333,
   "end": 26.0667,
   "text": "Inside the warm cabin, his brother played safely."
  },
  {
   "id": "4.bully",
   "start": 26.0667,
   "end": 28.0333,
   "text": "One night, a player laughed in his face."
  },
  {
   "id": "4.mock",
   "start": 28.0333,
   "end": 30.3667,
   "text": "He typed: you are just scared of monsters lol."
  },
  {
   "id": "4.hurt",
   "start": 30.3667,
   "end": 32.3667,
   "text": "Marcus lowered his sword and stared at chat."
  },
  {
   "id": "4.left",
   "start": 32.3667,
   "end": 34.6,
   "text": "Without a word, he logged off for good."
  },
  {
   "id": "5.msg",
   "start": 34.6,
   "end": 36.7333,
   "text": "The server owner messaged him asking what happened."
  },
  {
   "id": "5.tell",
   "start": 36.7333,
   "end": 38.8667,
   "text": "Marcus told him everything about his little brother."
  },
  {
   "id": "5.idea",
   "start": 38.8667,
   "end": 40.8333,
   "text": "The owner stared — and knew exactly what to do!"
  },
  {
   "id": "6.one",
   "start": 40.8333,
   "end": 43.0,
   "text": "Because one bed in Minecraft skips the whole night."
  },
  {
   "id": "6.ping",
   "start": 43.0,
   "end": 45.0333,
   "text": "The owner pinged everyone to grab wool and oak."
  },
  {
   "id": "6.build",
   "start": 45.0333,
   "end": 47.2333,
   "text": "Every player rushed into one giant wooden hall."
  },
  {
   "id": "6.fifty",
   "start": 47.2333,
   "end": 49.2333,
   "text": "All night, they placed fifty beds side by side!"
  },
  {
   "id": "7.join",
   "start": 49.2333,
   "end": 51.6,
   "text": "Next evening, Marcus finally joined the server again."
  },
  {
   "id": "7.wait",
   "start": 51.6,
   "end": 53.9333,
   "text": "Fifty bright beds and smiling players waited inside."
  },
  {
   "id": "7.chat",
   "start": 53.9333,
   "end": 55.9333,
   "text": "He typed softly: I am not alone anymore."
  },
  {
   "id": "7.all",
   "start": 55.9333,
   "end": 58.1667,
   "text": "Together, all fifty players lay down at once."
  },
  {
   "id": "7.sleep",
   "start": 58.1667,
   "end": 60.1333,
   "text": "First time in two hundred days, he slept."
  },
  {
   "id": "7.dawn",
   "start": 60.1333,
   "end": 62.5333,
   "text": "Golden sunrise broke across spawn with zero phantoms."
  },
  {
   "id": "7.hug",
   "start": 62.5333,
   "end": 64.6667,
   "text": "His little brother ran outside grinning and hugged him."
  },
  {
   "id": "7.sub",
   "start": 64.6667,
   "end": 66.7,
   "text": "So subscribe if you would go to bed, too."
  }
 ],
