 "cues": [
  {
   "id": "1.if",
   "start": 0.0,
   "end": 2.1333,
   "text": "What if everybody forgot you the moment you left the room?"
  },
  {
   "id": "1.me",
   "start": 2.1333,
   "end": 4.0,
   "text": "Since I was six, they have."
  },
  {
   "id": "1.day",
   "start": 4.0,
   "end": 5.7,
   "text": "It started on my first day of school."
  },
  {
   "id": "1.daya",
   "start": 5.7,
   "end": 7.9,
   "text": "I walked out at break and nobody knew me at lunch."
  },
  {
   "id": "1.why",
   "start": 7.9,
   "end": 9.2667,
   "text": "Nobody ever asked where I was."
  },
  {
   "id": "1.whya",
   "start": 9.2667,
   "end": 11.2333,
   "text": "That should have been the first clue."
  },
  {
   "id": "2.rule",
   "start": 11.2333,
   "end": 13.8667,
   "text": "If I leave a room, everybody in it forgets I was ever in it."
  },
  {
   "id": "2.food",
   "start": 13.8667,
   "end": 15.3667,
   "text": "I ate a whole lunch and walked out."
  },
  {
   "id": "2.fooda",
   "start": 15.3667,
   "end": 17.3333,
   "text": "She smiled at the next kid and asked what he wanted."
  },
  {
   "id": "2.tell",
   "start": 17.3333,
   "end": 19.8,
   "text": "My teacher told me off. I left. I came back."
  },
  {
   "id": "2.tella",
   "start": 19.8,
   "end": 22.2333,
   "text": "He told me off again, angrier, for the first time."
  },
  {
   "id": "2.chair",
   "start": 22.2333,
   "end": 23.3667,
   "text": "I left a class for a minute."
  },
  {
   "id": "2.chaira",
   "start": 23.3667,
   "end": 25.6,
   "text": "They spent the rest of it staring at an empty chair."
  },
  {
   "id": "3.five",
   "start": 25.6,
   "end": 27.5667,
   "text": "My mum sets five places at dinner."
  },
  {
   "id": "3.fivea",
   "start": 27.5667,
   "end": 28.8,
   "text": "There are four of us."
  },
  {
   "id": "3.shop",
   "start": 28.8,
   "end": 30.2667,
   "text": "I walked a bike out of a shop."
  },
  {
   "id": "3.shopa",
   "start": 30.2667,
   "end": 31.4667,
   "text": "The man held the door for me."
  },
  {
   "id": "3.rooms",
   "start": 31.4667,
   "end": 33.3333,
   "text": "Rooms. It is only rooms."
  },
  {
   "id": "3.roomsa",
   "start": 33.3333,
   "end": 36.3,
   "text": "If I am outside, under the sky, people remember me."
  },
  {
   "id": "4.best",
   "start": 36.3,
   "end": 37.9667,
   "text": "I thought it was the best thing that had ever happened to me."
  },
  {
   "id": "4.nobody",
   "start": 37.9667,
   "end": 39.1667,
   "text": "I could do anything."
  },
  {
   "id": "4.nobodya",
   "start": 39.1667,
   "end": 40.2667,
   "text": "So I did nothing."
  },
  {
   "id": "5.sky",
   "start": 40.2667,
   "end": 42.2333,
   "text": "The only place I was real was outside."
  },
  {
   "id": "5.alone",
   "start": 42.2333,
   "end": 44.4,
   "text": "Outside is also where you are on your own."
  },
  {
   "id": "5.alonea",
   "start": 44.4,
   "end": 46.7333,
   "text": "Which is the price, and I did not know it yet."
  },
  {
   "id": "6.week",
   "start": 46.7333,
   "end": 48.9333,
   "text": "Nobody remembered the week I was funny."
  },
  {
   "id": "6.better",
   "start": 48.9333,
   "end": 51.0,
   "text": "Nobody remembered the week I was kind."
  },
  {
   "id": "6.bettera",
   "start": 51.0,
   "end": 52.0667,
   "text": "I stopped being either."
  },
  {
   "id": "7.jo",
   "start": 52.0667,
   "end": 53.1333,
   "text": "Jo remembered me."
  },
  {
   "id": "7.joa",
   "start": 53.1333,
   "end": 55.0333,
   "text": "Out of everybody, only Jo."
  },
  {
   "id": "7.saw",
   "start": 55.0333,
   "end": 56.6667,
   "text": "She said my name in a corridor"
  },
  {
   "id": "7.sawa",
   "start": 56.6667,
   "end": 58.4333,
   "text": "like it was a normal thing to say."
  },
  {
   "id": "8.bill",
   "start": 58.4333,
   "end": 60.3,
   "text": "Then I came back into a room too fast"
  },
  {
   "id": "8.billa",
   "start": 60.3,
   "end": 61.8,
   "text": "and saw it before it went."
  },
  {
   "id": "8.ledger",
   "start": 61.8,
   "end": 63.3667,
   "text": "My name, on a piece of paper,"
  },
  {
   "id": "8.ledgera",
   "start": 63.3667,
   "end": 64.3,
   "text": "with a number next to it."
  },
  {
   "id": "9.arranged",
   "start": 64.3,
   "end": 65.2333,
   "text": "Somebody was paying."
  },
  {
   "id": "9.arrangeda",
   "start": 65.2333,
   "end": 67.1,
   "text": "And they were arranging the rooms so I would be in them."
  },
  {
   "id": "9.he",
   "start": 67.1,
   "end": 68.6,
   "text": "It was the teacher who kept telling me off."
  },
  {
   "id": "9.hea",
   "start": 68.6,
   "end": 71.0,
   "text": "He was not angry. He was paid to remember me."
  },
  {
   "id": "10.wall",
   "start": 71.0,
   "end": 72.4333,
   "text": "Every room costs."
  },
  {
   "id": "10.walla",
   "start": 72.4333,
   "end": 74.5,
   "text": "A classroom is cheap. A whole lunch is not."
  },
  {
   "id": "10.mum",
   "start": 74.5,
   "end": 76.3667,
   "text": "I followed the paper home. It went to my house."
  },
  {
   "id": "11.paid",
   "start": 76.3667,
   "end": 78.1667,
   "text": "My mum was at the kitchen table with a pencil,"
  },
  {
   "id": "11.paida",
   "start": 78.1667,
   "end": 79.6,
   "text": "counting coins into a tin."
  },
  {
   "id": "11.mine",
   "start": 79.6,
   "end": 81.6333,
   "text": "She has been paying for me since I was six."
  },
  {
   "id": "11.why",
   "start": 81.6333,
   "end": 83.2667,
   "text": "Not so I could do anything I wanted."
  },
  {
   "id": "11.whya",
   "start": 83.2667,
   "end": 85.1667,
   "text": "So that the world would not have to remember me."
  },
  {
   "id": "12.world",
   "start": 85.1667,
   "end": 87.2,
   "text": "Because she knew what it costs to be remembered,"
  },
  {
   "id": "12.worlda",
   "start": 87.2,
   "end": 88.8333,
   "text": "and she wanted me to cost less."
  },
  {
   "id": "12.out",
   "start": 88.8333,
   "end": 91.3,
   "text": "Then I walked out of the front door, under the sky,"
  },
  {
   "id": "12.outa",
   "start": 91.3,
   "end": 92.5667,
   "text": "and somebody said my name."
  },
  {
   "id": "12.sub",
   "start": 92.5667,
   "end": 93.7333,
   "text": "Somebody I have never met."
  },
  {
   "id": "12.suba",
   "start": 93.7333,
   "end": 95.8333,
   "text": "Subscribe, and I will tell you who."
  }
 ],
