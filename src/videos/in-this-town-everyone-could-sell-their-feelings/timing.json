 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.0667,
   "text": "In this town, everyone could sell a feeling."
  },
  {
   "id": "1.me",
   "start": 2.0667,
   "end": 4.0333,
   "text": "Except me. I was too scared to try."
  },
  {
   "id": "2.from",
   "start": 4.0333,
   "end": 5.6,
   "text": "Nobody knew where the feelings went."
  },
  {
   "id": "2.witch",
   "start": 5.6,
   "end": 7.8667,
   "text": "Nobody knew why the witch never left her shop."
  },
  {
   "id": "2.price",
   "start": 7.8667,
   "end": 10.2667,
   "text": "And nobody knew why the richest man never smiled."
  },
  {
   "id": "3.shop",
   "start": 10.2667,
   "end": 13.3333,
   "text": "The witch's shop had one humming helmet and shelves of empty glass."
  },
  {
   "id": "3.anger",
   "start": 13.3333,
   "end": 16.3333,
   "text": "My neighbor sold his anger. It dropped with a plink and he never shouted again."
  },
  {
   "id": "3.calm",
   "start": 16.3333,
   "end": 19.8333,
   "text": "The next morning his kid spilled soup on his shoes and he just smiled."
  },
  {
   "id": "3.sad",
   "start": 19.8333,
   "end": 23.8,
   "text": "My friend sold her sadness. It fell blue and she laughed when rain ruined her drawings."
  },
  {
   "id": "3.shy",
   "start": 23.8,
   "end": 26.8,
   "text": "The shy boy sold his shyness and waved at the whole square the next day."
  },
  {
   "id": "3.greedy",
   "start": 26.8,
   "end": 29.3,
   "text": "One man sold everything and just stared at his coins."
  },
  {
   "id": "3.mimic",
   "start": 29.3,
   "end": 31.8,
   "text": "He copied how we sat, how we smiled — a second late."
  },
  {
   "id": "3.golem",
   "start": 31.8,
   "end": 34.6333,
   "text": "Even the iron golem left a bottle — his lonely — and stood taller."
  },
  {
   "id": "4.good",
   "start": 34.6333,
   "end": 36.0667,
   "text": "It was a good life, honestly."
  },
  {
   "id": "4.dream",
   "start": 36.0667,
   "end": 38.8333,
   "text": "But I dreamed of a lemonade stand and froze every time someone looked."
  },
  {
   "id": "5.ask",
   "start": 38.8333,
   "end": 41.0333,
   "text": "So I asked the witch if fear was for sale."
  },
  {
   "id": "5.look",
   "start": 41.0333,
   "end": 42.8,
   "text": "She looked at my hands for a long time."
  },
  {
   "id": "5.hmm",
   "start": 42.8,
   "end": 45.4667,
   "text": "Then she said, fear keeps you alive."
  },
  {
   "id": "5.rule",
   "start": 45.4667,
   "end": 48.3333,
   "text": "It meant: don't sell the one that keeps you alive."
  },
  {
   "id": "6.plant",
   "start": 48.3333,
   "end": 50.1667,
   "text": "What did fear have to do with lemonade?"
  },
  {
   "id": "6.decide",
   "start": 50.1667,
   "end": 51.6,
   "text": "I decided to sell it anyway."
  },
  {
   "id": "7.helmet",
   "start": 51.6,
   "end": 54.1333,
   "text": "The next morning I sat under the humming helmet."
  },
  {
   "id": "7.plink",
   "start": 54.1333,
   "end": 56.6,
   "text": "My fear dropped with a plink — yellow — and I didn't flinch."
  },
  {
   "id": "7.home",
   "start": 56.6,
   "end": 59.1,
   "text": "I carried the bottle to her shelf and walked home light."
  },
  {
   "id": "7.laugh",
   "start": 59.1,
   "end": 61.4333,
   "text": "The whole square hummed that day and I hummed with them."
  },
  {
   "id": "8.stand",
   "start": 61.4333,
   "end": 64.5,
   "text": "Every morning I built my stand and never looked for traffic."
  },
  {
   "id": "8.line",
   "start": 64.5,
   "end": 67.2,
   "text": "Every day I shouted louder and never counted change right."
  },
  {
   "id": "8.money",
   "start": 67.2,
   "end": 69.1333,
   "text": "I sold out by noon and felt nothing."
  },
  {
   "id": "9.friend",
   "start": 69.1333,
   "end": 71.4,
   "text": "My best friend was waiting by my stand that night."
  },
  {
   "id": "9.worry",
   "start": 71.4,
   "end": 73.9,
   "text": "She said, you don't look before you cross anymore."
  },
  {
   "id": "9.sleeves",
   "start": 73.9,
   "end": 75.4667,
   "text": "I said, I don't have to."
  },
  {
   "id": "10.rush",
   "start": 75.4667,
   "end": 76.9333,
   "text": "The rush came just before close."
  },
  {
   "id": "10.line",
   "start": 76.9333,
   "end": 80.3,
   "text": "A line for lemonade, a cart rolling behind me, and I felt nothing."
  },
  {
   "id": "10.hands",
   "start": 80.3,
   "end": 81.8,
   "text": "I kept pouring with both hands."
  },
  {
   "id": "10.lean",
   "start": 81.8,
   "end": 84.0667,
   "text": "I leaned over the counter and didn't hear the wheels."
  },
  {
   "id": "11.stand",
   "start": 84.0667,
   "end": 86.0667,
   "text": "Then I saw my fear standing at my stand."
  },
  {
   "id": "11.yellow",
   "start": 86.0667,
   "end": 88.8333,
   "text": "Yellow, small, watching the road I never watched."
  },
  {
   "id": "11.caught",
   "start": 88.8333,
   "end": 91.6333,
   "text": "It didn't wave. It just stared at the cart and shook."
  },
  {
   "id": "11.cold",
   "start": 91.6333,
   "end": 94.2,
   "text": "And for the first time that week I felt cold."
  },
  {
   "id": "12.clear",
   "start": 94.2,
   "end": 97.1,
   "text": "When the cart cleared the corner I saw what my fear had been doing."
  },
  {
   "id": "12.watching",
   "start": 97.1,
   "end": 98.9,
   "text": "It had been watching the road while I poured."
  },
  {
   "id": "12.never",
   "start": 98.9,
   "end": 101.0,
   "text": "No one had taken it. I had left it there."
  },
  {
   "id": "12.held",
   "start": 101.0,
   "end": 102.6,
   "text": "The witch had just been holding it still."
  },
  {
   "id": "12.greedy2",
   "start": 102.6,
   "end": 104.9,
   "text": "And the rich man was still staring — he had no one left to copy."
  },
  {
   "id": "13.known",
   "start": 104.9,
   "end": 106.7667,
   "text": "My town had always known which feeling to keep."
  },
  {
   "id": "13.hoped",
   "start": 106.7667,
   "end": 108.5667,
   "text": "They just hoped I would learn before I needed it."
  },
  {
   "id": "14.seen",
   "start": 108.5667,
   "end": 111.2333,
   "text": "Then my friend pulled the cart and it stopped an inch from my stand."
  },
  {
   "id": "14.waved",
   "start": 111.2333,
   "end": 113.3667,
   "text": "She was shaking. I was finally shaking with her."
  },
  {
   "id": "14.sub",
   "start": 113.3667,
   "end": 116.2,
   "text": "Subscribe before you sell the feeling that keeps you alive."
  }
 ],
