 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.4,
   "text": "In this town, every kid had one big dad."
  },
  {
   "id": "1.four",
   "start": 2.4,
   "end": 3.7333,
   "text": "I had four tiny ones."
  },
  {
   "id": "1.same",
   "start": 3.7333,
   "end": 5.3333,
   "text": "And they were all the same guy."
  },
  {
   "id": "1.reed",
   "start": 5.3333,
   "end": 6.9333,
   "text": "He found me in a basket by the swamp."
  },
  {
   "id": "1.tall",
   "start": 6.9333,
   "end": 8.7333,
   "text": "Back then, he was two blocks tall."
  },
  {
   "id": "1.pat",
   "start": 8.7333,
   "end": 10.6,
   "text": "One pat from him sent me across the room."
  },
  {
   "id": "1.barrow",
   "start": 10.6,
   "end": 12.4333,
   "text": "Now all four fit in one wheelbarrow."
  },
  {
   "id": "2.bump",
   "start": 12.4333,
   "end": 14.0,
   "text": "A big slime knocks you flat."
  },
  {
   "id": "2.shin",
   "start": 14.0,
   "end": 15.8,
   "text": "A tiny slime cannot hurt a fly."
  },
  {
   "id": "2.dinner",
   "start": 15.8,
   "end": 17.8333,
   "text": "At dinner, all four yelled about my carrots."
  },
  {
   "id": "2.soup",
   "start": 17.8333,
   "end": 19.6333,
   "text": "Number three always slipped into the soup."
  },
  {
   "id": "2.door",
   "start": 19.6333,
   "end": 21.5,
   "text": "To open doors, he stood on his own head."
  },
  {
   "id": "2.clumsy",
   "start": 21.5,
   "end": 23.7667,
   "text": "I thought my dad was just clumsy."
  },
  {
   "id": "2.porch",
   "start": 23.7667,
   "end": 25.4333,
   "text": "He said he split falling down our stairs."
  },
  {
   "id": "2.cactus",
   "start": 25.4333,
   "end": 27.2667,
   "text": "And split again walking into a cactus."
  },
  {
   "id": "2.swamp",
   "start": 27.2667,
   "end": 29.1333,
   "text": "We lived in a swamp. No cacti anywhere."
  },
  {
   "id": "2.coat",
   "start": 29.1333,
   "end": 30.8,
   "text": "Only my torn baby coat hung by the door."
  },
  {
   "id": "2.bridge",
   "start": 30.8,
   "end": 33.1667,
   "text": "Every sunset, they barred the old river bridge."
  },
  {
   "id": "2.water",
   "start": 33.1667,
   "end": 34.9333,
   "text": "I thought they feared the dark water."
  },
  {
   "id": "2.splits",
   "start": 34.9333,
   "end": 37.3,
   "text": "Grandpa warned me tiny slimes have no splits left."
  },
  {
   "id": "2.ball",
   "start": 37.3,
   "end": 39.9333,
   "text": "One hit, and only a slimeball comes home."
  },
  {
   "id": "3.corner",
   "start": 39.9333,
   "end": 42.9,
   "text": "Every morning, I made them stop at the corner."
  },
  {
   "id": "3.friday",
   "start": 42.9,
   "end": 45.8,
   "text": "Fridays, big dads bounced kids onto the school roof."
  },
  {
   "id": "3.plank",
   "start": 45.8,
   "end": 47.4333,
   "text": "My four dads jumped on a plank."
  },
  {
   "id": "3.inch",
   "start": 47.4333,
   "end": 49.7,
   "text": "I went up two inches. Everyone laughed."
  },
  {
   "id": "3.wish",
   "start": 49.7,
   "end": 52.2667,
   "text": "Walking home, I wished for one real dad."
  },
  {
   "id": "3.quiet",
   "start": 52.2667,
   "end": 53.5667,
   "text": "None of them bounced after that."
  },
  {
   "id": "3.shed",
   "start": 53.5667,
   "end": 55.8333,
   "text": "They shut the shed and pressed slimeballs together."
  },
  {
   "id": "4.sunset",
   "start": 55.8333,
   "end": 58.0,
   "text": "At sunset, I unbarred that bridge alone."
  },
  {
   "id": "4.ruins",
   "start": 58.0,
   "end": 59.6333,
   "text": "I crossed over into the stone ruins."
  },
  {
   "id": "4.vine",
   "start": 59.6333,
   "end": 61.0333,
   "text": "Then the vines on the wall stood up."
  },
  {
   "id": "4.golem",
   "start": 61.0333,
   "end": 63.0,
   "text": "An iron golem, taller than a house."
  },
  {
   "id": "4.past",
   "start": 63.0,
   "end": 65.0667,
   "text": "Golems ignore kids, so it walked past me."
  },
  {
   "id": "4.barrow",
   "start": 65.0667,
   "end": 67.1333,
   "text": "Until my dads rolled up with my coat."
  },
  {
   "id": "4.hunt",
   "start": 67.1333,
   "end": 69.1333,
   "text": "An iron golem hunts every slime it sees."
  },
  {
   "id": "4.slam",
   "start": 69.1333,
   "end": 71.5,
   "text": "Both fists slammed two craters into the rail."
  },
  {
   "id": "5.stare",
   "start": 71.5,
   "end": 73.1333,
   "text": "I stared at those two white dents."
  },
  {
   "id": "5.craters",
   "start": 73.1333,
   "end": 75.7,
   "text": "The craters by our stairs. No cacti here."
  },
  {
   "id": "5.list",
   "start": 75.7,
   "end": 78.0,
   "text": "My torn baby coat. The barred bridge."
  },
  {
   "id": "5.never",
   "start": 78.0,
   "end": 79.7667,
   "text": "My dad never fell down the stairs."
  },
  {
   "id": "5.twice",
   "start": 79.7667,
   "end": 81.4667,
   "text": "Twice he took that fist to save me."
  },
  {
   "id": "5.zero",
   "start": 81.4667,
   "end": 82.9,
   "text": "Now he had zero splits left."
  },
  {
   "id": "5.front",
   "start": 82.9,
   "end": 85.2,
   "text": "And all four still stacked in front of me."
  },
  {
   "id": "6.scoop",
   "start": 85.2,
   "end": 86.6667,
   "text": "I scooped them up and ran back."
  },
  {
   "id": "6.pin",
   "start": 86.6667,
   "end": 88.2,
   "text": "I knocked the wooden pin from the post."
  },
  {
   "id": "6.drop",
   "start": 88.2,
   "end": 90.4,
   "text": "The bridge fell, and iron golems cannot swim."
  },
  {
   "id": "6.sink",
   "start": 90.4,
   "end": 92.2667,
   "text": "It sank straight down and stared at a fish."
  },
  {
   "id": "6.rope",
   "start": 92.2667,
   "end": 93.7667,
   "text": "Then a snapping rope pulled me off the ledge."
  },
  {
   "id": "6.three",
   "start": 93.7667,
   "end": 95.6,
   "text": "Number three slipped down into their wheelbarrow."
  },
  {
   "id": "6.block",
   "start": 95.6,
   "end": 97.6333,
   "text": "The sheet flew off one green slime block."
  },
  {
   "id": "6.boing",
   "start": 97.6333,
   "end": 99.9333,
   "text": "We hit it and bounced above the trees."
  },
  {
   "id": "7.hug",
   "start": 99.9333,
   "end": 102.0,
   "text": "A big dad could never hug me without hurting me."
  },
  {
   "id": "7.hold",
   "start": 102.0,
   "end": 104.1,
   "text": "Being small meant all four could hold me at once."
  },
  {
   "id": "7.roof",
   "start": 104.1,
   "end": 106.2667,
   "text": "Next Friday, I bounced past the bell tower."
  },
  {
   "id": "7.gate",
   "start": 106.2667,
   "end": 108.0,
   "text": "Now we roll right through the school gate."
  },
  {
   "id": "8.sub",
   "start": 108.0,
   "end": 110.4333,
   "text": "Like and subscribe before dad number three slips again."
  }
 ],
