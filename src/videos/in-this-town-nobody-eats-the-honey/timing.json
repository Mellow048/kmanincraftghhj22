 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 1.8667,
   "text": "In this town, nobody eats the honey."
  },
  {
   "id": "1.names",
   "start": 1.8667,
   "end": 3.9,
   "text": "Four hundred glowing jars line our hall wall."
  },
  {
   "id": "1.tag",
   "start": 3.9,
   "end": 5.7,
   "text": "Every single jar has a name on it."
  },
  {
   "id": "1.first",
   "start": 5.7,
   "end": 7.6333,
   "text": "The oldest dusty jar just says First."
  },
  {
   "id": "1.want",
   "start": 7.6333,
   "end": 9.5667,
   "text": "I wanted one tiny taste, that's all."
  },
  {
   "id": "1.misread",
   "start": 9.5667,
   "end": 11.2333,
   "text": "I thought our mayor hoarded them to sell."
  },
  {
   "id": "2.poppy",
   "start": 11.2333,
   "end": 13.4,
   "text": "Every morning, Dad walked holding a red poppy."
  },
  {
   "id": "2.bus",
   "start": 13.4,
   "end": 15.3333,
   "text": "Six fuzzy bees floated right behind him."
  },
  {
   "id": "2.smoke",
   "start": 15.3333,
   "end": 17.8,
   "text": "On harvest day, everyone lit campfires under hives."
  },
  {
   "id": "2.calm",
   "start": 17.8,
   "end": 19.7333,
   "text": "White smoke curled up so nobody swatted."
  },
  {
   "id": "2.class",
   "start": 19.7333,
   "end": 21.9,
   "text": "At school, my class faced one bee on the sill."
  },
  {
   "id": "2.sorry",
   "start": 21.9,
   "end": 23.7,
   "text": "We all said sorry out loud together."
  },
  {
   "id": "2.mayor",
   "start": 23.7,
   "end": 26.1,
   "text": "I asked the mayor once. He said no."
  },
  {
   "id": "3.try",
   "start": 26.1,
   "end": 27.9333,
   "text": "So I wore a bucket with zero smoke."
  },
  {
   "id": "3.reach",
   "start": 27.9333,
   "end": 29.9,
   "text": "I reached straight inside with my wooden spoon."
  },
  {
   "id": "3.swarm",
   "start": 29.9,
   "end": 31.9333,
   "text": "Ten angry red-eyed bees roared out after me!"
  },
  {
   "id": "3.chase",
   "start": 31.9333,
   "end": 33.9667,
   "text": "They chased me across the whole market square."
  },
  {
   "id": "3.well",
   "start": 33.9667,
   "end": 35.9,
   "text": "I sprinted and dived into our stone well."
  },
  {
   "id": "3.truce",
   "start": 35.9,
   "end": 38.1333,
   "text": "Inside, I pulled Dad's poppy from my pocket."
  },
  {
   "id": "3.soft",
   "start": 38.1333,
   "end": 40.1333,
   "text": "Every angry bee softened and drifted toward it."
  },
  {
   "id": "3.mine",
   "start": 40.1333,
   "end": 42.1,
   "text": "One little bee stayed hovering beside my shoulder."
  },
  {
   "id": "4.golden",
   "start": 42.1,
   "end": 44.3,
   "text": "At golden hour, I crept back with my spoon."
  },
  {
   "id": "4.land",
   "start": 44.3,
   "end": 46.1667,
   "text": "My little bee landed right on my spoon."
  },
  {
   "id": "4.panic",
   "start": 46.1667,
   "end": 48.9,
   "text": "Its wings buzzed near my face. I panicked."
  },
  {
   "id": "4.swat",
   "start": 48.9,
   "end": 50.7667,
   "text": "I swatted once, and it stung my hand!"
  },
  {
   "id": "4.poison",
   "start": 50.7667,
   "end": 52.6667,
   "text": "My hearts turned green and ticked down fast."
  },
  {
   "id": "4.ticks",
   "start": 52.6667,
   "end": 54.8333,
   "text": "Ten hearts, seven, four, down to one!"
  },
  {
   "id": "4.sprint",
   "start": 54.8333,
   "end": 56.8,
   "text": "I stumbled outside as the mayor sprinted over."
  },
  {
   "id": "5.hall",
   "start": 56.8,
   "end": 58.7,
   "text": "He carried me inside and grabbed a jar."
  },
  {
   "id": "5.pour",
   "start": 58.7,
   "end": 60.6333,
   "text": "He poured sweet amber honey onto my spoon."
  },
  {
   "id": "5.cure",
   "start": 60.6333,
   "end": 62.9,
   "text": "In Minecraft, honey cures poison right away."
  },
  {
   "id": "5.red",
   "start": 62.9,
   "end": 65.6667,
   "text": "All ten hearts flashed red. I gasped awake."
  },
  {
   "id": "5.dusk",
   "start": 65.6667,
   "end": 68.0,
   "text": "Outside, the sun sank over the sunflower fields."
  },
  {
   "id": "5.home",
   "start": 68.0,
   "end": 69.8667,
   "text": "Every single bee flew home to its hive."
  },
  {
   "id": "5.mine",
   "start": 69.8667,
   "end": 71.7333,
   "text": "I checked the sill — my bee never went home."
  },
  {
   "id": "5.still",
   "start": 71.7333,
   "end": 74.3667,
   "text": "Its tiny wings slowed down, then stopped completely."
  },
  {
   "id": "6.list",
   "start": 74.3667,
   "end": 78.6,
   "text": "The names. The flowers. The smoke. The sorry."
  },
  {
   "id": "6.sting",
   "start": 78.6,
   "end": 80.3333,
   "text": "A sting is the last thing a bee does."
  },
  {
   "id": "6.why",
   "start": 80.3333,
   "end": 83.2,
   "text": "Smoke keeps them safe. Sorry means we know."
  },
  {
   "id": "6.grandma",
   "start": 83.2,
   "end": 85.2,
   "text": "The mayor pointed up at the jar named First."
  },
  {
   "id": "6.saved",
   "start": 85.2,
   "end": 87.5333,
   "text": "That jar saved Grandma, the baker, half our town."
  },
  {
   "id": "6.empty",
   "start": 87.5333,
   "end": 89.4333,
   "text": "He placed one empty jar labeled Spoon."
  },
  {
   "id": "6.mine2",
   "start": 89.4333,
   "end": 91.3667,
   "text": "The honey that saved me came from my bee."
  },
  {
   "id": "6.plant",
   "start": 91.3667,
   "end": 93.5667,
   "text": "Next morning, I planted my poppy under the sill."
  },
  {
   "id": "6.rally",
   "start": 93.5667,
   "end": 95.6667,
   "text": "The whole town knelt planting four hundred flowers."
  },
  {
   "id": "6.crops",
   "start": 95.6667,
   "end": 98.0333,
   "text": "Bees drifted across the fields making crops bloom."
  },
  {
   "id": "6.sorry2",
   "start": 98.0333,
   "end": 100.1,
   "text": "Nobody laughed when the whole town whispered sorry."
  },
  {
   "id": "6.sub",
   "start": 100.1,
   "end": 102.4667,
   "text": "Subscribe, and plant one too — because in this town..."
  }
 ],
