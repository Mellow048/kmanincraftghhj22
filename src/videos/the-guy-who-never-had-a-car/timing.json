  "cues": [
    {
      "id": "1",
      "start": 0.0,
      "end": 1.8,
      "text": "HUS! HUS! HUS! HUS!"
    },
    {
      "id": "2",
      "start": 1.8,
      "end": 3.5,
      "text": "HUS! HUS! HUS! HUS!"
    },
    {
      "id": "3",
      "start": 3.5,
      "end": 6.8,
      "text": "HUS! HUS! HUS! HUS! HUS! HUS! HUS!"
    },
    {
      "id": "4",
      "start": 6.8,
      "end": 7.1,
      "text": "..."
    },
    {
      "id": "5",
      "start": 7.1,
      "end": 9.166667,
      "text": "Brooo! Get in! We're going to the lake! Bro,"
    },
    {
      "id": "6",
      "start": 9.166667,
      "end": 11.7,
      "text": "you don't even have a car! Stop washing that thing!"
    },
    {
      "id": "7",
      "start": 11.7,
      "end": 14.2,
      "text": "In this town, everybody loved to drive. Every"
    },
    {
      "id": "8",
      "start": 14.2,
      "end": 15.8,
      "text": "single Friday, my friends would"
    },
    {
      "id": "9",
      "start": 15.8,
      "end": 17.533333,
      "text": "line up, and go somewhere. I"
    },
    {
      "id": "10",
      "start": 17.533333,
      "end": 18.7,
      "text": "never had a car. I"
    },
    {
      "id": "11",
      "start": 18.7,
      "end": 19.733333,
      "text": "had a sponge. And"
    },
    {
      "id": "12",
      "start": 19.733333,
      "end": 20.766667,
      "text": "I had a different dream."
    },
    {
      "id": "13",
      "start": 20.766667,
      "end": 22.366667,
      "text": "I didn't want to drive it. I"
    },
    {
      "id": "14",
      "start": 22.366667,
      "end": 24.3,
      "text": "wanted to be the one who makes it shine."
    },
    {
      "id": "15",
      "start": 24.3,
      "end": 24.766667,
      "text": "Ahh! Almost!"
    },
    {
      "id": "16",
      "start": 24.766667,
      "end": 25.666667,
      "text": "Almost!"
    },
    {
      "id": "17",
      "start": 25.666667,
      "end": 27.166667,
      "text": "While my friends were out driving, I"
    },
    {
      "id": "18",
      "start": 27.166667,
      "end": 29.3,
      "text": "was in that driveway every single night. I"
    },
    {
      "id": "19",
      "start": 29.3,
      "end": 30.133333,
      "text": "ruined hundreds of paint"
    },
    {
      "id": "20",
      "start": 30.133333,
      "end": 31.033333,
      "text": "jobs. Went"
    },
    {
      "id": "21",
      "start": 31.033333,
      "end": 32.7,
      "text": "through thousands of sponges. And"
    },
    {
      "id": "22",
      "start": 32.7,
      "end": 34.2,
      "text": "spent countless nights, with"
    },
    {
      "id": "23",
      "start": 34.2,
      "end": 35.033333,
      "text": "a bucket, and"
    },
    {
      "id": "24",
      "start": 35.033333,
      "end": 35.733333,
      "text": "a hose."
    },
    {
      "id": "25",
      "start": 35.733333,
      "end": 36.133333,
      "text": "..."
    },
    {
      "id": "26",
      "start": 36.133333,
      "end": 36.533333,
      "text": "..."
    },
    {
      "id": "27",
