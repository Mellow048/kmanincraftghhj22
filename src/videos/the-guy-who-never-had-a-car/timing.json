      "end": 38.533333,
      "text": "..."
    },
    {
      "id": "32",
      "start": 38.533333,
      "end": 38.933333,
      "text": "Months"
    },
    {
      "id": "33",
      "start": 38.933333,
      "end": 40.8,
      "text": "passed. And eventually, I"
    },
    {
      "id": "34",
      "start": 40.8,
      "end": 41.333333,
      "text": "was ready. One"
    },
    {
      "id": "35",
      "start": 41.333333,
      "end": 43.4,
      "text": "day, I finally got hired, by"
    },
    {
      "id": "36",
      "start": 43.4,
      "end": 43.933333,
      "text": "the biggest dealership"
    },
    {
      "id": "37",
      "start": 43.933333,
      "end": 44.833333,
      "text": "in town. Wait."
    },
    {
      "id": "38",
      "start": 44.833333,
      "end": 46.133333,
      "text": "Is that him? Bro?!"
    },
    {
      "id": "39",
      "start": 46.133333,
      "end": 47.133333,
      "text": "How did you"
    },
    {
      "id": "40",
      "start": 47.133333,
      "end": 48.5,
      "text": "get so good at cars?!"
    },
    {
      "id": "41",
      "start": 48.5,
      "end": 49.4,
      "text": "Training. I've"
    },
    {
      "id": "42",
      "start": 49.4,
      "end": 50.466667,
      "text": "got work in the morning."
    },
    {
      "id": "43",
      "start": 50.466667,
      "end": 50.966667,
      "text": "..."
    },
    {
      "id": "44",
      "start": 50.966667,
      "end": 51.866667,
      "text": "Huss! Huss! Huss!"
