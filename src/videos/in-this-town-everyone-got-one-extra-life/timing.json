 "cues": [
  {
   "id": "1.tower",
   "start": 0.0,
   "end": 2.1333,
   "text": "In this town, every kid got one extra life."
  },
  {
   "id": "1.burst",
   "start": 2.1333,
   "end": 3.9,
   "text": "Three kids sprinted straight off our clocktower laughing,"
  },
  {
   "id": "1.pop",
   "start": 3.9,
   "end": 5.9333,
   "text": "and golden Totems burst green sparks under them."
  },
  {
   "id": "1.zero",
   "start": 5.9333,
   "end": 7.3333,
   "text": "I was born with zero."
  },
  {
   "id": "1.bucket",
   "start": 7.3333,
   "end": 9.4333,
   "text": "No gold charm, just a blue water bucket."
  },
  {
   "id": "2.stairs",
   "start": 9.4333,
   "end": 11.3667,
   "text": "Nobody in this town ever used stairs."
  },
  {
   "id": "2.mail",
   "start": 11.3667,
   "end": 13.3667,
   "text": "The mailman walked through lava for shortcuts."
  },
  {
   "id": "2.baker",
   "start": 13.3667,
   "end": 15.4,
   "text": "Our baker poked a Creeper to skip walking home."
  },
  {
   "id": "3.mock",
   "start": 15.4,
   "end": 17.4667,
   "text": "At school, kids mocked me as Bucket Boy."
  },
  {
   "id": "3.step",
   "start": 17.4667,
   "end": 19.4667,
   "text": "I took every wooden stair one careful step."
  },
  {
   "id": "3.dad",
   "start": 19.4667,
   "end": 21.5,
   "text": "Only my dad walked every stair beside me."
  },
  {
   "id": "3.hand",
   "start": 21.5,
   "end": 23.4333,
   "text": "He had a white bandage around his left hand."
  },
  {
   "id": "3.jar",
   "start": 23.4333,
   "end": 25.4333,
   "text": "On our shelf sat a cracked gold Totem wing."
  },
  {
   "id": "3.never",
   "start": 25.4333,
   "end": 27.3333,
   "text": "He never explained where that glass jar came from."
  },
  {
   "id": "4.once",
   "start": 27.3333,
   "end": 29.7667,
   "text": "Birth Totems only work once before turning to dust."
  },
  {
   "id": "4.shop",
   "start": 29.7667,
   "end": 31.9333,
   "text": "So everyone bought fresh ones from Mister Vex."
  },
  {
   "id": "4.price",
   "start": 31.9333,
   "end": 34.4667,
   "text": "Fifty emeralds each, filling a six-thousand emerald vault."
  },
  {
   "id": "4.shed",
   "start": 34.4667,
   "end": 36.7333,
   "text": "One afternoon, I walked past Vex's back shed."
  },
  {
   "id": "4.drop",
   "start": 36.7333,
   "end": 38.7,
   "text": "A shiny gold Totem rolled into a puddle."
  },
  {
   "id": "4.splash",
   "start": 38.7,
   "end": 40.4,
   "text": "I splashed it with my water bucket."
  },
  {
   "id": "4.wood",
   "start": 40.4,
   "end": 42.8,
   "text": "Gold paint washed right off, revealing carved oak wood."
  },
  {
   "id": "4.scam",
   "start": 42.8,
   "end": 44.7667,
   "text": "Every Totem in his fifty-emerald bin was fake."
  },
  {
   "id": "5.annual",
   "start": 44.7667,
   "end": 46.9667,
   "text": "That evening was the annual forty-block cliff jump."
  },
  {
   "id": "5.line",
   "start": 46.9667,
   "end": 49.1,
   "text": "Thirty kids lined the ridge waving fake Totems."
  },
  {
   "id": "5.count",
   "start": 49.1,
   "end": 51.5,
   "text": "The crowd roared the countdown: three, two, one!"
  },
  {
   "id": "5.yell",
   "start": 51.5,
   "end": 53.5667,
   "text": "I sprinted onto the cliff yelling, they are wood!"
  },
  {
   "id": "5.vex",
   "start": 53.5667,
   "end": 55.8333,
   "text": "Mister Vex laughed loud and shouted, jump anyway!"
  },
  {
   "id": "5.leap",
   "start": 55.8333,
   "end": 57.9,
   "text": "All thirty kids stepped off the cliff together."
  },
  {
   "id": "5.peel",
   "start": 57.9,
   "end": 60.0667,
   "text": "Mid-air, brown wood chips peeled off in the wind."
  },
  {
   "id": "5.nothing",
   "start": 60.0667,
   "end": 61.9,
   "text": "Not a single golden spark lit the sky."
  },
  {
   "id": "6.dive",
   "start": 61.9,
   "end": 63.9333,
   "text": "I gripped my bucket and dived past everyone."
  },
  {
   "id": "6.fall",
   "start": 63.9333,
   "end": 66.0667,
   "text": "Wind screamed past as canyon stone rushed up."
  },
  {
   "id": "6.blocks",
   "start": 66.0667,
   "end": 68.2,
   "text": "Twenty-five blocks, ten, five, one!"
  },
  {
   "id": "6.splash",
   "start": 68.2,
   "end": 70.2,
   "text": "I slammed the water bucket onto the stone!"
  },
  {
   "id": "6.pool",
   "start": 70.2,
   "end": 72.3667,
   "text": "A blue pool burst wide across the canyon floor."
  },
  {
   "id": "6.safe",
   "start": 72.3667,
   "end": 74.6667,
   "text": "All thirty kids splashed down without losing a heart."
  },
  {
   "id": "6.sticks",
   "start": 74.6667,
   "end": 76.6,
   "text": "Thirty fake oak sticks bobbed on the water."
  },
  {
   "id": "6.karma",
   "start": 76.6,
   "end": 79.0,
   "text": "Up top, Vex grabbed a Totem yelling, mine's real!"
  },
  {
   "id": "6.pig",
   "start": 79.0,
   "end": 80.8667,
   "text": "He jumped straight into a muddy pig pen."
  },
  {
   "id": "6.bin",
   "start": 80.8667,
   "end": 83.2,
   "text": "He grabbed right from his own fifty-emerald bin."
  },
  {
   "id": "7.sunset",
   "start": 83.2,
   "end": 85.6,
   "text": "At golden sunset, Dad took down the glass jar."
  },
  {
   "id": "7.band",
   "start": 85.6,
   "end": 87.6333,
   "text": "He lifted his bandaged hand and looked at me."
  },
  {
   "id": "7.two",
   "start": 87.6333,
   "end": 89.8667,
   "text": "He said, you were never born with zero, Leo."
  },
  {
   "id": "7.slip",
   "start": 89.8667,
   "end": 91.7,
   "text": "You slipped off that cliff when you were two."
  },
  {
   "id": "7.held",
   "start": 91.7,
   "end": 93.6667,
   "text": "My Totem popped in my hand while holding you."
  },
  {
   "id": "7.board",
   "start": 93.6667,
   "end": 96.0667,
   "text": "Next morning, Vex's shop was boarded up and closed."
  },
  {
   "id": "7.porch",
   "start": 96.0667,
   "end": 98.3333,
   "text": "Every kid jumped off their porch holding water buckets."
  },
  {
   "id": "7.trust",
   "start": 98.3333,
   "end": 100.2667,
   "text": "Turns out you do not need fifty emeralds."
  },
  {
   "id": "7.sub",
   "start": 100.2667,
   "end": 102.4,
   "text": "Subscribe if you would trust a water bucket too."
  }
 ],
