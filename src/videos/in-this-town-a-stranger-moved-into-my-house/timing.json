 "cues": [
  {
   "id": "1.moved",
   "start": 0.0,
   "end": 2.1,
   "text": "In this town, a stranger moved into my house."
  },
  {
   "id": "1.knock",
   "start": 2.1,
   "end": 2.9333,
   "text": "He did not knock."
  },
  {
   "id": "1.slept",
   "start": 2.9333,
   "end": 3.8333,
   "text": "He slept in my bed."
  },
  {
   "id": "1.pocket",
   "start": 3.8333,
   "end": 5.2,
   "text": "Then he put my bed in his pocket."
  },
  {
   "id": "1.days",
   "start": 5.2,
   "end": 6.3333,
   "text": "That was thirty days ago."
  },
  {
   "id": "1.want",
   "start": 6.3333,
   "end": 7.5333,
   "text": "Nobody knows what he wants."
  },
  {
   "id": "2.hrmm",
   "start": 7.5333,
   "end": 9.4667,
   "text": "In this town, we do not complain."
  },
  {
   "id": "2.say",
   "start": 9.4667,
   "end": 10.6333,
   "text": "We say, \"hmm\"."
  },
  {
   "id": "2.oldman",
   "start": 10.6333,
   "end": 13.2,
   "text": "This is the old man. He rings the bell when there is trouble."
  },
  {
   "id": "2.golem",
   "start": 13.2,
   "end": 15.7333,
   "text": "This is the iron man. He gives flowers to children."
  },
  {
   "id": "2.me",
   "start": 15.7333,
   "end": 16.7333,
   "text": "And this is me."
  },
  {
   "id": "2.books",
   "start": 16.7333,
   "end": 18.8,
   "text": "I sell books. I do not remember why."
  },
  {
   "id": "3.bread",
   "start": 18.8,
   "end": 20.6667,
   "text": "The stranger took the bread out of my chest."
  },
  {
   "id": "3.eye",
   "start": 20.6667,
   "end": 22.1333,
   "text": "He looked me in the eye while he did it."
  },
  {
   "id": "3.wheat",
   "start": 22.1333,
   "end": 23.7667,
   "text": "He jumped on our wheat. All of it."
  },
  {
   "id": "3.bell",
   "start": 23.7667,
   "end": 24.8333,
   "text": "He took the bell."
  },
  {
   "id": "3.ding",
   "start": 24.8333,
   "end": 26.5,
   "text": "Now the old man just says, \"ding\"."
  },
  {
   "id": "3.hit",
   "start": 26.5,
   "end": 29.5333,
   "text": "He hit the iron man. Once. By accident."
  },
  {
   "id": "3.remember",
   "start": 29.5333,
   "end": 30.8333,
   "text": "The iron man remembers."
  },
  {
   "id": "3.hole",
   "start": 30.8333,
   "end": 33.7,
   "text": "He dug a hole in the middle of town. Straight down."
  },
  {
   "id": "3.pick",
   "start": 33.7,
   "end": 36.3,
   "text": "He came back three days later, with a pickaxe that glowed."
  },
  {
   "id": "3.hiding",
   "start": 36.3,
   "end": 37.8667,
   "text": "Clearly, he was hiding."
  },
  {
   "id": "4.desk",
   "start": 37.8667,
   "end": 39.0,
   "text": "He put a desk in my room."
  },
  {
   "id": "4.broke",
   "start": 39.0,
   "end": 41.5333,
   "text": "Then he broke the desk. And put it back. And broke it."
  },
  {
   "id": "4.times",
   "start": 41.5333,
   "end": 42.5,
   "text": "Forty one times."
  },
  {
   "id": "4.sadder",
   "start": 42.5,
   "end": 44.6,
   "text": "Each time he looked at me, and each time he was sadder."
  },
  {
   "id": "4.mending",
   "start": 44.6,
   "end": 47.2,
   "text": "Then he shouted, \"Mending!\" And gave me all his emeralds."
  },
  {
   "id": "4.hates",
   "start": 47.2,
   "end": 48.8333,
   "text": "Clearly, he hates desks."
  },
  {
   "id": "5.torch",
   "start": 48.8333,
   "end": 52.1,
   "text": "He put torches on everything. The roofs. The well. My floor."
  },
  {
   "id": "5.dark",
   "start": 52.1,
   "end": 53.6667,
   "text": "Clearly, he is afraid of the dark."
  },
  {
   "id": "5.wall",
   "start": 53.6667,
   "end": 55.2,
   "text": "He built a wall round the whole town."
  },
  {
   "id": "5.keep",
   "start": 55.2,
   "end": 57.2333,
   "text": "Clearly, it is to keep us in."
  },
  {
   "id": "5.boat",
   "start": 57.2333,
   "end": 59.3333,
   "text": "And before all of that, he put me in a boat."
  },
  {
   "id": "5.week",
   "start": 59.3333,
   "end": 60.8333,
   "text": "I was in the boat for a week."
  },
  {
   "id": "5.before",
   "start": 60.8333,
   "end": 62.3667,
   "text": "I do not remember before the boat."
  },
  {
   "id": "5.green",
   "start": 62.3667,
   "end": 64.7333,
   "text": "I remember being very hungry. And very green."
  },
  {
   "id": "6.cloud",
   "start": 64.7333,
   "end": 67.7,
   "text": "On day thirty, he came home with a grey cloud round his head."
  },
  {
   "id": "6.horn",
   "start": 67.7,
   "end": 68.7333,
   "text": "Then a horn blew."
  },
  {
   "id": "6.men",
   "start": 68.7333,
   "end": 70.6333,
   "text": "Men with crossbows walked out of the trees."
  },
  {
   "id": "6.cow",
   "start": 70.6333,
   "end": 72.1667,
   "text": "They had a cow the size of a house."
  },
  {
   "id": "6.nobell",
   "start": 72.1667,
   "end": 74.5333,
   "text": "The old man ran for the bell. There was no bell."
  },
  {
   "id": "6.ding",
   "start": 74.5333,
   "end": 76.9,
   "text": "He said, \"ding\". Nobody panicked."
  },
  {
   "id": "6.walked",
   "start": 76.9,
   "end": 78.5,
   "text": "So I walked up to the biggest one,"
  },
  {
   "id": "6.hrmm",
   "start": 78.5,
   "end": 80.2333,
   "text": "and I said, \"hmm\"."
  },
  {
   "id": "6.help",
   "start": 80.2333,
   "end": 81.2333,
   "text": "It did not help."
  },
  {
   "id": "7.rang",
   "start": 81.2333,
   "end": 83.5667,
   "text": "Then somebody rang a bell. A real one."
  },
  {
   "id": "7.him",
   "start": 83.5667,
   "end": 84.6,
   "text": "It was the stranger."
  },
  {
   "id": "7.pocket",
   "start": 84.6,
   "end": 86.7667,
   "text": "It had been in his pocket. With my bed."
  },
  {
   "id": "7.wall",
   "start": 86.7667,
   "end": 89.4333,
   "text": "The men ran at the wall. The wall did not move."
  },
  {
   "id": "7.golem",
   "start": 89.4333,
   "end": 91.8,
   "text": "The iron man stood next to him. He was not happy about it."
  },
  {
   "id": "7.leader",
   "start": 91.8,
   "end": 93.3,
   "text": "Their leader ran at the stranger."
  },
  {
   "id": "7.hole",
   "start": 93.3,
   "end": 95.3,
   "text": "And fell down the hole. Straight down."
  },
  {
   "id": "7.quiet",
   "start": 95.3,
   "end": 96.4333,
   "text": "Then it was quiet."
  },
  {
   "id": "8.hero",
   "start": 96.4333,
   "end": 98.7,
   "text": "We gave him a discount. He already had one."
  },
  {
   "id": "8.one",
   "start": 98.7,
   "end": 100.9667,
   "text": "I have always sold him everything for one emerald."
  },
  {
   "id": "8.why",
   "start": 100.9667,
   "end": 102.0667,
   "text": "I never knew why."
  },
  {
   "id": "8.list",
   "start": 102.0667,
   "end": 103.2,
   "text": "So I thought about it."
  },
  {
   "id": "8.wall",
   "start": 103.2,
   "end": 104.0333,
   "text": "The wall."
  },
  {
   "id": "8.torch",
   "start": 104.0333,
   "end": 104.9,
   "text": "The torches."
  },
  {
   "id": "8.desk",
   "start": 104.9,
   "end": 105.7333,
   "text": "The desk."
  },
  {
   "id": "8.boat",
   "start": 105.7333,
   "end": 106.5333,
   "text": "The boat."
  },
  {
   "id": "8.house",
   "start": 106.5333,
   "end": 109.1,
   "text": "I looked at my house. Then at all the other houses."
  },
  {
   "id": "8.same",
   "start": 109.1,
   "end": 111.4,
   "text": "Same door. Same bed. Same desk."
  },
  {
   "id": "8.built",
   "start": 111.4,
   "end": 113.1,
   "text": "We did not build this town. He did."
  },
  {
   "id": "8.boats",
   "start": 113.1,
   "end": 115.2333,
   "text": "He brought us here. One boat at a time."
  },
  {
   "id": "8.apple",
   "start": 115.2333,
   "end": 116.7333,
   "text": "And when I was green, he threw a bottle at me,"
  },
  {
   "id": "8.gold",
   "start": 116.7333,
   "end": 118.1,
   "text": "and gave me a golden apple."
  },
  {
   "id": "8.lunch",
   "start": 118.1,
   "end": 119.1333,
   "text": "I thought it was lunch."
  },
  {
   "id": "8.truth",
   "start": 119.1333,
   "end": 120.8333,
   "text": "A stranger did not move into my house."
  },
  {
   "id": "8.his",
   "start": 120.8333,
   "end": 121.9333,
   "text": "I moved into his."
  },
  {
   "id": "9.back",
   "start": 121.9333,
   "end": 123.7,
   "text": "This morning, he came back with a boat."
  },
  {
   "id": "9.in",
   "start": 123.7,
   "end": 125.8333,
   "text": "There was somebody in it. He was very green."
  },
  {
   "id": "9.knock",
   "start": 125.8333,
   "end": 126.8667,
   "text": "He did not knock."
  },
  {
   "id": "9.floor",
   "start": 126.8667,
   "end": 129.6667,
   "text": "I said, \"hmm\". Then I gave him half my floor."
  },
  {
   "id": "9.sub",
   "start": 129.6667,
   "end": 132.1333,
   "text": "Like and subscribe. He still has my bed."
  }
 ],
