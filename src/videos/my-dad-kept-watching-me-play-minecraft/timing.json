 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 2.3,
   "text": "My dad kept watching me play Minecraft every night."
  },
  {
   "id": "1.watch",
   "start": 2.3,
   "end": 4.6667,
   "text": "Every time I hopped on, he stood behind my chair."
  },
  {
   "id": "1.sat",
   "start": 4.6667,
   "end": 6.4,
   "text": "Then one day, Dad quietly sat down at my desk"
  },
  {
   "id": "1.pc",
   "start": 6.4,
   "end": 8.4333,
   "text": "and launched my survival world all by himself."
  },
  {
   "id": "1.loop",
   "start": 8.4333,
   "end": 10.5667,
   "text": "He didn't know one mistake was about to break his heart."
  },
  {
   "id": "2.controls",
   "start": 10.5667,
   "end": 12.7667,
   "text": "Dad didn't even know how to move forward yet."
  },
  {
   "id": "2.tree",
   "start": 12.7667,
   "end": 15.0333,
   "text": "He stood beside an oak trunk failing to punch wood."
  },
  {
   "id": "2.fence",
   "start": 15.0333,
   "end": 17.5333,
   "text": "Bumping straight into fences, he panicked at the keys."
  },
  {
   "id": "2.creeper",
   "start": 17.5333,
   "end": 19.6,
   "text": "Then a green creeper hissed right behind him."
  },
  {
   "id": "2.boom",
   "start": 19.6,
   "end": 22.4333,
   "text": "Boom! The blast killed Dad right on the lawn."
  },
  {
   "id": "2.respawn",
   "start": 22.4333,
   "end": 24.3667,
   "text": "Respawning beside spawn, Dad walked slowly back out"
  },
  {
   "id": "2.froze",
   "start": 24.3667,
   "end": 25.9333,
   "text": "and froze when he saw the smoking crater."
  },
  {
   "id": "3.house",
   "start": 25.9333,
   "end": 28.8667,
   "text": "He hadn't just died. He blew up his son's house!"
  },
  {
   "id": "3.enter",
   "start": 28.8667,
   "end": 30.2667,
   "text": "Right then, I walked straight into the bedroom"
  },
  {
   "id": "3.monitor",
   "start": 30.2667,
   "end": 32.5333,
   "text": "and stared shocked at my broken pixelated screen."
  },
  {
   "id": "3.torn",
   "start": 32.5333,
   "end": 35.1,
   "text": "Missing oak walls, shattered glass, everything I built was torn up."
  },
  {
   "id": "4.guilt",
   "start": 35.1,
   "end": 37.6,
   "text": "Dad looked down feeling terrible inside our quiet room."
  },
  {
   "id": "4.scared",
   "start": 37.6,
   "end": 39.5333,
   "text": "He thought for sure I was about to yell."
  },
  {
   "id": "4.sorry",
   "start": 39.5333,
   "end": 42.1333,
   "text": "Tears welled up as Dad whispered: Ah, sorry, son."
  },
  {
   "id": "4.silence",
   "start": 42.1333,
   "end": 44.1333,
   "text": "Neither of us said one word for two whole seconds."
  },
  {
   "id": "5.laugh",
   "start": 44.1333,
   "end": 46.1667,
   "text": "Then I couldn't help it and burst out laughing."
  },
  {
   "id": "5.ask",
   "start": 46.1667,
   "end": 48.4667,
   "text": "I grinned and asked: Did you die by a creeper?"
  },
  {
   "id": "5.relief",
   "start": 48.4667,
   "end": 51.1,
   "text": "Dad laughed nervously, finally exhaling a giant breath."
  },
  {
   "id": "5.stairs",
   "start": 51.1,
   "end": 52.9667,
   "text": "Smiling wide, I bolted straight down our wooden stairs"
  },
  {
   "id": "5.laptop",
   "start": 52.9667,
   "end": 54.8667,
   "text": "and grabbed my spare silver laptop off the table."
  },
  {
   "id": "6.dual",
   "start": 54.8667,
   "end": 57.5333,
   "text": "Seconds later, we booted up two screens side by side."
  },
  {
   "id": "6.teach",
   "start": 57.5333,
   "end": 60.0333,
   "text": "This time I showed Dad every single survival control."
  },
  {
   "id": "6.wood",
   "start": 60.0333,
   "end": 62.3333,
   "text": "Dad swung his axe cleanly and broke real oak wood!"
  },
  {
   "id": "6.chest",
   "start": 62.3333,
   "end": 64.0,
   "text": "Then I opened my spawn chest beside the campfire"
  },
  {
   "id": "6.shield",
   "start": 64.0,
   "end": 65.9,
   "text": "and handed Dad his own crafted shield."
  },
  {
   "id": "6.creeper2",
   "start": 65.9,
   "end": 67.4667,
   "text": "When another creeper snuck behind our oak fence,"
  },
  {
   "id": "6.block",
   "start": 67.4667,
   "end": 69.5,
   "text": "Dad raised his shield and blocked the blast unharmed!"
  },
  {
   "id": "7.rebuild",
   "start": 69.5,
   "end": 72.1333,
   "text": "Together we rebuilt the whole starter house twice as cozy."
  },
  {
   "id": "7.cozy",
   "start": 72.1333,
   "end": 74.5,
   "text": "Warm lanterns hung beside twin oak beds inside."
  },
  {
   "id": "7.hearts",
   "start": 74.5,
   "end": 77.1667,
   "text": "In server chat, Dad typed: best game we ever played."
  },
  {
   "id": "7.cta",
   "start": 77.1667,
   "end": 79.6,
   "text": "Subscribe if you'd build a survival house with your dad."
  }
 ],
