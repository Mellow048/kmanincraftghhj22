 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.8333,
   "text": "I traded my bed for a plate of stew."
  },
  {
   "id": "1.cold",
   "start": 1.8333,
   "end": 3.0,
   "text": "The stew was cold."
  },
  {
   "id": "1.fine",
   "start": 3.0,
   "end": 3.9,
   "text": "That was fine."
  },
  {
   "id": "1.plate",
   "start": 3.9,
   "end": 5.3667,
   "text": "The plate was not included."
  },
  {
   "id": "1.rule",
   "start": 5.3667,
   "end": 7.2,
   "text": "In this village, a trade is binding."
  },
  {
   "id": "1.both",
   "start": 7.2,
   "end": 8.2333,
   "text": "For both of us."
  },
  {
   "id": "1.bell",
   "start": 8.2333,
   "end": 9.8667,
   "text": "The bell decides who owns what."
  },
  {
   "id": "2.stick",
   "start": 9.8667,
   "end": 11.6,
   "text": "I had pushed the plate over with a stick."
  },
  {
   "id": "2.pocket",
   "start": 11.6,
   "end": 12.9333,
   "text": "I kept the receipt in my pocket."
  },
  {
   "id": "2.night",
   "start": 12.9333,
   "end": 15.0333,
   "text": "That night, the villager slept in my bed."
  },
  {
   "id": "2.floor",
   "start": 15.0333,
   "end": 16.2,
   "text": "I slept on the floor."
  },
  {
   "id": "2.hisfloor",
   "start": 16.2,
   "end": 17.4667,
   "text": "It was his floor now."
  },
  {
   "id": "2.morning",
   "start": 17.4667,
   "end": 19.2,
   "text": "In the morning, he took the plate."
  },
  {
   "id": "2.table",
   "start": 19.2,
   "end": 20.0333,
   "text": "The table went with it."
  },
  {
   "id": "3.why",
   "start": 20.0333,
   "end": 21.4333,
   "text": "The plate had been on the table."
  },
  {
   "id": "3.tuesday",
   "start": 21.4333,
   "end": 23.2333,
   "text": "By Tuesday, he owned the table."
  },
  {
   "id": "3.floorplan",
   "start": 23.2333,
   "end": 24.4667,
   "text": "The table was on the floor."
  },
  {
   "id": "3.chair",
   "start": 24.4667,
   "end": 25.6333,
   "text": "So he owned the floor."
  },
  {
   "id": "3.stood",
   "start": 25.6333,
   "end": 26.8667,
   "text": "I stood on a chair."
  },
  {
   "id": "3.wednesday",
   "start": 26.8667,
   "end": 28.5667,
   "text": "On Wednesday, he took the chair."
  },
  {
   "id": "3.because",
   "start": 28.5667,
   "end": 30.5667,
   "text": "The chair was on the floor. I was on the chair."
  },
  {
   "id": "4.hours",
   "start": 30.5667,
   "end": 33.1333,
   "text": "So I stood. Nine hours."
  },
  {
   "id": "4.thursday",
   "start": 33.1333,
   "end": 35.0,
   "text": "On Thursday, he took my arm."
  },
  {
   "id": "4.armwhy",
   "start": 35.0,
   "end": 36.5333,
   "text": "That arm had handed him the plate."
  },
  {
   "id": "4.inspect",
   "start": 36.5333,
   "end": 37.5667,
   "text": "He held it up to the light."
  },
  {
   "id": "4.goodwork",
   "start": 37.5667,
   "end": 38.8,
   "text": "He said it was good work."
  },
  {
   "id": "4.friday",
   "start": 38.8,
   "end": 40.4667,
   "text": "On Friday, he took my legs."
  },
  {
   "id": "4.legswhy",
   "start": 40.4667,
   "end": 42.1667,
   "text": "My legs had walked me to his door."
  },
  {
   "id": "5.carried",
   "start": 42.1667,
   "end": 43.2333,
   "text": "He carried me home."
  },
  {
   "id": "5.duty",
   "start": 43.2333,
   "end": 44.6667,
   "text": "He said it was his job now."
  },
  {
   "id": "5.saturday",
   "start": 44.6667,
   "end": 46.3333,
   "text": "On Saturday, he took my mouth."
  },
  {
   "id": "5.mouthwhy",
   "start": 46.3333,
   "end": 47.4667,
   "text": "My mouth had said deal."
  },
  {
   "id": "5.talks",
   "start": 47.4667,
   "end": 48.8667,
   "text": "He does my talking at the market."
  },
  {
   "id": "5.prices",
   "start": 48.8667,
   "end": 50.4667,
   "text": "He says my prices are better than his."
  },
  {
   "id": "5.nothing",
   "start": 50.4667,
   "end": 51.4,
   "text": "I own one thing."
  },
  {
   "id": "6.pivot",
   "start": 51.4,
   "end": 52.6,
   "text": "So that was it."
  },
  {
   "id": "6.pivot2",
   "start": 52.6,
   "end": 54.7667,
   "text": "Everything that touched the plate was part of the trade."
  },
  {
   "id": "6.how",
   "start": 54.7667,
   "end": 57.1667,
   "text": "So how do you buy a house back when your arm is in the deal?"
  },
  {
   "id": "6.simply",
   "start": 57.1667,
   "end": 59.4,
   "text": "I simply used the one thing that never touched it."
  },
  {
   "id": "6.stick2",
   "start": 59.4,
   "end": 60.2,
   "text": "The stick."
  },
  {
   "id": "6.neverheld",
   "start": 60.2,
   "end": 62.0667,
   "text": "It pushed the plate. It never held it."
  },
  {
   "id": "6.receipt",
   "start": 62.0667,
   "end": 64.0667,
   "text": "And the receipt never touched anything."
  },
  {
   "id": "6.trousers",
   "start": 64.0667,
   "end": 65.5,
   "text": "It lived in my other trousers."
  },
  {
   "id": "7.bellfoot",
   "start": 65.5,
   "end": 66.8,
   "text": "I rang the bell with my foot."
  },
  {
   "id": "7.refuse",
   "start": 66.8,
   "end": 68.5,
   "text": "A villager never refuses a trade."
  },
  {
   "id": "7.offer",
   "start": 68.5,
   "end": 69.7667,
   "text": "I offered him the receipt."
  },
  {
   "id": "7.terms",
   "start": 69.7667,
   "end": 71.0667,
   "text": "For everything that touched the plate."
  },
  {
   "id": "7.read",
   "start": 71.0667,
   "end": 72.5333,
   "text": "He read it. He cannot read."
  },
  {
   "id": "7.accepted",
   "start": 72.5333,
   "end": 74.6667,
   "text": "He accepted. Binding is binding."
  },
  {
   "id": "7.witharm",
   "start": 74.6667,
   "end": 76.0333,
   "text": "He took it with the arm he took from me."
  },
  {
   "id": "8.bed",
   "start": 76.0333,
   "end": 77.0,
   "text": "My bed came back."
  },
  {
   "id": "8.table2",
   "start": 77.0,
   "end": 78.0667,
   "text": "My table came back."
  },
  {
   "id": "8.floor2",
   "start": 78.0667,
   "end": 79.2333,
   "text": "My floor came back."
  },
  {
   "id": "8.chair2",
   "start": 79.2333,
   "end": 80.4667,
   "text": "My chair came back."
  },
  {
   "id": "8.arm2",
   "start": 80.4667,
   "end": 82.6333,
   "text": "My arm came back. It was cold."
  },
  {
   "id": "8.legs2",
   "start": 82.6333,
   "end": 84.8,
   "text": "My legs came back. The left one was late."
  },
  {
   "id": "8.mouth2",
   "start": 84.8,
   "end": 86.8,
   "text": "My mouth came back. I said thank you."
  },
  {
   "id": "9.price",
   "start": 86.8,
   "end": 89.3333,
   "text": "The receipt cost nothing. It came free with the stew."
  },
  {
   "id": "9.tuesday2",
   "start": 89.3333,
   "end": 91.1333,
   "text": "It was Tuesday. I had my house."
  },
  {
   "id": "9.but",
   "start": 91.1333,
   "end": 92.4333,
   "text": "But the receipt was binding too."
  },
  {
   "id": "9.debt",
   "start": 92.4333,
   "end": 93.6333,
   "text": "Now he owns my debt."
  },
  {
   "id": "9.four",
   "start": 93.6333,
   "end": 94.7,
   "text": "Four hundred dollars."
  },
  {
   "id": "9.before",
   "start": 94.7,
   "end": 95.8333,
   "text": "I owed it before the stew."
  },
  {
   "id": "9.best",
   "start": 95.8333,
   "end": 97.7333,
   "text": "He says it is the best trade he has ever made."
  },
  {
   "id": "10.dinner",
   "start": 97.7333,
   "end": 99.2,
   "text": "I had dinner in my own house."
  },
  {
   "id": "10.onfloor",
   "start": 99.2,
   "end": 101.0667,
   "text": "On the floor. The plate is still his."
  },
  {
   "id": "10.stillcold",
   "start": 101.0667,
   "end": 102.2667,
   "text": "The stew is still cold."
  },
  {
   "id": "10.again",
   "start": 102.2667,
   "end": 104.6333,
   "text": "I would do it again. The bed was not that good."
  },
  {
   "id": "10.sub",
   "start": 104.6333,
   "end": 106.6,
   "text": "Subscribe if you would have read the receipt first."
  }
 ],
