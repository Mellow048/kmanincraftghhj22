 "cues": [
  {
   "id": "1.died",
   "start": 0.0,
   "end": 1.8667,
   "text": "In this town, our golem died."
  },
  {
   "id": "1.back",
   "start": 1.8667,
   "end": 3.5,
   "text": "The next morning, it came back."
  },
  {
   "id": "1.how",
   "start": 3.5,
   "end": 4.6667,
   "text": "Nobody would tell me how."
  },
  {
   "id": "6.bell",
   "start": 4.6667,
   "end": 6.2667,
   "text": "Then one night, the bell rang."
  },
  {
   "id": "6.wall",
   "start": 6.2667,
   "end": 7.6333,
   "text": "Something was on the wall."
  },
  {
   "id": "7.sword",
   "start": 7.6333,
   "end": 9.6,
   "text": "I grabbed my father's diamond sword."
  },
  {
   "id": "7.zombie",
   "start": 9.6,
   "end": 10.7,
   "text": "I got the zombie."
  },
  {
   "id": "7.skeleton",
   "start": 10.7,
   "end": 11.8667,
   "text": "I got the skeleton."
  },
  {
   "id": "7.proud",
   "start": 11.8667,
   "end": 14.5667,
   "text": "I was so proud of myself that I forgot to look behind it."
  },
  {
   "id": "8.behind",
   "start": 14.5667,
   "end": 16.2667,
   "text": "There was a creeper behind the golem."
  },
  {
   "id": "8.shout",
   "start": 16.2667,
   "end": 17.3,
   "text": "I should have shouted."
  },
  {
   "id": "8.late",
   "start": 17.3,
   "end": 19.4333,
   "text": "But I was too far away, and it was too late."
  },
  {
   "id": "9.boom",
   "start": 19.4333,
   "end": 20.2,
   "text": "It exploded."
  },
  {
   "id": "9.dust",
   "start": 20.2,
   "end": 22.5333,
   "text": "When the dust settled, our protector was gone."
  },
  {
   "id": "10.finish",
   "start": 22.5333,
   "end": 23.8667,
   "text": "We finished the monsters."
  },
  {
   "id": "10.walk",
   "start": 23.8667,
   "end": 25.1333,
   "text": "I walked to where it fell."
  },
  {
   "id": "10.rose",
   "start": 25.1333,
   "end": 26.4667,
   "text": "In the ash was a rose."
  },
  {
   "id": "11.pick",
   "start": 26.4667,
   "end": 28.3333,
   "text": "I picked it up. It was still warm."
  },
  {
   "id": "5.ask",
   "start": 28.3333,
   "end": 30.3667,
   "text": "So I took it to the oldest woman in town."
  },
  {
   "id": "5.say",
   "start": 30.3667,
   "end": 32.5,
   "text": "\"Never keep a golem's flower,\" she said."
  },
  {
   "id": "5.again",
   "start": 32.5,
   "end": 33.5667,
   "text": "I asked her again."
  },
  {
   "id": "5.walk",
   "start": 33.5667,
   "end": 34.3667,
   "text": "She walked away."
  },
  {
   "id": "3.wall",
   "start": 34.3667,
   "end": 36.9,
   "text": "It had guarded that wall since before I was born."
  },
  {
   "id": "3.take",
   "start": 36.9,
   "end": 39.0667,
   "text": "Every morning it took one flower off the well,"
  },
  {
   "id": "3.child",
   "start": 39.0667,
   "end": 40.4,
   "text": "and gave it to a child."
  },
  {
   "id": "3.anvil",
   "start": 40.4,
   "end": 43.2,
   "text": "The blacksmith had an anvil. My mother had a pot."
  },
  {
   "id": "3.bucket",
   "start": 43.2,
   "end": 45.0333,
   "text": "My father had a bucket with a hole in it."
  },
  {
   "id": "3.remember",
   "start": 45.0333,
   "end": 47.2333,
   "text": "He said iron remembers the shape you give it."
  },
  {
   "id": "3.good",
   "start": 47.2333,
   "end": 50.5667,
   "text": "It was a good life. The town had not lost anyone since it came."
  },
  {
   "id": "4.protect",
   "start": 50.5667,
   "end": 52.4,
   "text": "But the golem protected all of us."
  },
  {
   "id": "4.need",
   "start": 52.4,
   "end": 53.4667,
   "text": "I wanted it to need me."
  },
  {
   "id": "11.put",
   "start": 53.4667,
   "end": 55.5667,
   "text": "I put the rose on the well, with all the others."
  },
  {
   "id": "11.letgo",
   "start": 55.5667,
   "end": 58.0,
   "text": "The rule said never keep it. So I let it go."
  },
  {
   "id": "12.home",
   "start": 58.0,
   "end": 58.7333,
   "text": "I went home."
  },
  {
   "id": "12.bed",
   "start": 58.7333,
   "end": 60.5667,
   "text": "I lay on my bed and did not sleep."
  },
  {
   "id": "13.light",
   "start": 60.5667,
   "end": 61.9667,
   "text": "In the morning, the sun came in."
  },
  {
   "id": "13.square",
   "start": 61.9667,
   "end": 62.9667,
   "text": "I went to the square."
  },
  {
   "id": "13.there",
   "start": 62.9667,
   "end": 64.0,
   "text": "It was standing there."
  },
  {
   "id": "14.hooks",
   "start": 64.0,
   "end": 65.5333,
   "text": "The hooks on the wall were empty."
  },
  {
   "id": "14.pot",
   "start": 65.5333,
   "end": 67.4,
   "text": "My mother's pot was gone from the kitchen."
  },
  {
   "id": "14.iron",
   "start": 67.4,
   "end": 69.7333,
   "text": "Every piece of iron in this town was in the square."
  },
  {
   "id": "14.built",
   "start": 69.7333,
   "end": 71.8667,
   "text": "In the night, the whole village had built it again."
  },
  {
   "id": "14.afraid",
   "start": 71.8667,
   "end": 74.2667,
   "text": "Not because they loved it. Because they were afraid."
  },
  {
   "id": "14.giveback",
   "start": 74.2667,
   "end": 76.4,
   "text": "And because the well gives back what you put in it."
  },
  {
   "id": "14.flowers",
   "start": 76.4,
   "end": 78.9,
   "text": "Every flower on that well was somebody we had lost."
  },
  {
   "id": "14.ours",
   "start": 78.9,
   "end": 81.1333,
   "text": "The golem had been handing us our own flowers."
  },
  {
   "id": "14.held",
   "start": 81.1333,
   "end": 82.3333,
   "text": "Then it held one out to me."
  },
  {
   "id": "14.mine",
   "start": 82.3333,
   "end": 84.6333,
   "text": "It was mine. The rose I had left on the well."
  },
  {
   "id": "14.sub",
   "start": 84.6333,
   "end": 86.3,
   "text": "Subscribe before I keep it."
  }
 ],
