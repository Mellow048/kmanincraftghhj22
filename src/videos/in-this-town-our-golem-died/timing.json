 "clips": [],
 "cues": [
  {
   "id": "1.died",
   "start": 0.0,
   "end": 1.4,
   "text": "In this town, our golem died."
  },
  {
   "id": "1.back",
   "start": 1.4,
   "end": 2.8667,
   "text": "The next morning, it came back."
  },
  {
   "id": "1.how",
   "start": 2.8667,
   "end": 4.2,
   "text": "Nobody would tell me how."
  },
  {
   "id": "2.sleep",
   "start": 4.2,
   "end": 5.8333,
   "text": "Nobody had ever seen it sleep."
  },
  {
   "id": "2.break",
   "start": 5.8333,
   "end": 7.4667,
   "text": "Nobody had ever seen it break."
  },
  {
   "id": "2.well",
   "start": 7.4667,
   "end": 9.9667,
   "text": "And nobody would say why the well was full of flowers."
  },
  {
   "id": "2.rule",
   "start": 9.9667,
   "end": 12.1,
   "text": "The oldest rule in town was about those flowers."
  },
  {
   "id": "2.keep",
   "start": 12.1,
   "end": 12.9667,
   "text": "Never keep one."
  },
  {
   "id": "3.wall",
   "start": 12.9667,
   "end": 15.0333,
   "text": "It had guarded that wall since before I was born."
  },
  {
   "id": "3.gate",
   "start": 15.0333,
   "end": 16.5333,
   "text": "At dawn, it stood at the gate."
  },
  {
   "id": "3.take",
   "start": 16.5333,
   "end": 18.1667,
   "text": "Then it took one flower off the well,"
  },
  {
   "id": "3.child",
   "start": 18.1667,
   "end": 19.4,
   "text": "and gave it to a child."
  },
  {
   "id": "3.none",
   "start": 19.4,
   "end": 21.3667,
   "text": "Nobody asked how. Nobody asked why."
  },
  {
   "id": "3.lid",
   "start": 21.3667,
   "end": 23.6333,
   "text": "The well had a stone lid. It was never on."
  },
  {
   "id": "3.anvil",
   "start": 23.6333,
   "end": 26.1667,
   "text": "The blacksmith had an anvil. My mother had a pot."
  },
  {
   "id": "3.bucket",
   "start": 26.1667,
   "end": 28.3667,
   "text": "My father had a bucket with a hole in it."
  },
  {
   "id": "3.remember",
   "start": 28.3667,
   "end": 30.5333,
   "text": "He said iron remembers the shape you give it."
  },
  {
   "id": "3.good",
   "start": 30.5333,
   "end": 33.1,
   "text": "It was a good life. Nobody had been hurt in years."
  },
  {
   "id": "4.protect",
   "start": 33.1,
   "end": 34.7667,
   "text": "But the golem protected all of us."
  },
  {
   "id": "4.need",
   "start": 34.7667,
   "end": 36.0333,
   "text": "I wanted it to need me."
  },
  {
   "id": "5.ask",
   "start": 36.0333,
   "end": 38.0333,
   "text": "So I asked the oldest woman in town why."
  },
  {
   "id": "5.say",
   "start": 38.0333,
   "end": 39.9333,
   "text": "\"Never keep a golem's flower,\" she said."
  },
  {
   "id": "5.again",
   "start": 39.9333,
   "end": 40.9667,
   "text": "I asked her again."
  },
  {
   "id": "5.walk",
   "start": 40.9667,
   "end": 41.8333,
   "text": "She walked away."
  },
  {
   "id": "6.bell",
   "start": 41.8333,
   "end": 43.1667,
   "text": "Then one night, the bell rang."
  },
  {
   "id": "6.wall",
   "start": 43.1667,
   "end": 44.5,
   "text": "Something was on the wall."
  },
  {
   "id": "7.sword",
   "start": 44.5,
   "end": 46.0,
   "text": "I grabbed my father's diamond sword."
  },
  {
   "id": "7.zombie",
   "start": 46.0,
   "end": 47.0333,
   "text": "I got the zombie."
  },
  {
   "id": "7.skeleton",
   "start": 47.0333,
   "end": 48.1667,
   "text": "I got the skeleton."
  },
  {
   "id": "7.proud",
   "start": 48.1667,
   "end": 51.0333,
   "text": "I was so proud of myself that I forgot to look behind it."
  },
  {
   "id": "8.behind",
   "start": 51.0333,
   "end": 52.8333,
   "text": "There was a creeper behind the golem."
  },
  {
   "id": "8.shout",
   "start": 52.8333,
   "end": 53.7333,
   "text": "I should have shouted."
  },
  {
   "id": "8.late",
   "start": 53.7333,
   "end": 56.0667,
   "text": "But I was too far away, and it was too late."
  },
  {
   "id": "9.boom",
   "start": 56.0667,
   "end": 56.7333,
   "text": "It exploded."
  },
  {
   "id": "9.dust",
   "start": 56.7333,
   "end": 58.7,
   "text": "When the dust settled, our protector was gone."
  },
  {
   "id": "10.finish",
   "start": 58.7,
   "end": 59.8333,
   "text": "We finished the monsters."
  },
  {
   "id": "10.walk",
   "start": 59.8333,
   "end": 61.1,
   "text": "I walked to where it fell."
  },
  {
   "id": "10.rose",
   "start": 61.1,
   "end": 62.3333,
   "text": "In the ash was a rose."
  },
  {
   "id": "11.pick",
   "start": 62.3333,
   "end": 64.1333,
   "text": "I picked it up. It was still warm."
  },
  {
   "id": "11.put",
   "start": 64.1333,
   "end": 66.3,
   "text": "I put it on the well, with all the others."
  },
  {
   "id": "11.letgo",
   "start": 66.3,
   "end": 68.7333,
   "text": "The rule said never keep it. So I let it go."
  },
  {
   "id": "12.home",
   "start": 68.7333,
   "end": 69.4667,
   "text": "I went home."
  },
  {
   "id": "12.bed",
   "start": 69.4667,
   "end": 71.2333,
   "text": "I lay on my bed and did not sleep."
  },
  {
   "id": "13.light",
   "start": 71.2333,
   "end": 72.8667,
   "text": "In the morning, the sun came in."
  },
  {
   "id": "13.square",
   "start": 72.8667,
   "end": 73.9333,
   "text": "I went to the square."
  },
  {
   "id": "13.there",
   "start": 73.9333,
   "end": 74.9667,
   "text": "It was standing there."
  },
  {
   "id": "14.hooks",
   "start": 74.9667,
   "end": 76.6667,
   "text": "The hooks in the smithy were empty."
  },
  {
   "id": "14.pot",
   "start": 76.6667,
   "end": 78.5,
   "text": "My mother's pot was gone from the kitchen."
  },
  {
   "id": "14.iron",
   "start": 78.5,
   "end": 81.0,
   "text": "Every piece of iron in this town was in the square."
  },
  {
   "id": "14.built",
   "start": 81.0,
   "end": 83.3,
   "text": "In the night, the whole village had built it again."
  },
  {
   "id": "14.afraid",
   "start": 83.3,
   "end": 85.6333,
   "text": "Not because they loved it. Because they were afraid."
  },
  {
   "id": "14.giveback",
   "start": 85.6333,
   "end": 87.9,
   "text": "And because the well gives back what you put in it."
  },
  {
   "id": "14.flowers",
   "start": 87.9,
   "end": 90.6,
   "text": "Every flower on that well was somebody we had lost."
  },
  {
   "id": "14.ours",
   "start": 90.6,
   "end": 92.7667,
   "text": "The golem had been handing us our own flowers."
  },
  {
   "id": "14.held",
   "start": 92.7667,
   "end": 94.1667,
   "text": "Then it held one out to me."
  },
  {
   "id": "14.mine",
   "start": 94.1667,
   "end": 96.5,
   "text": "It was mine. The rose I had left on the well."
  },
  {
   "id": "14.sub",
   "start": 96.5,
   "end": 98.1667,
   "text": "Subscribe before I keep it."
  }
 ],
