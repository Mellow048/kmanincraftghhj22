{
 "film": "in-this-town-the-golem-gave-us-flowers",
 "fps": 30,
 "duration": 96.5333,
 "estimated": true,
 "tempo": 1.0,
 "wordsPerMinute": 255.5,
 "audio": null,
 "clips": [],
 "cues": [
  {
   "id": "1.flower",
   "start": 0.0,
   "end": 1.8667,
   "text": "In this town, our golem gave us flowers."
  },
  {
   "id": "1.every",
   "start": 1.8667,
   "end": 3.9667,
   "text": "Every single morning, to somebody new."
  },
  {
   "id": "1.nobody",
   "start": 3.9667,
   "end": 5.4333,
   "text": "Nobody knew where it got them."
  },
  {
   "id": "2.sleep",
   "start": 5.4333,
   "end": 7.0667,
   "text": "Nobody had ever seen it sleep."
  },
  {
   "id": "2.break",
   "start": 7.0667,
   "end": 8.7,
   "text": "Nobody had ever seen it break."
  },
  {
   "id": "2.well",
   "start": 8.7,
   "end": 11.3333,
   "text": "And nobody would tell me why the well was full of flowers."
  },
  {
   "id": "2.rule",
   "start": 11.3333,
   "end": 13.4667,
   "text": "The oldest rule in town was about those flowers."
  },
  {
   "id": "2.keep",
   "start": 13.4667,
   "end": 14.3333,
   "text": "Never keep one."
  },
  {
   "id": "3.wall",
   "start": 14.3333,
   "end": 15.5667,
   "text": "It walked the wall all night."
  },
  {
   "id": "3.gate",
   "start": 15.5667,
   "end": 17.0667,
   "text": "At dawn, it stood at the gate."
  },
  {
   "id": "3.take",
   "start": 17.0667,
   "end": 18.6667,
   "text": "Then it took one flower off the well,"
  },
  {
   "id": "3.child",
   "start": 18.6667,
   "end": 19.9,
   "text": "and gave it to a child."
  },
  {
   "id": "3.none",
   "start": 19.9,
   "end": 21.8333,
   "text": "Nobody asked how. Nobody asked why."
  },
  {
   "id": "3.lid",
   "start": 21.8333,
   "end": 24.1,
   "text": "The well had a stone lid. It was never on."
  },
  {
   "id": "3.anvil",
   "start": 24.1,
   "end": 26.6,
   "text": "The blacksmith had an anvil. My mother had a pot."
  },
  {
   "id": "3.bucket",
   "start": 26.6,
   "end": 28.8,
   "text": "My father had a bucket with a hole in it."
  },
  {
   "id": "3.remember",
   "start": 28.8,
   "end": 30.9333,
   "text": "He said iron remembers the shape you give it."
  },
  {
   "id": "3.good",
   "start": 30.9333,
   "end": 33.5,
   "text": "It was a good life. Nobody had been hurt in years."
  },
  {
   "id": "4.protect",
   "start": 33.5,
   "end": 35.1667,
   "text": "But the golem protected all of us."
  },
  {
   "id": "4.need",
   "start": 35.1667,
   "end": 36.4,
   "text": "I wanted it to need me."
  },
  {
   "id": "5.ask",
   "start": 36.4,
   "end": 38.4,
   "text": "So I asked the oldest woman in town why."
  },
  {
   "id": "5.say",
   "start": 38.4,
   "end": 40.2667,
   "text": "\"Never keep a golem's flower,\" she said."
  },
  {
   "id": "5.again",
   "start": 40.2667,
   "end": 41.3,
   "text": "I asked her again."
  },
  {
   "id": "5.walk",
   "start": 41.3,
   "end": 42.1333,
   "text": "She walked away."
  },
  {
   "id": "6.bell",
   "start": 42.1333,
   "end": 43.4667,
   "text": "Then one night, the bell rang."
  },
  {
   "id": "6.wall",
   "start": 43.4667,
   "end": 44.8,
   "text": "Something was on the wall."
  },
  {
   "id": "7.sword",
   "start": 44.8,
   "end": 46.3,
   "text": "I grabbed my father's diamond sword."
  },
  {
   "id": "7.zombie",
   "start": 46.3,
   "end": 47.3,
   "text": "I got the zombie."
  },
  {
   "id": "7.skeleton",
   "start": 47.3,
   "end": 48.4667,
   "text": "I got the skeleton."
  },
  {
   "id": "7.proud",
   "start": 48.4667,
   "end": 51.2667,
   "text": "I was so proud of myself that I forgot to look behind it."
  },
  {
   "id": "8.behind",
   "start": 51.2667,
   "end": 53.0667,
   "text": "There was a creeper behind the golem."
  },
  {
   "id": "8.shout",
   "start": 53.0667,
   "end": 53.9667,
   "text": "I should have shouted."
  },
  {
   "id": "8.stood",
   "start": 53.9667,
   "end": 54.8667,
   "text": "I just stood there."
  },
  {
   "id": "9.boom",
   "start": 54.8667,
   "end": 55.5333,
   "text": "It exploded."
  },
  {
   "id": "9.dust",
   "start": 55.5333,
   "end": 57.3333,
   "text": "When the dust settled, the golem was gone."
  },
  {
   "id": "10.finish",
   "start": 57.3333,
   "end": 58.4667,
   "text": "We finished the monsters."
  },
  {
   "id": "10.walk",
   "start": 58.4667,
   "end": 59.7333,
   "text": "I walked to where it fell."
  },
  {
   "id": "10.rose",
   "start": 59.7333,
   "end": 60.9667,
   "text": "In the ash was a rose."
  },
  {
   "id": "11.pick",
   "start": 60.9667,
   "end": 62.7333,
   "text": "I picked it up. It was still warm."
  },
  {
   "id": "11.put",
   "start": 62.7333,
   "end": 64.9,
   "text": "I put it on the well, with all the others."
  },
  {
   "id": "11.letgo",
   "start": 64.9,
   "end": 67.3,
   "text": "The rule said never keep it. So I let it go."
  },
  {
   "id": "12.home",
   "start": 67.3,
   "end": 68.0333,
   "text": "I went home."
  },
  {
   "id": "12.bed",
   "start": 68.0333,
   "end": 69.8,
   "text": "I lay on my bed and did not sleep."
  },
  {
   "id": "13.light",
   "start": 69.8,
   "end": 71.4,
   "text": "In the morning, the sun came in."
  },
  {
   "id": "13.square",
   "start": 71.4,
   "end": 72.4667,
   "text": "I went to the square."
  },
  {
   "id": "13.there",
   "start": 72.4667,
   "end": 73.5,
   "text": "It was standing there."
  },
  {
   "id": "14.hooks",
   "start": 73.5,
   "end": 75.1667,
   "text": "The hooks in the smithy were empty."
  },
  {
   "id": "14.pot",
   "start": 75.1667,
   "end": 77.0,
   "text": "My mother's pot was gone from the kitchen."
  },
  {
   "id": "14.iron",
   "start": 77.0,
   "end": 79.4667,
   "text": "Every piece of iron in this town was in the square."
  },
  {
   "id": "14.built",
   "start": 79.4667,
   "end": 81.7667,
   "text": "In the night, the whole village had built it again."
  },
  {
   "id": "14.afraid",
   "start": 81.7667,
   "end": 84.1,
   "text": "Not because they loved it. Because they were afraid."
  },
  {
   "id": "14.giveback",
   "start": 84.1,
   "end": 86.3,
   "text": "And because the well gives back what you put in it."
  },
  {
   "id": "14.flowers",
   "start": 86.3,
   "end": 89.0,
   "text": "Every flower on that well was somebody we had lost."
  },
  {
   "id": "14.ours",
   "start": 89.0,
   "end": 91.1333,
   "text": "The golem had been handing us our own flowers."
  },
  {
   "id": "14.held",
   "start": 91.1333,
   "end": 92.5667,
   "text": "Then it held one out to me."
  },
  {
   "id": "14.mine",
   "start": 92.5667,
   "end": 94.8667,
   "text": "It was mine. The rose I had left on the well."
  },
  {
   "id": "14.sub",
   "start": 94.8667,
   "end": 96.5333,
   "text": "Subscribe before I keep it."
  }
 ],
