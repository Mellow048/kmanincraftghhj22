 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 1.0333,
   "text": "In this town, HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "1.catch",
   "start": 1.0333,
   "end": 3.1,
   "text": "One last turn, and the engine caught."
  },
  {
   "id": "2.love",
   "start": 3.1,
   "end": 5.6,
   "text": "Everybody loved partying. Every single night."
  },
  {
   "id": "2.invite",
   "start": 5.6,
   "end": 7.4333,
   "text": "My friends would invite me to come along."
  },
  {
   "id": "2.once",
   "start": 7.4333,
   "end": 9.1333,
   "text": "\"Come on! You only live once!\""
  },
  {
   "id": "2.hide",
   "start": 9.1333,
   "end": 11.3333,
   "text": "\"Stop hiding in that garage! Get over here!\""
  },
  {
   "id": "2.hood",
   "start": 11.3333,
   "end": 13.3,
   "text": "I stayed under the hood, and I did not move."
  },
  {
   "id": "2.light",
   "start": 13.3,
   "end": 14.9,
   "text": "The party was just a light in the window."
  },
  {
   "id": "2.dream",
   "start": 14.9,
   "end": 16.3667,
   "text": "But I had a different dream."
  },
  {
   "id": "3.tv",
   "start": 16.3667,
   "end": 18.2333,
   "text": "A mechanic on the television turned a key."
  },
  {
   "id": "3.start",
   "start": 18.2333,
   "end": 21.1667,
   "text": "The dead car started. I leaned all the way in."
  },
  {
   "id": "3.want",
   "start": 21.1667,
   "end": 22.4333,
   "text": "I wanted to be a mechanic."
  },
  {
   "id": "3.any",
   "start": 22.4333,
   "end": 24.8333,
   "text": "I wanted to be the guy who could make any car start."
  },
  {
   "id": "3.sleeve",
   "start": 24.8333,
   "end": 26.2333,
   "text": "So I rolled my sleeves up."
  },
  {
   "id": "3.walk",
   "start": 26.2333,
   "end": 27.7667,
   "text": "And I walked straight back under the hood."
  },
  {
   "id": "4.jack",
   "start": 27.7667,
   "end": 29.9667,
   "text": "I jacked the car up. I was completely sure."
  },
  {
   "id": "4.tire",
   "start": 29.9667,
   "end": 31.4667,
   "text": "I pulled the tire off and I held it up."
  },
  {
   "id": "4.roll",
   "start": 31.4667,
   "end": 32.8667,
   "text": "Then the car rolled off the jack."
  },
  {
   "id": "4.hedge",
   "start": 32.8667,
   "end": 35.1,
   "text": "It stopped in the hedge, slow, like it meant to."
  },
  {
   "id": "4.hold",
   "start": 35.1,
   "end": 36.6333,
   "text": "And I was still holding the tire."
  },
  {
   "id": "4.almost",
   "start": 36.6333,
   "end": 39.3333,
   "text": "\"Almost! Almost!\" I shouted at the hedge."
  },
  {
   "id": "4.learn",
   "start": 39.3333,
   "end": 41.0667,
   "text": "Well. I still had a lot to learn."
  },
  {
   "id": "5.bolt",
   "start": 41.0667,
   "end": 43.2333,
   "text": "One rusty bolt. I turned it slow."
  },
  {
   "id": "5.fast",
   "start": 43.2333,
   "end": 46.0333,
   "text": "Then faster. Then the whole wheel came off."
  },
  {
   "id": "5.hus",
   "start": 46.0333,
   "end": 47.5333,
   "text": "HUS. HUS HUS. HUS HUS HUS!"
  },
  {
   "id": "5.back",
   "start": 47.5333,
   "end": 48.9,
   "text": "I put a headlight in backwards."
  },
  {
   "id": "5.face",
   "start": 48.9,
   "end": 50.7333,
   "text": "It shone straight into my own face."
  },
  {
   "id": "5.fix",
   "start": 50.7333,
   "end": 52.7667,
   "text": "I turned it around. I did not quit."
  },
  {
   "id": "5.smoke",
   "start": 52.7667,
   "end": 54.5,
   "text": "The engine coughed a cloud of smoke at me."
  },
  {
   "id": "5.key",
   "start": 54.5,
   "end": 56.7,
   "text": "I waved it away, and I turned the key again."
  },
  {
   "id": "5.night",
   "start": 56.7,
   "end": 58.8667,
   "text": "The party light stayed on. So did mine."
  },
  {
   "id": "5.while",
   "start": 58.8667,
   "end": 61.2333,
   "text": "While they were out partying, I was under that car."
  },
  {
   "id": "5.strip",
   "start": 61.2333,
   "end": 63.4667,
   "text": "I stripped a hundred bolts. I flooded the engine."
  },
  {
   "id": "5.water",
   "start": 63.4667,
   "end": 66.3,
   "text": "I came in for water, and I went straight back out."
  },
  {
   "id": "5.months",
   "start": 66.3,
   "end": 68.8333,
   "text": "The months passed, one page at a time."
  },
  {
   "id": "5.hired",
   "start": 68.8333,
   "end": 70.6667,
   "text": "Then the garage on the main street hired me."
  },
  {
   "id": "6.sat",
   "start": 70.6667,
   "end": 72.8333,
   "text": "It was a Saturday. Cars lined up out the door."
  },
  {
   "id": "6.behind",
   "start": 72.8333,
   "end": 74.3333,
   "text": "The other mechanics were already behind."
  },
  {
   "id": "6.board",
   "start": 74.3333,
   "end": 76.3333,
   "text": "A clipboard sat there. Nobody picked it up."
  },
  {
   "id": "6.under",
   "start": 76.3333,
   "end": 78.2333,
   "text": "I rolled under the first car. I was calm."
  },
  {
   "id": "6.wrench",
   "start": 78.2333,
   "end": 80.0,
   "text": "The wrench was a blur. HUS HUS HUS!"
  },
  {
   "id": "6.wheel",
   "start": 80.0,
   "end": 81.8,
   "text": "A tire seated in one push."
  },
  {
   "id": "6.spark",
   "start": 81.8,
   "end": 84.3333,
   "text": "The cables sparked. I did not even flinch."
  },
  {
   "id": "6.hood",
   "start": 84.3333,
   "end": 85.6333,
   "text": "I dropped the hood and I turned the key."
  },
  {
   "id": "6.blink",
   "start": 85.6333,
   "end": 87.7333,
   "text": "The car started. The owner just blinked."
  },
  {
   "id": "6.boss",
   "start": 87.7333,
   "end": 89.6333,
   "text": "The boss looked over. Nothing left to fix."
  },
  {
   "id": "7.push",
   "start": 89.6333,
   "end": 91.7333,
   "text": "Then my old friends pushed a dead car up the street."
  },
  {
   "id": "7.dress",
   "start": 91.7333,
   "end": 93.0667,
   "text": "They were still dressed for the party."
  },
  {
   "id": "7.stop",
   "start": 93.0667,
   "end": 95.0667,
   "text": "It rolled to a stop, right at my feet."
  },
  {
   "id": "7.wait",
   "start": 95.0667,
   "end": 96.4667,
   "text": "\"Wait. Is that him?\""
  },
  {
   "id": "7.how",
   "start": 96.4667,
   "end": 98.3,
   "text": "\"How did you get so good at fixing cars?\""
  },
  {
   "id": "7.train",
   "start": 98.3,
   "end": 100.7,
   "text": "\"Training,\" I said, and I did not smile."
  },
  {
   "id": "7.quiet",
   "start": 100.7,
   "end": 102.8667,
   "text": "For one second, the engine was dead quiet."
  },
  {
   "id": "7.up",
   "start": 102.8667,
   "end": 104.7667,
   "text": "I looked up, and the wrench came up with me."
  },
  {
   "id": "7.hus",
   "start": 104.7667,
   "end": 105.4667,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "7.catch",
   "start": 105.4667,
   "end": 107.4,
   "text": "The engine caught before they let go of the bumper."
  },
  {
   "id": "7.end",
   "start": 107.4,
   "end": 109.0,
   "text": "Like and subscribe for more."
  }
 ],
