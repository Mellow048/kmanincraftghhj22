 "cues": [
  {
   "id": "1.race",
   "start": 0.0,
   "end": 2.0,
   "text": "In this town, we have a swimming race every summer."
  },
  {
   "id": "1.trophy",
   "start": 2.0,
   "end": 3.6667,
   "text": "The winner gets a trophy as big as my head."
  },
  {
   "id": "1.window",
   "start": 3.6667,
   "end": 5.2333,
   "text": "It sits in the town hall window all year."
  },
  {
   "id": "1.shower",
   "start": 5.2333,
   "end": 6.8333,
   "text": "I can shower. I just can't swim."
  },
  {
   "id": "1.toes",
   "start": 6.8333,
   "end": 9.0,
   "text": "If the water goes past my toes, I panic."
  },
  {
   "id": "1.worm",
   "start": 9.0,
   "end": 10.9333,
   "text": "I look like a worm somebody sprinkled with salt."
  },
  {
   "id": "1.want",
   "start": 10.9333,
   "end": 11.9333,
   "text": "But I wanted that trophy."
  },
  {
   "id": "2.smell",
   "start": 11.9333,
   "end": 13.6667,
   "text": "The pool smelled like bleach and other kids."
  },
  {
   "id": "2.everyday",
   "start": 13.6667,
   "end": 15.3667,
   "text": "So every morning, I went there anyway."
  },
  {
   "id": "2.hold",
   "start": 15.3667,
   "end": 16.8333,
   "text": "I held the wall with both hands."
  },
  {
   "id": "2.kick",
   "start": 16.8333,
   "end": 18.3333,
   "text": "I kicked like a chicken with a problem."
  },
  {
   "id": "2.sink",
   "start": 18.3333,
   "end": 19.9667,
   "text": "My legs went down like two stones."
  },
  {
   "id": "2.laugh",
   "start": 19.9667,
   "end": 21.2,
   "text": "The little kids laughed at me."
  },
  {
   "id": "2.deep",
   "start": 21.2,
   "end": 22.2333,
   "text": "Then I tried the deep end."
  },
  {
   "id": "2.down",
   "start": 22.2333,
   "end": 23.5667,
   "text": "The water closed over my head."
  },
  {
   "id": "2.arms",
   "start": 23.5667,
   "end": 24.7333,
   "text": "I couldn't find the top."
  },
  {
   "id": "2.hand",
   "start": 24.7333,
   "end": 25.8667,
   "text": "A hand grabbed my arm."
  },
  {
   "id": "2.friend",
   "start": 25.8667,
   "end": 27.4,
   "text": "My friend pulled me onto the tiles."
  },
  {
   "id": "2.breath",
   "start": 27.4,
   "end": 29.5,
   "text": "I couldn't breathe, and I couldn't talk."
  },
  {
   "id": "2.days",
   "start": 29.5,
   "end": 30.6,
   "text": "The race was in three days."
  },
  {
   "id": "3.phone",
   "start": 30.6,
   "end": 32.6667,
   "text": "That night, I watched a video on my phone."
  },
  {
   "id": "3.title",
   "start": 32.6667,
   "end": 34.2667,
   "text": "It was called \"learn fast\"."
  },
  {
   "id": "3.try",
   "start": 34.2667,
   "end": 35.6333,
   "text": "The next day, I tried it."
  },
  {
   "id": "3.sank",
   "start": 35.6333,
   "end": 36.6333,
   "text": "Down I went."
  },
  {
   "id": "3.again",
   "start": 36.6333,
   "end": 38.6667,
   "text": "I tried again. I sank again."
  },
  {
   "id": "3.again2",
   "start": 38.6667,
   "end": 40.0333,
   "text": "Again, and again."
  },
  {
   "id": "3.up",
   "start": 40.0333,
   "end": 41.1333,
   "text": "Then I stayed on top."
  },
  {
   "id": "3.cross",
   "start": 41.1333,
   "end": 42.4333,
   "text": "I swam all the way across."
  },
  {
   "id": "3.stop",
   "start": 42.4333,
   "end": 44.2333,
   "text": "But the moment I stopped, I went down."
  },
  {
   "id": "3.coin",
   "start": 44.2333,
   "end": 45.6667,
   "text": "Straight down, like a coin."
  },
  {
   "id": "4.bottom",
   "start": 45.6667,
   "end": 46.9333,
   "text": "I hit the bottom and looked up."
  },
  {
   "id": "4.bubble",
   "start": 46.9333,
   "end": 48.4333,
   "text": "The top looked a long way away."
  },
  {
   "id": "4.shoes",
   "start": 48.4333,
   "end": 49.9,
   "text": "My friend jumped in with his shoes on."
  },
  {
   "id": "4.pull",
   "start": 49.9,
   "end": 51.1333,
   "text": "He pulled me out by my shirt."
  },
  {
   "id": "4.taste",
   "start": 51.1333,
   "end": 52.4333,
   "text": "I could still taste the water."
  },
  {
   "id": "4.tiles",
   "start": 52.4333,
   "end": 53.9667,
   "text": "I lay on the tiles and didn't move."
  },
  {
   "id": "4.tired",
   "start": 53.9667,
   "end": 55.0667,
   "text": "I was so tired."
  },
  {
   "id": "5.home",
   "start": 55.0667,
   "end": 56.5,
   "text": "It was dark when I walked home."
  },
  {
   "id": "5.call",
   "start": 56.5,
   "end": 58.5667,
   "text": "Then somebody called my name from the trees."
  },
  {
   "id": "5.woods",
   "start": 58.5667,
   "end": 59.6333,
   "text": "I went into the woods."
  },
  {
   "id": "5.stranger",
   "start": 59.6333,
   "end": 61.7,
   "text": "Someone stood there, holding out a ring."
  },
  {
   "id": "5.ask",
   "start": 61.7,
   "end": 62.8667,
   "text": "I asked him what it was for."
  },
  {
   "id": "5.silent",
   "start": 62.8667,
   "end": 63.8333,
   "text": "He didn't say anything."
  },
  {
   "id": "5.left",
   "start": 63.8333,
   "end": 64.5667,
   "text": "He just left."
  },
  {
   "id": "5.cold",
   "start": 64.5667,
   "end": 66.3,
   "text": "The ring was cold, and it hummed a little."
  },
  {
   "id": "5.lamp",
   "start": 66.3,
   "end": 67.7,
   "text": "I put it by my lamp and went to sleep."
  },
  {
   "id": "6.morning",
   "start": 67.7,
   "end": 69.0333,
   "text": "The next morning, I put it on."
  },
  {
   "id": "6.luck",
   "start": 69.0333,
   "end": 70.0333,
   "text": "I wore it for luck."
  },
  {
   "id": "6.alone",
   "start": 70.0333,
   "end": 72.2333,
   "text": "My friend wasn't there today, so I went alone."
  },
  {
   "id": "6.dive",
   "start": 72.2333,
   "end": 73.5,
   "text": "I dove in and swam."
  },
  {
   "id": "6.bonk",
   "start": 73.5,
   "end": 74.7667,
   "text": "Then I hit my head on the wall."
  },
  {
   "id": "6.side",
   "start": 74.7667,
   "end": 76.2333,
   "text": "But I was already on the other side."
  },
  {
   "id": "6.back",
   "start": 76.2333,
   "end": 77.4333,
   "text": "I swam back."
  },
  {
   "id": "6.bonk2",
   "start": 77.4333,
   "end": 78.9333,
   "text": "And hit my head on that side too."
  },
  {
   "id": "6.same",
   "start": 78.9333,
   "end": 80.7,
   "text": "I tried again. Same thing."
  },
  {
   "id": "6.dream",
   "start": 80.7,
   "end": 81.8333,
   "text": "I thought I was dreaming."
  },
  {
   "id": "6.hurt",
   "start": 81.8333,
   "end": 83.4333,
   "text": "But my head hurt too much for a dream."
  },
  {
   "id": "6.looked",
   "start": 83.4333,
   "end": 84.5,
   "text": "Then I looked at the ring."
  },
  {
   "id": "6.buttons",
   "start": 84.5,
   "end": 85.7667,
   "text": "There were three little buttons."
  },
  {
   "id": "6.medium",
   "start": 85.7667,
   "end": 87.6667,
   "text": "Max speed. Medium. Low."
  },
  {
   "id": "6.scared",
   "start": 87.6667,
   "end": 89.5667,
   "text": "I pressed medium. The pool went short."
  },
  {
   "id": "6.low",
   "start": 89.5667,
   "end": 91.2667,
   "text": "That scared me, so I pressed low."
  },
  {
   "id": "6.fast",
   "start": 91.2667,
   "end": 92.8667,
   "text": "I swam, and I was fast."
  },
  {
   "id": "6.how",
   "start": 92.8667,
   "end": 94.2667,
   "text": "How does a ring make me swim?"
  },
  {
   "id": "6.shrug",
   "start": 94.2667,
   "end": 95.3667,
   "text": "I don't know. It did."
  },
  {
   "id": "7.days",
   "start": 95.3667,
   "end": 97.1333,
   "text": "Three days later, I signed my name."
  },
  {
   "id": "7.hands",
   "start": 97.1333,
   "end": 98.5,
   "text": "My hands were shaking on the pen."
  },
  {
   "id": "7.number",
   "start": 98.5,
   "end": 100.0,
   "text": "They gave me number sixty-six."
  },
  {
   "id": "7.crowd",
   "start": 100.0,
   "end": 101.1333,
   "text": "The pool was full of people."
  },
  {
   "id": "7.pro",
   "start": 101.1333,
   "end": 102.5333,
   "text": "They all looked like professionals."
  },
  {
   "id": "7.matter",
   "start": 102.5333,
   "end": 104.0333,
   "text": "It didn't matter. I had a ring."
  },
  {
   "id": "7.table",
   "start": 104.0333,
   "end": 105.6,
   "text": "The trophy was on a table by the water."
  },
  {
   "id": "7.big",
   "start": 105.6,
   "end": 107.0,
   "text": "Then I saw the pool."
  },
  {
   "id": "7.speaker",
   "start": 107.0,
   "end": 108.3333,
   "text": "The speaker crackled."
  },
  {
   "id": "7.three",
   "start": 108.3333,
   "end": 109.5,
   "text": "There are three pools."
  },
  {
   "id": "7.smallest",
   "start": 109.5,
   "end": 111.6333,
   "text": "This is pool one. The smallest."
  },
  {
   "id": "7.most",
   "start": 111.6333,
   "end": 113.1333,
   "text": "Most wins takes the trophy."
  },
  {
   "id": "7.what",
   "start": 113.1333,
   "end": 114.7333,
   "text": "This pool is way bigger than mine?"
  },
  {
   "id": "7.go",
   "start": 114.7333,
   "end": 117.4667,
   "text": "Three. Two. One. Go."
  },
  {
   "id": "8.water",
   "start": 117.4667,
   "end": 118.6667,
   "text": "Everybody hit the water."
  },
  {
   "id": "8.tenth",
   "start": 118.6667,
   "end": 119.4,
   "text": "I was tenth."
  },
  {
   "id": "8.eighth",
   "start": 119.4,
   "end": 120.1333,
   "text": "Then eighth."
  },
  {
   "id": "8.seventh",
   "start": 120.1333,
   "end": 121.1,
   "text": "Then I was seventh."
  },
  {
   "id": "8.fourth",
   "start": 121.1,
   "end": 121.9667,
   "text": "Then fourth."
  },
  {
   "id": "8.feel",
   "start": 121.9667,
   "end": 123.1667,
   "text": "I could feel it working."
  },
  {
   "id": "8.saw",
   "start": 123.1667,
   "end": 124.2333,
   "text": "Then I saw something."
  },
  {
   "id": "8.glint",
   "start": 124.2333,
   "end": 126.1,
   "text": "A ring. On the hand in front of me."
  },
  {
   "id": "8.panic",
   "start": 126.1,
   "end": 127.0667,
   "text": "I swam harder."
  },
  {
   "id": "8.third",
   "start": 127.0667,
   "end": 127.9333,
   "text": "Third place."
  },
  {
   "id": "8.second",
   "start": 127.9333,
   "end": 128.9,
   "text": "Second place."
  },
  {
   "id": "8.catch",
   "start": 128.9,
   "end": 129.9667,
   "text": "But I couldn't catch him."
  },
  {
   "id": "8.dare",
   "start": 129.9667,
   "end": 131.5667,
   "text": "I didn't dare change the setting."
  },
  {
   "id": "8.lose",
   "start": 131.5667,
   "end": 132.9667,
   "text": "He touched the wall first."
  },
  {
   "id": "8.secondplace",
   "start": 132.9667,
   "end": 134.4667,
   "text": "The trophy was one place away."
  },
  {
   "id": "8.tiles",
   "start": 134.4667,
   "end": 136.4,
   "text": "I lay on the white tiles, exhausted."
  },
  {
   "id": "8.hand",
   "start": 136.4,
   "end": 137.3,
   "text": "I looked at his hand."
  },
  {
   "id": "8.problem",
   "start": 137.3,
   "end": 138.8,
   "text": "This is going to be a problem."
  },
  {
   "id": "8.sub",
   "start": 138.8,
   "end": 140.6,
   "text": "Like and subscribe for part two."
  }
 ],
