 "cues": [
  {
   "id": "1.race",
   "start": 0.0,
   "end": 2.4333,
   "text": "In this town, we have a swimming race every summer."
  },
  {
   "id": "1.trophy",
   "start": 2.4333,
   "end": 4.2333,
   "text": "The winner gets a trophy as big as my head."
  },
  {
   "id": "1.window",
   "start": 4.2333,
   "end": 6.0667,
   "text": "It sits in the town hall window all year."
  },
  {
   "id": "1.shower",
   "start": 6.0667,
   "end": 7.7333,
   "text": "I can shower. I just can't swim."
  },
  {
   "id": "1.toes",
   "start": 7.7333,
   "end": 9.6667,
   "text": "If the water goes past my toes, I panic."
  },
  {
   "id": "1.worm",
   "start": 9.6667,
   "end": 11.8667,
   "text": "I look like a worm somebody sprinkled with salt."
  },
  {
   "id": "1.want",
   "start": 11.8667,
   "end": 12.8667,
   "text": "But I wanted that trophy."
  },
  {
   "id": "2.smell",
   "start": 12.8667,
   "end": 14.9,
   "text": "The pool smelled like bleach and other kids."
  },
  {
   "id": "2.everyday",
   "start": 14.9,
   "end": 16.7667,
   "text": "So every morning, I went there anyway."
  },
  {
   "id": "2.hold",
   "start": 16.7667,
   "end": 18.1667,
   "text": "I held the wall with both hands."
  },
  {
   "id": "2.kick",
   "start": 18.1667,
   "end": 19.8,
   "text": "I kicked like a chicken with a problem."
  },
  {
   "id": "2.sink",
   "start": 19.8,
   "end": 21.4333,
   "text": "My legs went down like two stones."
  },
  {
   "id": "2.laugh",
   "start": 21.4333,
   "end": 22.6667,
   "text": "The little kids laughed at me."
  },
  {
   "id": "2.deep",
   "start": 22.6667,
   "end": 23.7333,
   "text": "Then I tried the deep end."
  },
  {
   "id": "2.down",
   "start": 23.7333,
   "end": 25.1333,
   "text": "The water closed over my head."
  },
  {
   "id": "2.arms",
   "start": 25.1333,
   "end": 26.2333,
   "text": "I couldn't find the top."
  },
  {
   "id": "2.hand",
   "start": 26.2333,
   "end": 27.3667,
   "text": "A hand grabbed my arm."
  },
  {
   "id": "2.friend",
   "start": 27.3667,
   "end": 28.9333,
   "text": "My friend pulled me onto the tiles."
  },
  {
   "id": "2.breath",
   "start": 28.9333,
   "end": 30.7333,
   "text": "I couldn't breathe, and I couldn't talk."
  },
  {
   "id": "2.days",
   "start": 30.7333,
   "end": 31.8333,
   "text": "The race was in three days."
  },
  {
   "id": "3.phone",
   "start": 31.8333,
   "end": 33.9667,
   "text": "That night, I watched a video on my phone."
  },
  {
   "id": "3.title",
   "start": 33.9667,
   "end": 35.5,
   "text": "It was called \"learn fast\"."
  },
  {
   "id": "3.try",
   "start": 35.5,
   "end": 36.8333,
   "text": "The next day, I tried it."
  },
  {
   "id": "3.sank",
   "start": 36.8333,
   "end": 37.5667,
   "text": "Down I went."
  },
  {
   "id": "3.again",
   "start": 37.5667,
   "end": 39.1,
   "text": "I tried again. I sank again."
  },
  {
   "id": "3.again2",
   "start": 39.1,
   "end": 40.3667,
   "text": "Again, and again."
  },
  {
   "id": "3.up",
   "start": 40.3667,
   "end": 41.5,
   "text": "Then I stayed on top."
  },
  {
   "id": "3.cross",
   "start": 41.5,
   "end": 42.7667,
   "text": "I swam all the way across."
  },
  {
   "id": "3.stop",
   "start": 42.7667,
   "end": 44.3667,
   "text": "But the moment I stopped, I went down."
  },
  {
   "id": "3.coin",
   "start": 44.3667,
   "end": 45.9333,
   "text": "Straight down, like a coin."
  },
  {
   "id": "4.bottom",
   "start": 45.9333,
   "end": 47.2667,
   "text": "I hit the bottom and looked up."
  },
  {
   "id": "4.bubble",
   "start": 47.2667,
   "end": 48.9,
   "text": "The top looked a long way away."
  },
  {
   "id": "4.shoes",
   "start": 48.9,
   "end": 50.4667,
   "text": "My friend jumped in with his shoes on."
  },
  {
   "id": "4.pull",
   "start": 50.4667,
   "end": 51.9333,
   "text": "He pulled me out by my shirt."
  },
  {
   "id": "4.taste",
   "start": 51.9333,
   "end": 53.2333,
   "text": "I could still taste the water."
  },
  {
   "id": "4.tiles",
   "start": 53.2333,
   "end": 54.7333,
   "text": "I lay on the tiles and didn't move."
  },
  {
   "id": "4.tired",
   "start": 54.7333,
   "end": 55.6333,
   "text": "I was so tired."
  },
  {
   "id": "5.home",
   "start": 55.6333,
   "end": 57.2,
   "text": "It was dark when I walked home."
  },
  {
   "id": "5.call",
   "start": 57.2,
   "end": 59.0667,
   "text": "Then somebody called my name from the trees."
  },
  {
   "id": "5.woods",
   "start": 59.0667,
   "end": 60.2,
   "text": "I went into the woods."
  },
  {
   "id": "5.stranger",
   "start": 60.2,
   "end": 62.1667,
   "text": "Someone stood there, holding out a ring."
  },
  {
   "id": "5.ask",
   "start": 62.1667,
   "end": 63.2667,
   "text": "I asked him what it was for."
  },
  {
   "id": "5.silent",
   "start": 63.2667,
   "end": 64.1,
   "text": "He didn't say anything."
  },
  {
   "id": "5.left",
   "start": 64.1,
   "end": 64.9333,
   "text": "He just left."
  },
  {
   "id": "5.cold",
   "start": 64.9333,
   "end": 67.1333,
   "text": "The ring was cold, and it hummed a little."
  },
  {
   "id": "5.lamp",
   "start": 67.1333,
   "end": 68.4667,
   "text": "I put it by my lamp and went to sleep."
  },
  {
   "id": "6.morning",
   "start": 68.4667,
   "end": 70.2,
   "text": "The next morning, I put it on."
  },
  {
   "id": "6.luck",
   "start": 70.2,
   "end": 71.2,
   "text": "I wore it for luck."
  },
  {
   "id": "6.alone",
   "start": 71.2,
   "end": 73.5667,
   "text": "My friend wasn't there today, so I went alone."
  },
  {
   "id": "6.dive",
   "start": 73.5667,
   "end": 75.2333,
   "text": "I dove in and swam."
  },
  {
   "id": "6.bonk",
   "start": 75.2333,
   "end": 76.5333,
   "text": "Then I hit my head on the wall."
  },
  {
   "id": "6.side",
   "start": 76.5333,
   "end": 77.9333,
   "text": "But I was already on the other side."
  },
  {
   "id": "6.back",
   "start": 77.9333,
   "end": 78.8667,
   "text": "I swam back."
  },
  {
   "id": "6.bonk2",
   "start": 78.8667,
   "end": 80.3333,
   "text": "And hit my head on that side too."
  },
  {
   "id": "6.same",
   "start": 80.3333,
   "end": 81.9667,
   "text": "I tried again. Same thing."
  },
  {
   "id": "6.dream",
   "start": 81.9667,
   "end": 82.9667,
   "text": "I thought I was dreaming."
  },
  {
   "id": "6.hurt",
   "start": 82.9667,
   "end": 84.8,
   "text": "But my head hurt too much for a dream."
  },
  {
   "id": "6.looked",
   "start": 84.8,
   "end": 85.7333,
   "text": "Then I looked at the ring."
  },
  {
   "id": "6.buttons",
   "start": 85.7333,
   "end": 86.7333,
   "text": "There were three little buttons."
  },
  {
   "id": "6.medium",
   "start": 86.7333,
   "end": 88.5333,
   "text": "Max speed. Medium. Low."
  },
  {
   "id": "6.scared",
   "start": 88.5333,
   "end": 90.5667,
   "text": "I pressed medium. The pool went short."
  },
  {
   "id": "6.low",
   "start": 90.5667,
   "end": 92.4,
   "text": "That scared me, so I pressed low."
  },
  {
   "id": "6.fast",
   "start": 92.4,
   "end": 93.9667,
   "text": "I swam, and I was fast."
  },
  {
   "id": "6.how",
   "start": 93.9667,
   "end": 95.3667,
   "text": "How does a ring make me swim?"
  },
  {
   "id": "6.shrug",
   "start": 95.3667,
   "end": 96.6,
   "text": "I don't know. It did."
  },
  {
   "id": "7.days",
   "start": 96.6,
   "end": 98.9333,
   "text": "Three days later, I signed my name."
  },
  {
   "id": "7.hands",
   "start": 98.9333,
   "end": 100.6667,
   "text": "My hands were shaking on the pen."
  },
  {
   "id": "7.number",
   "start": 100.6667,
   "end": 102.2333,
   "text": "They gave me number sixty-six."
  },
  {
   "id": "7.crowd",
   "start": 102.2333,
   "end": 103.5333,
   "text": "The pool was full of people."
  },
  {
   "id": "7.pro",
   "start": 103.5333,
   "end": 105.1333,
   "text": "They all looked like professionals."
  },
  {
   "id": "7.matter",
   "start": 105.1333,
   "end": 106.8333,
   "text": "It didn't matter. I had a ring."
  },
  {
   "id": "7.table",
   "start": 106.8333,
   "end": 108.4333,
   "text": "The trophy was on a table by the water."
  },
  {
   "id": "7.big",
   "start": 108.4333,
   "end": 109.4,
   "text": "Then I saw the pool."
  },
  {
   "id": "7.speaker",
   "start": 109.4,
   "end": 110.3333,
   "text": "The speaker crackled."
  },
  {
   "id": "7.three",
   "start": 110.3333,
   "end": 111.4333,
   "text": "There are three pools."
  },
  {
   "id": "7.smallest",
   "start": 111.4333,
   "end": 113.2333,
   "text": "This is pool one. The smallest."
  },
  {
   "id": "7.most",
   "start": 113.2333,
   "end": 114.6,
   "text": "Most wins takes the trophy."
  },
  {
   "id": "7.what",
   "start": 114.6,
   "end": 116.1,
   "text": "This pool is way bigger than mine?"
  },
  {
   "id": "7.go",
   "start": 116.1,
   "end": 118.9,
   "text": "Three. Two. One. Go."
  },
  {
   "id": "8.water",
   "start": 118.9,
   "end": 120.0,
   "text": "Everybody hit the water."
  },
  {
   "id": "8.tenth",
   "start": 120.0,
   "end": 120.7333,
   "text": "I was tenth."
  },
  {
   "id": "8.eighth",
   "start": 120.7333,
   "end": 121.3333,
   "text": "Then eighth."
  },
  {
   "id": "8.seventh",
   "start": 121.3333,
   "end": 122.0667,
   "text": "Then I was seventh."
  },
  {
   "id": "8.fourth",
   "start": 122.0667,
   "end": 122.7333,
   "text": "Then fourth."
  },
  {
   "id": "8.feel",
   "start": 122.7333,
   "end": 123.7333,
   "text": "I could feel it working."
  },
  {
   "id": "8.saw",
   "start": 123.7333,
   "end": 124.6667,
   "text": "Then I saw something."
  },
  {
   "id": "8.glint",
   "start": 124.6667,
   "end": 126.5333,
   "text": "A ring. On the hand in front of me."
  },
  {
   "id": "8.panic",
   "start": 126.5333,
   "end": 127.4333,
   "text": "I swam harder."
  },
  {
   "id": "8.third",
   "start": 127.4333,
   "end": 128.4333,
   "text": "Third place."
  },
  {
   "id": "8.second",
   "start": 128.4333,
   "end": 129.3,
   "text": "Second place."
  },
  {
   "id": "8.catch",
   "start": 129.3,
   "end": 130.3333,
   "text": "But I couldn't catch him."
  },
  {
   "id": "8.dare",
   "start": 130.3333,
   "end": 131.6,
   "text": "I didn't dare change the setting."
  },
  {
   "id": "8.lose",
   "start": 131.6,
   "end": 132.7667,
   "text": "He touched the wall first."
  },
  {
   "id": "8.secondplace",
   "start": 132.7667,
   "end": 134.2333,
   "text": "The trophy was one place away."
  },
  {
   "id": "8.tiles",
   "start": 134.2333,
   "end": 136.0667,
   "text": "I lay on the white tiles, exhausted."
  },
  {
   "id": "8.atleast",
   "start": 136.0667,
   "end": 138.5667,
   "text": "Well, at least I'm second. I've never been second."
  },
  {
   "id": "8.hand",
   "start": 138.5667,
   "end": 139.9333,
   "text": "Then I looked at his hand."
  },
  {
   "id": "8.problem",
   "start": 139.9333,
   "end": 142.1333,
   "text": "This is going to be a problem."
  },
  {
   "id": "8.sub",
   "start": 142.1333,
   "end": 144.0,
   "text": "Like and subscribe for part two."
  }
 ],
