 "audio": null,
 "clips": [],
 "cues": [
  {
   "id": "1.race",
   "start": 0.0,
   "end": 2.5,
   "text": "In this town, we have a swimming race every summer."
  },
  {
   "id": "1.trophy",
   "start": 2.5,
   "end": 4.7333,
   "text": "The winner gets a trophy as big as my head."
  },
  {
   "id": "1.window",
   "start": 4.7333,
   "end": 6.6333,
   "text": "It sits in the town hall window all year."
  },
  {
   "id": "1.shower",
   "start": 6.6333,
   "end": 8.4,
   "text": "I can shower. I just can't swim."
  },
  {
   "id": "1.toes",
   "start": 8.4,
   "end": 10.5333,
   "text": "If the water goes past my toes, I panic."
  },
  {
   "id": "1.worm",
   "start": 10.5333,
   "end": 12.7,
   "text": "I look like a worm somebody sprinkled with salt."
  },
  {
   "id": "1.want",
   "start": 12.7,
   "end": 13.9333,
   "text": "But I wanted that trophy."
  },
  {
   "id": "2.smell",
   "start": 13.9333,
   "end": 15.6667,
   "text": "The pool smelled like bleach and other kids."
  },
  {
   "id": "2.everyday",
   "start": 15.6667,
   "end": 17.8333,
   "text": "So every morning, I went there anyway."
  },
  {
   "id": "2.hold",
   "start": 17.8333,
   "end": 19.2667,
   "text": "I held the wall with both hands."
  },
  {
   "id": "2.kick",
   "start": 19.2667,
   "end": 21.1333,
   "text": "I kicked like a chicken with a problem."
  },
  {
   "id": "2.sink",
   "start": 21.1333,
   "end": 22.5667,
   "text": "My legs went down like two stones."
  },
  {
   "id": "2.laugh",
   "start": 22.5667,
   "end": 23.8333,
   "text": "The little kids laughed at me."
  },
  {
   "id": "2.deep",
   "start": 23.8333,
   "end": 25.0667,
   "text": "Then I tried the deep end."
  },
  {
   "id": "2.down",
   "start": 25.0667,
   "end": 26.6,
   "text": "The water closed over my head."
  },
  {
   "id": "2.arms",
   "start": 26.6,
   "end": 27.6667,
   "text": "I couldn't find the top."
  },
  {
   "id": "2.hand",
   "start": 27.6667,
   "end": 28.7667,
   "text": "A hand grabbed my arm."
  },
  {
   "id": "2.friend",
   "start": 28.7667,
   "end": 30.3333,
   "text": "My friend pulled me onto the tiles."
  },
  {
   "id": "2.breath",
   "start": 30.3333,
   "end": 31.8667,
   "text": "I couldn't breathe, and I couldn't talk."
  },
  {
   "id": "2.days",
   "start": 31.8667,
   "end": 33.1,
   "text": "The race was in three days."
  },
  {
   "id": "3.phone",
   "start": 33.1,
   "end": 35.1,
   "text": "That night, I watched a video on my phone."
  },
  {
   "id": "3.title",
   "start": 35.1,
   "end": 36.2,
   "text": "It was called \"learn fast\"."
  },
  {
   "id": "3.try",
   "start": 36.2,
   "end": 37.5333,
   "text": "The next day, I tried it."
  },
  {
   "id": "3.sank",
   "start": 37.5333,
   "end": 38.2667,
   "text": "Down I went."
  },
  {
   "id": "3.again",
   "start": 38.2667,
   "end": 40.0,
   "text": "I tried again. I sank again."
  },
  {
   "id": "3.again2",
   "start": 40.0,
   "end": 41.1,
   "text": "Again, and again."
  },
  {
   "id": "3.up",
   "start": 41.1,
   "end": 42.1667,
   "text": "Then I stayed on top."
  },
  {
   "id": "3.cross",
   "start": 42.1667,
   "end": 43.5667,
   "text": "I swam all the way across."
  },
  {
   "id": "3.stop",
   "start": 43.5667,
   "end": 45.3667,
   "text": "But the moment I stopped, I went down."
  },
  {
   "id": "3.coin",
   "start": 45.3667,
   "end": 46.5667,
   "text": "Straight down, like a coin."
  },
  {
   "id": "4.bottom",
   "start": 46.5667,
   "end": 48.1333,
   "text": "I hit the bottom and looked up."
  },
  {
   "id": "4.bubble",
   "start": 48.1333,
   "end": 49.6667,
   "text": "The top looked a long way away."
  },
  {
   "id": "4.shoes",
   "start": 49.6667,
   "end": 51.3,
   "text": "My friend jumped in with his shoes on."
  },
  {
   "id": "4.pull",
   "start": 51.3,
   "end": 52.7333,
   "text": "He pulled me out by my shirt."
  },
  {
   "id": "4.taste",
   "start": 52.7333,
   "end": 54.1,
   "text": "I could still taste the water."
  },
  {
   "id": "4.tiles",
   "start": 54.1,
   "end": 55.7333,
   "text": "I lay on the tiles and didn't move."
  },
  {
   "id": "4.tired",
   "start": 55.7333,
   "end": 56.6333,
   "text": "I was so tired."
  },
  {
   "id": "5.home",
   "start": 56.6333,
   "end": 58.0667,
   "text": "It was dark when I walked home."
  },
  {
   "id": "5.call",
   "start": 58.0667,
   "end": 60.0667,
   "text": "Then somebody called my name from the trees."
  },
  {
   "id": "5.woods",
   "start": 60.0667,
   "end": 61.2667,
   "text": "I went into the woods."
  },
  {
   "id": "5.stranger",
   "start": 61.2667,
   "end": 63.0333,
   "text": "Someone stood there, holding out a ring."
  },
  {
   "id": "5.ask",
   "start": 63.0333,
   "end": 64.4667,
   "text": "I asked him what it was for."
  },
  {
   "id": "5.silent",
   "start": 64.4667,
   "end": 65.6333,
   "text": "He didn't say anything."
  },
  {
   "id": "5.left",
   "start": 65.6333,
   "end": 66.3667,
   "text": "He just left."
  },
  {
   "id": "5.cold",
   "start": 66.3667,
   "end": 68.2667,
   "text": "The ring was cold, and it hummed a little."
  },
  {
   "id": "5.lamp",
   "start": 68.2667,
   "end": 70.2,
   "text": "I put it by my lamp and went to sleep."
  },
  {
   "id": "6.morning",
   "start": 70.2,
   "end": 71.8667,
   "text": "The next morning, I put it on."
  },
  {
   "id": "6.luck",
   "start": 71.8667,
   "end": 72.9333,
   "text": "I wore it for luck."
  },
  {
   "id": "6.alone",
   "start": 72.9333,
   "end": 75.0667,
   "text": "My friend wasn't there today, so I went alone."
  },
  {
   "id": "6.dive",
   "start": 75.0667,
   "end": 76.1667,
   "text": "I dove in and swam."
  },
  {
   "id": "6.bonk",
   "start": 76.1667,
   "end": 77.7667,
   "text": "Then I hit my head on the wall."
  },
  {
   "id": "6.side",
   "start": 77.7667,
   "end": 79.7667,
   "text": "But I was already on the other side."
  },
  {
   "id": "6.back",
   "start": 79.7667,
   "end": 80.5,
   "text": "I swam back."
  },
  {
   "id": "6.bonk2",
   "start": 80.5,
   "end": 82.1,
   "text": "And hit my head on that side too."
  },
  {
   "id": "6.same",
   "start": 82.1,
   "end": 83.5333,
   "text": "I tried again. Same thing."
  },
  {
   "id": "6.dream",
   "start": 83.5333,
   "end": 84.7333,
   "text": "I thought I was dreaming."
  },
  {
   "id": "6.hurt",
   "start": 84.7333,
   "end": 86.5333,
   "text": "But my head hurt too much for a dream."
  },
  {
   "id": "6.looked",
   "start": 86.5333,
   "end": 87.8,
   "text": "Then I looked at the ring."
  },
  {
   "id": "6.buttons",
   "start": 87.8,
   "end": 89.0,
   "text": "There were three little buttons."
  },
  {
   "id": "6.medium",
   "start": 89.0,
   "end": 90.4333,
   "text": "Max speed. Medium. Low."
  },
  {
   "id": "6.scared",
   "start": 90.4333,
   "end": 92.2333,
   "text": "I pressed medium. The pool went short."
  },
  {
   "id": "6.low",
   "start": 92.2333,
   "end": 93.7333,
   "text": "That scared me, so I pressed low."
  },
  {
   "id": "6.fast",
   "start": 93.7333,
   "end": 95.1,
   "text": "I swam, and I was fast."
  },
  {
   "id": "6.how",
   "start": 95.1,
   "end": 96.5333,
   "text": "How does a ring make me swim?"
  },
  {
   "id": "6.shrug",
   "start": 96.5333,
   "end": 97.8,
   "text": "I don't know. It did."
  },
  {
   "id": "7.days",
   "start": 97.8,
   "end": 99.4667,
   "text": "Three days later, I signed my name."
  },
  {
   "id": "7.hands",
   "start": 99.4667,
   "end": 101.0333,
   "text": "My hands were shaking on the pen."
  },
  {
   "id": "7.number",
   "start": 101.0333,
   "end": 102.5,
   "text": "They gave me number sixty-six."
  },
  {
   "id": "7.crowd",
   "start": 102.5,
   "end": 103.7667,
   "text": "The pool was full of people."
  },
  {
   "id": "7.pro",
   "start": 103.7667,
   "end": 105.2333,
   "text": "They all looked like professionals."
  },
  {
   "id": "7.matter",
   "start": 105.2333,
   "end": 107.0,
   "text": "It didn't matter. I had a ring."
  },
  {
   "id": "7.table",
   "start": 107.0,
   "end": 109.0333,
   "text": "The trophy was on a table by the water."
  },
  {
   "id": "7.big",
   "start": 109.0333,
   "end": 110.1333,
   "text": "Then I saw the pool."
  },
  {
   "id": "7.speaker",
   "start": 110.1333,
   "end": 111.0,
   "text": "The speaker crackled."
  },
  {
   "id": "7.three",
   "start": 111.0,
   "end": 111.9,
   "text": "There are three pools."
  },
  {
   "id": "7.smallest",
   "start": 111.9,
   "end": 113.5,
   "text": "This is pool one. The smallest."
  },
  {
   "id": "7.most",
   "start": 113.5,
   "end": 114.7,
   "text": "Most wins takes the trophy."
  },
  {
   "id": "7.what",
   "start": 114.7,
   "end": 116.2667,
   "text": "This pool is way bigger than mine?"
  },
  {
   "id": "7.go",
   "start": 116.2667,
   "end": 117.8,
   "text": "Three. Two. One. Go."
  },
  {
   "id": "8.water",
   "start": 117.8,
   "end": 119.3667,
   "text": "Everybody hit the water."
  },
  {
   "id": "8.tenth",
   "start": 119.3667,
   "end": 120.1,
   "text": "I was tenth."
  },
  {
   "id": "8.eighth",
   "start": 120.1,
   "end": 120.6333,
   "text": "Then eighth."
  },
  {
   "id": "8.seventh",
   "start": 120.6333,
   "end": 121.6667,
   "text": "Then I was seventh."
  },
  {
   "id": "8.fourth",
   "start": 121.6667,
   "end": 122.2333,
   "text": "Then fourth."
  },
  {
   "id": "8.feel",
   "start": 122.2333,
   "end": 123.4333,
   "text": "I could feel it working."
  },
  {
   "id": "8.saw",
   "start": 123.4333,
   "end": 124.6,
   "text": "Then I saw something."
  },
  {
   "id": "8.glint",
   "start": 124.6,
   "end": 126.6,
   "text": "A ring. On the hand in front of me."
  },
  {
   "id": "8.panic",
   "start": 126.6,
   "end": 127.4667,
   "text": "I swam harder."
  },
  {
   "id": "8.third",
   "start": 127.4667,
   "end": 128.0333,
   "text": "Third place."
  },
  {
   "id": "8.second",
   "start": 128.0333,
   "end": 128.7,
   "text": "Second place."
  },
  {
   "id": "8.catch",
   "start": 128.7,
   "end": 129.8,
   "text": "But I couldn't catch him."
  },
  {
   "id": "8.dare",
   "start": 129.8,
   "end": 131.2,
   "text": "I didn't dare change the setting."
  },
  {
   "id": "8.lose",
   "start": 131.2,
   "end": 132.2667,
   "text": "He touched the wall first."
  },
  {
   "id": "8.secondplace",
   "start": 132.2667,
   "end": 133.8,
   "text": "The trophy was one place away."
  },
  {
   "id": "8.tiles",
   "start": 133.8,
   "end": 135.4333,
   "text": "I lay on the white tiles, exhausted."
  },
  {
   "id": "8.hand",
   "start": 135.4333,
   "end": 136.5333,
   "text": "I looked at his hand."
  },
  {
   "id": "8.problem",
   "start": 136.5333,
   "end": 138.0667,
   "text": "This is going to be a problem."
  },
  {
   "id": "8.sub",
   "start": 138.0667,
   "end": 139.8333,
   "text": "Like and subscribe for part two."
  }
