 "cues": [
  {
   "id": "1.what",
   "start": 0.0,
   "end": 2.2667,
   "text": "What if every lie added a Netherite block?"
  },
  {
   "id": "1.weight",
   "start": 2.2667,
   "end": 4.1667,
   "text": "One block made my knees buckle."
  },
  {
   "id": "2.day",
   "start": 4.1667,
   "end": 6.2333,
   "text": "I built a giant lantern with my best friend."
  },
  {
   "id": "2.goal",
   "start": 6.2333,
   "end": 8.2667,
   "text": "We wanted it glowing above the whole parade."
  },
  {
   "id": "3.rule",
   "start": 8.2667,
   "end": 10.8,
   "text": "Every deliberate lie dropped one block in my pack."
  },
  {
   "id": "3.secret",
   "start": 10.8,
   "end": 13.0667,
   "text": "Only I could see them; their weight was real."
  },
  {
   "id": "3.truth",
   "start": 13.0667,
   "end": 14.9,
   "text": "Telling the person I lied to cleared one."
  },
  {
   "id": "3.limit",
   "start": 14.9,
   "end": 16.8667,
   "text": "The blocks never told me what to confess."
  },
  {
   "id": "3.danger",
   "start": 16.8667,
   "end": 18.4667,
   "text": "Too many could make me pass away."
  },
  {
   "id": "4.test",
   "start": 18.4667,
   "end": 20.1,
   "text": "I lied that I'd tested our new switch."
  },
  {
   "id": "4.block",
   "start": 20.1,
   "end": 21.8333,
   "text": "A dark block slammed into my pack."
  },
  {
   "id": "4.told",
   "start": 21.8333,
   "end": 23.6333,
   "text": "I told him, \"I never tested it.\""
  },
  {
   "id": "5.proud",
   "start": 23.6333,
   "end": 25.4,
   "text": "I wanted our lantern to win the blue ribbon."
  },
  {
   "id": "5.friend",
   "start": 25.4,
   "end": 28.1333,
   "text": "My friend grinned. \"If it breaks, we'll fix it together.\""
  },
  {
   "id": "6.accident",
   "start": 28.1333,
   "end": 30.0667,
   "text": "Then I snapped the switch while showing off."
  },
  {
   "id": "6.deny",
   "start": 30.0667,
   "end": 31.7333,
   "text": "\"I didn't touch it,\" I told him."
  },
  {
   "id": "6.weight",
   "start": 31.7333,
   "end": 33.7,
   "text": "Another Netherite block dragged my shoulders down."
  },
  {
   "id": "6.hide",
   "start": 33.7,
   "end": 35.5,
   "text": "I smiled, so he wouldn't ask again."
  },
  {
   "id": "7.fix",
   "start": 35.5,
   "end": 37.1,
   "text": "He asked if I could repair the lantern."
  },
  {
   "id": "7.lie",
   "start": 37.1,
   "end": 39.2667,
   "text": "I said, \"I can fix it by myself.\""
  },
  {
   "id": "7.spare",
   "start": 39.2667,
   "end": 40.8667,
   "text": "Then I swore I had a spare switch."
  },
  {
   "id": "7.blocks",
   "start": 40.8667,
   "end": 42.5,
   "text": "Two more blocks bent my knees."
  },
  {
   "id": "8.red",
   "start": 42.5,
   "end": 44.2667,
   "text": "The broken lantern still flashed red."
  },
  {
   "id": "8.lie",
   "start": 44.2667,
   "end": 46.6,
   "text": "I said, \"It's warming up; just wait.\""
  },
  {
   "id": "8.weight",
   "start": 46.6,
   "end": 48.4667,
   "text": "Another block made every step slower."
  },
  {
   "id": "9.friend",
   "start": 48.4667,
   "end": 50.0333,
   "text": "My friend saw the sweat on my face."
  },
  {
   "id": "9.fine",
   "start": 50.0333,
   "end": 51.2,
   "text": "He asked if I was okay."
  },
  {
   "id": "9.lie",
   "start": 51.2,
   "end": 53.0667,
   "text": "I said, \"I'm fine.\" The fifth block fell."
  },
  {
   "id": "9.breath",
   "start": 53.0667,
   "end": 55.4,
   "text": "My chest tightened; I could hardly breathe."
  },
  {
   "id": "10.storm",
   "start": 55.4,
   "end": 57.2333,
   "text": "Then the storm yanked the lantern sideways."
  },
  {
   "id": "10.rope",
   "start": 57.2333,
   "end": 59.0,
   "text": "My friend caught its rope, alone."
  },
  {
   "id": "10.run",
   "start": 59.0,
   "end": 61.3,
   "text": "I ran toward him, slower with every step."
  },
  {
   "id": "10.down",
   "start": 61.3,
   "end": 62.9333,
   "text": "The blocks pulled me onto my knees."
  },
  {
   "id": "10.danger",
   "start": 62.9333,
   "end": 64.6,
   "text": "One more lie could make me pass away."
  },
  {
   "id": "11.admit",
   "start": 64.6,
   "end": 66.8333,
   "text": "I shouted, \"I broke it. I lied.\""
  },
  {
   "id": "11.spare",
   "start": 66.8333,
   "end": 68.2667,
   "text": "I never had a spare switch."
  },
  {
   "id": "11.vanish",
   "start": 68.2667,
   "end": 70.4,
   "text": "Two blocks vanished; I could breathe again."
  },
  {
   "id": "12.remain",
   "start": 70.4,
   "end": 71.9,
   "text": "Three blocks still pinned me down."
  },
  {
   "id": "12.why",
   "start": 71.9,
   "end": 73.2667,
   "text": "He kept one hand on the rope."
  },
  {
   "id": "12.reach",
   "start": 73.2667,
   "end": 74.5667,
   "text": "His other hand reached for me."
  },
  {
   "id": "12.truth",
   "start": 74.5667,
   "end": 76.2667,
   "text": "I lied; the switch wasn't warming."
  },
  {
   "id": "12.fine",
   "start": 76.2667,
   "end": 77.9,
   "text": "I wasn't fine; I was scared."
  },
  {
   "id": "12.help",
   "start": 77.9,
   "end": 79.9,
   "text": "I couldn't fix it alone. I needed you."
  },
  {
   "id": "13.release",
   "start": 79.9,
   "end": 82.2333,
   "text": "The last three blocks disappeared; he pulled me up."
  },
  {
   "id": "13.repair",
   "start": 82.2333,
   "end": 84.5333,
   "text": "Together, we repaired the switch and steadied the lantern."
  },
  {
   "id": "13.light",
   "start": 84.5333,
   "end": 86.6667,
   "text": "It lit crookedly, but the whole street cheered."
  },
  {
   "id": "14.action",
   "start": 86.6667,
   "end": 88.4333,
   "text": "I left the empty pack beside our lantern."
  },
  {
   "id": "14.sub",
   "start": 88.4333,
   "end": 91.0667,
   "text": "Subscribe. I won't lie about how heavy it was."
  }
 ],
