 "cues": [
  {
   "id": "1.hus",
   "start": 0.0,
   "end": 2.4667,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "1.how",
   "start": 2.4667,
   "end": 5.2667,
   "text": "BRO. HOW?!"
  },
  {
   "id": "2.paper",
   "start": 5.2667,
   "end": 7.7333,
   "text": "One year earlier, I could not cut paper."
  },
  {
   "id": "2.party",
   "start": 7.7333,
   "end": 10.0,
   "text": "In this town, every night was a party."
  },
  {
   "id": "2.door",
   "start": 10.0,
   "end": 12.0667,
   "text": "And every night, my friends knocked on my door."
  },
  {
   "id": "2.friday",
   "start": 12.0667,
   "end": 13.4,
   "text": "DUDE! IT'S FRIDAY!"
  },
  {
   "id": "2.whole",
   "start": 13.4,
   "end": 14.5333,
   "text": "THE WHOLE TOWN IS OVER THERE!"
  },
  {
   "id": "2.who",
   "start": 14.5333,
   "end": 16.0,
   "text": "WHO STAYS HOME ON A FRIDAY?!"
  },
  {
   "id": "2.weird",
   "start": 16.0,
   "end": 18.4,
   "text": "YOU'RE BEING WEIRD AGAIN!"
  },
  {
   "id": "3.tv",
   "start": 18.4,
   "end": 19.5333,
   "text": "I had seen a barber on TV"
  },
  {
   "id": "3.cry",
   "start": 19.5333,
   "end": 21.9667,
   "text": "make a grown man cry with one haircut."
  },
  {
   "id": "3.happy",
   "start": 21.9667,
   "end": 23.2667,
   "text": "Happy tears."
  },
  {
   "id": "3.wanted",
   "start": 23.2667,
   "end": 29.3,
   "text": "I wanted to do that."
  },
  {
   "id": "4.okay",
   "start": 29.3,
   "end": 31.1333,
   "text": "OKAY! OKAY!"
  },
  {
   "id": "4.fixable",
   "start": 31.1333,
   "end": 34.4667,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "4.not",
   "start": 34.4667,
   "end": 35.6333,
   "text": "It was not fixable."
  },
  {
   "id": "4.hat",
   "start": 35.6333,
   "end": 41.4333,
   "text": "Dad wore a hat until spring."
  },
  {
   "id": "5.hus",
   "start": 41.4333,
   "end": 46.1333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "5.while",
   "start": 46.1333,
   "end": 47.6333,
   "text": "While my friends were out dancing,"
  },
  {
   "id": "5.cutting",
   "start": 47.6333,
   "end": 48.9333,
   "text": "I was cutting."
  },
  {
   "id": "5.mops",
   "start": 48.9333,
   "end": 50.4,
   "text": "I went through hundreds of mops,"
  },
  {
   "id": "5.combs",
   "start": 50.4,
   "end": 51.4333,
   "text": "thousands of combs,"
  },
  {
   "id": "5.dog",
   "start": 51.4333,
   "end": 55.4,
   "text": "and one very patient dog."
  },
  {
   "id": "5.fixable",
   "start": 55.4,
   "end": 58.6667,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "5.spring",
   "start": 58.6667,
   "end": 59.7333,
   "text": "Spring came."
  },
  {
   "id": "5.sat",
   "start": 59.7333,
   "end": 62.9667,
   "text": "And Dad sat back down in the chair."
  },
  {
   "id": "6.busiest",
   "start": 62.9667,
   "end": 64.5667,
   "text": "Then the busiest barbershop in town"
  },
  {
   "id": "6.sign",
   "start": 64.5667,
   "end": 66.3333,
   "text": "put a sign in the window."
  },
  {
   "id": "6.saturday",
   "start": 66.3333,
   "end": 67.4333,
   "text": "It was a Saturday."
  },
  {
   "id": "6.line",
   "start": 67.4333,
   "end": 68.7667,
   "text": "The line went around the block."
  },
  {
   "id": "6.beard",
   "start": 68.7667,
   "end": 74.8,
   "text": "One man had grown a beard waiting."
  },
  {
   "id": "6.forty",
   "start": 74.8,
   "end": 78.7,
   "text": "I cut forty heads before lunch."
  },
  {
   "id": "7.help",
   "start": 78.7,
   "end": 80.4333,
   "text": "HELP! THE PARTY STARTS IN AN HOUR,"
  },
  {
   "id": "7.look",
   "start": 80.4333,
   "end": 81.1,
   "text": "AND LOOK AT HIM!"
  },
  {
   "id": "7.please",
   "start": 81.1,
   "end": 83.3667,
   "text": "PLEASE! IS THIS FIXABLE?!"
  },
  {
   "id": "7.wait",
   "start": 83.3667,
   "end": 83.9,
   "text": "WAIT."
  },
  {
   "id": "7.weirdone",
   "start": 83.9,
   "end": 87.2333,
   "text": "IT'S THE WEIRD ONE!"
  },
  {
   "id": "7.bro",
   "start": 87.2333,
   "end": 89.6333,
   "text": "BRO. HOW?!"
  },
  {
   "id": "7.training",
   "start": 89.6333,
   "end": 91.4333,
   "text": "Training."
  },
  {
   "id": "7.hus",
   "start": 91.4333,
   "end": 94.0333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "7.coming",
   "start": 94.0333,
   "end": 95.8333,
   "text": "YOU COMING?!"
  },
  {
   "id": "7.never",
   "start": 95.8333,
   "end": 97.9333,
   "text": "I still have not been to a party."
  },
  {
   "id": "7.end",
   "start": 97.9333,
   "end": 99.2,
   "text": "HUS HUS HUS!"
  }
 ],
