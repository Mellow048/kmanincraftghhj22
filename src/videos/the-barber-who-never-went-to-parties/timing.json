 "cues": [
  {
   "id": "1.hus",
   "start": 0.0,
   "end": 1.9,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "1.how",
   "start": 1.9,
   "end": 4.7,
   "text": "BRO. HOW?!"
  },
  {
   "id": "2.paper",
   "start": 4.7,
   "end": 7.1333,
   "text": "One year earlier, I could not cut paper."
  },
  {
   "id": "2.party",
   "start": 7.1333,
   "end": 9.4333,
   "text": "In this town, every night was a party."
  },
  {
   "id": "2.door",
   "start": 9.4333,
   "end": 11.5,
   "text": "And every night, my friends knocked on my door."
  },
  {
   "id": "2.friday",
   "start": 11.5,
   "end": 12.8333,
   "text": "DUDE! IT'S FRIDAY!"
  },
  {
   "id": "2.whole",
   "start": 12.8333,
   "end": 13.9667,
   "text": "THE WHOLE TOWN IS OVER THERE!"
  },
  {
   "id": "2.who",
   "start": 13.9667,
   "end": 15.4333,
   "text": "WHO STAYS HOME ON A FRIDAY?!"
  },
  {
   "id": "2.weird",
   "start": 15.4333,
   "end": 17.8,
   "text": "YOU'RE BEING WEIRD AGAIN!"
  },
  {
   "id": "3.tv",
   "start": 17.8,
   "end": 18.9667,
   "text": "I had seen a barber on TV"
  },
  {
   "id": "3.cry",
   "start": 18.9667,
   "end": 21.3667,
   "text": "make a grown man cry with one haircut."
  },
  {
   "id": "3.happy",
   "start": 21.3667,
   "end": 22.7,
   "text": "Happy tears."
  },
  {
   "id": "3.wanted",
   "start": 22.7,
   "end": 28.7333,
   "text": "I wanted to do that."
  },
  {
   "id": "4.okay",
   "start": 28.7333,
   "end": 30.5667,
   "text": "OKAY! OKAY!"
  },
  {
   "id": "4.fixable",
   "start": 30.5667,
   "end": 33.9,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "4.not",
   "start": 33.9,
   "end": 35.0667,
   "text": "It was not fixable."
  },
  {
   "id": "4.hat",
   "start": 35.0667,
   "end": 40.8667,
   "text": "Dad wore a hat until spring."
  },
  {
   "id": "5.hus",
   "start": 40.8667,
   "end": 44.8667,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "5.while",
   "start": 44.8667,
   "end": 46.3667,
   "text": "While my friends were out dancing,"
  },
  {
   "id": "5.cutting",
   "start": 46.3667,
   "end": 47.6667,
   "text": "I was cutting."
  },
  {
   "id": "5.mops",
   "start": 47.6667,
   "end": 49.1,
   "text": "I went through hundreds of mops,"
  },
  {
   "id": "5.combs",
   "start": 49.1,
   "end": 50.1333,
   "text": "thousands of combs,"
  },
  {
   "id": "5.dog",
   "start": 50.1333,
   "end": 54.1333,
   "text": "and one very patient dog."
  },
  {
   "id": "5.fixable",
   "start": 54.1333,
   "end": 57.4,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "5.spring",
   "start": 57.4,
   "end": 58.4667,
   "text": "Spring came."
  },
  {
   "id": "5.sat",
   "start": 58.4667,
   "end": 61.7,
   "text": "And Dad sat back down in the chair."
  },
  {
   "id": "6.busiest",
   "start": 61.7,
   "end": 63.3,
   "text": "Then the busiest barbershop in town"
  },
  {
   "id": "6.sign",
   "start": 63.3,
   "end": 65.0667,
   "text": "put a sign in the window."
  },
  {
   "id": "6.saturday",
   "start": 65.0667,
   "end": 66.1333,
   "text": "It was a Saturday."
  },
  {
   "id": "6.line",
   "start": 66.1333,
   "end": 67.5,
   "text": "The line went around the block."
  },
  {
   "id": "6.beard",
   "start": 67.5,
   "end": 73.5333,
   "text": "One man had grown a beard waiting."
  },
  {
   "id": "6.forty",
   "start": 73.5333,
   "end": 77.4,
   "text": "I cut forty heads before lunch."
  },
  {
   "id": "7.help",
   "start": 77.4,
   "end": 79.1667,
   "text": "HELP! THE PARTY STARTS IN AN HOUR,"
  },
  {
   "id": "7.look",
   "start": 79.1667,
   "end": 79.8,
   "text": "AND LOOK AT HIM!"
  },
  {
   "id": "7.please",
   "start": 79.8,
   "end": 82.1,
   "text": "PLEASE! IS THIS FIXABLE?!"
  },
  {
   "id": "7.wait",
   "start": 82.1,
   "end": 82.6,
   "text": "WAIT."
  },
  {
   "id": "7.weirdone",
   "start": 82.6,
   "end": 85.9667,
   "text": "IT'S THE WEIRD ONE!"
  },
  {
   "id": "7.bro",
   "start": 85.9667,
   "end": 88.3333,
   "text": "BRO. HOW?!"
  },
  {
   "id": "7.training",
   "start": 88.3333,
   "end": 90.1667,
   "text": "Training."
  },
  {
   "id": "7.hus",
   "start": 90.1667,
   "end": 92.2,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "7.coming",
   "start": 92.2,
   "end": 94.0,
   "text": "YOU COMING?!"
  },
  {
   "id": "7.never",
   "start": 94.0,
   "end": 96.1,
   "text": "I still have not been to a party."
  },
  {
   "id": "7.end",
   "start": 96.1,
   "end": 97.0667,
   "text": "HUS HUS HUS!"
  }
 ],
