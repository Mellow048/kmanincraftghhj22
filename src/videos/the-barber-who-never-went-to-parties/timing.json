 "cues": [
  {
   "id": "1.hus",
   "start": 0.0,
   "end": 1.7333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "1.how",
   "start": 1.7333,
   "end": 3.9,
   "text": "BRO. HOW?!"
  },
  {
   "id": "2.paper",
   "start": 3.9,
   "end": 6.1,
   "text": "One year earlier, I could not cut paper."
  },
  {
   "id": "2.party",
   "start": 6.1,
   "end": 8.2,
   "text": "In this town, every night was a party."
  },
  {
   "id": "2.door",
   "start": 8.2,
   "end": 10.0333,
   "text": "And every night, my friends knocked on my door."
  },
  {
   "id": "2.friday",
   "start": 10.0333,
   "end": 11.2333,
   "text": "DUDE! IT'S FRIDAY!"
  },
  {
   "id": "2.whole",
   "start": 11.2333,
   "end": 12.3,
   "text": "THE WHOLE TOWN IS OVER THERE!"
  },
  {
   "id": "2.who",
   "start": 12.3,
   "end": 13.6333,
   "text": "WHO STAYS HOME ON A FRIDAY?!"
  },
  {
   "id": "2.weird",
   "start": 13.6333,
   "end": 15.3333,
   "text": "YOU'RE BEING WEIRD AGAIN!"
  },
  {
   "id": "3.tv",
   "start": 15.3333,
   "end": 16.3667,
   "text": "I had seen a barber on TV"
  },
  {
   "id": "3.cry",
   "start": 16.3667,
   "end": 18.5667,
   "text": "make a grown man cry with one haircut."
  },
  {
   "id": "3.happy",
   "start": 18.5667,
   "end": 19.7667,
   "text": "Happy tears."
  },
  {
   "id": "3.wanted",
   "start": 19.7667,
   "end": 22.4,
   "text": "I wanted to do that."
  },
  {
   "id": "3.hus",
   "start": 22.4,
   "end": 23.6333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "4.okay",
   "start": 23.6333,
   "end": 25.3,
   "text": "OKAY! OKAY!"
  },
  {
   "id": "4.fixable",
   "start": 25.3,
   "end": 27.1667,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "4.not",
   "start": 27.1667,
   "end": 28.2,
   "text": "It was not fixable."
  },
  {
   "id": "4.hat",
   "start": 28.2,
   "end": 30.6667,
   "text": "Dad wore a hat until spring."
  },
  {
   "id": "5.hus",
   "start": 30.6667,
   "end": 32.9333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "5.while",
   "start": 32.9333,
   "end": 34.3,
   "text": "While my friends were out dancing,"
  },
  {
   "id": "5.cutting",
   "start": 34.3,
   "end": 35.2333,
   "text": "I was cutting."
  },
  {
   "id": "5.mops",
   "start": 35.2333,
   "end": 36.5333,
   "text": "I went through hundreds of mops,"
  },
  {
   "id": "5.combs",
   "start": 36.5333,
   "end": 37.4667,
   "text": "thousands of combs,"
  },
  {
   "id": "5.dog",
   "start": 37.4667,
   "end": 39.1667,
   "text": "and one very patient dog."
  },
  {
   "id": "5.m1",
   "start": 39.1667,
   "end": 39.8,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m2",
   "start": 39.8,
   "end": 40.4333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m3",
   "start": 40.4333,
   "end": 41.0333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m4",
   "start": 41.0333,
   "end": 41.6333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m5",
   "start": 41.6333,
   "end": 42.6333,
   "text": "HUS HUS HUS HUS HUS HUS!"
  },
  {
   "id": "5.m6",
   "start": 42.6333,
   "end": 43.7667,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.fixable",
   "start": 43.7667,
   "end": 45.5,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "5.spring",
   "start": 45.5,
   "end": 46.4667,
   "text": "Spring came."
  },
  {
   "id": "5.sat",
   "start": 46.4667,
   "end": 48.5,
   "text": "And Dad sat back down in the chair."
  },
  {
   "id": "5.dadhus",
   "start": 48.5,
   "end": 49.7333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "6.busiest",
   "start": 49.7333,
   "end": 51.2,
   "text": "Then the busiest barbershop in town"
  },
  {
   "id": "6.sign",
   "start": 51.2,
   "end": 52.6667,
   "text": "put a sign in the window."
  },
  {
   "id": "6.saturday",
   "start": 52.6667,
   "end": 53.6333,
   "text": "It was a Saturday."
  },
  {
   "id": "6.line",
   "start": 53.6333,
   "end": 54.8667,
   "text": "The line went around the block."
  },
  {
   "id": "6.beard",
   "start": 54.8667,
   "end": 57.4667,
   "text": "One man had grown a beard waiting."
  },
  {
   "id": "6.hus",
   "start": 57.4667,
   "end": 59.7667,
   "text": "HUS HUS HUS! HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "6.forty",
   "start": 59.7667,
   "end": 62.2333,
   "text": "I cut forty heads before lunch."
  },
  {
   "id": "7.help",
   "start": 62.2333,
   "end": 63.7667,
   "text": "HELP! THE PARTY STARTS IN AN HOUR,"
  },
  {
   "id": "7.look",
   "start": 63.7667,
   "end": 64.4333,
   "text": "AND LOOK AT HIM!"
  },
  {
   "id": "7.please",
   "start": 64.4333,
   "end": 66.2667,
   "text": "PLEASE! IS THIS FIXABLE?!"
  },
  {
   "id": "7.wait",
   "start": 66.2667,
   "end": 66.7333,
   "text": "WAIT."
  },
  {
   "id": "7.weirdone",
   "start": 66.7333,
   "end": 68.0,
   "text": "IT'S THE WEIRD ONE!"
  },
  {
   "id": "7.hus1",
   "start": 68.0,
   "end": 69.7333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "7.bro",
   "start": 69.7333,
   "end": 71.5333,
   "text": "BRO. HOW?!"
  },
  {
   "id": "7.training",
   "start": 71.5333,
   "end": 72.8333,
   "text": "Training."
  },
  {
   "id": "7.hus",
   "start": 72.8333,
   "end": 74.4667,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "7.coming",
   "start": 74.4667,
   "end": 75.4,
   "text": "YOU COMING?!"
  },
  {
   "id": "7.no",
   "start": 75.4,
   "end": 77.1,
   "text": "No."
  },
  {
   "id": "7.end",
   "start": 77.1,
   "end": 79.6333,
   "text": "HUS HUS HUS HUS HUS HUS!"
  }
 ],
