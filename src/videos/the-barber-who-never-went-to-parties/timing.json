 "cues": [
  {
   "id": "1.hus",
   "start": 0.0,
   "end": 1.7333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "1.how",
   "start": 1.7333,
   "end": 4.2,
   "text": "BRO. HOW?!"
  },
  {
   "id": "2.paper",
   "start": 4.2,
   "end": 6.4,
   "text": "One year earlier, I could not cut paper."
  },
  {
   "id": "2.party",
   "start": 6.4,
   "end": 8.5,
   "text": "In this town, every night was a party."
  },
  {
   "id": "2.door",
   "start": 8.5,
   "end": 10.3333,
   "text": "And every night, my friends knocked on my door."
  },
  {
   "id": "2.friday",
   "start": 10.3333,
   "end": 11.5333,
   "text": "DUDE! IT'S FRIDAY!"
  },
  {
   "id": "2.whole",
   "start": 11.5333,
   "end": 12.6,
   "text": "THE WHOLE TOWN IS OVER THERE!"
  },
  {
   "id": "2.who",
   "start": 12.6,
   "end": 13.9333,
   "text": "WHO STAYS HOME ON A FRIDAY?!"
  },
  {
   "id": "2.weird",
   "start": 13.9333,
   "end": 15.9333,
   "text": "YOU'RE BEING WEIRD AGAIN!"
  },
  {
   "id": "3.tv",
   "start": 15.9333,
   "end": 16.9667,
   "text": "I had seen a barber on TV"
  },
  {
   "id": "3.cry",
   "start": 16.9667,
   "end": 19.1667,
   "text": "make a grown man cry with one haircut."
  },
  {
   "id": "3.happy",
   "start": 19.1667,
   "end": 20.3667,
   "text": "Happy tears."
  },
  {
   "id": "3.wanted",
   "start": 20.3667,
   "end": 23.8,
   "text": "I wanted to do that."
  },
  {
   "id": "3.hus",
   "start": 23.8,
   "end": 25.0333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "4.okay",
   "start": 25.0333,
   "end": 26.7,
   "text": "OKAY! OKAY!"
  },
  {
   "id": "4.fixable",
   "start": 26.7,
   "end": 29.0667,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "4.not",
   "start": 29.0667,
   "end": 30.1,
   "text": "It was not fixable."
  },
  {
   "id": "4.hat",
   "start": 30.1,
   "end": 33.1333,
   "text": "Dad wore a hat until spring."
  },
  {
   "id": "5.hus",
   "start": 33.1333,
   "end": 35.7333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "5.while",
   "start": 35.7333,
   "end": 37.1,
   "text": "While my friends were out dancing,"
  },
  {
   "id": "5.cutting",
   "start": 37.1,
   "end": 38.0333,
   "text": "I was cutting."
  },
  {
   "id": "5.mops",
   "start": 38.0333,
   "end": 39.3333,
   "text": "I went through hundreds of mops,"
  },
  {
   "id": "5.combs",
   "start": 39.3333,
   "end": 40.2667,
   "text": "thousands of combs,"
  },
  {
   "id": "5.dog",
   "start": 40.2667,
   "end": 41.9667,
   "text": "and one very patient dog."
  },
  {
   "id": "5.m1",
   "start": 41.9667,
   "end": 42.6,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m2",
   "start": 42.6,
   "end": 43.2333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m3",
   "start": 43.2333,
   "end": 43.8333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m4",
   "start": 43.8333,
   "end": 44.4333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.m5",
   "start": 44.4333,
   "end": 45.4333,
   "text": "HUS HUS HUS HUS HUS HUS!"
  },
  {
   "id": "5.m6",
   "start": 45.4333,
   "end": 46.5667,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.fixable",
   "start": 46.5667,
   "end": 48.6667,
   "text": "THAT'S FIXABLE!"
  },
  {
   "id": "5.spring",
   "start": 48.6667,
   "end": 49.6333,
   "text": "Spring came."
  },
  {
   "id": "5.sat",
   "start": 49.6333,
   "end": 51.6333,
   "text": "And Dad sat back down in the chair."
  },
  {
   "id": "5.dadhus",
   "start": 51.6333,
   "end": 52.9,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "6.busiest",
   "start": 52.9,
   "end": 54.3333,
   "text": "Then the busiest barbershop in town"
  },
  {
   "id": "6.sign",
   "start": 54.3333,
   "end": 55.8,
   "text": "put a sign in the window."
  },
  {
   "id": "6.saturday",
   "start": 55.8,
   "end": 56.8,
   "text": "It was a Saturday."
  },
  {
   "id": "6.line",
   "start": 56.8,
   "end": 58.0,
   "text": "The line went around the block."
  },
  {
   "id": "6.beard",
   "start": 58.0,
   "end": 60.9333,
   "text": "One man had grown a beard waiting."
  },
  {
   "id": "6.hus",
   "start": 60.9333,
   "end": 63.2,
   "text": "HUS HUS HUS! HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "6.forty",
   "start": 63.2,
   "end": 66.4667,
   "text": "I cut forty heads before lunch."
  },
  {
   "id": "7.help",
   "start": 66.4667,
   "end": 68.0333,
   "text": "HELP! THE PARTY STARTS IN AN HOUR,"
  },
  {
   "id": "7.look",
   "start": 68.0333,
   "end": 68.6333,
   "text": "AND LOOK AT HIM!"
  },
  {
   "id": "7.please",
   "start": 68.6333,
   "end": 70.6333,
   "text": "PLEASE! IS THIS FIXABLE?!"
  },
  {
   "id": "7.wait",
   "start": 70.6333,
   "end": 71.1,
   "text": "WAIT."
  },
  {
   "id": "7.weirdone",
   "start": 71.1,
   "end": 72.4667,
   "text": "IT'S THE WEIRD ONE!"
  },
  {
   "id": "7.hus1",
   "start": 72.4667,
   "end": 74.3333,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "7.bro",
   "start": 74.3333,
   "end": 76.2667,
   "text": "BRO. HOW?!"
  },
  {
   "id": "7.training",
   "start": 76.2667,
   "end": 77.7333,
   "text": "Training."
  },
  {
   "id": "7.hus",
   "start": 77.7333,
   "end": 79.4667,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "7.coming",
   "start": 79.4667,
   "end": 80.4,
   "text": "YOU COMING?!"
  },
  {
   "id": "7.no",
   "start": 80.4,
   "end": 82.8,
   "text": "No."
  },
  {
   "id": "7.end",
   "start": 82.8,
   "end": 85.3333,
   "text": "HUS HUS HUS HUS HUS HUS!"
  }
 ],
