 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.7667,
   "text": "Taxes explained using Minecraft."
  },
  {
   "id": "1.ten",
   "start": 1.7667,
   "end": 4.0667,
   "text": "Leo mines ten shiny diamonds every single day."
  },
  {
   "id": "1.keep",
   "start": 4.0667,
   "end": 6.4,
   "text": "No rules, no king, so Leo keeps all ten."
  },
  {
   "id": "1.dark",
   "start": 6.4,
   "end": 9.6,
   "text": "Sounds awesome, right? Except spawn has zero torches."
  },
  {
   "id": "1.roads",
   "start": 9.6,
   "end": 12.3333,
   "text": "Zero roads, zero walls, just pitch dark grass."
  },
  {
   "id": "2.night",
   "start": 12.3333,
   "end": 14.5,
   "text": "Then night hits, and three green creepers sneak up."
  },
  {
   "id": "2.boom",
   "start": 14.5,
   "end": 17.5667,
   "text": "Boom! Leo's roof explodes and five diamonds vanish."
  },
  {
   "id": "2.again",
   "start": 17.5667,
   "end": 19.8667,
   "text": "The next night, creepers blast his friend's house too."
  },
  {
   "id": "2.broke",
   "start": 19.8667,
   "end": 22.0667,
   "text": "Nobody can afford a giant wall all by themselves."
  },
  {
   "id": "3.meet",
   "start": 22.0667,
   "end": 24.0,
   "text": "So the whole server meets in the square."
  },
  {
   "id": "3.rule",
   "start": 24.0,
   "end": 25.9667,
   "text": "They make one simple deal for every player."
  },
  {
   "id": "3.two",
   "start": 25.9667,
   "end": 28.1667,
   "text": "Out of ten diamonds, put two in the town chest."
  },
  {
   "id": "3.twenty",
   "start": 28.1667,
   "end": 30.3,
   "text": "That two out of ten is a twenty percent tax."
  },
  {
   "id": "3.groan",
   "start": 30.3,
   "end": 32.4333,
   "text": "Leo groans, watching two diamonds leave his hand."
  },
  {
   "id": "4.mods",
   "start": 32.4333,
   "end": 34.5667,
   "text": "Next morning, the mods open that town chest."
  },
  {
   "id": "4.wall",
   "start": 34.5667,
   "end": 36.5667,
   "text": "They pay builders to raise a huge stone wall."
  },
  {
   "id": "4.torch",
   "start": 36.5667,
   "end": 38.7333,
   "text": "They line every dirt path with bright warm torches."
  },
  {
   "id": "4.road",
   "start": 38.7333,
   "end": 40.8,
   "text": "They pave clean stone roads right to every door."
  },
  {
   "id": "4.safe",
   "start": 40.8,
   "end": 43.0,
   "text": "That night, creepers slam the wall and bounce off."
  },
  {
   "id": "4.math",
   "start": 43.0,
   "end": 45.2667,
   "text": "Leo only keeps eight diamonds instead of ten now."
  },
  {
   "id": "4.win",
   "start": 45.2667,
   "end": 47.8667,
   "text": "Wait—eight safe diamonds beats five after a creeper!"
  },
  {
   "id": "5.but",
   "start": 47.8667,
   "end": 50.6,
   "text": "That's when taxes work. Now watch when they break."
  },
  {
   "id": "5.greedy",
   "start": 50.6,
   "end": 52.7667,
   "text": "A new mod takes over the town chest next month."
  },
  {
   "id": "5.six",
   "start": 52.7667,
   "end": 54.9333,
   "text": "He raises the tax from two diamonds to six."
  },
  {
   "id": "5.wait",
   "start": 54.9333,
   "end": 57.1,
   "text": "Everyone waits for better walls and brighter streets."
  },
  {
   "id": "5.statue",
   "start": 57.1,
   "end": 59.5333,
   "text": "Instead, he builds a giant gold statue of himself!"
  },
  {
   "id": "5.dark2",
   "start": 59.5333,
   "end": 61.6333,
   "text": "The torches go dark, and creepers sneak back in."
  },
  {
   "id": "6.real",
   "start": 61.6333,
   "end": 63.8,
   "text": "In the real world, the town chest is government."
  },
  {
   "id": "6.good",
   "start": 63.8,
   "end": 66.2667,
   "text": "Good taxes pay for roads, schools, and clean water."
  },
  {
   "id": "6.bad",
   "start": 66.2667,
   "end": 68.5333,
   "text": "Bad taxes just make the people in charge richer."
  },
  {
   "id": "6.same",
   "start": 68.5333,
   "end": 71.3667,
   "text": "Same diamonds, same players—totally different results."
  },
  {
   "id": "7.ask",
   "start": 71.3667,
   "end": 73.2667,
   "text": "So which server would you rather play on?"
  },
  {
   "id": "7.free",
   "start": 73.2667,
   "end": 75.4667,
   "text": "Zero taxes with creepers blowing up your house?"
  },
  {
   "id": "7.pay",
   "start": 75.4667,
   "end": 77.3667,
   "text": "Or two diamonds a day for safe walls?"
  },
  {
   "id": "7.loop",
   "start": 77.3667,
   "end": 78.3667,
   "text": "And that's—"
  }
 ],
