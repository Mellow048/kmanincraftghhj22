 "cues": [
  {
   "id": "1.job",
   "start": 0.0,
   "end": 2.3333,
   "text": "In this town, being scared is my job."
  },
  {
   "id": "1.zombie",
   "start": 2.3333,
   "end": 4.0,
   "text": "There is a zombie outside my window."
  },
  {
   "id": "1.years",
   "start": 4.0,
   "end": 5.4667,
   "text": "He has been there for two years."
  },
  {
   "id": "1.kevin",
   "start": 5.4667,
   "end": 6.5333,
   "text": "His name is Kevin."
  },
  {
   "id": "1.tag",
   "start": 6.5333,
   "end": 7.9667,
   "text": "It says so on his tag."
  },
  {
   "id": "1.scream",
   "start": 7.9667,
   "end": 10.6,
   "text": "Every morning, I look at Kevin, and I scream."
  },
  {
   "id": "1.lunch",
   "start": 10.6,
   "end": 11.6,
   "text": "Then I have lunch."
  },
  {
   "id": "2.town",
   "start": 11.6,
   "end": 13.7333,
   "text": "Our town is three glass rooms in the sky."
  },
  {
   "id": "2.gary",
   "start": 13.7333,
   "end": 15.8667,
   "text": "This is Gary. Gary screams in his sleep."
  },
  {
   "id": "2.barb",
   "start": 15.8667,
   "end": 17.6,
   "text": "This is Barb. Barb counts."
  },
  {
   "id": "2.pop",
   "start": 17.6,
   "end": 20.0,
   "text": "When we are scared enough, an iron man pops out of the air."
  },
  {
   "id": "2.step",
   "start": 20.0,
   "end": 20.9,
   "text": "He takes one step."
  },
  {
   "id": "2.water",
   "start": 20.9,
   "end": 22.2333,
   "text": "Then the water takes him away."
  },
  {
   "id": "2.talk",
   "start": 22.2333,
   "end": 24.0333,
   "text": "We do not talk about where the iron men go."
  },
  {
   "id": "2.nice",
   "start": 24.0333,
   "end": 26.2333,
   "text": "Clearly, it is somewhere nice."
  },
  {
   "id": "2.chest",
   "start": 26.2333,
   "end": 29.8333,
   "text": "Under the floor, there is a chest. Iron falls into it. And flowers."
  },
  {
   "id": "2.pay",
   "start": 29.8333,
   "end": 31.5667,
   "text": "Clearly, the flowers are our pay."
  },
  {
   "id": "2.boss",
   "start": 31.5667,
   "end": 35.2,
   "text": "Once a week, the boss comes. He takes the iron. He has never looked up."
  },
  {
   "id": "3.problem",
   "start": 35.2,
   "end": 36.0,
   "text": "Here is the problem."
  },
  {
   "id": "3.long",
   "start": 36.0,
   "end": 37.8,
   "text": "Two years is a long time to look at one face."
  },
  {
   "id": "3.wave",
   "start": 37.8,
   "end": 39.1333,
   "text": "One morning, Kevin waved."
  },
  {
   "id": "3.back",
   "start": 39.1333,
   "end": 40.1333,
   "text": "I waved back."
  },
  {
   "id": "3.game",
   "start": 40.1333,
   "end": 41.7667,
   "text": "Now we play tic tac toe on the glass."
  },
  {
   "id": "3.lost",
   "start": 41.7667,
   "end": 43.7,
   "text": "Kevin has never won. He does not mind."
  },
  {
   "id": "3.urr",
   "start": 43.7,
   "end": 45.9,
   "text": "He says, \"urr\". I think it means good morning."
  },
  {
   "id": "3.nothing",
   "start": 45.9,
   "end": 49.9333,
   "text": "So now I look at Kevin, and I open my mouth, and nothing comes out."
  },
  {
   "id": "3.noiron",
   "start": 49.9333,
   "end": 52.9,
   "text": "No scream. No iron man. No iron."
  },
  {
   "id": "3.gary",
   "start": 52.9,
   "end": 55.8667,
   "text": "Gary screamed for both of us. Then Gary lost his voice."
  },
  {
   "id": "3.barb",
   "start": 55.8667,
   "end": 57.3,
   "text": "Barb stopped counting."
  },
  {
   "id": "4.empty",
   "start": 57.3,
   "end": 59.4667,
   "text": "The boss opened the chest. It was empty."
  },
  {
   "id": "4.up",
   "start": 59.4667,
   "end": 61.2333,
   "text": "And for the first time, he looked up."
  },
  {
   "id": "4.atme",
   "start": 61.2333,
   "end": 63.1,
   "text": "He looked at me. He looked at Kevin."
  },
  {
   "id": "4.left",
   "start": 63.1,
   "end": 65.2,
   "text": "Then he left. I thought that was that."
  },
  {
   "id": "4.rope",
   "start": 65.2,
   "end": 67.3,
   "text": "He came back with a new zombie on a rope."
  },
  {
   "id": "4.new",
   "start": 67.3,
   "end": 70.1,
   "text": "The new one had no tag. He did not wave."
  },
  {
   "id": "4.bucket",
   "start": 70.1,
   "end": 71.8333,
   "text": "And for Kevin, he had a bucket."
  },
  {
   "id": "4.fire",
   "start": 71.8333,
   "end": 73.3667,
   "text": "There was no water in the bucket."
  },
  {
   "id": "5.tried",
   "start": 73.3667,
   "end": 76.1,
   "text": "I tried to scream. To show him Kevin still worked."
  },
  {
   "id": "5.hello",
   "start": 76.1,
   "end": 77.5,
   "text": "It came out as, \"hello\"."
  },
  {
   "id": "5.eep",
   "start": 77.5,
   "end": 79.2333,
   "text": "Gary tried. Gary went, \"eep\"."
  },
  {
   "id": "5.lift",
   "start": 79.2333,
   "end": 80.3333,
   "text": "The boss lifted the bucket."
  },
  {
   "id": "5.kevin",
   "start": 80.3333,
   "end": 82.6,
   "text": "Kevin looked at me, and said, \"urr\"."
  },
  {
   "id": "5.bye",
   "start": 82.6,
   "end": 84.2333,
   "text": "That one did not mean good morning."
  },
  {
   "id": "6.scared",
   "start": 84.2333,
   "end": 86.7667,
   "text": "And then I was scared. Not of Kevin. For Kevin."
  },
  {
   "id": "6.real",
   "start": 86.7667,
   "end": 90.2667,
   "text": "I have screamed every day for two years. That was the first real one."
  },
  {
   "id": "6.glass",
   "start": 90.2667,
   "end": 91.3,
   "text": "The glass cracked."
  },
  {
   "id": "6.pop",
   "start": 91.3,
   "end": 92.9,
   "text": "An iron man popped out of the air."
  },
  {
   "id": "6.barb",
   "start": 92.9,
   "end": 95.0333,
   "text": "Barb said, \"nine hundred and twelve\"."
  },
  {
   "id": "6.step",
   "start": 95.0333,
   "end": 96.0333,
   "text": "He took one step."
  },
  {
   "id": "6.stop",
   "start": 96.0333,
   "end": 97.9333,
   "text": "And stopped. He did not go in the water."
  },
  {
   "id": "6.kevin",
   "start": 97.9333,
   "end": 100.5333,
   "text": "He looked at Kevin. Iron men do not like zombies."
  },
  {
   "id": "6.said",
   "start": 100.5333,
   "end": 102.9,
   "text": "I hit the glass. I said, \"he is with us\"."
  },
  {
   "id": "6.turn",
   "start": 102.9,
   "end": 105.1667,
   "text": "The iron man looked at me. Then he looked at the boss."
  },
  {
   "id": "6.back",
   "start": 105.1667,
   "end": 106.5667,
   "text": "The boss took one step back."
  },
  {
   "id": "6.nofloor",
   "start": 106.5667,
   "end": 107.5667,
   "text": "There was no floor there."
  },
  {
   "id": "6.long",
   "start": 107.5667,
   "end": 109.8667,
   "text": "It is a long way down. I counted to nine."
  },
  {
   "id": "7.quiet",
   "start": 109.8667,
   "end": 111.0333,
   "text": "Then it was just us."
  },
  {
   "id": "7.broke",
   "start": 111.0333,
   "end": 113.3333,
   "text": "The iron man broke the glass. He let us out."
  },
  {
   "id": "7.legs",
   "start": 113.3333,
   "end": 115.8333,
   "text": "Kevin got out of his boat. His legs had forgotten how."
  },
  {
   "id": "7.follow",
   "start": 115.8333,
   "end": 118.3,
   "text": "I followed the water. I wanted to see the nice place."
  },
  {
   "id": "7.end",
   "start": 118.3,
   "end": 120.1667,
   "text": "At the end of the water, there was fire."
  },
  {
   "id": "7.list",
   "start": 120.1667,
   "end": 122.4333,
   "text": "The chest. The iron. The flowers."
  },
  {
   "id": "7.count",
   "start": 122.4333,
   "end": 124.1,
   "text": "Nine hundred and eleven iron men."
  },
  {
   "id": "7.job",
   "start": 124.1,
   "end": 125.1333,
   "text": "It was never a job."
  },
  {
   "id": "7.parts",
   "start": 125.1333,
   "end": 127.3,
   "text": "We were not the staff. We were the machine."
  },
  {
   "id": "8.gave",
   "start": 127.3,
   "end": 130.6667,
   "text": "The iron man looked at the fire for a long time. Then he gave Barb a flower."
  },
  {
   "id": "8.edge",
   "start": 130.6667,
   "end": 132.7667,
   "text": "We walked to the edge of town, and looked down."
  },
  {
   "id": "8.down",
   "start": 132.7667,
   "end": 134.5333,
   "text": "The ground is two hundred blocks away."
  },
  {
   "id": "8.have",
   "start": 134.5333,
   "end": 138.0667,
   "text": "We have one iron man, one boat, and a zombie called Kevin."
  },
  {
   "id": "8.bed",
   "start": 138.0667,
   "end": 139.9333,
   "text": "And far below, a bed lit up."
  },
  {
   "id": "8.sub",
   "start": 139.9333,
   "end": 143.1,
   "text": "Like and subscribe for part two. The boss is on his way back."
  }
 ],
