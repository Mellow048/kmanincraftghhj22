 "cues": [
  {
   "id": "1.copy",
   "start": 0.0,
   "end": 2.2667,
   "text": "In this town, everybody's shadow copies them."
  },
  {
   "id": "1.own",
   "start": 2.2667,
   "end": 3.7,
   "text": "Mine had a mind of its own."
  },
  {
   "id": "1.brave",
   "start": 3.7,
   "end": 5.2333,
   "text": "It was not scared of anything."
  },
  {
   "id": "1.me",
   "start": 5.2333,
   "end": 6.8,
   "text": "I was scared of everything."
  },
  {
   "id": "2.rule",
   "start": 6.8,
   "end": 8.3667,
   "text": "A shadow belongs under your shoes."
  },
  {
   "id": "2.mine",
   "start": 8.3667,
   "end": 10.2667,
   "text": "Mine went up walls and into rooms without me."
  },
  {
   "id": "2.why",
   "start": 10.2667,
   "end": 12.3,
   "text": "Nobody knew why. Not even the doctor."
  },
  {
   "id": "2.only",
   "start": 12.3,
   "end": 13.8,
   "text": "I was the only one like this."
  },
  {
   "id": "3.class",
   "start": 13.8,
   "end": 16.0667,
   "text": "In class, my shadow stood up and answered the questions."
  },
  {
   "id": "3.mark",
   "start": 16.0667,
   "end": 17.5667,
   "text": "It got a better mark than me."
  },
  {
   "id": "3.hall",
   "start": 17.5667,
   "end": 20.1,
   "text": "In the hallway it walked the wall and waved at the principal."
  },
  {
   "id": "3.lunch",
   "start": 20.1,
   "end": 21.5667,
   "text": "At lunch it took the last pudding."
  },
  {
   "id": "3.cook",
   "start": 21.5667,
   "end": 23.5667,
   "text": "The cook shouted. My shadow blew her a kiss."
  },
  {
   "id": "3.good",
   "start": 23.5667,
   "end": 26.1667,
   "text": "It was a good life. The best part of me was not me."
  },
  {
   "id": "4.one",
   "start": 26.1667,
   "end": 27.5667,
   "text": "But one thing it could not do."
  },
  {
   "id": "4.her",
   "start": 27.5667,
   "end": 28.5,
   "text": "Her. Just her."
  },
  {
   "id": "4.stop",
   "start": 28.5,
   "end": 30.3,
   "text": "I could not say hi. My legs stopped."
  },
  {
   "id": "5.friend",
   "start": 30.3,
   "end": 32.3,
   "text": "My best friend was tired of hearing about her."
  },
  {
   "id": "5.quote",
   "start": 32.3,
   "end": 34.2333,
   "text": "\"You have described her pencil case twice today.\""
  },
  {
   "id": "5.cat",
   "start": 34.2333,
   "end": 35.4667,
   "text": "\"It has a cat on it.\""
  },
  {
   "id": "5.ask",
   "start": 35.4667,
   "end": 36.1,
   "text": "\"Ask her.\""
  },
  {
   "id": "6.prac",
   "start": 36.1,
   "end": 37.6667,
   "text": "So I practised on a bread roll."
  },
  {
   "id": "6.quote",
   "start": 37.6667,
   "end": 38.4333,
   "text": "\"Do you want to—\""
  },
  {
   "id": "6.walk",
   "start": 38.4333,
   "end": 40.8,
   "text": "My shadow stood up and walked to her table without me."
  },
  {
   "id": "6.laugh",
   "start": 40.8,
   "end": 43.6333,
   "text": "She laughed. I was under the table. Being replaced is worse."
  },
  {
   "id": "7.jan",
   "start": 43.6333,
   "end": 45.4667,
   "text": "The old janitor had seen it before."
  },
  {
   "id": "7.why",
   "start": 45.4667,
   "end": 47.3667,
   "text": "\"Why does mine never stay where I put it?\""
  },
  {
   "id": "7.ans",
   "start": 47.3667,
   "end": 49.4333,
   "text": "\"Because you keep letting it do the brave parts.\""
  },
  {
   "id": "7.mop",
   "start": 49.4333,
   "end": 50.4333,
   "text": "Then he walked off."
  },
  {
   "id": "8.night",
   "start": 50.4333,
   "end": 51.8,
   "text": "That night I could not sleep."
  },
  {
   "id": "8.wall",
   "start": 51.8,
   "end": 53.9,
   "text": "My shadow was on the wall, doing push-ups."
  },
  {
   "id": "8.q",
   "start": 53.9,
   "end": 56.4,
   "text": "Whose shadow is it, if it does all the living?"
  },
  {
   "id": "8.dec",
   "start": 56.4,
   "end": 60.5333,
   "text": "Prom was on Friday. So I decided. I would ask her. Me. Not it."
  },
  {
   "id": "9.night",
   "start": 60.5333,
   "end": 62.4,
   "text": "Prom night. Loud music. Shoes too tight."
  },
  {
   "id": "9.mirror",
   "start": 62.4,
   "end": 65.0667,
   "text": "In the mirror I practised. My shadow said it perfectly."
  },
  {
   "id": "9.steps",
   "start": 65.0667,
   "end": 66.5333,
   "text": "I got three steps across the floor."
  },
  {
   "id": "9.plant",
   "start": 66.5333,
   "end": 68.2,
   "text": "Then I was behind a plant, hiding."
  },
  {
   "id": "9.found",
   "start": 68.2,
   "end": 70.6333,
   "text": "My friend found me. \"Three steps. That is a record.\""
  },
  {
   "id": "10.legs",
   "start": 70.6333,
   "end": 72.3667,
   "text": "Then my legs started walking without me."
  },
  {
   "id": "10.push",
   "start": 72.3667,
   "end": 74.1667,
   "text": "My shadow was behind me, pushing."
  },
  {
   "id": "10.her",
   "start": 74.1667,
   "end": 75.8,
   "text": "She was under the lights, waiting."
  },
  {
   "id": "10.mouth",
   "start": 75.8,
   "end": 77.7333,
   "text": "I opened my mouth. Nothing came out."
  },
  {
   "id": "11.hand",
   "start": 77.7333,
   "end": 79.8333,
   "text": "My shadow put out its hand instead of me."
  },
  {
   "id": "11.past",
   "start": 79.8333,
   "end": 81.5333,
   "text": "She looked right past it. At me."
  },
  {
   "id": "11.q",
   "start": 81.5333,
   "end": 83.1333,
   "text": "\"Is your shadow going to ask me?\""
  },
  {
   "id": "11.stop",
   "start": 83.1333,
   "end": 85.3,
   "text": "The music stopped. Even my shadow stopped."
  },
  {
   "id": "12.knees",
   "start": 85.3,
   "end": 87.1667,
   "text": "My knees shook so hard my shoelaces moved."
  },
  {
   "id": "12.breath",
   "start": 87.1667,
   "end": 88.1333,
   "text": "I took one breath."
  },
  {
   "id": "12.ask",
   "start": 88.1333,
   "end": 89.6667,
   "text": "\"Do you want to dance with me?\""
  },
  {
   "id": "12.voice",
   "start": 89.6667,
   "end": 91.4333,
   "text": "My voice. Cracked and quiet and mine."
  },
  {
   "id": "12.still",
   "start": 91.4333,
   "end": 92.5667,
   "text": "My shadow went still."
  },
  {
   "id": "12.floor",
   "start": 92.5667,
   "end": 95.0333,
   "text": "It stepped onto the floor and slid under my shoes."
  },
  {
   "id": "13.yes",
   "start": 95.0333,
   "end": 95.7667,
   "text": "She said yes."
  },
  {
   "id": "13.follow",
   "start": 95.7667,
   "end": 98.3667,
   "text": "Then she took my hand, and my shadow followed on the floor."
  },
  {
   "id": "13.dance",
   "start": 98.3667,
   "end": 100.9667,
   "text": "We danced like a badly drawn puppet. I did not care."
  },
  {
   "id": "13.friend",
   "start": 100.9667,
   "end": 103.6,
   "text": "My friend cried in the corner. She blames the smoke machine."
  },
  {
   "id": "14.real",
   "start": 103.6,
   "end": 105.4333,
   "text": "My shadow never had a mind of its own."
  },
  {
   "id": "14.mine",
   "start": 105.4333,
   "end": 106.2667,
   "text": "It had my mind."
  },
  {
   "id": "14.part",
   "start": 106.2667,
   "end": 108.7333,
   "text": "It was the part of me that was not scared, doing what I wanted."
  },
  {
   "id": "14.now",
   "start": 108.7333,
   "end": 111.3667,
   "text": "She is asleep on my shoulder. My shadow is on the floor."
  },
  {
   "id": "14.together",
   "start": 111.3667,
   "end": 112.7667,
   "text": "Both of us are where we belong."
  },
  {
   "id": "15.like",
   "start": 112.7667,
   "end": 116.1,
   "text": "Like this video if you had to borrow your courage before it became yours."
  }
 ],
