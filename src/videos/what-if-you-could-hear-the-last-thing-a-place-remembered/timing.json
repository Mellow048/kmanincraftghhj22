{
 "film": "what-if-you-could-hear-the-last-thing-a-place-remembered",
 "fps": 30,
 "duration": 96.0667,
 "estimated": true,
 "tempo": 1.0,
 "wordsPerMinute": 255.6,
 "audio": null,
 "clips": [],
 "cues": [
  {
   "id": "1.if",
   "start": 0.0,
   "end": 2.4,
   "text": "What if you could hear the last thing a place remembered?"
  },
  {
   "id": "1.rule",
   "start": 2.4,
   "end": 4.8667,
   "text": "I touch a wall, and I hear the last thing it heard."
  },
  {
   "id": "1.once",
   "start": 4.8667,
   "end": 7.0333,
   "text": "One sentence. Then the wall goes quiet for good."
  },
  {
   "id": "1.found",
   "start": 7.0333,
   "end": 9.1,
   "text": "I found out at the bus stop, at midnight."
  },
  {
   "id": "1.one",
   "start": 9.1,
   "end": 11.4,
   "text": "One sentence came out of the glass. Then nothing."
  },
  {
   "id": "2.bench",
   "start": 11.4,
   "end": 13.0,
   "text": "The bench outside the shop said OW."
  },
  {
   "id": "2.benchb",
   "start": 13.0,
   "end": 15.2667,
   "text": "I looked under it. There was nobody there."
  },
  {
   "id": "2.class",
   "start": 15.2667,
   "end": 17.2,
   "text": "The classroom wall played the teacher's worst joke."
  },
  {
   "id": "2.classb",
   "start": 17.2,
   "end": 19.3667,
   "text": "All of it. Somebody had laughed, once."
  },
  {
   "id": "2.bus",
   "start": 19.3667,
   "end": 21.8333,
   "text": "The bus stop said the same thing it says every day."
  },
  {
   "id": "2.busb",
   "start": 21.8333,
   "end": 24.3667,
   "text": "Somebody had been standing in the rain for a year."
  },
  {
   "id": "2.gym",
   "start": 24.3667,
   "end": 25.9667,
   "text": "The gym wall said nothing at all."
  },
  {
   "id": "2.gymb",
   "start": 25.9667,
   "end": 28.3333,
   "text": "I knocked on it. I thought I had broken it."
  },
  {
   "id": "2.mirror",
   "start": 28.3333,
   "end": 29.9333,
   "text": "The bathroom wall said you look nice."
  },
  {
   "id": "2.mirrorb",
   "start": 29.9333,
   "end": 32.5,
   "text": "That was my mum's voice. She said it when I was six."
  },
  {
   "id": "3.week",
   "start": 32.5,
   "end": 34.9333,
   "text": "For a week I was the best-informed person in town."
  },
  {
   "id": "3.tally",
   "start": 34.9333,
   "end": 36.9333,
   "text": "I kept a list of the best things I heard."
  },
  {
   "id": "3.what",
   "start": 36.9333,
   "end": 39.5667,
   "text": "What people really think, in one sentence, when you walk out."
  },
  {
   "id": "3.dad",
   "start": 39.5667,
   "end": 42.1,
   "text": "My dad said one thing to the kitchen every morning."
  },
  {
   "id": "3.dadb",
   "start": 42.1,
   "end": 45.1,
   "text": "Same words. No one in the room. He said it to the sink."
  },
  {
   "id": "3.sick",
   "start": 45.1,
   "end": 46.6333,
   "text": "I stopped touching things after that."
  },
  {
   "id": "3.hands",
   "start": 46.6333,
   "end": 48.4333,
   "text": "Doorknobs, my own bed, my mum's hand."
  },
  {
   "id": "3.still",
   "start": 48.4333,
   "end": 50.4,
   "text": "You cannot sit still in a house like that."
  },
  {
   "id": "4.one",
   "start": 50.4,
   "end": 52.9,
   "text": "There was one wall I could not get a sentence out of."
  },
  {
   "id": "4.gym",
   "start": 52.9,
   "end": 54.9,
   "text": "The gym wall. Silent from the first day."
  },
  {
   "id": "4.touch",
   "start": 54.9,
   "end": 57.0,
   "text": "I put my hand on it, and heard my name."
  },
  {
   "id": "4.name",
   "start": 57.0,
   "end": 59.7,
   "text": "My name, in my mum's voice, in a room with no windows."
  },
  {
   "id": "4.before",
   "start": 59.7,
   "end": 61.3,
   "text": "She said it before I was born."
  },
  {
   "id": "5.thought",
   "start": 61.3,
   "end": 63.3,
   "text": "I thought walls remembered the important things."
  },
  {
   "id": "5.instead",
   "start": 63.3,
   "end": 65.8,
   "text": "They remember the last thing. That is not the same."
  },
  {
   "id": "6.comeback",
   "start": 65.8,
   "end": 67.7667,
   "text": "I went back to the bench outside the shop."
  },
  {
   "id": "6.gone",
   "start": 67.7667,
   "end": 70.0667,
   "text": "It had nothing left. I had taken the OW."
  },
  {
   "id": "6.list",
   "start": 70.0667,
   "end": 71.9333,
   "text": "Every wall I had touched was silent."
  },
  {
   "id": "6.mine",
   "start": 71.9333,
   "end": 74.4333,
   "text": "And my list had a sentence on it I did not write."
  },
  {
   "id": "7.quiet",
   "start": 74.4333,
   "end": 76.8333,
   "text": "The one wall that never said anything was my own."
  },
  {
   "id": "7.wait",
   "start": 76.8333,
   "end": 79.4333,
   "text": "It was not empty. It was holding something back."
  },
  {
   "id": "8.morning",
   "start": 79.4333,
   "end": 81.7,
   "text": "My mum was in the kitchen on the last morning."
  },
  {
   "id": "8.said",
   "start": 81.7,
   "end": 83.9,
   "text": "She said the thing my dad had said to the sink."
  },
  {
   "id": "8.wall",
   "start": 83.9,
   "end": 85.6667,
   "text": "And I heard the kitchen wall take it."
  },
  {
   "id": "8.why",
   "start": 85.6667,
   "end": 88.0333,
   "text": "My dad said it every day for nineteen years."
  },
  {
   "id": "9.heard",
   "start": 88.0333,
   "end": 90.0333,
   "text": "\"Your turn. Your turn to be listened to.\""
  },
  {
   "id": "9.that",
   "start": 90.0333,
   "end": 93.1,
   "text": "He had been saying it to me. I had never been in the room."
  },
  {
   "id": "10.sub",
   "start": 93.1,
   "end": 96.0667,
   "text": "Subscribe, and I will tell you what the wall did with it."
  }
 ],
