 "cues": [
  {
   "id": "1.dad",
   "start": 0.0,
   "end": 2.1667,
   "text": "In this town, my dad disappears every night."
  },
  {
   "id": "1.trader",
   "start": 2.1667,
   "end": 3.8333,
   "text": "He is a wandering trader in a blue hood."
  },
  {
   "id": "1.llamas",
   "start": 3.8333,
   "end": 6.0333,
   "text": "With two goofy llamas that spit when people laugh."
  },
  {
   "id": "1.bush",
   "start": 6.0333,
   "end": 8.3,
   "text": "His best deal is one dead bush for five emeralds."
  },
  {
   "id": "1.sand",
   "start": 8.3,
   "end": 10.3,
   "text": "And three emeralds for one bucket of sand."
  },
  {
   "id": "1.sunset",
   "start": 10.3,
   "end": 12.3333,
   "text": "Then at sunset, he drinks a glowing blue potion."
  },
  {
   "id": "1.poof",
   "start": 12.3333,
   "end": 14.7333,
   "text": "And poof. He vanishes into thin air."
  },
  {
   "id": "2.rich",
   "start": 14.7333,
   "end": 16.7667,
   "text": "The rich merchants laugh right in his face all day."
  },
  {
   "id": "2.sign",
   "start": 16.7667,
   "end": 18.9667,
   "text": "They hung a sign calling him the worst trader alive."
  },
  {
   "id": "2.school",
   "start": 18.9667,
   "end": 21.2667,
   "text": "Kids at school ask if my dad sold dirt today."
  },
  {
   "id": "2.hood",
   "start": 21.2667,
   "end": 24.0333,
   "text": "So I pull my hood low and walk home fast."
  },
  {
   "id": "2.chair",
   "start": 24.0333,
   "end": 26.5333,
   "text": "Every night at dinner, his chair stays empty."
  },
  {
   "id": "2.shame",
   "start": 26.5333,
   "end": 28.9333,
   "text": "I thought my dad turned invisible out of shame."
  },
  {
   "id": "2.wrong",
   "start": 28.9333,
   "end": 31.3333,
   "text": "I had no idea how wrong I was."
  },
  {
   "id": "3.weird",
   "start": 31.3333,
   "end": 33.6667,
   "text": "Because strange things started happening every morning."
  },
  {
   "id": "3.hole",
   "start": 33.6667,
   "end": 35.6,
   "text": "Old Nora had a big hole in her roof."
  },
  {
   "id": "3.fixed",
   "start": 35.6,
   "end": 38.1667,
   "text": "By dawn, fresh oak planks patched the whole gap."
  },
  {
   "id": "3.baker",
   "start": 38.1667,
   "end": 40.1,
   "text": "The sick baker woke up to ten warm loaves."
  },
  {
   "id": "3.porch",
   "start": 40.1,
   "end": 41.9667,
   "text": "Stacked neat and tidy on his front porch."
  },
  {
   "id": "3.sheep",
   "start": 41.9667,
   "end": 44.0333,
   "text": "A stray sheep found a brand new oak fence."
  },
  {
   "id": "3.guard",
   "start": 44.0333,
   "end": 46.1333,
   "text": "Nobody saw who did it. Not even the guards."
  },
  {
   "id": "3.prints",
   "start": 46.1333,
   "end": 48.7333,
   "text": "Except every time, I found two muddy llama prints."
  },
  {
   "id": "3.wait",
   "start": 48.7333,
   "end": 50.9,
   "text": "Hold on. Only one guy here owns llamas."
  },
  {
   "id": "4.night",
   "start": 50.9,
   "end": 52.8,
   "text": "So that night, I did not sleep."
  },
  {
   "id": "4.milk",
   "start": 52.8,
   "end": 54.4667,
   "text": "I grabbed an iron bucket of fresh milk."
  },
  {
   "id": "4.fact",
   "start": 54.4667,
   "end": 57.1333,
   "text": "In Minecraft, milk cancels any potion right away."
  },
  {
   "id": "4.sneak",
   "start": 57.1333,
   "end": 59.1,
   "text": "I slipped outside into the cold blue street."
  },
  {
   "id": "4.track",
   "start": 59.1,
   "end": 61.0333,
   "text": "Two muddy tracks led down the dark alley."
  },
  {
   "id": "4.torch",
   "start": 61.0333,
   "end": 63.8333,
   "text": "Then I froze. A wooden torch floated in midair."
  },
  {
   "id": "4.hammer",
   "start": 63.8333,
   "end": 66.7667,
   "text": "And an invisible hammer banged planks onto a roof."
  },
  {
   "id": "5.thief",
   "start": 66.7667,
   "end": 68.4,
   "text": "I thought a thief was robbing the carpenter."
  },
  {
   "id": "5.run",
   "start": 68.4,
   "end": 70.2,
   "text": "So I sprinted up and swung my milk bucket."
  },
  {
   "id": "5.splash",
   "start": 70.2,
   "end": 72.3,
   "text": "Splash. White milk hit the floating torch."
  },
  {
   "id": "5.poof",
   "start": 72.3,
   "end": 74.6,
   "text": "Blue sparkles popped, and my dad appeared right there."
  },
  {
   "id": "5.llamas",
   "start": 74.6,
   "end": 77.1667,
   "text": "Behind him stood both llamas, packed with bread and wood."
  },
  {
   "id": "5.drop",
   "start": 77.1667,
   "end": 79.4333,
   "text": "He dropped his hammer. His blue hood dripped milk."
  },
  {
   "id": "5.shh",
   "start": 79.4333,
   "end": 82.2333,
   "text": "\"Keep your voice down,\" he whispered. \"Do not tell.\""
  },
  {
   "id": "6.why",
   "start": 82.2333,
   "end": 83.6,
   "text": "Then he explained the dead bushes."
  },
  {
   "id": "6.merch",
   "start": 83.6,
   "end": 85.5333,
   "text": "The rich merchants crush anyone who gives free help."
  },
  {
   "id": "6.act",
   "start": 85.5333,
   "end": 87.6,
   "text": "So he acted like a terrible trader all day."
  },
  {
   "id": "6.nobody",
   "start": 87.6,
   "end": 89.4333,
   "text": "That way the rich merchants left him alone."
  },
  {
   "id": "6.night",
   "start": 89.4333,
   "end": 91.5333,
   "text": "Then every night he turned invisible and helped the town."
  },
  {
   "id": "6.door",
   "start": 91.5333,
   "end": 93.5,
   "text": "Just then, the baker opened his front door."
  },
  {
   "id": "6.saw",
   "start": 93.5,
   "end": 95.3,
   "text": "He saw my dad. He saw the milk."
  },
  {
   "id": "6.quiet",
   "start": 95.3,
   "end": 96.7,
   "text": "The whole alley went dead quiet."
  },
  {
   "id": "6.stall",
   "start": 96.7,
   "end": 98.9,
   "text": "The next morning, my dad opened his wooden stall."
  },
  {
   "id": "6.line",
   "start": 98.9,
   "end": 101.0333,
   "text": "The entire town lined up down the whole street."
  },
  {
   "id": "6.buy",
   "start": 101.0333,
   "end": 103.4333,
   "text": "Every neighbor gladly paid five emeralds for a dead bush."
  },
  {
   "id": "6.hood",
   "start": 103.4333,
   "end": 105.4667,
   "text": "Now I wear my dad's blue hood to school proudly."
  },
  {
   "id": "6.sub",
   "start": 105.4667,
   "end": 107.6333,
   "text": "Subscribe if you would buy a dead bush from Dad."
  }
 ],
