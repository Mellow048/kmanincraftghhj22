 "clips": [],
 "cues": [
  {
   "id": "1.ask",
   "start": 0.0,
   "end": 1.3,
   "text": "What is a dictator?"
  },
  {
   "id": "2.vote",
   "start": 1.3,
   "end": 4.2333,
   "text": "In your village, the people pick their leader with a vote."
  },
  {
   "id": "2.judge",
   "start": 4.2333,
   "end": 6.8333,
   "text": "If he breaks a rule, a judge can tell him no."
  },
  {
   "id": "2.loud",
   "start": 6.8333,
   "end": 9.8,
   "text": "If he does a bad job, anyone can say so out loud."
  },
  {
   "id": "2.again",
   "start": 9.8,
   "end": 12.9,
   "text": "And every few years they vote again, and he can lose."
  },
  {
   "id": "3.hates",
   "start": 12.9,
   "end": 15.1333,
   "text": "Now meet a leader who hates the word no."
  },
  {
   "id": "4.army",
   "start": 15.1333,
   "end": 16.7667,
   "text": "He may march in with soldiers."
  },
  {
   "id": "4.won",
   "start": 16.7667,
   "end": 19.0,
   "text": "Or he may even win a fair vote first."
  },
  {
   "id": "4.judge",
   "start": 19.0,
   "end": 21.3,
   "text": "Then he makes sure no judge can tell him no."
  },
  {
   "id": "4.jail",
   "start": 21.3,
   "end": 23.4,
   "text": "He locks up people who say he is wrong."
  },
  {
   "id": "4.vote",
   "start": 23.4,
   "end": 25.9667,
   "text": "And the next vote is fixed, or it never comes."
  },
  {
   "id": "4.name",
   "start": 25.9667,
   "end": 28.9,
   "text": "That is a dictator, and no vote can make him leave."
  },
  {
   "id": "5.word",
   "start": 28.9,
   "end": 32.5667,
   "text": "The word is over two thousand years old. It used to be a job."
  },
  {
   "id": "5.rome",
   "start": 32.5667,
   "end": 35.8333,
   "text": "When ancient Rome was in danger, it gave one man the power."
  },
  {
   "id": "5.six",
   "start": 35.8333,
   "end": 38.9333,
   "text": "But only for six months. Then he had to give it back."
  },
  {
   "id": "5.caesar",
   "start": 38.9333,
   "end": 41.4333,
   "text": "Then Julius Caesar was made dictator for life."
  },
  {
   "id": "5.now",
   "start": 41.4333,
   "end": 43.4333,
   "text": "Today the word means only that kind."
  },
  {
   "id": "6.answer",
   "start": 43.4333,
   "end": 47.0667,
   "text": "So a dictator is a ruler nobody is allowed to tell no."
  },
  {
   "id": "7.you",
   "start": 47.0667,
   "end": 50.1667,
   "text": "Which is why a vote matters. It is how you say no."
  },
  {
   "id": "7.sub",
   "start": 50.1667,
   "end": 53.3333,
   "text": "So subscribe. Or say no. Here, you still can."
  }
 ],
