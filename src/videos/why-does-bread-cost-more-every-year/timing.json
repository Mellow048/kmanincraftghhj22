 "cues": [
  {
   "id": "1.ask",
   "start": 0.0,
   "end": 1.6333,
   "text": "Why does bread cost more every year?"
  },
  {
   "id": "2.loaf",
   "start": 1.6333,
   "end": 3.6333,
   "text": "Today, a loaf costs you two coins."
  },
  {
   "id": "3.mom",
   "start": 3.6333,
   "end": 5.9333,
   "text": "When your mom was your age, the same loaf cost one."
  },
  {
   "id": "3.same",
   "start": 5.9333,
   "end": 8.6333,
   "text": "Same bread. Same oven. Only the price moved."
  },
  {
   "id": "4.village",
   "start": 8.6333,
   "end": 10.7333,
   "text": "To see why, picture a tiny village."
  },
  {
   "id": "4.ten",
   "start": 10.7333,
   "end": 13.7,
   "text": "It has ten loaves of bread, and ten coins to buy them with."
  },
  {
   "id": "4.one",
   "start": 13.7,
   "end": 15.6333,
   "text": "So each loaf sells for one coin."
  },
  {
   "id": "4.more",
   "start": 15.6333,
   "end": 17.4333,
   "text": "Now hand the village ten more coins."
  },
  {
   "id": "4.still",
   "start": 17.4333,
   "end": 19.3667,
   "text": "The baker still has only ten loaves,"
  },
  {
   "id": "4.two",
   "start": 19.3667,
   "end": 21.2667,
   "text": "so each loaf now sells for two."
  },
  {
   "id": "4.nobody",
   "start": 21.2667,
   "end": 25.2,
   "text": "Nobody can buy any more bread than before. Each coin just buys less."
  },
  {
   "id": "5.real",
   "start": 25.2,
   "end": 27.8,
   "text": "The real world does the same thing, only slowly."
  },
  {
   "id": "5.faster",
   "start": 27.8,
   "end": 30.2333,
   "text": "New money is made a little faster than new bread is baked."
  },
  {
   "id": "5.name",
   "start": 30.2333,
   "end": 34.2333,
   "text": "So year after year, prices creep up. That creep is called inflation."
  },
  {
   "id": "5.germany",
   "start": 34.2333,
   "end": 37.2,
   "text": "A hundred years ago, Germany printed money far too fast."
  },
  {
   "id": "5.billion",
   "start": 37.2,
   "end": 40.0333,
   "text": "By the end, one loaf of bread cost two hundred billion."
  },
  {
   "id": "6.answer",
   "start": 40.0333,
   "end": 43.8,
   "text": "So your bread never changed. There is more money, and each coin buys less."
  },
  {
   "id": "7.chest",
   "start": 43.8,
   "end": 46.7667,
   "text": "Which means the coins in your chest buy a little less every year."
  },
  {
   "id": "7.sub",
   "start": 46.7667,
   "end": 49.2,
   "text": "So subscribe now. It still costs nothing."
  }
 ],
