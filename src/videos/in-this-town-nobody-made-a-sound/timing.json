 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 1.6333,
   "text": "In this town, nobody made a sound."
  },
  {
   "id": "1.me",
   "start": 1.6333,
   "end": 2.5667,
   "text": "Nobody but me."
  },
  {
   "id": "1.kid",
   "start": 2.5667,
   "end": 4.2667,
   "text": "I was the kid who could not help it."
  },
  {
   "id": "1.hiccup",
   "start": 4.2667,
   "end": 5.8,
   "text": "Hiccup. And the whole street stopped."
  },
  {
   "id": "2.wool",
   "start": 5.8,
   "end": 7.1,
   "text": "The floors were covered in wool."
  },
  {
   "id": "2.steps",
   "start": 7.1,
   "end": 8.8333,
   "text": "You could walk anywhere and hear nothing."
  },
  {
   "id": "2.signs",
   "start": 8.8333,
   "end": 11.4333,
   "text": "The school was in signs. Nobody talked. Nobody hummed."
  },
  {
   "id": "2.noon",
   "start": 11.4333,
   "end": 13.3667,
   "text": "And at noon, everybody went to bed."
  },
  {
   "id": "3.grand",
   "start": 13.3667,
   "end": 14.8,
   "text": "My grandmother kept the town bell."
  },
  {
   "id": "3.blanket",
   "start": 14.8,
   "end": 17.1667,
   "text": "It was wrapped in a black blanket, up in the tower."
  },
  {
   "id": "3.never",
   "start": 17.1667,
   "end": 19.9,
   "text": "Nobody was allowed to ring it. Not once. Not ever."
  },
  {
   "id": "3.why",
   "start": 19.9,
   "end": 22.2667,
   "text": "I asked her why. She put one finger on her lips."
  },
  {
   "id": "4.only",
   "start": 22.2667,
   "end": 24.2333,
   "text": "So I was the only sound in the whole town."
  },
  {
   "id": "4.try",
   "start": 24.2333,
   "end": 25.9667,
   "text": "I tried to stop. I held my breath."
  },
  {
   "id": "4.bad",
   "start": 25.9667,
   "end": 27.5,
   "text": "I turned blue. I fell over."
  },
  {
   "id": "4.again",
   "start": 27.5,
   "end": 29.7667,
   "text": "And I hiccupped again, on the floor, in the wool."
  },
  {
   "id": "5.think",
   "start": 29.7667,
   "end": 31.6,
   "text": "I thought the town was quiet because of me."
  },
  {
   "id": "5.sorry",
   "start": 31.6,
   "end": 33.3667,
   "text": "Everyone was being careful, for me."
  },
  {
   "id": "5.hate",
   "start": 33.3667,
   "end": 35.1,
   "text": "I hated it. I hated my own chest."
  },
  {
   "id": "6.door",
   "start": 35.1,
   "end": 36.9333,
   "text": "Then one night, the tower door was open."
  },
  {
   "id": "6.up",
   "start": 36.9333,
   "end": 37.8,
   "text": "I climbed the stairs."
  },
  {
   "id": "6.grand",
   "start": 37.8,
   "end": 38.9,
   "text": "It was my grandmother."
  },
  {
   "id": "6.ring",
   "start": 38.9,
   "end": 40.2333,
   "text": "And she was ringing the bell."
  },
  {
   "id": "7.ask",
   "start": 40.2333,
   "end": 42.1,
   "text": "I said: you told me nobody rings it."
  },
  {
   "id": "7.for",
   "start": 42.1,
   "end": 44.7667,
   "text": "She said: I ring it every night. For the thing below."
  },
  {
   "id": "7.below",
   "start": 44.7667,
   "end": 46.6,
   "text": "Something under this town is listening."
  },
  {
   "id": "7.wake",
   "start": 46.6,
   "end": 48.3333,
   "text": "If it stops hearing us, it wakes up."
  },
  {
   "id": "8.wrong",
   "start": 48.3333,
   "end": 49.9,
   "text": "You are not the problem, she said."
  },
  {
   "id": "8.only",
   "start": 49.9,
   "end": 51.3667,
   "text": "You are the only one it hears."
  },
  {
   "id": "8.purpose",
   "start": 51.3667,
   "end": 53.1667,
   "text": "The town was never quiet because of me."
  },
  {
   "id": "8.quiet",
   "start": 53.1667,
   "end": 54.4667,
   "text": "The town was quiet on purpose."
  },
  {
   "id": "9.think2",
   "start": 54.4667,
   "end": 55.6667,
   "text": "I thought quiet kept us safe."
  },
  {
   "id": "9.actually",
   "start": 55.6667,
   "end": 56.8333,
   "text": "But quiet sounds like nothing."
  },
  {
   "id": "9.gone",
   "start": 56.8333,
   "end": 57.9667,
   "text": "And nothing sounds like gone."
  },
  {
   "id": "9.bell2",
   "start": 57.9667,
   "end": 59.6,
   "text": "The bell was the town saying: still here."
  },
  {
   "id": "10.mine",
   "start": 59.6,
   "end": 61.3667,
   "text": "So one night, she let me hold the rope."
  },
  {
   "id": "10.breath",
   "start": 61.3667,
   "end": 63.2667,
   "text": "I held my breath. The whole town held theirs."
  },
  {
   "id": "10.wool",
   "start": 63.2667,
   "end": 64.3,
   "text": "You could hear the wool."
  },
  {
   "id": "11.loud",
   "start": 64.3,
   "end": 65.5333,
   "text": "And I rang it. Loud."
  },
  {
   "id": "11.one",
   "start": 65.5333,
   "end": 66.6,
   "text": "One. Two. Three."
  },
  {
   "id": "11.answer",
   "start": 66.6,
   "end": 68.3,
   "text": "And something under the town answered."
  },
  {
   "id": "12.low",
   "start": 68.3,
   "end": 69.7,
   "text": "One low note, under the ground."
  },
  {
   "id": "12.not",
   "start": 69.7,
   "end": 70.3667,
   "text": "Not angry."
  },
  {
   "id": "12.lonely",
   "start": 70.3667,
   "end": 70.9667,
   "text": "Lonely."
  },
  {
   "id": "12.still",
   "start": 70.9667,
   "end": 72.0,
   "text": "The whole town stood still."
  },
  {
   "id": "13.now",
   "start": 72.0,
   "end": 74.3,
   "text": "Now the bell rings every night. I take a turn."
  },
  {
   "id": "13.town",
   "start": 74.3,
   "end": 75.5,
   "text": "And the town is still quiet."
  },
  {
   "id": "13.diff",
   "start": 75.5,
   "end": 77.2667,
   "text": "But it is a different kind of quiet."
  },
  {
   "id": "13.hiccup",
   "start": 77.2667,
   "end": 79.2667,
   "text": "I still hiccup. Nobody minds anymore."
  },
  {
   "id": "14.answer",
   "start": 79.2667,
   "end": 81.4667,
   "text": "And if you hear a bell tonight, answer it back."
  },
  {
   "id": "14.sub",
   "start": 81.4667,
   "end": 82.6667,
   "text": "Like and subscribe."
  }
 ],
