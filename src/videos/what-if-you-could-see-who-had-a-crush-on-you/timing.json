 "clips": [],
 "cues": [
  {
   "id": "1.what",
   "start": 0.0,
   "end": 2.1333,
   "text": "What if you could see who had a crush on you?"
  },
  {
   "id": "1.me",
   "start": 2.1333,
   "end": 3.3,
   "text": "One morning, I could."
  },
  {
   "id": "2.mom",
   "start": 3.3,
   "end": 5.5,
   "text": "At breakfast, a pink heart floated over my mom."
  },
  {
   "id": "2.dad",
   "start": 5.5,
   "end": 7.0667,
   "text": "When my dad walked in, it doubled."
  },
  {
   "id": "2.dog",
   "start": 7.0667,
   "end": 9.2,
   "text": "Even my dog had one. For his dinner."
  },
  {
   "id": "2.mirror",
   "start": 9.2,
   "end": 11.5667,
   "text": "I checked the mirror. I could not see my own."
  },
  {
   "id": "3.school",
   "start": 11.5667,
   "end": 13.3333,
   "text": "At school, the hearts were everywhere."
  },
  {
   "id": "3.grew",
   "start": 13.3333,
   "end": 15.5333,
   "text": "A heart grew when the one it was for came close."
  },
  {
   "id": "3.teacher",
   "start": 15.5333,
   "end": 18.1667,
   "text": "My math teacher's filled the room when the gym teacher walked past."
  },
  {
   "id": "3.never",
   "start": 18.1667,
   "end": 20.1333,
   "text": "But a heart never said who it was for."
  },
  {
   "id": "3.guess",
   "start": 20.1333,
   "end": 21.8,
   "text": "I had to watch what made it grow."
  },
  {
   "id": "4.ben",
   "start": 21.8,
   "end": 24.4,
   "text": "I told Ben that Lily's heart doubled whenever he sat down."
  },
  {
   "id": "4.lunch",
   "start": 24.4,
   "end": 26.1333,
   "text": "By lunch they were sharing a sandwich."
  },
  {
   "id": "4.cookie",
   "start": 26.1333,
   "end": 28.7667,
   "text": "By Wednesday, kids were paying me one cookie a question."
  },
  {
   "id": "4.hands",
   "start": 28.7667,
   "end": 31.7667,
   "text": "By Friday, the math teacher and the gym teacher were holding hands."
  },
  {
   "id": "5.mia",
   "start": 31.7667,
   "end": 33.8667,
   "text": "But the only heart I cared about was Mia's."
  },
  {
   "id": "5.small",
   "start": 33.8667,
   "end": 36.4333,
   "text": "She sat by the window, and her heart was always small."
  },
  {
   "id": "5.forme",
   "start": 36.4333,
   "end": 38.4667,
   "text": "Could it be for me? I had to know."
  },
  {
   "id": "6.jo",
   "start": 38.4667,
   "end": 40.9,
   "text": "My best friend Jo sat behind me in every class."
  },
  {
   "id": "6.biggest",
   "start": 40.9,
   "end": 42.8667,
   "text": "Her heart was the biggest in the whole school."
  },
  {
   "id": "6.lucky",
   "start": 42.8667,
   "end": 45.5,
   "text": "I told her, whoever he is, he is one lucky guy."
  },
  {
   "id": "6.eraser",
   "start": 45.5,
   "end": 47.2333,
   "text": "She threw an eraser at my head."
  },
  {
   "id": "7.walk",
   "start": 47.2333,
   "end": 49.8,
   "text": "So I walked past Mia's desk to see if her heart would grow."
  },
  {
   "id": "7.watch",
   "start": 49.8,
   "end": 51.1,
   "text": "I watched it the whole way."
  },
  {
   "id": "7.door",
   "start": 51.1,
   "end": 52.3667,
   "text": "I did not watch the door."
  },
  {
   "id": "7.laugh",
   "start": 52.3667,
   "end": 54.9667,
   "text": "Everybody laughed. Her heart did not move at all."
  },
  {
   "id": "8.line",
   "start": 54.9667,
   "end": 57.6667,
   "text": "Then, in the lunch line, I got the spot right behind her."
  },
  {
   "id": "8.ceiling",
   "start": 57.6667,
   "end": 59.5667,
   "text": "Her heart grew until it touched the ceiling."
  },
  {
   "id": "8.mine",
   "start": 59.5667,
   "end": 60.8667,
   "text": "It had to be for me."
  },
  {
   "id": "8.seat",
   "start": 60.8667,
   "end": 62.4667,
   "text": "I forgot to save Jo a seat."
  },
  {
   "id": "8.apart",
   "start": 62.4667,
   "end": 64.9,
   "text": "It was the first lunch we had ever eaten apart."
  },
  {
   "id": "9.smile",
   "start": 64.9,
   "end": 66.8,
   "text": "Jo asked why I kept smiling at nothing."
  },
  {
   "id": "9.ask",
   "start": 66.8,
   "end": 69.2667,
   "text": "I told her about Mia. She said, then ask her."
  },
  {
   "id": "9.home",
   "start": 69.2667,
   "end": 71.1333,
   "text": "That day, she walked home the other way."
  },
  {
   "id": "10.dance",
   "start": 71.1333,
   "end": 72.7667,
   "text": "The school dance was on Friday night."
  },
  {
   "id": "10.card",
   "start": 72.7667,
   "end": 74.3667,
   "text": "I wrote my question on a card."
  },
  {
   "id": "10.dog",
   "start": 74.3667,
   "end": 76.3667,
   "text": "I practised on my dog. He said yes."
  },
  {
   "id": "10.tie",
   "start": 76.3667,
   "end": 78.4,
   "text": "I wore my dad's tie. It reached my knees."
  },
  {
   "id": "10.lights",
   "start": 78.4,
   "end": 81.3333,
   "text": "Mia stood under the lights. Her heart was small. Not for long."
  },
  {
   "id": "10.jo",
   "start": 81.3333,
   "end": 82.9667,
   "text": "Jo had said she was not coming."
  },
  {
   "id": "11.walk",
   "start": 82.9667,
   "end": 84.2,
   "text": "I walked across the gym."
  },
  {
   "id": "11.card",
   "start": 84.2,
   "end": 85.3,
   "text": "I held out the card."
  },
  {
   "id": "11.ask",
   "start": 85.3,
   "end": 86.4333,
   "text": "Will you dance with me?"
  },
  {
   "id": "12.shook",
   "start": 86.4333,
   "end": 87.1667,
   "text": "Her heart shook."
  },
  {
   "id": "12.grew",
   "start": 87.1667,
   "end": 89.7333,
   "text": "Then it grew, bigger than I had ever seen one grow."
  },
  {
   "id": "12.sure",
   "start": 89.7333,
   "end": 91.8,
   "text": "I had never been so sure of anything."
  },
  {
   "id": "13.over",
   "start": 91.8,
   "end": 93.4667,
   "text": "She was looking over my shoulder."
  },
  {
   "id": "13.leo",
   "start": 93.4667,
   "end": 96.0333,
   "text": "Leo was right behind me. Just like in the lunch line."
  },
  {
   "id": "13.biggest",
   "start": 96.0333,
   "end": 98.1333,
   "text": "Then I thought about the biggest heart in school."
  },
  {
   "id": "13.gate",
   "start": 98.1333,
   "end": 101.3,
   "text": "Jo was out by the gate, a long way off. Her heart was tiny."
  },
  {
   "id": "13.step",
   "start": 101.3,
   "end": 102.8667,
   "text": "I took one step, and it grew."
  },
  {
   "id": "13.near",
   "start": 102.8667,
   "end": 105.8667,
   "text": "It had never been big. It had only ever been near me."
  },
  {
   "id": "14.gone",
   "start": 105.8667,
   "end": 107.8333,
   "text": "The next morning, every heart was gone."
  },
  {
   "id": "14.loud",
   "start": 107.8333,
   "end": 110.2333,
   "text": "So I had to ask Jo the old way. Out loud."
  },
  {
   "id": "14.sub",
   "start": 110.2333,
   "end": 113.0,
   "text": "Subscribe, and I will tell you what she threw at me."
  }
 ],
