 "cues": [
  {
   "id": "1.trial",
   "start": 0.0,
   "end": 1.5333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "1.two",
   "start": 1.5333,
   "end": 4.3,
   "text": "Two in my mouth. One off my forehead."
  },
  {
   "id": "1.best",
   "start": 4.3,
   "end": 5.8667,
   "text": "A personal best."
  },
  {
   "id": "1.drink",
   "start": 5.8667,
   "end": 7.3333,
   "text": "Bea moved her drink."
  },
  {
   "id": "1.book",
   "start": 7.3333,
   "end": 9.1333,
   "text": "Then she saw my notebook."
  },
  {
   "id": "1.day",
   "start": 9.1333,
   "end": 11.9667,
   "text": "Day forty seven. Still rushing the third one."
  },
  {
   "id": "2.gold",
   "start": 11.9667,
   "end": 14.0333,
   "text": "Our cinema had one gold seat."
  },
  {
   "id": "2.win",
   "start": 14.0333,
   "end": 16.4667,
   "text": "Catch three pieces of popcorn before the trailers"
  },
  {
   "id": "2.year",
   "start": 16.4667,
   "end": 18.0667,
   "text": "and it was yours for a year."
  },
  {
   "id": "2.fame",
   "start": 18.0667,
   "end": 19.5333,
   "text": "I didn't want fame."
  },
  {
   "id": "2.fold",
   "start": 19.5333,
   "end": 21.6667,
   "text": "I wanted a seat that didn't fold me in half."
  },
  {
   "id": "3.friday",
   "start": 21.6667,
   "end": 23.9,
   "text": "On Friday nights my friends went out."
  },
  {
   "id": "3.stay",
   "start": 23.9,
   "end": 25.4667,
   "text": "I stayed in the kitchen."
  },
  {
   "id": "3.same",
   "start": 25.4667,
   "end": 28.1333,
   "text": "Same bucket. Same distance."
  },
  {
   "id": "3.ceiling",
   "start": 28.1333,
   "end": 29.9333,
   "text": "Slightly lower ceiling."
  },
  {
   "id": "3.reps",
   "start": 29.9333,
   "end": 31.7,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "4.sink",
   "start": 31.7,
   "end": 34.1667,
   "text": "One in the sink. One in the butter."
  },
  {
   "id": "4.clock",
   "start": 34.1667,
   "end": 36.5667,
   "text": "The third one stuck to the clock."
  },
  {
   "id": "4.almost",
   "start": 36.5667,
   "end": 39.6333,
   "text": "Ah, almost, almost."
  },
  {
   "id": "4.dots",
   "start": 39.6333,
   "end": 41.8,
   "text": "Bea drew three dots in my notebook."
  },
  {
   "id": "4.gap",
   "start": 41.8,
   "end": 43.8,
   "text": "There was a gap before the last dot."
  },
  {
   "id": "5.watch",
   "start": 43.8,
   "end": 46.0667,
   "text": "She made me watch my hand."
  },
  {
   "id": "5.reach",
   "start": 46.0667,
   "end": 47.9333,
   "text": "On the third toss I was already reaching"
  },
  {
   "id": "5.bucket",
   "start": 47.9333,
   "end": 49.2333,
   "text": "back into the bucket."
  },
  {
   "id": "5.what",
   "start": 49.2333,
   "end": 52.1,
   "text": "For what? There's no fourth piece."
  },
  {
   "id": "5.drill",
   "start": 52.1,
   "end": 54.2667,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "6.full",
   "start": 54.2667,
   "end": 56.5,
   "text": "Friday. Full house."
  },
  {
   "id": "6.rope",
   "start": 56.5,
   "end": 58.1,
   "text": "The usher lifted the rope."
  },
  {
   "id": "6.pick",
   "start": 58.1,
   "end": 60.7667,
   "text": "I picked out three pieces and set the bucket down."
  },
  {
   "id": "6.two",
   "start": 60.7667,
   "end": 63.5,
   "text": "Two clean catches. Then I waited."
  },
  {
   "id": "6.three",
   "start": 63.5,
   "end": 65.4667,
   "text": "Number three came straight down."
  },
  {
   "id": "7.mine",
   "start": 65.4667,
   "end": 67.3333,
   "text": "The gold seat was mine."
  },
  {
   "id": "7.beside",
   "start": 67.3333,
   "end": 68.9667,
   "text": "Bea sat beside me."
  },
  {
   "id": "7.shut",
   "start": 68.9667,
   "end": 70.7333,
   "text": "Her seat folded shut."
  },
  {
   "id": "7.research",
   "start": 70.7333,
   "end": 74.0333,
   "text": "Forty seven days of research finally paid off."
  },
  {
   "id": "7.wedge",
   "start": 74.0333,
   "end": 77.4333,
   "text": "I folded my notebook and wedged it under her seat."
  },
  {
   "id": "7.pair",
   "start": 77.4333,
   "end": 78.5667,
   "text": "Now we had two."
  },
  {
   "id": "7.trailers",
   "start": 78.5667,
   "end": 80.6667,
   "text": "Halfway through the trailers, I heard it behind me."
  },
  {
   "id": "7.rows",
   "start": 80.6667,
   "end": 82.0667,
   "text": "Three entire rows."
  },
  {
   "id": "7.training",
