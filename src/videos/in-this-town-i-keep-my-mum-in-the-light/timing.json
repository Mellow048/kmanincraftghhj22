 "cues": [
  {
   "id": "1.keep",
   "start": 0.0,
   "end": 1.8333,
   "text": "In this town, I keep my mum in the light."
  },
  {
   "id": "1.spider",
   "start": 1.8333,
   "end": 2.7667,
   "text": "She is a spider."
  },
  {
   "id": "1.six",
   "start": 2.7667,
   "end": 4.2667,
   "text": "She knits. Six needles."
  },
  {
   "id": "1.jumper",
   "start": 4.2667,
   "end": 6.3333,
   "text": "Two jumpers a week. One is always mine."
  },
  {
   "id": "1.evening",
   "start": 6.3333,
   "end": 7.5333,
   "text": "She came to school once."
  },
  {
   "id": "1.chairs",
   "start": 7.5333,
   "end": 8.9333,
   "text": "Everybody stood on their chairs."
  },
  {
   "id": "2.light",
   "start": 8.9333,
   "end": 11.2667,
   "text": "In this town, a spider in the light does nothing at all."
  },
  {
   "id": "2.dark",
   "start": 11.2667,
   "end": 13.2667,
   "text": "In the dark, a spider does what it likes."
  },
  {
   "id": "2.knits",
   "start": 13.2667,
   "end": 14.9333,
   "text": "Mum knits. One jumper a minute."
  },
  {
   "id": "2.sleeves",
   "start": 14.9333,
   "end": 17.1667,
   "text": "The jumper has too many sleeves. I wear it anyway."
  },
  {
   "id": "2.evening",
   "start": 17.1667,
   "end": 19.3,
   "text": "At parents' evening, every other mum was a villager."
  },
  {
   "id": "2.back",
   "start": 19.3,
   "end": 22.0333,
   "text": "And everybody stood on their chairs. She has not been back."
  },
  {
   "id": "2.step",
   "start": 22.0333,
   "end": 23.3667,
   "text": "She never comes out to the step."
  },
  {
   "id": "2.thought",
   "start": 23.3667,
   "end": 24.8333,
   "text": "I thought she did not like being near me."
  },
  {
   "id": "2.legs",
   "start": 24.8333,
   "end": 27.7,
   "text": "Then I saw her legs, flat against the frame, holding her in."
  },
  {
   "id": "3.candles",
   "start": 27.7,
   "end": 29.5,
   "text": "First I put a candle in every window."
  },
  {
   "id": "3.wind",
   "start": 29.5,
   "end": 31.1,
   "text": "The wind took them, one by one."
  },
  {
   "id": "3.lantern",
   "start": 31.1,
   "end": 34.7667,
   "text": "Then a lantern on a string round her neck. She walked through a door and it came off."
  },
  {
   "id": "3.trade",
   "start": 34.7667,
   "end": 37.4333,
   "text": "Then I traded everything I owned for one block of glowstone."
  },
  {
   "id": "3.hung",
   "start": 37.4333,
   "end": 38.6,
   "text": "I hung it over her corner."
  },
  {
   "id": "3.mum",
   "start": 38.6,
   "end": 41.3,
   "text": "She sat under it and knitted, and was my mum all night."
  },
  {
   "id": "3.awake",
   "start": 41.3,
   "end": 43.7333,
   "text": "It was too bright to sleep under. So I stopped sleeping."
  },
  {
   "id": "3.nights",
   "start": 43.7333,
   "end": 45.9333,
   "text": "One night awake, then two, then three."
  },
  {
   "id": "4.sky",
   "start": 45.9333,
   "end": 48.3667,
   "text": "On the third night, the sky started screaming."
  },
  {
   "id": "4.three",
   "start": 48.3667,
   "end": 52.1,
   "text": "Three of them came over the roofs, wide as doors, with no faces at all."
  },
  {
   "id": "4.around",
   "start": 52.1,
   "end": 55.3,
   "text": "They went round the house, round and round, lower every time."
  },
  {
   "id": "4.gate",
   "start": 55.3,
   "end": 57.2,
   "text": "I was outside, lighting the lamp by the gate."
  },
  {
   "id": "4.hand",
   "start": 57.2,
   "end": 59.2,
   "text": "One of them came down and took it out of my hand."
  },
  {
   "id": "4.dark",
   "start": 59.2,
   "end": 60.2,
   "text": "The street went dark."
  },
  {
   "id": "4.mum",
   "start": 60.2,
   "end": 63.0667,
   "text": "And my mum was standing in the doorway, in the dark, looking at me."
  },
  {
   "id": "5.still",
   "start": 63.0667,
   "end": 64.8,
   "text": "I stood still. I did not run."
  },
  {
   "id": "5.door",
   "start": 64.8,
   "end": 66.7,
   "text": "She came out of the door, and she filled it."
  },
  {
   "id": "5.eight",
   "start": 66.7,
   "end": 68.8,
   "text": "Eight legs, two wings, then feathers."
  },
  {
   "id": "5.wind",
   "start": 68.8,
   "end": 71.5667,
   "text": "She went over me. I felt the wind of her, twice."
  },
  {
   "id": "5.gone",
   "start": 71.5667,
   "end": 72.4,
   "text": "And she was gone."
  },
  {
   "id": "5.quiet",
   "start": 72.4,
   "end": 73.6667,
   "text": "The sky went quiet."
  },
  {
   "id": "5.roof",
   "start": 73.6667,
   "end": 76.5333,
   "text": "She was on the roof, looking down the street, not at me."
  },
  {
   "id": "6.wash",
   "start": 76.5333,
   "end": 77.9667,
   "text": "In the morning she was washing."
  },
  {
   "id": "6.wrung",
   "start": 77.9667,
   "end": 79.0667,
   "text": "She wrung out the sheets."
  },
  {
   "id": "6.remembers",
   "start": 79.0667,
   "end": 80.4,
   "text": "She never remembers the night."
  },
  {
   "id": "6.told",
   "start": 80.4,
   "end": 81.3333,
   "text": "I have not told her."
  },
  {
   "id": "6.list",
   "start": 81.3333,
   "end": 82.8,
   "text": "So this is the list."
  },
  {
   "id": "6.one",
   "start": 82.8,
   "end": 85.3333,
   "text": "One: never be out after the lamps go cold."
  },
  {
   "id": "6.two",
   "start": 85.3333,
   "end": 87.6667,
   "text": "Two: if your street goes dark, do not run."
  },
  {
   "id": "6.still",
   "start": 87.6667,
   "end": 89.6,
   "text": "Stand still. She will step over you."
  },
  {
   "id": "6.sub",
   "start": 89.6,
   "end": 91.6667,
   "text": "If you want more of these, subscribe."
  }
 ],
