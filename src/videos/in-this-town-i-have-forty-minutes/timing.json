 "cues": [
  {
   "id": "1.forty",
   "start": 0.0,
   "end": 1.6,
   "text": "In this town, I have forty minutes."
  },
  {
   "id": "1.sell",
   "start": 1.6,
   "end": 3.2667,
   "text": "I sell things. Nobody wants them."
  },
  {
   "id": "1.llamas",
   "start": 3.2667,
   "end": 5.4,
   "text": "I have two llamas. They do not want them either."
  },
  {
   "id": "1.clock",
   "start": 5.4,
   "end": 7.2667,
   "text": "When the clock says zero, I am gone."
  },
  {
   "id": "1.where",
   "start": 7.2667,
   "end": 9.7333,
   "text": "I do not know where I go. I have never asked."
  },
  {
   "id": "2.goods",
   "start": 9.7333,
   "end": 13.6,
   "text": "This is my shop. One sapling. One slime ball. One fish in a bucket."
  },
  {
   "id": "2.bush",
   "start": 13.6,
   "end": 14.6667,
   "text": "And one dead bush."
  },
  {
   "id": "2.five",
   "start": 14.6667,
   "end": 15.9667,
   "text": "Everything is five emeralds."
  },
  {
   "id": "2.nine",
   "start": 15.9667,
   "end": 17.4,
   "text": "I have been to nine hundred towns."
  },
  {
   "id": "2.sold",
   "start": 17.4,
   "end": 18.3667,
   "text": "I have sold nothing."
  },
  {
   "id": "2.think",
   "start": 18.3667,
   "end": 19.9333,
   "text": "I think my prices are too low."
  },
  {
   "id": "3.town",
   "start": 19.9333,
   "end": 22.3667,
   "text": "This town looked rich. Everybody had a shop."
  },
  {
   "id": "3.baker",
   "start": 22.3667,
   "end": 25.0,
   "text": "I showed the baker my fish. He showed me his bread."
  },
  {
   "id": "3.fisher",
   "start": 25.0,
   "end": 27.8,
   "text": "I showed the fisherman my fish. He showed me his fish."
  },
  {
   "id": "3.same",
   "start": 27.8,
   "end": 28.9667,
   "text": "It was a better fish."
  },
  {
   "id": "3.farmer",
   "start": 28.9667,
   "end": 31.8333,
   "text": "I showed the farmer my slime ball. He showed me a carrot."
  },
  {
   "id": "3.salesmen",
   "start": 31.8333,
   "end": 34.6333,
   "text": "It was a town of salesmen. Nobody here buys anything."
  },
  {
   "id": "3.clock",
   "start": 34.6333,
   "end": 35.9,
   "text": "Thirty one minutes."
  },
  {
   "id": "4.player",
   "start": 35.9,
   "end": 38.4333,
   "text": "Then a customer came. A real one. He had a sword."
  },
  {
   "id": "4.looked",
   "start": 38.4333,
   "end": 40.3333,
   "text": "He looked at my shop. He looked at my llamas."
  },
  {
   "id": "4.took",
   "start": 40.3333,
   "end": 41.1333,
   "text": "He took the llamas."
  },
  {
   "id": "4.pay",
   "start": 41.1333,
   "end": 42.9,
   "text": "He did not pay. I think he forgot."
  },
  {
   "id": "4.gone",
   "start": 42.9,
   "end": 45.0,
   "text": "They did not look back. Llamas are like that."
  },
  {
   "id": "5.night",
   "start": 45.0,
   "end": 45.9,
   "text": "Then it got dark."
  },
  {
   "id": "5.potion",
   "start": 45.9,
   "end": 47.4667,
   "text": "At night, I drink this."
  },
  {
   "id": "5.invisible",
   "start": 47.4667,
   "end": 50.7667,
   "text": "It makes me invisible. So nobody has to feel bad about not buying."
  },
  {
   "id": "5.clock",
   "start": 50.7667,
   "end": 52.8,
   "text": "Only my clock shows. Nine minutes."
  },
  {
   "id": "5.alone",
   "start": 52.8,
   "end": 54.8667,
   "text": "I stood in the dark, and counted towns."
  },
  {
   "id": "6.kid",
   "start": 54.8667,
   "end": 56.9,
   "text": "At three minutes, somebody pulled my robe."
  },
  {
   "id": "6.see",
   "start": 56.9,
   "end": 59.0333,
   "text": "A kid. He should not have been able to see me."
  },
  {
   "id": "6.said",
   "start": 59.0333,
   "end": 60.6,
   "text": "He said, \"I can see your clock\"."
  },
  {
   "id": "6.want",
   "start": 60.6,
   "end": 62.6333,
   "text": "He wanted the dead bush. For his mum."
  },
  {
   "id": "6.one",
   "start": 62.6333,
   "end": 64.7667,
   "text": "He had one emerald. The bush is five."
  },
  {
   "id": "6.looked",
   "start": 64.7667,
   "end": 66.7333,
   "text": "I looked at the clock. I looked at the kid."
  },
  {
   "id": "6.deal",
   "start": 66.7333,
   "end": 68.9,
   "text": "I said, \"today, it is one\"."
  },
  {
   "id": "6.first",
   "start": 68.9,
   "end": 71.3,
   "text": "Nine hundred towns. My first sale."
  },
  {
   "id": "6.home",
   "start": 71.3,
   "end": 73.1667,
   "text": "He carried it home like it was gold."
  },
  {
   "id": "7.tell",
   "start": 73.1667,
   "end": 74.6667,
   "text": "I turned round to tell my llamas."
  },
  {
   "id": "7.right",
   "start": 74.6667,
   "end": 76.1667,
   "text": "Right. No llamas."
  },
  {
   "id": "7.two",
   "start": 76.1667,
   "end": 79.5,
   "text": "Two minutes. One emerald. I had never had one before."
  },
  {
   "id": "7.buy",
   "start": 79.5,
   "end": 82.0,
   "text": "So I did something I had never done. I bought something."
  },
  {
   "id": "7.bread",
   "start": 82.0,
   "end": 84.8,
   "text": "One loaf, from the baker. It was his first sale too."
  },
  {
   "id": "7.round",
   "start": 84.8,
   "end": 87.5,
   "text": "The baker ran to the fisherman. The fisherman ran to the farmer."
  },
  {
   "id": "7.town",
   "start": 87.5,
   "end": 89.1667,
   "text": "One emerald went round the whole town."
  },
  {
   "id": "7.why",
   "start": 89.1667,
   "end": 92.5,
   "text": "Nobody could buy, because nobody had ever sold. Somebody has to go first."
  },
  {
   "id": "7.lights",
   "start": 92.5,
   "end": 93.5333,
   "text": "Every window lit up."
  },
  {
   "id": "7.back",
   "start": 93.5333,
   "end": 96.3333,
   "text": "Then it came back to me. The farmer wanted my slime ball."
  },
  {
   "id": "7.zero",
   "start": 96.3333,
   "end": 98.8,
   "text": "Two sales. I opened my mouth to say thank you."
  },
  {
   "id": "7.poof",
   "start": 98.8,
   "end": 99.6,
   "text": "Zero."
  },
  {
   "id": "8.kid",
   "start": 99.6,
   "end": 101.3333,
   "text": "The kid's mum put the dead bush in the window."
  },
  {
   "id": "8.ugly",
   "start": 101.3333,
   "end": 103.4667,
   "text": "It is the ugliest thing in town. She loves it."
  },
  {
   "id": "8.next",
   "start": 103.4667,
   "end": 105.5,
   "text": "I am in a new town now. Forty minutes."
  },
  {
   "id": "8.know",
   "start": 105.5,
   "end": 108.2333,
   "text": "They have shops here too. And I have one emerald."
  },
  {
   "id": "8.sub",
   "start": 108.2333,
   "end": 111.8333,
   "text": "Like and subscribe for part two. I am going to buy my llamas back."
  }
 ],
