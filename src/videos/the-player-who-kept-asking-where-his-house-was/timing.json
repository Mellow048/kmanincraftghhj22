 "cues": [
  {
   "id": "1.ask",
   "start": 0.0,
   "end": 2.0333,
   "text": "This player asked where his house was forty times."
  },
  {
   "id": "1.close",
   "start": 2.0333,
   "end": 4.0667,
   "text": "He stood ten blocks from his own front door."
  },
  {
   "id": "1.mock",
   "start": 4.0667,
   "end": 6.2667,
   "text": "Everyone on the server called him a fake-noob troll."
  },
  {
   "id": "1.tease",
   "start": 6.2667,
   "end": 8.3,
   "text": "When the owner learned why, everyone built a road."
  },
  {
   "id": "2.signs",
   "start": 8.3,
   "end": 10.5333,
   "text": "Every morning, Arthur placed oak signs from spawn."
  },
  {
   "id": "2.blue",
   "start": 10.5333,
   "end": 12.7667,
   "text": "Each sign pointed straight toward his bright blue roof."
  },
  {
   "id": "2.past",
   "start": 12.7667,
   "end": 15.2,
   "text": "Still, players laughed whenever he walked past his door."
  },
  {
   "id": "2.rex",
   "start": 15.2,
   "end": 17.2333,
   "text": "One bully named Rex followed him mocking every step."
  },
  {
   "id": "3.desk",
   "start": 17.2333,
   "end": 19.8333,
   "text": "In real life, Arthur was seventy-two with fading memory."
  },
  {
   "id": "3.note",
   "start": 19.8333,
   "end": 22.0333,
   "text": "One yellow note sat taped: find the blue roof."
  },
  {
   "id": "3.sam",
   "start": 22.0333,
   "end": 24.2667,
   "text": "His grandson Sam built that cottage before college."
  },
  {
   "id": "3.place",
   "start": 24.2667,
   "end": 26.0667,
   "text": "It was where they could always hang out together."
  },
  {
   "id": "4.rain",
   "start": 26.0667,
   "end": 28.2,
   "text": "One rainy night, Rex pulled a cruel prank."
  },
  {
   "id": "4.break",
   "start": 28.2,
   "end": 30.3333,
   "text": "He smashed every single wooden trail sign down."
  },
  {
   "id": "4.cobble",
   "start": 30.3333,
   "end": 32.4333,
   "text": "Then he covered Arthur's blue roof in grey cobble."
  },
  {
   "id": "4.wander",
   "start": 32.4333,
   "end": 34.6333,
   "text": "That night, Arthur walked past home three times."
  },
  {
   "id": "4.stop",
   "start": 34.6333,
   "end": 36.5333,
   "text": "He stopped dead still in the rain and typed."
  },
  {
   "id": "4.sorry",
   "start": 36.5333,
   "end": 39.2,
   "text": "I am sorry. I cannot find Sam's house."
  },
  {
   "id": "4.left",
   "start": 39.2,
   "end": 42.3,
   "text": "Arthur left the game. Chat went dead quiet."
  },
  {
   "id": "5.owner",
   "start": 42.3,
   "end": 44.5667,
   "text": "The server owner walked into Arthur's empty cottage."
  },
  {
   "id": "5.chest",
   "start": 44.5667,
   "end": 46.4333,
   "text": "He opened the chest and found one book."
  },
  {
   "id": "5.book",
   "start": 46.4333,
   "end": 48.5667,
   "text": "One line read: blue roof, Sam built it."
  },
  {
   "id": "5.ping",
   "start": 48.5667,
   "end": 50.4667,
   "text": "The owner froze—then pinged the whole server!"
  },
  {
   "id": "6.join",
   "start": 50.4667,
   "end": 52.9,
   "text": "Within minutes, twenty-five players flooded back online."
  },
  {
   "id": "6.lode",
   "start": 52.9,
   "end": 55.3333,
   "text": "Because one Minecraft block never forgets where home is."
  },
  {
   "id": "6.comp",
   "start": 55.3333,
   "end": 57.5,
   "text": "Tap a compass on a Lodestone—it locks forever."
  },
  {
   "id": "6.roof",
   "start": 57.5,
   "end": 59.7,
   "text": "All night, they rebuilt his glowing blue wool roof."
  },
  {
   "id": "6.road",
   "start": 59.7,
   "end": 61.8333,
   "text": "They built a blue lantern highway straight from spawn."
  },
  {
   "id": "6.place2",
   "start": 61.8333,
   "end": 63.9333,
   "text": "They set a Lodestone right beside his front door."
  },
  {
   "id": "6.fill",
   "start": 63.9333,
   "end": 66.0333,
   "text": "They filled his chest with twenty-seven Home compasses."
  },
  {
   "id": "7.back",
   "start": 66.0333,
   "end": 68.3,
   "text": "Next evening, Arthur finally joined the game again."
  },
  {
   "id": "7.open",
   "start": 68.3,
   "end": 70.4667,
   "text": "He opened the chest and lifted a purple compass."
  },
  {
   "id": "7.snap",
   "start": 70.4667,
   "end": 72.5333,
   "text": "The red needle snapped straight down the blue road."
  },
  {
   "id": "7.walk",
   "start": 72.5333,
   "end": 74.8333,
   "text": "Arthur followed the glowing lanterns to his blue porch."
  },
  {
   "id": "7.cheer",
   "start": 74.8333,
   "end": 77.5,
   "text": "Twenty-five cheering players waited—even Rex dropping flowers."
  },
  {
   "id": "7.sam2",
   "start": 77.5,
   "end": 79.6333,
   "text": "Then chat pinged once more: Sam joined the game!"
  },
  {
   "id": "7.door",
   "start": 79.6333,
   "end": 81.9333,
   "text": "His grandson stepped out the front door smiling wide."
  },
  {
   "id": "7.found",
   "start": 81.9333,
   "end": 84.1,
   "text": "Arthur smiled at his screen and typed: I found it."
  },
  {
   "id": "7.sub",
   "start": 84.1,
   "end": 86.4,
   "text": "Subscribe if you would help Arthur find home, too."
  }
 ],
