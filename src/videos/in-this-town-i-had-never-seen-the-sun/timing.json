 "cues": [
  {
   "id": "1.sun",
   "start": 0.0,
   "end": 2.1333,
   "text": "In this town, I had never seen the sun."
  },
  {
   "id": "1.nobody",
   "start": 2.1333,
   "end": 3.1667,
   "text": "Nobody had."
  },
  {
   "id": "1.bed",
   "start": 3.1667,
   "end": 4.4667,
   "text": "We went to bed when it came up."
  },
  {
   "id": "1.once",
   "start": 4.4667,
   "end": 6.2333,
   "text": "I wanted to see it. Just once."
  },
  {
   "id": "2.trees",
   "start": 6.2333,
   "end": 8.7,
   "text": "We lived under the big trees, where it was always dark."
  },
  {
   "id": "2.bad",
   "start": 8.7,
   "end": 10.3667,
   "text": "The grown-ups called the sun the bad light."
  },
  {
   "id": "2.rule",
   "start": 10.3667,
   "end": 13.8667,
   "text": "When the sky went pink, you went inside. You shut the door."
  },
  {
   "id": "2.look",
   "start": 13.8667,
   "end": 15.0333,
   "text": "And you did not look."
  },
  {
   "id": "2.line",
   "start": 15.0333,
   "end": 17.8333,
   "text": "But every morning, a line of gold came in under my door."
  },
  {
   "id": "2.floor",
   "start": 17.8333,
   "end": 19.5667,
   "text": "I used to lie on the floor and look at it."
  },
  {
   "id": "2.grandpa",
   "start": 19.5667,
   "end": 21.5667,
   "text": "My grandpa was the oldest one in town."
  },
  {
   "id": "2.rain",
   "start": 21.5667,
   "end": 24.6333,
   "text": "Whenever it rained, he said, \"Ah. The good weather.\""
  },
  {
   "id": "2.why",
   "start": 24.6333,
   "end": 25.6,
   "text": "Nobody knew why."
  },
  {
   "id": "2.puddles",
   "start": 25.6,
   "end": 27.0,
   "text": "I thought he just liked puddles."
  },
  {
   "id": "3.morning",
   "start": 27.0,
   "end": 28.9667,
   "text": "One morning, I did not go to bed."
  },
  {
   "id": "3.wait",
   "start": 28.9667,
   "end": 30.9667,
   "text": "I waited by the door until the sky went pink."
  },
  {
   "id": "3.ran",
   "start": 30.9667,
   "end": 32.0,
   "text": "Then I ran out."
  },
  {
   "id": "3.saw",
   "start": 32.0,
   "end": 33.6333,
   "text": "I saw a gold edge on top of the hill."
  },
  {
   "id": "3.fire",
   "start": 33.6333,
   "end": 34.7333,
   "text": "And then I was on fire."
  },
  {
   "id": "3.mum",
   "start": 34.7333,
   "end": 37.1667,
   "text": "My mum pulled me in and sat on me until it went out."
  },
  {
   "id": "3.toast",
   "start": 37.1667,
   "end": 38.6,
   "text": "I smelled like toast for a week."
  },
  {
   "id": "3.that",
   "start": 38.6,
   "end": 40.5667,
   "text": "So that was that. I thought."
  },
  {
   "id": "4.found",
   "start": 40.5667,
   "end": 43.3667,
   "text": "Then one night, I found a hat at the edge of town."
  },
  {
   "id": "4.iron",
   "start": 43.3667,
   "end": 45.4667,
   "text": "It was made of iron, and it had a dent."
  },
  {
   "id": "4.old",
   "start": 45.4667,
   "end": 47.7333,
   "text": "The old ones said a hat keeps the bad light off."
  },
  {
   "id": "4.long",
   "start": 47.7333,
   "end": 49.4333,
   "text": "They did not say for how long."
  },
  {
   "id": "4.on",
   "start": 49.4333,
   "end": 51.7333,
   "text": "So at sunrise, I put it on."
  },
  {
   "id": "4.out",
   "start": 51.7333,
   "end": 52.8333,
   "text": "And I walked out."
  },
  {
   "id": "5.nothing",
   "start": 52.8333,
   "end": 53.7,
   "text": "Nothing happened."
  },
  {
   "id": "5.colour",
   "start": 53.7,
   "end": 54.8333,
   "text": "And everything had a colour."
  },
  {
   "id": "5.grass",
   "start": 54.8333,
   "end": 57.0333,
   "text": "The grass was green. I had always thought it was grey."
  },
  {
   "id": "5.bees",
   "start": 57.0333,
   "end": 58.5333,
   "text": "There were flowers. There were bees."
  },
  {
   "id": "5.up",
   "start": 58.5333,
   "end": 60.0667,
   "text": "Then I looked up. There it was."
  },
  {
   "id": "5.small",
   "start": 60.0667,
   "end": 62.8,
   "text": "It was smaller than I thought. And I could not look at it for long."
  },
  {
   "id": "5.flower",
   "start": 62.8,
   "end": 66.4667,
   "text": "There was a yellow flower, taller than me. It was looking at the sun too."
  },
  {
   "id": "5.hat",
   "start": 66.4667,
   "end": 69.0667,
   "text": "But the sun was eating my hat. A little at a time."
  },
  {
   "id": "6.kid",
   "start": 69.0667,
   "end": 70.7667,
   "text": "Then a kid from the day town saw me."
  },
  {
   "id": "6.scream",
   "start": 70.7667,
   "end": 71.5,
   "text": "He screamed."
  },
  {
   "id": "6.only",
   "start": 71.5,
   "end": 72.9333,
   "text": "But I was only looking at a flower."
  },
  {
   "id": "6.stop",
   "start": 72.9333,
   "end": 73.6,
   "text": "So he stopped."
  },
  {
   "id": "6.town",
   "start": 73.6,
   "end": 76.2667,
   "text": "He showed me his town. All the doors were open."
  },
  {
   "id": "6.bread",
   "start": 76.2667,
   "end": 78.6667,
   "text": "He gave me bread. I gave him a bone."
  },
  {
   "id": "6.bone",
   "start": 78.6667,
   "end": 81.0,
   "text": "He did not want the bone. He kept it anyway."
  },
  {
   "id": "6.best",
   "start": 81.0,
   "end": 82.6667,
   "text": "It was the best day I ever had."
  },
  {
   "id": "6.crack",
   "start": 82.6667,
   "end": 84.1,
   "text": "Then my hat went crack."
  },
  {
   "id": "7.far",
   "start": 84.1,
   "end": 85.3333,
   "text": "And home was far."
  },
  {
   "id": "7.ran",
   "start": 85.3333,
   "end": 86.1667,
   "text": "I ran."
  },
  {
   "id": "7.broke",
   "start": 86.1667,
   "end": 87.3667,
   "text": "The hat broke in two."
  },
  {
   "id": "7.pond",
   "start": 87.3667,
   "end": 88.5667,
   "text": "So I jumped in the pond."
  },
  {
   "id": "7.neck",
   "start": 88.5667,
   "end": 90.9,
   "text": "The water came up to my neck. It did not burn in there."
  },
  {
   "id": "7.stuck",
   "start": 90.9,
   "end": 92.9,
   "text": "But I could not get out. And it was only noon."
  },
  {
   "id": "7.kid",
   "start": 92.9,
   "end": 95.6667,
   "text": "The kid sat down on the bank. He did not know what to do either."
  },
  {
   "id": "7.grey",
   "start": 95.6667,
   "end": 96.9,
   "text": "Then the sky went grey."
  },
  {
   "id": "7.drop",
   "start": 96.9,
   "end": 98.8,
   "text": "One drop. Then all of it."
  },
  {
   "id": "7.walk",
   "start": 98.8,
   "end": 101.5,
   "text": "And I walked out of the pond, in the day, with nothing on my head."
  },
  {
   "id": "7.nofire",
   "start": 101.5,
   "end": 102.4,
   "text": "No fire."
  },
  {
   "id": "7.good",
   "start": 102.4,
   "end": 104.7333,
   "text": "Now I knew why grandpa called it the good weather."
  },
  {
   "id": "7.been",
   "start": 104.7333,
   "end": 107.1333,
   "text": "He had been out here too. A long time ago."
  },
  {
   "id": "8.edge",
   "start": 107.1333,
   "end": 109.2667,
   "text": "The kid walked me back to the edge of the trees."
  },
  {
   "id": "8.said",
   "start": 109.2667,
   "end": 112.2667,
   "text": "I said, \"Come back tonight. I will show you the stars.\""
  },
  {
   "id": "8.what",
   "start": 112.2667,
   "end": 113.6333,
   "text": "He said, \"What are stars?\""
  },
  {
   "id": "8.never",
   "start": 113.6333,
   "end": 114.6667,
   "text": "He had never seen them."
  },
  {
   "id": "8.his",
   "start": 114.6667,
   "end": 117.3,
   "text": "In his town, they went to bed when the sun went down."
  },
  {
   "id": "8.door",
   "start": 117.3,
   "end": 119.2667,
   "text": "They shut the door. And they did not look."
  },
  {
   "id": "8.dark",
   "start": 119.2667,
   "end": 120.6333,
   "text": "They called it the bad dark."
  },
  {
   "id": "8.same",
   "start": 120.6333,
   "end": 122.9,
   "text": "It was the same rule. Just the other way round."
  },
  {
   "id": "9.meet",
   "start": 122.9,
   "end": 126.2,
   "text": "So now we meet when the sky is pink. It is the one time we are both awake."
  },
  {
   "id": "9.sun",
   "start": 126.2,
   "end": 127.4,
   "text": "He showed me the sun."
  },
  {
   "id": "9.moon",
   "start": 127.4,
   "end": 128.5333,
   "text": "I showed him the moon."
  },
  {
   "id": "9.grandpa",
   "start": 128.5333,
   "end": 130.6,
   "text": "And when it rains, grandpa comes too."
  },
  {
   "id": "9.dad",
   "start": 130.6,
   "end": 132.2333,
   "text": "Then one evening, his dad followed him."
  },
  {
   "id": "9.sub",
   "start": 132.2333,
   "end": 134.3,
   "text": "Like and subscribe to find out what he did."
  }
 ],
