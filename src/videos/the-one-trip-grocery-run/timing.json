 "cues": [
  {
   "id": "1.hus",
   "start": 0.0,
   "end": 2.5,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "1.one",
   "start": 2.5,
   "end": 3.5333,
   "text": "One trip."
  },
  {
   "id": "1.bag",
   "start": 3.5333,
   "end": 6.0,
   "text": "Every bag. Even the eggs."
  },
  {
   "id": "1.how",
   "start": 6.0,
   "end": 9.7,
   "text": "How did I get it all inside without dropping a thing?"
  },
  {
   "id": "2.sat",
   "start": 9.7,
   "end": 13.2667,
   "text": "Last Saturday, my sister made four trips from the car."
  },
  {
   "id": "2.one",
   "start": 13.2667,
   "end": 14.8667,
   "text": "I said I could do it in one."
  },
  {
   "id": "2.eggs",
   "start": 14.8667,
   "end": 16.5667,
   "text": "She asked if the eggs had agreed."
  },
  {
   "id": "2.contest",
   "start": 16.5667,
   "end": 19.2667,
   "text": "She had a plan. I had a contest."
  },
  {
   "id": "3.heavy",
   "start": 19.2667,
   "end": 21.1667,
   "text": "Heavy bags on both arms."
  },
  {
   "id": "3.bread",
   "start": 21.1667,
   "end": 22.5667,
   "text": "The bread went on my head."
  },
  {
   "id": "3.hus",
   "start": 22.5667,
   "end": 25.0667,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "3.swing",
   "start": 25.0667,
   "end": 28.3667,
   "text": "Three cans swung left. The oranges rolled right."
  },
  {
   "id": "3.catch",
   "start": 28.3667,
   "end": 31.8,
   "text": "I caught the oranges. The cans did not catch me."
  },
  {
   "id": "3.wire",
   "start": 31.8,
   "end": 35.3333,
   "text": "By round two, the handles felt like piano wire."
  },
  {
   "id": "4.door",
   "start": 35.3333,
   "end": 38.1667,
   "text": "I tried the door with one foot, both hands full."
  },
  {
   "id": "4.hus",
   "start": 38.1667,
   "end": 40.4667,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "4.open",
   "start": 40.4667,
   "end": 43.7333,
   "text": "The door opened. The carton of eggs opened too."
  },
  {
   "id": "4.sis",
   "start": 43.7333,
   "end": 47.2667,
   "text": "My sister said, maybe leave the eggs in the carton."
  },
  {
   "id": "4.shoe",
   "start": 47.2667,
   "end": 50.4,
   "text": "The next morning, an egg rolled out of my shoe."
  },
  {
   "id": "5.scale",
   "start": 50.4,
   "end": 52.1,
   "text": "So I weighed every bag."
  },
  {
   "id": "5.plan",
   "start": 52.1,
   "end": 55.0,
   "text": "Cans close. Soft things up top."
  },
  {
   "id": "5.tote",
   "start": 55.0,
   "end": 58.7667,
   "text": "A spare tote cushioned the handles. My fingers survived."
  },
  {
   "id": "5.guess",
   "start": 58.7667,
   "end": 60.7667,
   "text": "Guessing the bag’s limit helped less."
  },
  {
   "id": "5.hus",
   "start": 60.7667,
   "end": 63.4333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "5.done",
   "start": 63.4333,
   "end": 67.4333,
   "text": "At last, everything crossed the kitchen in one trip."
  },
  {
   "id": "6.neighbor",
   "start": 67.4333,
   "end": 71.1,
   "text": "Then our neighbor reached the apartment buzzer, both hands full."
  },
  {
   "id": "6.load",
   "start": 71.1,
   "end": 74.3667,
   "text": "She had cans, paper bags, and a watermelon."
  },
  {
   "id": "6.test",
   "start": 74.3667,
   "end": 77.5333,
   "text": "She needed the door. I needed a real test."
  },
  {
   "id": "6.hus",
   "start": 77.5333,
   "end": 80.3,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "6.bags",
   "start": 80.3,
   "end": 82.9333,
   "text": "I took every grocery bag in one load."
  },
  {
   "id": "6.elbow",
   "start": 82.9333,
   "end": 85.1333,
   "text": "Then I pressed the buzzer with my elbow."
  },
  {
   "id": "6.door",
   "start": 85.1333,
   "end": 88.6333,
   "text": "The door clicked. She carried everything inside."
  },
  {
   "id": "7.ours",
   "start": 88.6333,
   "end": 91.2,
   "text": "I carried ours inside in one trip."
  },
  {
   "id": "7.trunk",
   "start": 91.2,
   "end": 93.0,
   "text": "My sister checked the trunk."
  },
  {
   "id": "7.empty",
   "start": 93.0,
   "end": 95.2667,
   "text": "It looked empty until she lifted the blanket."
  },
  {
   "id": "7.potato",
   "start": 95.2667,
   "end": 97.2,
   "text": "One potato sat alone."
  },
  {
   "id": "7.back",
   "start": 97.2,
   "end": 98.2333,
   "text": "I went back for it."
  },
  {
   "id": "7.hus",
   "start": 98.2333,
   "end": 100.9,
   "text": "HUS HUS HUS!"
  }
 ],
