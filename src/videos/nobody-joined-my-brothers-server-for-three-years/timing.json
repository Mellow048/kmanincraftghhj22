 "cues": [
  {
   "id": "1.left",
   "start": 0.0,
   "end": 1.8333,
   "text": "My brother moved out three years ago."
  },
  {
   "id": "1.online",
   "start": 1.8333,
   "end": 5.2667,
   "text": "His server still shows one player online. Every night."
  },
  {
   "id": "1.me",
   "start": 5.2667,
   "end": 5.9667,
   "text": "It's me."
  },
  {
   "id": "2.castle",
   "start": 5.9667,
   "end": 8.1,
   "text": "He left a castle half finished on a hill."
  },
  {
   "id": "2.chest",
   "start": 8.1,
   "end": 10.5667,
   "text": "A chest with his name. A bed with his name."
  },
  {
   "id": "2.stopped",
   "start": 10.5667,
   "end": 13.1333,
   "text": "He stopped building the day he stopped talking to us."
  },
  {
   "id": "2.seed",
   "start": 13.1333,
   "end": 15.9333,
   "text": "I know the seed by heart. I've never told anyone."
  },
  {
   "id": "3.pay",
   "start": 15.9333,
   "end": 18.1333,
   "text": "I pay for the server out of my lunch money."
  },
  {
   "id": "3.night",
   "start": 18.1333,
   "end": 20.4333,
   "text": "Every night I log on and stand in the same spot."
  },
  {
   "id": "3.block",
   "start": 20.4333,
   "end": 22.0667,
   "text": "And I add one block to his castle."
  },
  {
   "id": "4.two",
   "start": 22.0667,
   "end": 24.9333,
   "text": "One block a night. Three years of blocks."
  },
  {
   "id": "4.mobs",
   "start": 24.9333,
   "end": 27.3333,
   "text": "I keep the torches lit and the creepers out."
  },
  {
   "id": "4.roof",
   "start": 27.3333,
   "end": 29.8667,
   "text": "Last month I finished the roof he never started."
  },
  {
   "id": "4.never",
   "start": 29.8667,
   "end": 32.7,
   "text": "He never logged on. Not once in three years."
  },
  {
   "id": "5.birthday",
   "start": 32.7,
   "end": 35.6333,
   "text": "The server shuts down on his birthday. That's Friday."
  },
  {
   "id": "5.sign",
   "start": 35.6333,
   "end": 38.3,
   "text": "So I put a sign at the spawn point, just in case."
  },
  {
   "id": "5.words",
   "start": 38.3,
   "end": 39.9333,
   "text": "It's still here. I kept it."
  },
  {
   "id": "6.friday",
   "start": 39.9333,
   "end": 43.1333,
   "text": "Friday came. One player online. Me."
  },
  {
   "id": "6.two",
   "start": 43.1333,
   "end": 45.3667,
   "text": "Then the list moved. Two players."
  },
  {
   "id": "6.name",
   "start": 45.3667,
   "end": 48.5,
   "text": "His name. After three years, his name."
  },
  {
   "id": "6.wait",
   "start": 48.5,
   "end": 50.2333,
   "text": "I sat there for an hour without moving."
  },
  {
   "id": "7.walked",
   "start": 50.2333,
   "end": 52.7667,
   "text": "He walked the whole castle without saying a word."
  },
  {
   "id": "7.block",
   "start": 52.7667,
   "end": 55.3,
   "text": "Then he put down one block. The last one."
  },
  {
   "id": "7.said",
   "start": 55.3,
   "end": 58.4,
   "text": "He said: I watched the map. Every Sunday."
  },
  {
   "id": "7.light",
   "start": 58.4,
   "end": 61.8333,
   "text": "And the castle was finished. By both of us."
  },
  {
   "id": "7.sub",
   "start": 61.8333,
   "end": 64.8,
   "text": "Subscribe, if you'd keep the lights on for someone."
  }
 ],
