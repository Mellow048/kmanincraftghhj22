{
 "film": "in-this-town-you-cant-drop-your-torch",
 "fps": 30,
 "duration": 114.6667,
 "estimated": true,
 "wordTiming": "estimated",
 "tempo": 1.0,
 "wordsPerMinute": 215.5,
 "audio": null,
 "clips": [],
 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.3,
   "text": "In this town, you can never drop your torch."
  },
  {
   "id": "1.dark",
   "start": 2.3,
   "end": 5.3667,
   "text": "Every night at dusk, living shadows crawl off the trees."
  },
  {
   "id": "1.light",
   "start": 5.3667,
   "end": 7.7333,
   "text": "One bright flame pushes every shadow straight back."
  },
  {
   "id": "1.out",
   "start": 7.7333,
   "end": 10.4667,
   "text": "If your torch goes out, the shadows drag you away."
  },
  {
   "id": "1.sleep",
   "start": 10.4667,
   "end": 13.0333,
   "text": "Even babies sleep with a torch beside their crib."
  },
  {
   "id": "2.barber",
   "start": 13.0333,
   "end": 15.6,
   "text": "Our barber cuts hair while gripping a blazing torch."
  },
  {
   "id": "2.jog",
   "start": 15.6,
   "end": 18.0333,
   "text": "Runners sprint laps holding two torches like glow sticks."
  },
  {
   "id": "2.school",
   "start": 18.0333,
   "end": 20.6,
   "text": "Every kid balances a lit torch on their desk."
  },
  {
   "id": "2.mail",
   "start": 20.6,
   "end": 23.0333,
   "text": "Our last mailman sneezed his torch out on Tuesday."
  },
  {
   "id": "2.fifth",
   "start": 23.0333,
   "end": 25.4,
   "text": "We're already on our fifth mailman this month."
  },
  {
   "id": "3.kai",
   "start": 25.4,
   "end": 27.9333,
   "text": "I'm Kai, and I don't carry a wooden torch."
  },
  {
   "id": "3.pip",
   "start": 27.9333,
   "end": 30.7,
   "text": "I carry a glass jar with one firefly named Pip."
  },
  {
   "id": "3.laugh",
   "start": 30.7,
   "end": 32.9333,
   "text": "Kids point at my jar and yell, bug boy!"
  },
  {
   "id": "3.flint",
   "start": 32.9333,
   "end": 35.3333,
   "text": "Even Chief Flint laughs outside his big coal shop."
  },
  {
   "id": "3.quote",
   "start": 35.3333,
   "end": 37.9333,
   "text": "A tiny bug won't save you from the dark, kid."
  },
  {
   "id": "3.gone",
   "start": 37.9333,
   "end": 39.9667,
   "text": "One gust of wind and you're shadow food."
  },
  {
   "id": "4.mine",
   "start": 39.9667,
   "end": 42.2333,
   "text": "Chief Flint owns the only coal mine in town."
  },
  {
   "id": "4.ten",
   "start": 42.2333,
   "end": 44.6667,
   "text": "Ten emeralds a torch on a calm clear night."
  },
  {
   "id": "4.hundred",
   "start": 44.6667,
   "end": 47.0,
   "text": "When the wind blows, one hundred emeralds each."
  },
  {
   "id": "4.pile",
   "start": 47.0,
   "end": 49.2667,
   "text": "He sits on a giant mountain of black coal."
  },
  {
   "id": "4.thirty",
   "start": 49.2667,
   "end": 52.0,
   "text": "Thirty townsfolk couldn't pay and vanished into the woods."
  },
  {
   "id": "4.mom",
   "start": 52.0,
   "end": 54.5,
   "text": "One was my mom, right after gifting me Pip."
  },
  {
   "id": "5.wind",
   "start": 54.5,
   "end": 57.2,
   "text": "Then tonight at dusk, a howling windstorm slammed town."
  },
  {
   "id": "5.out2",
   "start": 57.2,
   "end": 59.8667,
   "text": "Whoosh! Every single torch on the street blew out!"
  },
  {
   "id": "5.lock",
   "start": 59.8667,
   "end": 62.3333,
   "text": "Chief Flint slammed his iron door and charged two hundred."
  },
  {
   "id": "5.creep",
   "start": 62.3333,
   "end": 64.7667,
   "text": "Tall black shadows crept straight onto the cobble square."
  },
  {
   "id": "5.trap",
   "start": 64.7667,
   "end": 67.6333,
   "text": "My neighbors backed up, waving cold dead sticks in panic."
  },
  {
   "id": "5.broke",
   "start": 67.6333,
   "end": 70.7333,
   "text": "Nobody had two hundred emeralds to buy a storm lantern."
  },
  {
   "id": "6.rule",
   "start": 70.7333,
   "end": 73.4,
   "text": "Then I remembered one simple rule everyone forgot."
  },
  {
   "id": "6.fire",
   "start": 73.4,
   "end": 75.6667,
   "text": "Wind can blow out fire in half a second."
  },
  {
   "id": "6.bug",
   "start": 75.6667,
   "end": 77.9,
   "text": "Wind can never blow out a living glow!"
  },
  {
   "id": "6.open",
   "start": 77.9,
   "end": 80.3667,
   "text": "I popped Pip's jar lid open and held it high."
  },
  {
   "id": "6.fly",
   "start": 80.3667,
   "end": 82.7333,
   "text": "Pip shot upward like a tiny golden star!"
  },
  {
   "id": "6.call",
   "start": 82.7333,
   "end": 85.0,
   "text": "Pip blinked three times toward the dark pine woods."
  },
  {
   "id": "6.swarm",
   "start": 85.0,
   "end": 87.7333,
   "text": "Fifty glowing fireflies burst out and flooded the square!"
  },
  {
   "id": "7.flint2",
   "start": 87.7333,
   "end": 90.4,
   "text": "Chief Flint marched out yelling, bugs aren't legal light!"
  },
  {
   "id": "7.gust",
   "start": 90.4,
   "end": 92.8333,
   "text": "One strong gust blew his fancy lantern right out!"
  },
  {
   "id": "7.mud",
   "start": 92.8333,
   "end": 95.6,
   "text": "He tripped backward into a mud puddle begging for help."
  },
  {
   "id": "7.chase",
   "start": 95.6,
   "end": 98.7,
   "text": "Our glowing swarm chased every shadow back into the trees."
  },
  {
   "id": "7.return",
   "start": 98.7,
   "end": 101.8,
   "text": "All thirty missing townsfolk walked safely out of the woods."
  },
  {
   "id": "7.momback",
   "start": 101.8,
   "end": 104.7333,
   "text": "The very last person stepping into the light was Mom."
  },
  {
   "id": "7.hug",
   "start": 104.7333,
   "end": 107.0,
   "text": "Mom hugged me tight while Pip danced around us."
  },
  {
   "id": "7.closed",
   "start": 107.0,
   "end": 108.9,
   "text": "Chief Flint's coal shop shut down for good."
  },
  {
   "id": "7.free",
   "start": 108.9,
   "end": 111.8333,
   "text": "Now nobody pays a hundred emeralds just to stay bright."
  },
  {
   "id": "7.cta",
   "start": 111.8333,
   "end": 114.6667,
   "text": "Subscribe if you'd keep Pip in your pocket, too!"
  }
 ],
