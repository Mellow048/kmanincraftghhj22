 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.8667,
   "text": "Tariffs, explained using Minecraft."
  },
  {
   "id": "1.jump",
   "start": 1.8667,
   "end": 3.7667,
   "text": "One second this sword costs five emeralds."
  },
  {
   "id": "1.fifteen",
   "start": 3.7667,
   "end": 5.5667,
   "text": "The next second, it jumps to fifteen."
  },
  {
   "id": "1.two",
   "start": 5.5667,
   "end": 7.5667,
   "text": "Picture two Minecraft islands across one bridge."
  },
  {
   "id": "1.special",
   "start": 7.5667,
   "end": 10.2667,
   "text": "Red Island bakes bread. Blue Island crafts swords."
  },
  {
   "id": "2.felint",
   "start": 10.2667,
   "end": 11.4,
   "text": "Meet Felint from Red Island."
  },
  {
   "id": "2.sam",
   "start": 11.4,
   "end": 13.5,
   "text": "Local smith Sam charges twelve emeralds per sword."
  },
  {
   "id": "2.cost",
   "start": 13.5,
   "end": 15.1667,
   "text": "Sam pays high iron costs at home."
  },
  {
   "id": "2.cross",
   "start": 15.1667,
   "end": 17.5333,
   "text": "Then Felint crosses over to the other side, Blue Island."
  },
  {
   "id": "2.five",
   "start": 17.5333,
   "end": 19.8333,
   "text": "Blue smith Alex sells the same sword for five!"
  },
  {
   "id": "2.deal",
   "start": 19.8333,
   "end": 21.4667,
   "text": "Felint buys it and saves seven emeralds."
  },
  {
   "id": "2.rush",
   "start": 21.4667,
   "end": 23.2667,
   "text": "Soon the whole town sprints across to shop."
  },
  {
   "id": "2.empty",
   "start": 23.2667,
   "end": 25.3,
   "text": "Back home, Sam stares at empty chests."
  },
  {
   "id": "2.close",
   "start": 25.3,
   "end": 27.6,
   "text": "With zero buyers, Sam might shut his shop."
  },
  {
   "id": "3.beg",
   "start": 27.6,
   "end": 29.0667,
   "text": "So Sam runs straight to Mayor Sterling."
  },
  {
   "id": "3.idea",
   "start": 29.0667,
   "end": 30.9333,
   "text": "Sterling smiles and slams down a red gate."
  },
  {
   "id": "3.rule",
   "start": 30.9333,
   "end": 32.5333,
   "text": "He stamps one rule on every foreign sword."
  },
  {
   "id": "3.tax",
   "start": 32.5333,
   "end": 34.1667,
   "text": "Ten extra emeralds just to cross this bridge!"
  },
  {
   "id": "3.name",
   "start": 34.1667,
   "end": 35.6333,
   "text": "That border tax on imports is a tariff."
  },
  {
   "id": "3.math",
   "start": 35.6333,
   "end": 37.9333,
   "text": "Blue swords cost five, plus ten at customs."
  },
  {
   "id": "3.total",
   "start": 37.9333,
   "end": 39.6667,
   "text": "Total price, fifteen emeralds at the counter!"
  },
  {
   "id": "3.switch",
   "start": 39.6667,
   "end": 41.2667,
   "text": "Now Sam's twelve emerald sword looks cheap."
  },
  {
   "id": "3.cheer",
   "start": 41.2667,
   "end": 43.1,
   "text": "Sam cheers as shoppers walk back inside."
  },
  {
   "id": "4.wait",
   "start": 43.1,
   "end": 45.5667,
   "text": "Wait, who actually paid that ten emerald tax?"
  },
  {
   "id": "4.notblue",
   "start": 45.5667,
   "end": 47.4,
   "text": "Not Blue Island. Alex still keeps five."
  },
  {
   "id": "4.felintpays",
   "start": 47.4,
   "end": 49.3333,
   "text": "Felint pays more, even buying from Sam!"
  },
  {
   "id": "4.before",
   "start": 49.3333,
   "end": 51.2333,
   "text": "Before the tariff, Felint paid five emeralds."
  },
  {
   "id": "4.after",
   "start": 51.2333,
   "end": 52.9,
   "text": "Now twelve is the cheapest sword left."
  },
  {
   "id": "4.mad",
   "start": 52.9,
   "end": 55.1667,
   "text": "Worse, Blue Mayor Cobalt spots the red gate."
  },
  {
   "id": "4.revenge",
   "start": 55.1667,
   "end": 57.1333,
   "text": "He slams a revenge tax on Red bread!"
  },
  {
   "id": "4.baker",
   "start": 57.1333,
   "end": 59.3667,
   "text": "Red baker Maya watches her foreign sales vanish."
  },
  {
   "id": "4.war",
   "start": 59.3667,
   "end": 61.1,
   "text": "Now both islands lock down in a trade war."
  },
  {
   "id": "4.stacks",
   "start": 61.1,
   "end": 63.0,
   "text": "Prices spike while chests sit half empty."
  },
  {
   "id": "5.three",
   "start": 63.0,
   "end": 65.0,
   "text": "Every tariff creates three clear Minecraft effects."
  },
  {
   "id": "5.one",
   "start": 65.0,
   "end": 67.0333,
   "text": "One, it shields local builders like Sam."
  },
  {
   "id": "5.two",
   "start": 67.0333,
   "end": 69.2,
   "text": "Two, shoppers like Felint pay higher prices."
  },
  {
   "id": "5.three2",
   "start": 69.2,
   "end": 71.3,
   "text": "Three, rival islands almost always hit back."
  },
  {
   "id": "5.gov",
   "start": 71.3,
   "end": 73.3,
   "text": "Meanwhile, Mayor Sterling piles up tax emeralds."
  },
  {
   "id": "5.choice",
   "start": 73.3,
   "end": 74.8333,
   "text": "So tariffs are never free foreign money."
  },
  {
   "id": "5.trade",
   "start": 74.8333,
   "end": 76.4,
   "text": "They trade cheap goods for local jobs."
  },
  {
   "id": "5.ask",
   "start": 76.4,
   "end": 77.5667,
   "text": "Would you pay extra to save Sam?"
  },
  {
   "id": "5.or",
   "start": 77.5667,
   "end": 78.8667,
   "text": "Or cross the bridge for five emeralds?"
  },
  {
   "id": "5.tell",
   "start": 78.8667,
   "end": 80.1,
   "text": "Drop your side in the comments now."
  },
  {
   "id": "5.loop",
   "start": 80.1,
   "end": 82.6,
   "text": "Because border taxes hit your bill, and that is"
  }
 ],
