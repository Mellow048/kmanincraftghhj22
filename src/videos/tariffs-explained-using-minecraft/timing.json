 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 2.1,
   "text": "Tariffs, explained using Minecraft."
  },
  {
   "id": "1.jump",
   "start": 2.1,
   "end": 4.0333,
   "text": "One second this sword costs five emeralds."
  },
  {
   "id": "1.fifteen",
   "start": 4.0333,
   "end": 6.0,
   "text": "The next second, it jumps to fifteen."
  },
  {
   "id": "1.two",
   "start": 6.0,
   "end": 8.3,
   "text": "Picture two Minecraft villages across one bridge."
  },
  {
   "id": "1.special",
   "start": 8.3,
   "end": 11.4,
   "text": "Red Village bakes bread. Blue Village crafts swords."
  },
  {
   "id": "2.leo",
   "start": 11.4,
   "end": 12.5667,
   "text": "Meet Leo from Red Village."
  },
  {
   "id": "2.sam",
   "start": 12.5667,
   "end": 14.7,
   "text": "Local smith Sam charges twelve emeralds per sword."
  },
  {
   "id": "2.cost",
   "start": 14.7,
   "end": 16.2333,
   "text": "Sam pays high iron costs at home."
  },
  {
   "id": "2.cross",
   "start": 16.2333,
   "end": 17.9,
   "text": "Then Leo crosses the bridge to Blue Village."
  },
  {
   "id": "2.five",
   "start": 17.9,
   "end": 19.9333,
   "text": "Blue smith Alex sells the same sword for five!"
  },
  {
   "id": "2.deal",
   "start": 19.9333,
   "end": 21.6333,
   "text": "Leo buys it and saves seven emeralds."
  },
  {
   "id": "2.rush",
   "start": 21.6333,
   "end": 23.8,
   "text": "Soon the whole town sprints across to shop."
  },
  {
   "id": "2.empty",
   "start": 23.8,
   "end": 26.1333,
   "text": "Back home, Sam stares at empty chests."
  },
  {
   "id": "2.close",
   "start": 26.1333,
   "end": 28.5667,
   "text": "With zero buyers, Sam might shut his shop."
  },
  {
   "id": "3.beg",
   "start": 28.5667,
   "end": 30.1667,
   "text": "So Sam runs straight to Mayor Sterling."
  },
  {
   "id": "3.idea",
   "start": 30.1667,
   "end": 32.1667,
   "text": "Sterling smiles and slams down a red gate."
  },
  {
   "id": "3.rule",
   "start": 32.1667,
   "end": 33.9,
   "text": "He stamps one rule on every foreign sword."
  },
  {
   "id": "3.tax",
   "start": 33.9,
   "end": 35.6333,
   "text": "Ten extra emeralds just to cross this bridge!"
  },
  {
   "id": "3.name",
   "start": 35.6333,
   "end": 37.2333,
   "text": "That border tax on imports is a tariff."
  },
  {
   "id": "3.math",
   "start": 37.2333,
   "end": 39.7333,
   "text": "Blue swords cost five, plus ten at customs."
  },
  {
   "id": "3.total",
   "start": 39.7333,
   "end": 41.6,
   "text": "Total price, fifteen emeralds at the counter!"
  },
  {
   "id": "3.switch",
   "start": 41.6,
   "end": 43.3333,
   "text": "Now Sam's twelve emerald sword looks cheap."
  },
  {
   "id": "3.cheer",
   "start": 43.3333,
   "end": 45.2,
   "text": "Sam cheers as shoppers walk back inside."
  },
  {
   "id": "4.wait",
   "start": 45.2,
   "end": 47.7,
   "text": "Wait, who actually paid that ten emerald tax?"
  },
  {
   "id": "4.notblue",
   "start": 47.7,
   "end": 50.0,
   "text": "Not Blue Village. Alex still keeps five."
  },
  {
   "id": "4.leopays",
   "start": 50.0,
   "end": 52.3,
   "text": "Leo pays more, even buying from Sam!"
  },
  {
   "id": "4.before",
   "start": 52.3,
   "end": 54.4333,
   "text": "Before the tariff, Leo paid five emeralds."
  },
  {
   "id": "4.after",
   "start": 54.4333,
   "end": 56.1667,
   "text": "Now twelve is the cheapest sword left."
  },
  {
   "id": "4.mad",
   "start": 56.1667,
   "end": 58.6,
   "text": "Worse, Blue Mayor Cobalt spots the red gate."
  },
  {
   "id": "4.revenge",
   "start": 58.6,
   "end": 60.4333,
   "text": "He slams a revenge tax on Red bread!"
  },
  {
   "id": "4.baker",
   "start": 60.4333,
   "end": 62.6667,
   "text": "Red baker Maya watches her foreign sales vanish."
  },
  {
   "id": "4.war",
   "start": 62.6667,
   "end": 64.4,
   "text": "Now both bridges block in a trade war."
  },
  {
   "id": "4.stacks",
   "start": 64.4,
   "end": 66.4,
   "text": "Prices spike while chests sit half empty."
  },
  {
   "id": "5.three",
   "start": 66.4,
   "end": 68.5333,
   "text": "Every tariff creates three clear Minecraft effects."
  },
  {
   "id": "5.one",
   "start": 68.5333,
   "end": 70.7,
   "text": "One, it shields local builders like Sam."
  },
  {
   "id": "5.two",
   "start": 70.7,
   "end": 72.9667,
   "text": "Two, shoppers like Leo pay higher prices."
  },
  {
   "id": "5.three2",
   "start": 72.9667,
   "end": 75.5,
   "text": "Three, rival villages almost always hit back."
  },
  {
   "id": "5.gov",
   "start": 75.5,
   "end": 77.5333,
   "text": "Meanwhile, Mayor Sterling piles up tax emeralds."
  },
  {
   "id": "5.choice",
   "start": 77.5333,
   "end": 79.2333,
   "text": "So tariffs are never free foreign money."
  },
  {
   "id": "5.trade",
   "start": 79.2333,
   "end": 80.9,
   "text": "They trade cheap goods for local jobs."
  },
  {
   "id": "5.ask",
   "start": 80.9,
   "end": 82.2,
   "text": "Would you pay extra to save Sam?"
  },
  {
   "id": "5.or",
   "start": 82.2,
   "end": 83.6667,
   "text": "Or cross the bridge for five emeralds?"
  },
  {
   "id": "5.tell",
   "start": 83.6667,
   "end": 85.1,
   "text": "Drop your side in the comments now."
  },
  {
   "id": "5.loop",
   "start": 85.1,
   "end": 87.4667,
   "text": "Because border taxes hit your bill, and that is"
  }
 ],
