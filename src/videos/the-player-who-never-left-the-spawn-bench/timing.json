 "cues": [
  {
   "id": "1.bench",
   "start": 0.0,
   "end": 1.9,
   "text": "There was a player who never left the spawn bench."
  },
  {
   "id": "1.four",
   "start": 1.9,
   "end": 4.3667,
   "text": "Every day at four, Maya logged in and sat down."
  },
  {
   "id": "1.hi",
   "start": 4.3667,
   "end": 6.4,
   "text": "She never mined diamonds, and never fought a mob."
  },
  {
   "id": "1.chat",
   "start": 6.4,
   "end": 7.8,
   "text": "All she ever typed in chat was hi."
  },
  {
   "id": "1.back",
   "start": 7.8,
   "end": 10.3333,
   "text": "And whenever someone returned, she typed welcome back."
  },
  {
   "id": "2.hut",
   "start": 10.3333,
   "end": 12.0333,
   "text": "She didn't even build a tiny dirt hut."
  },
  {
   "id": "2.walk",
   "start": 12.0333,
   "end": 14.4667,
   "text": "Players ran past her wearing full shiny diamond armor."
  },
  {
   "id": "2.wave",
   "start": 14.4667,
   "end": 16.3,
   "text": "Maya just stayed on that oak bench and waved."
  },
  {
   "id": "2.bot",
   "start": 16.3,
   "end": 18.6333,
   "text": "People started joking she was a lazy AFK bot."
  },
  {
   "id": "2.why",
   "start": 18.6333,
   "end": 20.8333,
   "text": "Nobody once stopped to ask why she never moved."
  },
  {
   "id": "3.jake",
   "start": 20.8333,
   "end": 23.2333,
   "text": "Then one afternoon, a griefer named Jake got annoyed."
  },
  {
   "id": "3.tnt",
   "start": 23.2333,
   "end": 25.7,
   "text": "He dropped red TNT right under Maya's wooden bench."
  },
  {
   "id": "3.boom",
   "start": 25.7,
   "end": 28.2667,
   "text": "Boom! Wood splinters flew across the whole spawn square."
  },
  {
   "id": "3.type",
   "start": 28.2667,
   "end": 30.4667,
   "text": "Jake laughed and typed, go actually play the game."
  },
  {
   "id": "3.stand",
   "start": 30.4667,
   "end": 32.5,
   "text": "Maya stood still in the crater for ten seconds."
  },
  {
   "id": "3.sorry",
   "start": 32.5,
   "end": 34.7,
   "text": "She slowly typed one word in chat: sorry."
  },
  {
   "id": "3.left",
   "start": 34.7,
   "end": 37.6333,
   "text": "Then Maya disconnected, and didn't log back on."
  },
  {
   "id": "4.days",
   "start": 37.6333,
   "end": 39.7667,
   "text": "Three days passed, and the bench spot stayed empty."
  },
  {
   "id": "4.join",
   "start": 39.7667,
   "end": 42.0333,
   "text": "Then Maya's account joined, and her older sister typed."
  },
  {
   "id": "4.hands",
   "start": 42.0333,
   "end": 43.9667,
   "text": "Maya's hands shake too hard to hold a mouse."
  },
  {
   "id": "4.keys",
   "start": 43.9667,
   "end": 45.8667,
   "text": "She can only press two keyboard keys at once."
  },
  {
   "id": "4.desk",
   "start": 45.8667,
   "end": 48.0667,
   "text": "At school, kids stared whenever she dropped her pencil."
  },
  {
   "id": "4.only",
   "start": 48.0667,
   "end": 50.1333,
   "text": "That spawn bench was the one place nobody stared."
  },
  {
   "id": "4.loved",
   "start": 50.1333,
   "end": 52.8667,
   "text": "Saying hi to everyone was her favorite part of day."
  },
  {
   "id": "5.quiet",
   "start": 52.8667,
   "end": 55.0,
   "text": "The entire server chat went dead silent for minutes."
  },
  {
   "id": "5.jake2",
   "start": 55.0,
   "end": 56.5,
   "text": "Jake stared at the crater he blew up."
  },
  {
   "id": "5.owner",
   "start": 56.5,
   "end": 59.0667,
   "text": "Then the server owner typed: grab your oak planks."
  },
  {
   "id": "6.forty",
   "start": 59.0667,
   "end": 61.0,
   "text": "Forty players showed up at spawn that same night."
  },
  {
   "id": "6.build",
   "start": 61.0,
   "end": 63.2,
   "text": "They rebuilt her oak bench with warm glowing lanterns."
  },
  {
   "id": "6.plate",
   "start": 63.2,
   "end": 65.0667,
   "text": "They wired a pressure plate right by her seat."
  },
  {
   "id": "6.auto",
   "start": 65.0667,
   "end": 67.1667,
   "text": "One tiny tap auto-typed welcome back in chat!"
  },
  {
   "id": "6.town",
   "start": 67.1667,
   "end": 69.7667,
   "text": "Then they built a whole cozy village around her."
  },
  {
   "id": "7.back2",
   "start": 69.7667,
   "end": 72.0,
   "text": "The next afternoon at four, Maya logged back in."
  },
  {
   "id": "7.line",
   "start": 72.0,
   "end": 74.2333,
   "text": "Forty players were lined up, waving and cheering."
  },
  {
   "id": "7.flowers",
   "start": 74.2333,
   "end": 76.3333,
   "text": "Jake walked up and dropped bright red flowers down."
  },
  {
   "id": "7.glad",
   "start": 76.3333,
   "end": 78.5,
   "text": "He typed, glad you're back, and sat beside her."
  },
  {
   "id": "7.home",
   "start": 78.5,
   "end": 80.8,
   "text": "Maya didn't type sorry—she just typed, I'm home."
  },
  {
   "id": "7.cta",
   "start": 80.8,
   "end": 82.9333,
   "text": "Subscribe if you'd save Maya a seat, too!"
  }
 ],
