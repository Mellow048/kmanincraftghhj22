 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 0.6667,
   "text": "In this town,"
  },
  {
   "id": "1.hook",
   "start": 0.6667,
   "end": 4.0333,
   "text": "i was a spy, My goal is to see what the pillagers is planning."
  },
  {
   "id": "2.start",
   "start": 4.0333,
   "end": 5.6333,
   "text": "it all started when i sneaked inside"
  },
  {
   "id": "2.clothes",
   "start": 5.6333,
   "end": 7.1,
   "text": "and grabbed some clothes to disguise me"
  },
  {
   "id": "2.pillager",
   "start": 7.1,
   "end": 7.7333,
   "text": "as a pillager."
  },
  {
   "id": "3.hood",
   "start": 7.7333,
   "end": 9.2333,
   "text": "I pulled my hood low, slipped into"
  },
  {
   "id": "3.line",
   "start": 9.2333,
   "end": 11.4667,
   "text": "their marching line, and copied every stomp."
  },
  {
   "id": "4.post",
   "start": 11.4667,
   "end": 12.8667,
   "text": "I walked straight into a post,"
  },
  {
   "id": "4.turn",
   "start": 12.8667,
   "end": 14.6,
   "text": "spun around, and saluted it. The"
  },
  {
   "id": "4.answer",
   "start": 14.6,
   "end": 15.6667,
   "text": "pillagers saluted back."
  },
  {
   "id": "5.whistle",
   "start": 15.6667,
   "end": 17.4667,
   "text": "A whistle blew. They charged a giant"
  },
  {
   "id": "5.ram",
   "start": 17.4667,
   "end": 19.0,
   "text": "battering ram at a wooden bell tower"
  },
  {
   "id": "5.crash",
   "start": 19.0,
   "end": 20.1,
   "text": "until it crashed down."
  },
  {
   "id": "6.rebuild",
   "start": 20.1,
   "end": 21.9,
   "text": "They rebuilt it and charged again."
  },
  {
   "id": "6.tower",
   "start": 21.9,
   "end": 23.8667,
   "text": "I recognized the tower. It was ours."
  },
  {
   "id": "7.sign",
   "start": 23.8667,
   "end": 25.4,
   "text": "Beside it, the pillagers had painted"
  },
  {
   "id": "7.sun",
   "start": 25.4,
   "end": 27.1667,
   "text": "a rising sun. Their leader pointed at"
  },
  {
   "id": "7.point",
   "start": 27.1667,
   "end": 28.6333,
   "text": "the sun, then our bell."
  },
  {
   "id": "7.dawn",
   "start": 28.6333,
   "end": 29.9667,
   "text": "At dawn they would smash it before"
  },
  {
   "id": "7.warn",
   "start": 29.9667,
   "end": 31.0,
   "text": "we could warn the village."
  },
  {
   "id": "8.join",
   "start": 31.0,
   "end": 32.3667,
   "text": "I joined the ram crew and pushed"
  },
  {
   "id": "8.push",
   "start": 32.3667,
   "end": 34.1333,
   "text": "with them. The wheels bounced over rocks"
  },
  {
   "id": "8.turn",
   "start": 34.1333,
   "end": 35.9,
   "text": "and nearly tipped at a tight turn."
  },
  {
   "id": "9.heave",
   "start": 35.9,
   "end": 37.8667,
   "text": "Everyone heaved, the ram lurched around,"
  },
  {
   "id": "9.weakness",
   "start": 37.8667,
   "end": 39.8667,
   "text": "and I saw its weakness: it could barely turn."
  },
  {
   "id": "10.slip",
   "start": 39.8667,
   "end": 42.0,
   "text": "When the drill marched past, I slipped away,"
  },
  {
   "id": "10.log",
   "start": 42.0,
   "end": 43.7333,
   "text": "ducked under a swinging log, and weaved"
  },
  {
   "id": "10.home",
   "start": 43.7333,
   "end": 46.0,
   "text": "through crossbow practice. I ran all the way home."
  },
  {
   "id": "11.warn",
   "start": 46.0,
   "end": 48.0667,
   "text": "I showed the villagers the ram's slow turn."
  },
  {
   "id": "11.carts",
   "start": 48.0667,
   "end": 50.1333,
   "text": "We dragged market carts, barrels, and hay bales"
  },
  {
   "id": "11.path",
   "start": 50.1333,
   "end": 52.0667,
   "text": "into a sharp zigzag across the road."
  },
  {
   "id": "12.charge",
   "start": 52.0667,
   "end": 54.0667,
   "text": "At sunrise, the pillagers charged."
  },
  {
   "id": "12.ram",
   "start": 54.0667,
   "end": 55.4333,
   "text": "The ram rattled through the turns,"
  },
  {
   "id": "12.swing",
   "start": 55.4333,
   "end": 57.4,
   "text": "swung wide, and buried itself in hay."
  },
  {
   "id": "12.bell",
   "start": 57.4,
   "end": 60.3333,
   "text": "The bell was safe. One ring made the whole village cheer."
  },
  {
   "id": "13.march",
   "start": 60.3333,
   "end": 62.8333,
   "text": "I marched away proudly, still walking like a pillager,"
  },
  {
   "id": "13.stumble",
   "start": 62.8333,
   "end": 64.4667,
   "text": "and stepped straight into the hay."
  },
  {
   "id": "14.sub",
   "start": 64.4667,
   "end": 66.4,
   "text": "Subscribe before I hit the hay."
  }
 ],
