 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 1.7667,
   "text": "In this town, I was a spy."
  },
  {
   "id": "1.goal",
   "start": 1.7667,
   "end": 4.0333,
   "text": "My goal was to see what the pillagers were planning."
  },
  {
   "id": "2.raid",
   "start": 4.0333,
   "end": 7.4333,
   "text": "Every month, the pillagers came out of the woods and raided our town."
  },
  {
   "id": "2.took",
   "start": 7.4333,
   "end": 11.0,
   "text": "They took our bread. They took our emeralds. Once, they took our bell."
  },
  {
   "id": "2.when",
   "start": 11.0,
   "end": 12.6333,
   "text": "And we never knew when they were coming."
  },
  {
   "id": "2.need",
   "start": 12.6333,
   "end": 14.7333,
   "text": "So the town needed a spy, to find out."
  },
  {
   "id": "3.asked",
   "start": 14.7333,
   "end": 17.6,
   "text": "They asked who wanted to go. Everyone took one step back."
  },
  {
   "id": "3.me",
   "start": 17.6,
   "end": 19.0333,
   "text": "I was looking at a butterfly."
  },
  {
   "id": "4.outpost",
   "start": 19.0333,
   "end": 21.6,
   "text": "The pillagers lived in an outpost, deep in the woods."
  },
  {
   "id": "4.guard",
   "start": 21.6,
   "end": 23.5667,
   "text": "The guard at the gate was asleep standing up."
  },
  {
   "id": "4.start",
   "start": 23.5667,
   "end": 25.2,
   "text": "It all started when I sneaked inside"
  },
  {
   "id": "4.clothes",
   "start": 25.2,
   "end": 27.2667,
   "text": "and grabbed some clothes to disguise me as a pillager."
  },
  {
   "id": "5.grey",
   "start": 27.2667,
   "end": 29.3667,
   "text": "But pillagers are grey. I am not."
  },
  {
   "id": "5.ash",
   "start": 29.3667,
   "end": 31.9667,
   "text": "So I rolled in the ash of their campfire."
  },
  {
   "id": "6.line",
   "start": 31.9667,
   "end": 33.7333,
   "text": "In the morning, I stood in their line."
  },
  {
   "id": "6.stare",
   "start": 33.7333,
   "end": 35.5667,
   "text": "One of them stared at my face for a long time."
  },
  {
   "id": "6.new",
   "start": 35.5667,
   "end": 38.6333,
   "text": "Then he grunted at me. I grunted back. We were friends now."
  },
  {
   "id": "6.smart",
   "start": 38.6333,
   "end": 40.7,
   "text": "Pillagers are strong. They are not smart."
  },
  {
   "id": "6.wall",
   "start": 40.7,
   "end": 43.4333,
   "text": "One of them walked into a wall all morning. Nobody helped him."
  },
  {
   "id": "7.bow",
   "start": 43.4333,
   "end": 44.9,
   "text": "Then they made us practise marching."
  },
  {
   "id": "7.hat",
   "start": 44.9,
   "end": 47.1333,
   "text": "I tripped, and knocked the banner right off the captain."
  },
  {
   "id": "7.point",
   "start": 47.1333,
   "end": 49.6333,
   "text": "Everyone turned around. I pointed at the guy next to me."
  },
  {
   "id": "7.pond",
   "start": 49.6333,
   "end": 51.7,
   "text": "He had to wash the ravager for a week."
  },
  {
   "id": "8.night",
   "start": 51.7,
   "end": 53.7,
   "text": "That night, I went looking for the plan."
  },
  {
   "id": "8.table",
   "start": 53.7,
   "end": 56.1667,
   "text": "It was on a table, at the top of the outpost."
  },
  {
   "id": "8.map",
   "start": 56.1667,
   "end": 58.7,
   "text": "A map of my town, with a red X on our bell."
  },
  {
   "id": "8.dawn",
   "start": 58.7,
   "end": 62.1333,
   "text": "They were coming tomorrow, before sunrise. And they would take the bell first,"
  },
  {
   "id": "8.warn",
   "start": 62.1333,
   "end": 63.6333,
   "text": "so nobody could warn anyone."
  },
  {
   "id": "8.ravager",
   "start": 63.6333,
   "end": 65.8667,
   "text": "And this time, they were bringing a ravager."
  },
  {
   "id": "8.window",
   "start": 65.8667,
   "end": 68.5,
   "text": "I had to get home. I climbed out of the window."
  },
  {
   "id": "9.captain",
   "start": 68.5,
   "end": 70.0667,
   "text": "The captain was standing right under it."
  },
  {
   "id": "9.done",
   "start": 70.0667,
   "end": 70.9333,
   "text": "I thought I was finished."
  },
  {
   "id": "9.banner",
   "start": 70.9333,
   "end": 71.9667,
   "text": "He handed me the banner."
  },
  {
   "id": "9.rule",
   "start": 71.9667,
   "end": 75.8,
   "text": "The banner goes in front, and everyone follows the banner. It is the only rule pillagers have."
  },
  {
   "id": "9.grunt",
   "start": 75.8,
   "end": 77.6667,
   "text": "He said I had the best grunt in the outpost."
  },
  {
   "id": "9.lead",
   "start": 77.6667,
   "end": 80.3,
   "text": "So now I was leading the raid. On my own town."
  },
  {
   "id": "10.march",
   "start": 80.3,
   "end": 83.9667,
   "text": "We marched out in the dark. Forty pillagers, one ravager, and me in front."
  },
  {
   "id": "10.lights",
   "start": 83.9667,
   "end": 86.5,
   "text": "I could see the lights of my town. My mum had left one on for me."
  },
  {
   "id": "10.idea",
   "start": 86.5,
   "end": 88.5,
   "text": "Then I had an idea. It was not a good one."
  },
  {
   "id": "11.left",
   "start": 88.5,
   "end": 89.4333,
   "text": "I turned left."
  },
  {
   "id": "11.follow",
   "start": 89.4333,
   "end": 91.8333,
   "text": "They all turned left. Nobody asked why."
  },
  {
   "id": "11.again",
   "start": 91.8333,
   "end": 94.9,
   "text": "So I turned left again. And again. And again."
  },
  {
   "id": "11.night",
   "start": 94.9,
   "end": 96.3667,
   "text": "We walked all night."
  },
  {
   "id": "12.sun",
   "start": 96.3667,
   "end": 99.2333,
   "text": "At sunrise, there was a tower in front of us, in the fog."
  },
  {
   "id": "12.charge",
   "start": 99.2333,
   "end": 100.8667,
   "text": "The captain yelled, and they charged."
  },
  {
   "id": "12.smash",
   "start": 100.8667,
   "end": 104.0667,
   "text": "They smashed the gate. They burned the tower. The ravager ate the kitchen."
  },
  {
   "id": "12.cheer",
   "start": 104.0667,
   "end": 105.9667,
   "text": "They cheered. Then they stopped cheering."
  },
  {
   "id": "12.own",
   "start": 105.9667,
   "end": 107.6333,
   "text": "It was their own outpost."
  },
  {
   "id": "13.look",
   "start": 107.6333,
   "end": 110.6,
   "text": "The captain looked at the tower. Then at the banner. Then at me."
  },
  {
   "id": "13.rain",
   "start": 110.6,
   "end": 112.2333,
   "text": "And that was when it started to rain."
  },
  {
   "id": "13.ash",
   "start": 112.2333,
   "end": 114.0667,
   "text": "I felt the ash run down my face."
  },
  {
   "id": "13.ohno",
   "start": 114.0667,
   "end": 115.1667,
   "text": "Oh no."
  },
  {
   "id": "14.sub",
   "start": 115.1667,
   "end": 117.0,
   "text": "Like and subscribe for part two."
  }
 ],
