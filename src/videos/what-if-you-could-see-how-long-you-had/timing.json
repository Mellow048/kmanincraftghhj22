 "cues": [
  {
   "id": "1.what",
   "start": 0.0,
   "end": 1.7,
   "text": "What if you could see how long you had?"
  },
  {
   "id": "1.live",
   "start": 1.7,
   "end": 3.0333,
   "text": "Not how long you had to live."
  },
  {
   "id": "1.temper",
   "start": 3.0333,
   "end": 4.6667,
   "text": "How long before you lost your temper."
  },
  {
   "id": "1.me",
   "start": 4.6667,
   "end": 6.0,
   "text": "One morning, I could."
  },
  {
   "id": "2.before",
   "start": 6.0,
   "end": 7.4,
   "text": "The boy in front of me had four."
  },
  {
   "id": "2.four",
   "start": 7.4,
   "end": 9.5333,
   "text": "Four seconds. I did not know four what."
  },
  {
   "id": "2.up",
   "start": 9.5333,
   "end": 12.2667,
   "text": "Then his shoulders went up, and he was shouting at the teacher."
  },
  {
   "id": "3.teacher",
   "start": 12.2667,
   "end": 14.1,
   "text": "My teacher had forty. He was fine."
  },
  {
   "id": "3.lady",
   "start": 14.1,
   "end": 16.3333,
   "text": "The dinner lady had two, so I let people go first."
  },
  {
   "id": "3.brother",
   "start": 16.3333,
   "end": 19.0667,
   "text": "My brother had three. I gave him the remote before he asked."
  },
  {
   "id": "3.easy",
   "start": 19.0667,
   "end": 20.6333,
   "text": "This was going to be easy."
  },
  {
   "id": "3.limit",
   "start": 20.6333,
   "end": 22.8333,
   "text": "A clock told you when. Nothing told you why."
  },
  {
   "id": "4.warn",
   "start": 22.8333,
   "end": 25.8667,
   "text": "I told a boy he had ten seconds. He told me to get lost."
  },
  {
   "id": "4.friday",
   "start": 25.8667,
   "end": 28.1,
   "text": "Every Friday, two people got a clock I did not expect."
  },
  {
   "id": "4.wrong",
   "start": 28.1,
   "end": 30.0333,
   "text": "So I stopped guessing out loud."
  },
  {
   "id": "5.jo",
   "start": 30.0333,
   "end": 33.2333,
   "text": "Jo sits by the door. Jo does not have a clock."
  },
  {
   "id": "5.why",
   "start": 33.2333,
   "end": 35.6333,
   "text": "Not a big number. Nothing. I asked her about it."
  },
  {
   "id": "5.shrug",
   "start": 35.6333,
   "end": 38.7667,
   "text": "She said, what are you looking at? I said, nothing."
  },
  {
   "id": "6.plant",
   "start": 38.7667,
   "end": 42.0333,
   "text": "A clock tells you when. Nothing tells you why."
  },
  {
   "id": "6.wave",
   "start": 42.0333,
   "end": 44.6667,
   "text": "I said that out loud, once, and forgot about it."
  },
  {
   "id": "7.week",
   "start": 44.6667,
   "end": 47.1,
   "text": "So I spent a week being the only calm person in school."
  },
  {
   "id": "7.hands",
   "start": 47.1,
   "end": 49.6333,
   "text": "I got very good at school that week. I was very bad at people."
  },
  {
   "id": "7.wrong2",
   "start": 49.6333,
   "end": 51.9,
   "text": "I did not talk to anybody. I was too busy reading them."
  },
  {
   "id": "8.quiet",
   "start": 51.9,
   "end": 55.3,
   "text": "Then one day the school was quiet. Every clock was far off."
  },
  {
   "id": "8.easy2",
   "start": 55.3,
   "end": 58.0333,
   "text": "Every clock except one, and it was over my head."
  },
  {
   "id": "10.mine",
   "start": 58.0333,
   "end": 59.8,
   "text": "I had never looked at mine. Ten."
  },
  {
   "id": "10.ten",
   "start": 59.8,
   "end": 60.8333,
   "text": "It said ten."
  },
  {
   "id": "11.run",
   "start": 60.8333,
   "end": 62.1667,
   "text": "Ten seconds. I ran."
  },
  {
   "id": "12.jo3",
   "start": 62.1667,
   "end": 64.9667,
   "text": "Jo was by the door, where she always is. And she had a clock."
  },
  {
   "id": "12.one",
   "start": 64.9667,
   "end": 65.7667,
   "text": "It said one."
  },
  {
   "id": "13.not",
   "start": 65.7667,
   "end": 68.1667,
   "text": "Then I understood. It was never counting down."
  },
  {
   "id": "13.on",
   "start": 68.1667,
   "end": 69.5,
   "text": "It was counting on me."
  },
  {
   "id": "13.why",
   "start": 69.5,
   "end": 72.0333,
   "text": "She was at one because of me. For a week of not saying anything."
  },
  {
   "id": "13.me",
   "start": 72.0333,
   "end": 74.4333,
   "text": "The power never showed me when. It showed me who was alone."
  },
  {
   "id": "14.talk",
   "start": 74.4333,
   "end": 77.4,
   "text": "So I did the one thing I had not done all week. I talked to her."
  },
  {
   "id": "14.out",
   "start": 77.4,
   "end": 78.3667,
   "text": "Her clock went out."
  },
  {
   "id": "14.school",
   "start": 78.3667,
   "end": 81.7667,
   "text": "Then every clock in the school turned round, and every one was counting."
  },
  {
   "id": "14.sub",
   "start": 81.7667,
   "end": 84.5667,
   "text": "Subscribe, and I will tell you what they were counting down to."
  }
 ],
