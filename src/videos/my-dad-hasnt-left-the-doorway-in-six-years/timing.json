 "cues": [
  {
   "id": "1.door",
   "start": 0.0,
   "end": 2.2333,
   "text": "My dad hasn't left our doorway in six years."
  },
  {
   "id": "1.why",
   "start": 2.2333,
   "end": 3.4333,
   "text": "Not because he's stuck."
  },
  {
   "id": "1.rule",
   "start": 3.4333,
   "end": 5.5667,
   "text": "Because monsters can't walk through a player."
  },
  {
   "id": "1.explain",
   "start": 5.5667,
   "end": 7.7667,
   "text": "A mob sees a body in the gap, and turns around."
  },
  {
   "id": "2.first",
   "start": 7.7667,
   "end": 9.9,
   "text": "The first night, a zombie came up our path."
  },
  {
   "id": "2.saw",
   "start": 9.9,
   "end": 10.6667,
   "text": "It saw him."
  },
  {
   "id": "2.left",
   "start": 10.6667,
   "end": 11.7333,
   "text": "Then it walked away."
  },
  {
   "id": "2.stayed",
   "start": 11.7333,
   "end": 12.8333,
   "text": "My dad stayed in the door."
  },
  {
   "id": "3.grew",
   "start": 12.8333,
   "end": 13.9333,
   "text": "I grew up behind him."
  },
  {
   "id": "3.floor",
   "start": 13.9333,
   "end": 15.9667,
   "text": "I built a second floor. He heard every nail."
  },
  {
   "id": "3.never",
   "start": 15.9667,
   "end": 17.3333,
   "text": "He never turned around once."
  },
  {
   "id": "3.busy",
   "start": 17.3333,
   "end": 19.4667,
   "text": "I asked him to come and see. He said he was busy."
  },
  {
   "id": "4.check",
   "start": 19.4667,
   "end": 21.2,
   "text": "Last week, I checked his inventory."
  },
  {
   "id": "4.nothing",
   "start": 21.2,
   "end": 23.1333,
   "text": "No axe. No food. No bed."
  },
  {
   "id": "4.six",
   "start": 23.1333,
   "end": 24.8333,
   "text": "Six years, and he carried one thing."
  },
  {
   "id": "4.sword",
   "start": 24.8333,
   "end": 26.7667,
   "text": "A wooden sword with one hit left on it."
  },
  {
   "id": "5.asked",
   "start": 26.7667,
   "end": 28.2,
   "text": "I asked him what he was saving it for."
  },
  {
   "id": "5.you",
   "start": 28.2,
   "end": 30.4667,
   "text": "He said, the night you stop being scared."
  },
  {
   "id": "5.sixteen",
   "start": 30.4667,
   "end": 32.6,
   "text": "I'm sixteen. That was a long time ago."
  },
  {
   "id": "5.nobody",
   "start": 32.6,
   "end": 34.2333,
   "text": "He didn't know. Nobody ever told him."
  },
  {
   "id": "6.stand",
   "start": 34.2333,
   "end": 35.8667,
   "text": "So I stood in the doorway beside him."
  },
  {
   "id": "6.hand",
   "start": 35.8667,
   "end": 37.1667,
   "text": "I put my hand on his shoulder."
  },
  {
   "id": "6.swap",
   "start": 37.1667,
   "end": 38.4667,
   "text": "And we swapped places."
  },
  {
   "id": "6.freeze",
   "start": 38.4667,
   "end": 41.5,
   "text": "Six years of standing still, and suddenly he could move."
  },
  {
   "id": "6.scared",
   "start": 41.5,
   "end": 43.4667,
   "text": "He was more scared of the yard than of the monsters."
  },
  {
   "id": "7.said",
   "start": 43.4667,
   "end": 45.8,
   "text": "I said, Dad. It's just grass."
  },
  {
   "id": "7.step",
   "start": 45.8,
   "end": 46.7333,
   "text": "He took one step."
  },
  {
   "id": "7.another",
   "start": 46.7333,
   "end": 47.5,
   "text": "Then another."
  },
  {
   "id": "7.saw",
   "start": 47.5,
   "end": 48.5,
   "text": "Then he turned around."
  },
  {
   "id": "7.things",
   "start": 48.5,
   "end": 50.5333,
   "text": "A garden. A pond. Two chairs."
  },
  {
   "id": "8.sun",
   "start": 50.5333,
   "end": 52.5,
   "text": "He sat in the sun for the first time in six years."
  },
  {
   "id": "8.sword",
   "start": 52.5,
   "end": 54.2,
   "text": "He put the sword on the table between us."
  },
  {
   "id": "8.onehit",
   "start": 54.2,
   "end": 56.0667,
   "text": "One hit left, after all that time."
  },
  {
   "id": "8.used",
   "start": 56.0667,
   "end": 57.6667,
   "text": "He'd been saving it for his last step out."
  },
  {
   "id": "8.now",
   "start": 57.6667,
   "end": 59.3667,
   "text": "He said, I didn't need it after all."
  },
  {
   "id": "9.sub",
   "start": 59.3667,
   "end": 60.7667,
   "text": "Subscribe if you'd take a shift."
  }
 ],
