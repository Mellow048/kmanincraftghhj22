 "cues": [
  {
   "id": "1.left",
   "start": 0.0,
   "end": 1.2667,
   "text": "That's me on the left."
  },
  {
   "id": "1.elbow",
   "start": 1.2667,
   "end": 2.9667,
   "text": "Not him. The elbow."
  },
  {
   "id": "2.drill",
   "start": 2.9667,
   "end": 5.4667,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "2.timer",
   "start": 5.4667,
   "end": 7.8667,
   "text": "Grandma's old camera gave you three seconds."
  },
  {
   "id": "2.fridge",
   "start": 7.8667,
   "end": 10.3,
   "text": "She had six birthday pictures on her fridge."
  },
  {
   "id": "2.four",
   "start": 10.3,
   "end": 11.6667,
   "text": "I was in four of them."
  },
  {
   "id": "2.blue",
   "start": 11.6667,
   "end": 14.5333,
   "text": "You could tell because I only owned one blue sweater."
  },
  {
   "id": "2.face",
   "start": 14.5333,
   "end": 16.9333,
   "text": "This year I wanted my face on that fridge."
  },
  {
   "id": "3.tape",
   "start": 16.9333,
   "end": 19.2667,
   "text": "I put tape where my shoes had to land."
  },
  {
   "id": "3.ear",
   "start": 19.2667,
   "end": 21.1667,
   "text": "My first print was an ear."
  },
  {
   "id": "3.brow",
   "start": 21.1667,
   "end": 22.8333,
   "text": "My second had eyebrows."
  },
  {
   "id": "3.mine",
   "start": 22.8333,
   "end": 25.1333,
   "text": "Both mine. Things were looking up."
  },
  {
   "id": "3.reps",
   "start": 25.1333,
   "end": 26.4667,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "4.friends",
   "start": 26.4667,
   "end": 28.7667,
   "text": "On Friday my friends came over to test it."
  },
  {
   "id": "4.tape",
   "start": 28.7667,
   "end": 30.5333,
   "text": "I put one on each side of the tape."
  },
  {
   "id": "4.run",
   "start": 30.5333,
   "end": 31.9333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "4.best",
   "start": 31.9333,
   "end": 34.1,
   "text": "Three seconds later I had the best picture of me"
  },
  {
   "id": "4.taken",
   "start": 34.1,
   "end": 35.8,
   "text": "anybody had ever taken."
  },
  {
   "id": "4.ears",
   "start": 35.8,
   "end": 37.7333,
   "text": "My friends came out as four ears."
  },
  {
   "id": "4.almost",
   "start": 37.7333,
   "end": 40.1667,
   "text": "Ah, almost, almost."
  },
  {
   "id": "5.chairs",
   "start": 40.1667,
   "end": 42.5333,
   "text": "After that I trained with the dining chairs."
  },
  {
   "id": "5.glasses",
   "start": 42.5333,
   "end": 44.3667,
   "text": "One wore Grandma's glasses."
  },
  {
   "id": "5.uncle",
   "start": 44.3667,
   "end": 46.1,
   "text": "One wore my uncle's hat."
  },
  {
   "id": "5.count",
   "start": 46.1,
   "end": 48.9,
   "text": "If the hat disappeared, it didn't count."
  },
  {
   "id": "5.middle",
   "start": 48.9,
   "end": 50.4,
   "text": "I stopped aiming for the middle."
  },
  {
   "id": "5.hats",
   "start": 50.4,
   "end": 52.0333,
   "text": "I aimed between the hats."
  },
  {
   "id": "5.reps",
   "start": 52.0333,
   "end": 54.3667,
   "text": "HUS HUS HUS! HUS HUS HUS!"
  },
  {
   "id": "6.party",
   "start": 54.3667,
   "end": 56.8333,
   "text": "At Grandma's birthday they left me a spot."
  },
  {
   "id": "6.cake",
   "start": 56.8333,
   "end": 58.5,
   "text": "My uncle put the cake in it."
  },
  {
   "id": "6.light",
   "start": 58.5,
   "end": 60.4667,
   "text": "The red light was already blinking."
  },
  {
   "id": "6.behind",
   "start": 60.4667,
   "end": 62.0667,
   "text": "I went behind him this time."
  },
  {
   "id": "6.lean",
   "start": 62.0667,
   "end": 64.3333,
   "text": "He leaned left. I leaned right."
  },
  {
   "id": "6.reps",
   "start": 64.3333,
   "end": 66.0333,
   "text": "HUS HUS HUS!"
  },
  {
   "id": "6.fridge",
   "start": 66.0333,
   "end": 68.0667,
   "text": "Grandma took the elbow off the fridge."
  },
  {
   "id": "6.all",
   "start": 68.0667,
   "end": 70.3,
   "text": "She put us all up there instead."
  },
  {
   "id": "7.couple",
   "start": 70.3,
   "end": 72.0667,
   "text": "Then a couple handed me the camera."
  },
  {
   "id": "7.us",
   "start": 72.0667,
   "end": 74.2667,
   "text": "Could you take one of just the two of us?"
  },
  {
   "id": "7.sure",
   "start": 74.2667,
   "end": 75.5,
   "text": "I said sure."
  },
  {
   "id": "7.reps",
   "start": 75.5,
   "end": 77.5,
   "text": "HUS HUS HUS!"
  }
 ],
