 "cues": [
  {
   "id": "1.question",
   "start": 0.0,
   "end": 4.9,
   "text": "Why did Dream and Technoblade duel for a hundred thousand dollars, then split the prize?"
  },
  {
   "id": "2.event",
   "start": 4.9,
   "end": 8.9,
   "text": "In twenty twenty, MrBeast Gaming hosted ten online PvP duels."
  },
  {
   "id": "2.styles",
   "start": 8.9,
   "end": 12.3333,
   "text": "Dream knew the newer combat; Techno was known for version one point eight."
  },
  {
   "id": "3.home",
   "start": 12.3333,
   "end": 14.1667,
   "text": "But neither got to stay on home turf."
  },
  {
   "id": "3.versions",
   "start": 14.1667,
   "end": 17.9,
   "text": "Versions switched each round, and a coin toss chose the opener for round one."
  },
  {
   "id": "3.advantage",
   "start": 17.9,
   "end": 20.3333,
   "text": "Each switch changed what counted as an advantage."
  },
  {
   "id": "3.lead",
   "start": 20.3333,
   "end": 24.5,
   "text": "Neither player could trust a lead because the next round might favor the other combat style instead."
  },
  {
   "id": "4.first",
   "start": 24.5,
   "end": 25.6,
   "text": "Techno scored first."
  },
  {
   "id": "4.answer",
   "start": 25.6,
   "end": 28.0,
   "text": "Dream answered, then Techno surged ahead."
  },
  {
   "id": "5.rule",
   "start": 28.0,
   "end": 31.1,
   "text": "But the lead wasn't safe: first to six wins took the best-of-ten."
  },
  {
   "id": "5.tie",
   "start": 31.1,
   "end": 34.1333,
   "text": "Dream tied it at three-all, and the scoreboard could swing either way."
  },
  {
   "id": "5.four",
   "start": 34.1333,
   "end": 35.9,
   "text": "Four-four. Two rounds left."
  },
  {
   "id": "5.next",
   "start": 35.9,
   "end": 38.2,
   "text": "If Techno won the next, he would be on match point;"
  },
  {
   "id": "5.final",
   "start": 38.2,
   "end": 40.8667,
   "text": "One more would seal it. Dream could force five-all."
  },
  {
   "id": "5.finish",
   "start": 40.8667,
   "end": 43.0667,
   "text": "Then Techno won both. Six-four."
  },
  {
   "id": "6.whole",
   "start": 43.0667,
   "end": 47.1333,
   "text": "And that should've been the whole story, but the hundred thousand was already promised to be split:"
  },
  {
   "id": "6.agreement",
   "start": 47.1333,
   "end": 50.9,
   "text": "Beforehand, they agreed to split the prize equally, regardless of who won."
  },
  {
   "id": "6.pressure",
   "start": 50.9,
   "end": 53.6667,
   "text": "Dream later said it took off pressure so they could enjoy it."
  },
  {
   "id": "7.winner",
   "start": 53.6667,
   "end": 55.9,
   "text": "Techno won the match, but not a bigger share."
  },
  {
   "id": "7.callback",
   "start": 55.9,
   "end": 59.6,
   "text": "So the opening dollar banner returns as two equal chests beneath the six-four."
  },
  {
   "id": "7.recap",
   "start": 59.6,
   "end": 63.6,
   "text": "The rivals played ten rounds against each other, then shared the prize they'd agreed on before the game."
  },
  {
   "id": "7.reframe",
   "start": 63.6,
   "end": 67.3,
   "text": "They competed for the win, while their prize split was settled before the first round."
  },
  {
   "id": "7.subscribe",
   "start": 67.3,
   "end": 70.7667,
   "text": "Subscribe for Minecraft rivalries with unexpected twists."
  }
 ],
