 "cues": [
  {
   "id": "1.gold",
   "start": 0.0,
   "end": 1.7333,
   "text": "In this town, nobody wears gold."
  },
  {
   "id": "1.dive",
   "start": 1.7333,
   "end": 3.7667,
   "text": "Neighbors dive behind stalls whenever I walk past."
  },
  {
   "id": "1.helmet",
   "start": 3.7667,
   "end": 5.7333,
   "text": "Because I wear one bright shiny gold helmet."
  },
  {
   "id": "1.portal",
   "start": 5.7333,
   "end": 7.8,
   "text": "Our village sits beside a giant glowing nether portal."
  },
  {
   "id": "1.piglins",
   "start": 7.8,
   "end": 10.5,
   "text": "Every sunset, angry piglins march out swinging golden swords."
  },
  {
   "id": "2.rule",
   "start": 10.5,
   "end": 12.7333,
   "text": "Mayor Vance says gold makes the piglins mad."
  },
  {
   "id": "2.flower",
   "start": 12.7333,
   "end": 15.4667,
   "text": "Yesterday, three villagers panicked over one yellow dandelion."
  },
  {
   "id": "2.baker",
   "start": 15.4667,
   "end": 17.4333,
   "text": "Our baker made a golden carrot and got fired."
  },
  {
   "id": "2.fourth",
   "start": 17.4333,
   "end": 18.9333,
   "text": "We are on our fourth baker this month."
  },
  {
   "id": "2.paint",
   "start": 18.9333,
   "end": 21.1667,
   "text": "Even our blacksmith painted his yellow sign grey."
  },
  {
   "id": "3.toby",
   "start": 21.1667,
   "end": 23.3333,
   "text": "I am Toby, and I keep this dented gold helmet on."
  },
  {
   "id": "3.grandpa",
   "start": 23.3333,
   "end": 24.8667,
   "text": "Grandpa gave it to me right before he vanished."
  },
  {
   "id": "3.never",
   "start": 24.8667,
   "end": 26.7,
   "text": "He whispered one rule, never take it off."
  },
  {
   "id": "3.laugh",
   "start": 26.7,
   "end": 28.4667,
   "text": "Kids point down Main Street yelling, butter head!"
  },
  {
   "id": "3.vance",
   "start": 28.4667,
   "end": 30.4,
   "text": "Mayor Vance laughs outside his huge brick vault."
  },
  {
   "id": "3.cursed",
   "start": 30.4,
   "end": 32.5667,
   "text": "Gold is cursed, kid, ditch that shiny junk."
  },
  {
   "id": "4.locked",
   "start": 32.5667,
   "end": 34.9,
   "text": "Mayor Vance locked every bar of gold inside his vault."
  },
  {
   "id": "4.iron",
   "start": 34.9,
   "end": 37.2333,
   "text": "Instead, he sells plain iron armor at his stall."
  },
  {
   "id": "4.fifty",
   "start": 37.2333,
   "end": 39.4,
   "text": "Fifty emeralds a chestplate on a clear day."
  },
  {
   "id": "4.hundred",
   "start": 39.4,
   "end": 41.5667,
   "text": "After the sunset bell, one hundred emeralds each."
  },
  {
   "id": "4.twenty",
   "start": 41.5667,
   "end": 43.8333,
   "text": "Twenty neighbors could not pay and vanished into the pines."
  },
  {
   "id": "4.clue",
   "start": 43.8333,
   "end": 46.1667,
   "text": "Wait, last Friday I missed curfew wearing my helmet."
  },
  {
   "id": "4.sniff",
   "start": 46.1667,
   "end": 49.1667,
   "text": "A huge piglin walked past, sniffed, and never touched me."
  },
  {
   "id": "5.bell",
   "start": 49.1667,
   "end": 51.3667,
   "text": "Tonight, the sunset bell rang three loud times."
  },
  {
   "id": "5.roar",
   "start": 51.3667,
   "end": 53.0,
   "text": "The purple portal roared open up the street."
  },
  {
   "id": "5.twelve",
   "start": 53.0,
   "end": 55.4333,
   "text": "Twelve angry piglins charged down the cobble road!"
  },
  {
   "id": "5.slam",
   "start": 55.4333,
   "end": 57.9,
   "text": "Mayor Vance slammed his vault door yelling, two hundred!"
  },
  {
   "id": "5.back",
   "start": 57.9,
   "end": 61.0667,
   "text": "Iron guards slid back, ten blocks, five blocks, two blocks!"
  },
  {
   "id": "5.corner",
   "start": 61.0667,
   "end": 63.5333,
   "text": "Our whole town backed into the square with nowhere left."
  },
  {
   "id": "6.wait",
   "start": 63.5333,
   "end": 65.6667,
   "text": "Then I remembered two Minecraft rules everyone forgot."
  },
  {
   "id": "6.calm",
   "start": 65.6667,
   "end": 67.7667,
   "text": "Piglins never attack anyone wearing one piece of gold."
  },
  {
   "id": "6.trade",
   "start": 67.7667,
   "end": 69.6667,
   "text": "Toss them gold ingots, and they stop fighting to trade!"
  },
  {
   "id": "6.sprint",
   "start": 69.6667,
   "end": 71.4667,
   "text": "I sprinted up the vault stairs in my gold helmet."
  },
  {
   "id": "6.walk",
   "start": 71.4667,
   "end": 73.1667,
   "text": "Three piglins stared at me and stepped right aside!"
  },
  {
   "id": "6.lever",
   "start": 73.1667,
   "end": 75.0,
   "text": "I pulled the lever and threw the vault door open!"
  },
  {
   "id": "6.rain",
   "start": 75.0,
   "end": 78.0667,
   "text": "One hundred shining gold ingots rained down the street!"
  },
  {
   "id": "7.freeze",
   "start": 78.0667,
   "end": 80.2333,
   "text": "Every piglin froze mid swing and dropped his sword."
  },
  {
   "id": "7.pearls",
   "start": 80.2333,
   "end": 82.4333,
   "text": "They scooped up gold and tossed glowing ender pearls back!"
  },
  {
   "id": "7.mayor",
   "start": 82.4333,
   "end": 84.9667,
   "text": "Mayor Vance marched out in iron yelling, gold is cursed!"
  },
  {
   "id": "7.six",
   "start": 84.9667,
   "end": 87.5,
   "text": "Three piglins spotted his iron suit. He made six blocks."
  },
  {
   "id": "7.boots",
   "start": 87.5,
   "end": 89.4667,
   "text": "Next morning, everyone put on shiny gold boots."
  },
  {
   "id": "7.pines",
   "start": 89.4667,
   "end": 91.3667,
   "text": "We walked straight into the pines without a scratch."
  },
  {
   "id": "7.back2",
   "start": 91.3667,
   "end": 93.7667,
   "text": "Out walked all twenty missing neighbors, Grandpa last."
  },
  {
   "id": "7.tap",
   "start": 93.7667,
   "end": 96.1667,
   "text": "Grandpa tapped my helmet and grinned, told you so."
  },
  {
   "id": "7.shop",
   "start": 96.1667,
   "end": 98.0,
   "text": "The mayor's iron stall shut down for good."
  },
  {
   "id": "7.cta",
   "start": 98.0,
   "end": 100.3333,
   "text": "Subscribe if you would keep Grandpa's gold helmet on, too."
  }
 ],
