 "cues": [
  {
   "id": "1.gold",
   "start": 0.0,
   "end": 1.7,
   "text": "In this town, nobody wears gold."
  },
  {
   "id": "1.dive",
   "start": 1.7,
   "end": 3.6667,
   "text": "Neighbors dive behind stalls whenever I walk past."
  },
  {
   "id": "1.helmet",
   "start": 3.6667,
   "end": 5.6,
   "text": "Because I wear one bright shiny gold helmet."
  },
  {
   "id": "1.portal",
   "start": 5.6,
   "end": 7.6,
   "text": "Our village sits beside a giant glowing nether portal."
  },
  {
   "id": "1.piglins",
   "start": 7.6,
   "end": 10.3,
   "text": "Every sunset, angry piglins march out swinging golden swords."
  },
  {
   "id": "2.rule",
   "start": 10.3,
   "end": 12.5,
   "text": "Mayor Vance says gold makes the piglins mad."
  },
  {
   "id": "2.flower",
   "start": 12.5,
   "end": 15.1333,
   "text": "Yesterday, three villagers panicked over one yellow dandelion."
  },
  {
   "id": "2.baker",
   "start": 15.1333,
   "end": 17.0667,
   "text": "Our baker made a golden carrot and got fired."
  },
  {
   "id": "2.fourth",
   "start": 17.0667,
   "end": 18.5333,
   "text": "We are on our fourth baker this month."
  },
  {
   "id": "2.paint",
   "start": 18.5333,
   "end": 20.7667,
   "text": "Even our blacksmith painted his yellow sign grey."
  },
  {
   "id": "3.toby",
   "start": 20.7667,
   "end": 23.7333,
   "text": "I am Toby, and I found this dented gold helmet by the mine."
  },
  {
   "id": "3.grandpa",
   "start": 23.7333,
   "end": 25.7333,
   "text": "Everyone warned me the piglins would hunt me down."
  },
  {
   "id": "3.never",
   "start": 25.7333,
   "end": 27.8667,
   "text": "Even Grandpa vanished last winter when raids got bad."
  },
  {
   "id": "3.laugh",
   "start": 27.8667,
   "end": 30.2,
   "text": "Kids point down Main Street yelling, butter head!"
  },
  {
   "id": "3.vance",
   "start": 30.2,
   "end": 32.1,
   "text": "Mayor Vance grins outside his huge brick vault."
  },
  {
   "id": "3.cursed",
   "start": 32.1,
   "end": 34.1333,
   "text": "Gold is cursed, kid, ditch that shiny junk."
  },
  {
   "id": "4.locked",
   "start": 34.1333,
   "end": 36.3333,
   "text": "Vance locked every gold bar in his vault so nobody could wear it."
  },
  {
   "id": "4.iron",
   "start": 36.3333,
   "end": 39.2,
   "text": "Why? Because scared villagers buy his overpriced iron armor instead!"
  },
  {
   "id": "4.fifty",
   "start": 39.2,
   "end": 41.0667,
   "text": "Fifty emeralds a chestplate on a clear day."
  },
  {
   "id": "4.hundred",
   "start": 41.0667,
   "end": 43.3333,
   "text": "After the sunset bell, one hundred emeralds each."
  },
  {
   "id": "4.twenty",
   "start": 43.3333,
   "end": 45.6,
   "text": "Twenty neighbors could not pay and fled into the pines."
  },
  {
   "id": "4.clue",
   "start": 45.6,
   "end": 48.2667,
   "text": "Wait, last Friday I tested my helmet right near the portal."
  },
  {
   "id": "4.sniff",
   "start": 48.2667,
   "end": 51.7667,
   "text": "A huge piglin sniffed my gold, lowered his sword, and walked away!"
  },
  {
   "id": "5.bell",
   "start": 51.7667,
   "end": 53.9333,
   "text": "Tonight, the sunset bell rang three loud times."
  },
  {
   "id": "5.roar",
   "start": 53.9333,
   "end": 55.5333,
   "text": "The purple portal roared open up the street."
  },
  {
   "id": "5.twelve",
   "start": 55.5333,
   "end": 57.9,
   "text": "Twelve angry piglins charged down the cobble road!"
  },
  {
   "id": "5.slam",
   "start": 57.9,
   "end": 60.3333,
   "text": "Mayor Vance slammed his vault door yelling, two hundred!"
  },
  {
   "id": "5.back",
   "start": 60.3333,
   "end": 63.4,
   "text": "Iron guards slid back, ten blocks, five blocks, two blocks!"
  },
  {
   "id": "5.corner",
   "start": 63.4,
   "end": 65.9,
   "text": "Our whole town backed into the square with nowhere left."
  },
  {
   "id": "6.wait",
   "start": 65.9,
   "end": 67.5,
   "text": "That is when I put the whole puzzle together!"
  },
  {
   "id": "6.calm",
   "start": 67.5,
   "end": 69.7,
   "text": "Piglins never attack anyone wearing one piece of gold!"
  },
  {
   "id": "6.trade",
   "start": 69.7,
   "end": 71.9333,
   "text": "Toss them gold ingots, and they stop fighting to trade!"
  },
  {
   "id": "6.sprint",
   "start": 71.9333,
   "end": 73.6333,
   "text": "I sprinted up the vault stairs in my gold helmet."
  },
  {
   "id": "6.walk",
   "start": 73.6333,
   "end": 75.8,
   "text": "Three piglins stared at my helmet and stepped right aside!"
  },
  {
   "id": "6.lever",
   "start": 75.8,
   "end": 77.6,
   "text": "I pulled the lever and threw Vance's vault door open!"
  },
  {
   "id": "6.rain",
   "start": 77.6,
   "end": 80.4,
   "text": "One hundred shining gold ingots rained down the street!"
  },
  {
   "id": "7.freeze",
   "start": 80.4,
   "end": 82.9667,
   "text": "Every piglin froze mid swing and dropped his sword."
  },
  {
   "id": "7.pearls",
   "start": 82.9667,
   "end": 85.2,
   "text": "They scooped up gold and tossed glowing ender pearls back!"
  },
  {
   "id": "7.mayor",
   "start": 85.2,
   "end": 87.7,
   "text": "Mayor Vance marched out in iron yelling, gold is cursed!"
  },
  {
   "id": "7.six",
   "start": 87.7,
   "end": 90.1667,
   "text": "Three piglins spotted his iron suit. He ran six blocks."
  },
  {
   "id": "7.boots",
   "start": 90.1667,
   "end": 92.6667,
   "text": "Next morning, everyone put on shiny gold boots."
  },
  {
   "id": "7.pines",
   "start": 92.6667,
   "end": 94.6667,
   "text": "We walked straight into the pines without a scratch."
  },
  {
   "id": "7.back2",
   "start": 94.6667,
   "end": 97.0667,
   "text": "Out walked all twenty missing neighbors, Grandpa last."
  },
  {
   "id": "7.tap",
   "start": 97.0667,
   "end": 99.3,
   "text": "Grandpa tapped my helmet and grinned, you figured it out!"
  },
  {
   "id": "7.shop",
   "start": 99.3,
   "end": 101.1333,
   "text": "The mayor's iron stall shut down for good."
  },
  {
   "id": "7.cta",
   "start": 101.1333,
   "end": 103.2333,
   "text": "Subscribe if you would wear gold in this town, too!"
  }
 ],
