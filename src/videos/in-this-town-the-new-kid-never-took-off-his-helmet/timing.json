 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.0667,
   "text": "In this town, the new kid never took off his helmet."
  },
  {
   "id": "1.not",
   "start": 2.0667,
   "end": 4.3667,
   "text": "Not in class. Not at lunch. Not even in the pool."
  },
  {
   "id": "1.teacher",
   "start": 4.3667,
   "end": 6.3333,
   "text": "The teacher asked him once. He just shook his head."
  },
  {
   "id": "1.face",
   "start": 6.3333,
   "end": 8.8333,
   "text": "Nobody knew his face. Nobody knew where he lived."
  },
  {
   "id": "1.back",
   "start": 8.8333,
   "end": 11.5,
   "text": "He sat at the back, next to me. He never said a word."
  },
  {
   "id": "1.shy",
   "start": 11.5,
   "end": 12.9333,
   "text": "I thought he was just shy."
  },
  {
   "id": "2.first",
   "start": 12.9333,
   "end": 14.4333,
   "text": "Then the first kid went missing."
  },
  {
   "id": "2.desk",
   "start": 14.4333,
   "end": 16.9333,
   "text": "His desk was empty on Monday. His bag was still under it."
  },
  {
   "id": "2.ran",
   "start": 16.9333,
   "end": 18.4333,
   "text": "The adults said he ran away."
  },
  {
   "id": "2.more",
   "start": 18.4333,
   "end": 21.7,
   "text": "On Wednesday, another desk was empty. On Friday, two more."
  },
  {
   "id": "2.posters",
   "start": 21.7,
   "end": 24.4667,
   "text": "Posters went up on every wall. Nobody played outside anymore."
  },
  {
   "id": "2.noticed",
   "start": 24.4667,
   "end": 25.3333,
   "text": "And I noticed something."
  },
  {
   "id": "2.mean",
   "start": 25.3333,
   "end": 27.2333,
   "text": "Every kid who went missing had been mean to him."
  },
  {
   "id": "2.three",
   "start": 27.2333,
   "end": 30.4333,
   "text": "One threw his lunch. One knocked on his helmet. One tried to pull it off."
  },
  {
   "id": "2.mom",
   "start": 30.4333,
   "end": 33.1,
   "text": "I told my mom. She said, \"Do not blame the new kid.\""
  },
  {
   "id": "2.sit",
   "start": 33.1,
   "end": 35.2667,
   "text": "I told the teacher. He said, \"Sit down.\""
  },
  {
   "id": "3.watch",
   "start": 35.2667,
   "end": 36.5333,
   "text": "So I watched him myself."
  },
  {
   "id": "3.woods",
   "start": 36.5333,
   "end": 39.3333,
   "text": "Every day after school, he walked into the woods. Alone."
  },
  {
   "id": "3.wet",
   "start": 39.3333,
   "end": 42.3333,
   "text": "Every morning, he came back. And his helmet was a little wet."
  },
  {
   "id": "3.know",
   "start": 42.3333,
   "end": 43.9333,
   "text": "I had to know what was in those woods."
  },
  {
   "id": "3.follow",
   "start": 43.9333,
   "end": 45.4333,
   "text": "So one night, I followed him."
  },
  {
   "id": "3.far",
   "start": 45.4333,
   "end": 47.6,
   "text": "I stayed far back. He never turned around."
  },
  {
   "id": "3.hid",
   "start": 47.6,
   "end": 50.1,
   "text": "At the edge of the woods, I hid behind a tree."
  },
  {
   "id": "4.lamp",
   "start": 50.1,
   "end": 52.8,
   "text": "He was standing under the old lamp. He was not alone."
  },
  {
   "id": "4.circle",
   "start": 52.8,
   "end": 56.0,
   "text": "Three big kids had him in a circle. The last three bullies in town."
  },
  {
   "id": "4.push",
   "start": 56.0,
   "end": 58.0,
   "text": "They pushed him. He did not push back."
  },
  {
   "id": "4.take",
   "start": 58.0,
   "end": 60.5333,
   "text": "\"Take it off,\" one said. \"Show us your face.\""
  },
  {
   "id": "4.held",
   "start": 60.5333,
   "end": 63.5,
   "text": "He held his helmet with both hands. He was shaking all over."
  },
  {
   "id": "4.scared",
   "start": 63.5,
   "end": 66.4,
   "text": "He was not angry. He was scared. But not of them."
  },
  {
   "id": "4.pull",
   "start": 66.4,
   "end": 69.5667,
   "text": "Two of them held his arms. The third one pulled."
  },
  {
   "id": "4.off",
   "start": 69.5667,
   "end": 72.2333,
   "text": "The helmet came off."
  },
  {
   "id": "4.noface",
   "start": 72.2333,
   "end": 74.5,
   "text": "There was no face."
  },
  {
   "id": "4.hole",
   "start": 74.5,
   "end": 76.3,
   "text": "There was a hole."
  },
  {
   "id": "4.moved",
   "start": 76.3,
   "end": 79.6,
   "text": "And something inside it moved."
  },
  {
   "id": "4.tent",
   "start": 79.6,
   "end": 82.6333,
   "text": "One tentacle came out. Then five. Then too many to count."
  },
  {
   "id": "4.thick",
   "start": 82.6333,
   "end": 85.3333,
   "text": "They were as thick as trees. They wrapped around all three of them."
  },
  {
   "id": "4.scream",
   "start": 85.3333,
   "end": 87.2333,
   "text": "Nobody made a sound. There was no time."
  },
  {
   "id": "4.swallow",
   "start": 87.2333,
   "end": 90.8667,
   "text": "It pulled them in. All three. And then they were gone."
  },
  {
   "id": "5.quiet",
   "start": 90.8667,
   "end": 91.7333,
   "text": "Then it was quiet."
  },
  {
   "id": "5.pick",
   "start": 91.7333,
   "end": 94.1333,
   "text": "The kid picked up his helmet. His hands were still shaking."
  },
  {
   "id": "5.step",
   "start": 94.1333,
   "end": 95.3,
   "text": "I took one step back."
  },
  {
   "id": "5.stick",
   "start": 95.3,
   "end": 96.6333,
   "text": "A stick snapped under my foot."
  },
  {
   "id": "5.stop",
   "start": 96.6333,
   "end": 97.3333,
   "text": "He stopped."
  },
  {
   "id": "5.turn",
   "start": 97.3333,
   "end": 100.8,
   "text": "One tentacle turned around. Slowly. It pointed at my tree."
  },
  {
   "id": "5.breath",
   "start": 100.8,
   "end": 102.7,
   "text": "I held my breath. I did not move."
  },
  {
   "id": "5.closer",
   "start": 102.7,
   "end": 106.5333,
   "text": "It came closer. It touched the bark, right next to my face."
  },
  {
   "id": "9.sub",
   "start": 106.5333,
   "end": 108.3,
   "text": "Like and subscribe for part two."
  }
 ],
