 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.7,
   "text": "Inflation, explained using Minecraft."
  },
  {
   "id": "1.paradox",
   "start": 1.7,
   "end": 3.8333,
   "text": "Everyone thinks more cash makes the whole server rich."
  },
  {
   "id": "1.reverse",
   "start": 3.8333,
   "end": 6.1333,
   "text": "In reality, it can make everyone afford less."
  },
  {
   "id": "2.bread",
   "start": 6.1333,
   "end": 8.2333,
   "text": "On day one, one warm loaf costs one emerald."
  },
  {
   "id": "2.miles",
   "start": 8.2333,
   "end": 10.1333,
   "text": "Miles swings his pickaxe all morning in the mine,"
  },
  {
   "id": "2.happy",
   "start": 10.1333,
   "end": 12.0333,
   "text": "buys one loaf cleanly, and walks home happy."
  },
  {
   "id": "3.crisis",
   "start": 12.0333,
   "end": 14.0333,
   "text": "Then a dry drought hits farms across the server."
  },
  {
   "id": "3.empty",
   "start": 14.0333,
   "end": 16.4667,
   "text": "Miles opens his chest at night and finds zero emeralds."
  },
  {
   "id": "3.count",
   "start": 16.4667,
   "end": 18.4333,
   "text": "Empty chests line the entire dark market square."
  },
  {
   "id": "4.sterling",
   "start": 18.4333,
   "end": 19.7,
   "text": "This is President Sterling."
  },
  {
   "id": "4.promise",
   "start": 19.7,
   "end": 22.2333,
   "text": "He promises an instant emerald fix for every player."
  },
  {
   "id": "4.rules",
   "start": 22.2333,
   "end": 23.7333,
   "text": "He marches straight into the council hall"
  },
  {
   "id": "4.charter",
   "start": 23.7333,
   "end": 25.6333,
   "text": "and pins one brand-new order onto the wall."
  },
  {
   "id": "5.print",
   "start": 25.6333,
   "end": 27.9,
   "text": "Sterling flips on the emerald printer to max speed."
  },
  {
   "id": "5.chat",
   "start": 27.9,
   "end": 30.0333,
   "text": "Ten thousand green bills drop right into server chat."
  },
  {
   "id": "5.cheer",
   "start": 30.0333,
   "end": 32.1333,
   "text": "Everyone cheers over chests bursting with fresh notes."
  },
  {
   "id": "5.miles2",
   "start": 32.1333,
   "end": 33.5667,
   "text": "Miles packs a thick stack of green bills"
  },
  {
   "id": "5.sprint",
   "start": 33.5667,
   "end": 35.4667,
   "text": "and sprints straight back to the village bakery."
  },
  {
   "id": "6.same",
   "start": 35.4667,
   "end": 37.3333,
   "text": "He slaps ten green notes onto the stone plinth."
  },
  {
   "id": "6.smile",
   "start": 37.3333,
   "end": 39.4,
   "text": "Miles smiles wide for the very first time all week."
  },
  {
   "id": "6.problem",
   "start": 39.4,
   "end": 41.7667,
   "text": "Wait. Look closely at yesterday versus today."
  },
  {
   "id": "6.ovens",
   "start": 41.7667,
   "end": 44.0667,
   "text": "The baker's oven still baked the exact same four loaves."
  },
  {
   "id": "6.bid",
   "start": 44.0667,
   "end": 46.0,
   "text": "Ten rich buyers now wave cash for that same bread."
  },
  {
   "id": "6.jump",
   "start": 46.0,
   "end": 48.9,
   "text": "Yesterday one emerald bought dinner. Today it jumps to ten."
  },
  {
   "id": "7.work",
   "start": 48.9,
   "end": 50.8,
   "text": "So Miles hacks ore late at night just to eat."
  },
  {
   "id": "7.chart",
   "start": 50.8,
   "end": 53.0333,
   "text": "Watch the chart: the green cash tower shoots past his head,"
  },
  {
   "id": "7.flat",
   "start": 53.0333,
   "end": 55.0333,
   "text": "while the real bread bar barely moves an inch."
  },
  {
   "id": "7.value",
   "start": 55.0333,
   "end": 56.9667,
   "text": "Extra bills didn't bake one extra loaf today."
  },
  {
   "id": "7.half",
   "start": 56.9667,
   "end": 59.3667,
   "text": "Printing only cut each emerald's buying power in half."
  },
  {
   "id": "7.history",
   "start": 59.3667,
   "end": 61.5,
   "text": "In real life, when governments print trillions for bills,"
  },
  {
   "id": "7.bills",
   "start": 61.5,
   "end": 64.0333,
   "text": "new money floods markets long before factories build more goods."
  },
  {
   "id": "7.prices",
   "start": 64.0333,
   "end": 66.1,
   "text": "Food, rent, and fuel climb right beside that stack."
  },
  {
   "id": "8.first",
   "start": 66.1,
   "end": 67.7,
   "text": "Sterling got to spend the new cash first,"
  },
  {
   "id": "8.cheap",
   "start": 67.7,
   "end": 69.4333,
   "text": "buying real goods while old cheap prices still held."
  },
  {
   "id": "8.burn",
   "start": 69.4333,
   "end": 71.8667,
   "text": "Wait last in line, and your savings lose half their value."
  },
  {
   "id": "8.final",
   "start": 71.8667,
   "end": 73.8333,
   "text": "Miles worked twice as hard for the exact same loaf,"
  },
  {
   "id": "8.loop",
   "start": 73.8333,
   "end": 75.8,
   "text": "watching prices hit a hundred, and that's"
  }
 ],
