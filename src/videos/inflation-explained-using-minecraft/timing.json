 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.6667,
   "text": "Inflation, explained using Minecraft."
  },
  {
   "id": "2.bread",
   "start": 1.6667,
   "end": 4.0333,
   "text": "On this server, one loaf of bread costs one emerald."
  },
  {
   "id": "2.miles",
   "start": 4.0333,
   "end": 6.5333,
   "text": "Miles mines all morning, buys a loaf, and goes home happy."
  },
  {
   "id": "3.crisis",
   "start": 6.5333,
   "end": 9.0667,
   "text": "Then a dry summer hits, and players run short on emeralds."
  },
  {
   "id": "4.sterling",
   "start": 9.0667,
   "end": 12.3333,
   "text": "This is President Sterling. He wants everybody to feel rich again."
  },
  {
   "id": "4.rules",
   "start": 12.3333,
   "end": 15.1333,
   "text": "So he opens the treasury and pins one new rule on the board."
  },
  {
   "id": "5.print",
   "start": 15.1333,
   "end": 18.3333,
   "text": "He flips on the emerald printer and drops ten thousand fresh notes into chat."
  },
  {
   "id": "5.cheer",
   "start": 18.3333,
   "end": 20.8,
   "text": "Everyone cheers because their chests are full for the first time."
  },
  {
   "id": "6.same",
   "start": 20.8,
   "end": 23.7,
   "text": "Miles runs straight back to the bakery with ten emeralds in his hand."
  },
  {
   "id": "6.problem",
   "start": 23.7,
   "end": 26.6333,
   "text": "Wait. The baker's oven still baked the exact same four loaves today."
  },
  {
   "id": "6.bid",
   "start": 26.6333,
   "end": 28.9667,
   "text": "Now ten rich players are bidding on the exact same bread."
  },
  {
   "id": "6.jump",
   "start": 28.9667,
   "end": 32.0333,
   "text": "Yesterday one loaf cost one emerald. Today the tag jumps to ten."
  },
  {
   "id": "7.chart",
   "start": 32.0333,
   "end": 34.2,
   "text": "More money chasing the same goods doesn't make more bread."
  },
  {
   "id": "7.value",
   "start": 34.2,
   "end": 36.7667,
   "text": "It just makes each emerald worth less than it was yesterday."
  },
  {
   "id": "7.history",
   "start": 36.7667,
   "end": 39.8,
   "text": "In real life, every time a government prints money to pay its bills,"
  },
  {
   "id": "7.prices",
   "start": 39.8,
   "end": 42.2,
   "text": "groceries, rent, and gas climb right alongside the cash."
  },
  {
   "id": "8.end",
   "start": 42.2,
   "end": 44.9667,
   "text": "Sterling got to spend the new emeralds first while prices were still low."
  },
  {
   "id": "8.loop",
   "start": 44.9667,
   "end": 47.8,
   "text": "Miles worked twice as hard for the exact same loaf, and that's"
  }
 ],
