 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.6667,
   "text": "Inflation, explained using Minecraft."
  },
  {
   "id": "1.paradox",
   "start": 1.6667,
   "end": 4.2333,
   "text": "Every player on this server thinks more cash makes them richer."
  },
  {
   "id": "1.reverse",
   "start": 4.2333,
   "end": 6.5,
   "text": "In reality, it can make everyone afford less."
  },
  {
   "id": "2.bread",
   "start": 6.5,
   "end": 8.7333,
   "text": "On day one, one loaf of bread costs one emerald."
  },
  {
   "id": "2.miles",
   "start": 8.7333,
   "end": 11.5667,
   "text": "Miles works the mine all morning, buys a loaf, and goes home happy."
  },
  {
   "id": "3.crisis",
   "start": 11.5667,
   "end": 13.9667,
   "text": "Then a dry summer hits, and chests across town go dry."
  },
  {
   "id": "3.empty",
   "start": 13.9667,
   "end": 16.4333,
   "text": "Miles checks his chest at night and finds zero emeralds left."
  },
  {
   "id": "4.sterling",
   "start": 16.4333,
   "end": 18.9667,
   "text": "This is President Sterling. He promises an easy fix."
  },
  {
   "id": "4.rules",
   "start": 18.9667,
   "end": 21.7333,
   "text": "He unlocks the treasury and pins one brand-new rule on the board."
  },
  {
   "id": "5.print",
   "start": 21.7333,
   "end": 24.8,
   "text": "He flips on the emerald printer and drops ten thousand fresh notes in chat."
  },
  {
   "id": "5.cheer",
   "start": 24.8,
   "end": 27.6,
   "text": "Everyone cheers because their chests are overflowing for the first time."
  },
  {
   "id": "5.miles2",
   "start": 27.6,
   "end": 30.3667,
   "text": "Miles packs a fresh emerald stack and sprints back to the bakery."
  },
  {
   "id": "6.same",
   "start": 30.3667,
   "end": 33.1333,
   "text": "He slaps ten emeralds onto the counter, smiling ear to ear."
  },
  {
   "id": "6.problem",
   "start": 33.1333,
   "end": 36.0667,
   "text": "Wait. The baker's oven still baked the exact same four loaves today."
  },
  {
   "id": "6.bid",
   "start": 36.0667,
   "end": 38.5667,
   "text": "Now ten rich players are waving cash for that exact same bread."
  },
  {
   "id": "6.jump",
   "start": 38.5667,
   "end": 41.6333,
   "text": "Yesterday one loaf cost one emerald. Today the tag jumps to ten."
  },
  {
   "id": "7.work",
   "start": 41.6333,
   "end": 44.1,
   "text": "So Miles mines twice as late at night just to afford dinner."
  },
  {
   "id": "7.chart",
   "start": 44.1,
   "end": 46.5667,
   "text": "More money chasing the same goods doesn't create one extra loaf."
  },
  {
   "id": "7.value",
   "start": 46.5667,
   "end": 48.9,
   "text": "It just slices every emerald's buying power in half."
  },
  {
   "id": "7.history",
   "start": 48.9,
   "end": 51.9,
   "text": "In real life, whenever a government prints money to pay massive bills,"
  },
  {
   "id": "7.prices",
   "start": 51.9,
   "end": 54.5,
   "text": "groceries, rent, and fuel climb right beside the stack of cash."
  },
  {
   "id": "8.first",
   "start": 54.5,
   "end": 57.0,
   "text": "Sterling got to spend the brand-new notes first while prices were low."
  },
  {
   "id": "8.loop",
   "start": 57.0,
   "end": 59.8,
   "text": "Miles worked twice as hard for the exact same loaf, and that's"
  }
 ],
