 "cues": [
  {
   "id": "1.bell",
   "start": 0.0,
   "end": 3.5667,
   "text": "In this town, the bell rang once a day, and nobody was allowed to look up."
  },
  {
   "id": "1.dirt",
   "start": 3.5667,
   "end": 7.4,
   "text": "Every face went into the dirt. Shopkeepers. Kids. The iron golem."
  },
  {
   "id": "1.me",
   "start": 7.4,
   "end": 8.8333,
   "text": "I was nine. I looked up."
  },
  {
   "id": "1.saw",
   "start": 8.8333,
   "end": 11.7333,
   "text": "There was a hole in the sky, and something was climbing out of it."
  },
  {
   "id": "2.big",
   "start": 11.7333,
   "end": 14.5667,
   "text": "It was bigger than the bell tower. It had too many legs."
  },
  {
   "id": "2.slow",
   "start": 14.5667,
   "end": 17.5333,
   "text": "It moved like it had all day. It did not see me."
  },
  {
   "id": "2.down",
   "start": 17.5333,
   "end": 21.2333,
   "text": "Then the bell stopped, and I put my face in the dirt like everybody else."
  },
  {
   "id": "2.fine",
   "start": 21.2333,
   "end": 23.9667,
   "text": "Nobody asked what I saw. You did not talk about the bell."
  },
  {
   "id": "3.again",
   "start": 23.9667,
   "end": 26.2667,
   "text": "The next day I looked up again. It was closer."
  },
  {
   "id": "3.roof",
   "start": 26.2667,
   "end": 29.3667,
   "text": "One leg was on the baker's roof. The baker had his face in his bread."
  },
  {
   "id": "3.tell",
   "start": 29.3667,
   "end": 31.7667,
   "text": "I grabbed my friend. \"Look up. Please look up.\""
  },
  {
   "id": "3.wont",
   "start": 31.7667,
   "end": 35.7667,
   "text": "He would not. He put his hands over his eyes and sang the town song."
  },
  {
   "id": "4.mum",
   "start": 35.7667,
   "end": 38.5,
   "text": "I told my mum. She put a hand on my head and pushed it down."
  },
  {
   "id": "4.dad",
   "start": 38.5,
   "end": 41.5667,
   "text": "My dad said, \"The bell keeps us. Do not make it ring twice.\""
  },
  {
   "id": "4.why",
   "start": 41.5667,
   "end": 44.5333,
   "text": "\"Keeps us from what?\" He smiled. He did not answer."
  },
  {
   "id": "4.night",
   "start": 44.5333,
   "end": 47.9333,
   "text": "That night I could not sleep. The thing was on the well. I heard it."
  },
  {
   "id": "5.wait",
   "start": 47.9333,
   "end": 50.2667,
   "text": "So the next day I did not put my face down at all."
  },
  {
   "id": "5.count",
   "start": 50.2667,
   "end": 53.7,
   "text": "I counted the legs. Eight. Then nine. Then I stopped counting."
  },
  {
   "id": "5.eye",
   "start": 53.7,
   "end": 55.8333,
   "text": "It had one eye, and the eye was on the bell."
  },
  {
   "id": "5.want",
   "start": 55.8333,
   "end": 58.8333,
   "text": "It wanted the bell. The bell was the only thing it could not stand."
  },
  {
   "id": "6.reach",
   "start": 58.8333,
   "end": 61.5,
   "text": "It reached for the rope. I was the only one standing."
  },
  {
   "id": "6.run",
   "start": 61.5,
   "end": 65.8667,
   "text": "I ran. Under its leg. Past the baker. Up the tower steps."
  },
  {
   "id": "6.pull",
   "start": 65.8667,
   "end": 68.3333,
   "text": "I got to the rope first, and I pulled it."
  },
  {
   "id": "6.twice",
   "start": 68.3333,
   "end": 70.8,
   "text": "The bell rang twice. The whole town looked up."
  },
  {
   "id": "7.scream",
   "start": 70.8,
   "end": 73.0,
   "text": "My mum screamed. My friend stopped singing."
  },
  {
   "id": "7.run",
   "start": 73.0,
   "end": 75.8,
   "text": "Everybody ran. Not away. Toward the tower."
  },
  {
   "id": "7.rope",
   "start": 75.8,
   "end": 78.0,
   "text": "Hands on the rope. Ten of them. Then twenty."
  },
  {
   "id": "7.ring",
   "start": 78.0,
   "end": 81.7333,
   "text": "The bell did not stop. The thing hated it. It hated all of us now."
  },
  {
   "id": "8.back",
   "start": 81.7333,
   "end": 84.2667,
   "text": "It put one leg back into the hole. Then another."
  },
  {
   "id": "8.slow",
   "start": 84.2667,
   "end": 86.5333,
   "text": "It went slow. It looked at me the whole way."
  },
  {
   "id": "8.gone",
   "start": 86.5333,
   "end": 88.9333,
   "text": "The hole closed. The sky was just sky."
  },
  {
   "id": "8.quiet",
   "start": 88.9333,
   "end": 90.9,
   "text": "The bell stopped. Nobody spoke."
  },
  {
   "id": "9.mum",
   "start": 90.9,
   "end": 94.1667,
   "text": "My mum looked at the sky for a long time. Then she looked at me."
  },
  {
   "id": "9.new",
   "start": 94.1667,
   "end": 96.5333,
   "text": "\"From tomorrow,\" she said, \"we look up.\""
  },
  {
   "id": "9.bell",
   "start": 96.5333,
   "end": 98.8333,
   "text": "The bell rang once, the way it always had."
  },
  {
   "id": "9.up",
   "start": 98.8333,
   "end": 102.3333,
   "text": "Every face came up. The baker. The kids. The iron golem."
  },
  {
   "id": "9.end",
   "start": 102.3333,
   "end": 103.8667,
   "text": "Like and subscribe for more."
  }
 ],
