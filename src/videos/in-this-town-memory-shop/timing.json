 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 1.9,
   "text": "In this town, memories were money."
  },
  {
   "id": "1.what",
   "start": 1.9,
   "end": 3.7,
   "text": "Nobody knew what the shopkeeper did with them."
  },
  {
   "id": "1.shook",
   "start": 3.7,
   "end": 5.6667,
   "text": "Nobody knew why his shop shook every night."
  },
  {
   "id": "1.back",
   "start": 5.6667,
   "end": 7.1667,
   "text": "And nobody ever got a memory back."
  },
  {
   "id": "2.bread",
   "start": 7.1667,
   "end": 8.5,
   "text": "A happy memory bought bread."
  },
  {
   "id": "2.boots",
   "start": 8.5,
   "end": 9.8,
   "text": "A birthday bought new boots."
  },
  {
   "id": "2.cubes",
   "start": 9.8,
   "end": 12.1667,
   "text": "The shopkeeper pulled memories out as glowing blue cubes,"
  },
  {
   "id": "2.jars",
   "start": 12.1667,
   "end": 13.6333,
   "text": "then shut them in glass jars."
  },
  {
   "id": "2.ladder",
   "start": 13.6333,
   "end": 16.1333,
   "text": "A man bought a ladder with the memory of falling off his roof."
  },
  {
   "id": "2.fell",
   "start": 16.1333,
   "end": 17.6333,
   "text": "The next day, he fell off again."
  },
  {
   "id": "3.scarf",
   "start": 17.6333,
   "end": 19.1667,
   "text": "My little sister wore a yellow scarf."
  },
  {
   "id": "3.boats",
   "start": 19.1667,
   "end": 20.6333,
   "text": "We raced paper boats down the river."
  },
  {
   "id": "3.mine",
   "start": 20.6333,
   "end": 22.2667,
   "text": "Mine always sank. Hers never did."
  },
  {
   "id": "3.bed",
   "start": 22.2667,
   "end": 24.0667,
   "text": "Every night, she left one by my bed."
  },
  {
   "id": "4.crops",
   "start": 24.0667,
   "end": 25.6667,
   "text": "Then our crops died."
  },
  {
   "id": "4.mom",
   "start": 25.6667,
   "end": 29.2667,
   "text": "Mom sold her memories for food until the shopkeeper didn't want any more."
  },
  {
   "id": "4.offer",
   "start": 29.2667,
   "end": 31.9667,
   "text": "He offered us a basket of food for every memory I had of my sister."
  },
  {
   "id": "4.no",
   "start": 31.9667,
   "end": 32.6667,
   "text": "I said no."
  },
  {
   "id": "4.okay",
   "start": 32.6667,
   "end": 34.6333,
   "text": "\"It's okay,\" she said. \"I'll remind you.\""
  },
  {
   "id": "4.yes",
   "start": 34.6333,
   "end": 35.3,
   "text": "So I said yes."
  },
  {
   "id": "5.cubes",
   "start": 35.3,
   "end": 37.7333,
   "text": "Blue cubes flew from my head into a jar with my name."
  },
  {
   "id": "5.smile",
   "start": 37.7333,
   "end": 40.3333,
   "text": "My sister smiled at me. I asked Mom who she was."
  },
  {
   "id": "5.boat",
   "start": 40.3333,
   "end": 42.7333,
   "text": "My sister handed me a paper boat. I gave it back."
  },
  {
   "id": "6.gone",
   "start": 42.7333,
   "end": 44.8,
   "text": "The next morning, my sister was gone."
  },
  {
   "id": "6.note",
   "start": 44.8,
   "end": 47.2667,
   "text": "She'd left a note: \"I'm getting your memories back.\""
  },
  {
   "id": "6.picture",
   "start": 47.2667,
   "end": 50.2667,
   "text": "Mom showed me her picture: yellow scarf, paper boat."
  },
  {
   "id": "6.looking",
   "start": 50.2667,
   "end": 52.4333,
   "text": "I didn't remember her, but I went looking anyway."
  },
  {
   "id": "6.lie",
   "start": 52.4333,
   "end": 54.3667,
   "text": "At the shop, the owner said he hadn't seen her."
  },
  {
   "id": "6.door",
   "start": 54.3667,
   "end": 56.1333,
   "text": "But her paper boat was caught under the door."
  },
  {
   "id": "7.pipe",
   "start": 56.1333,
   "end": 57.8667,
   "text": "I climbed the drainpipe. It snapped."
  },
  {
   "id": "7.cart",
   "start": 57.8667,
   "end": 59.2,
   "text": "I landed in his potato cart."
  },
  {
   "id": "7.sack",
   "start": 59.2,
   "end": 61.3,
   "text": "When I heard footsteps, I hid under a sack."
  },
  {
   "id": "7.golem",
   "start": 61.3,
   "end": 63.2667,
   "text": "His iron golem pushed the cart inside."
  },
  {
   "id": "8.stairs",
   "start": 63.2667,
   "end": 64.7667,
   "text": "I followed the thumping down a staircase."
  },
  {
   "id": "8.belts",
   "start": 64.7667,
   "end": 66.3,
   "text": "Jars moved along belts under the shop."
  },
  {
   "id": "8.press",
   "start": 66.3,
   "end": 67.9667,
   "text": "A giant press came down on one."
  },
  {
   "id": "8.emerald",
   "start": 67.9667,
   "end": 69.7,
   "text": "When it rose, an emerald fell out."
  },
  {
   "id": "9.truth",
   "start": 69.7,
   "end": 71.1,
   "text": "He wasn't saving our memories."
  },
  {
   "id": "9.crush",
   "start": 71.1,
   "end": 72.4667,
   "text": "He was crushing them into emeralds."
  },
  {
   "id": "10.sister",
   "start": 72.4667,
   "end": 74.1333,
   "text": "The girl from the picture was reaching for my jar."
  },
  {
   "id": "10.scarf",
   "start": 74.1333,
   "end": 75.6667,
   "text": "Her scarf caught in a gear and pulled her away."
  },
  {
   "id": "10.jar",
   "start": 75.6667,
   "end": 76.8667,
   "text": "The jar rolled toward the press."
  },
  {
   "id": "10.choice",
   "start": 76.8667,
   "end": 79.6,
   "text": "I could save my memories, or I could save her. Not both."
  },
  {
   "id": "11.jump",
   "start": 79.6,
   "end": 81.8,
   "text": "I jumped onto the belt and pulled her scarf free."
  },
  {
   "id": "11.tumble",
   "start": 81.8,
   "end": 82.9667,
   "text": "We tumbled off together."
  },
  {
   "id": "11.press",
   "start": 82.9667,
   "end": 84.3333,
   "text": "The press crushed my jar."
  },
  {
   "id": "11.one",
   "start": 84.3333,
   "end": 86.7,
   "text": "Every memory I had of her became one emerald."
  },
  {
   "id": "12.stairs",
   "start": 86.7,
   "end": 88.1333,
   "text": "The golem stomped down the stairs."
  },
  {
   "id": "12.lever",
   "start": 88.1333,
   "end": 89.9667,
   "text": "I pulled the red lever, and the belts stopped."
  },
  {
   "id": "12.feet",
   "start": 89.9667,
   "end": 91.9,
   "text": "The jars rolled under its feet. It fell."
  },
  {
   "id": "12.free",
   "start": 91.9,
   "end": 94.2667,
   "text": "The jars smashed, and memories flew back to their owners."
  },
  {
   "id": "13.town",
   "start": 94.2667,
   "end": 96.0333,
   "text": "The town saw what the shopkeeper had done."
  },
  {
   "id": "13.food",
   "start": 96.0333,
   "end": 97.8333,
   "text": "That evening, people brought us food."
  },
  {
   "id": "13.river",
   "start": 97.8333,
   "end": 99.2667,
   "text": "My sister took me down to the river."
  },
  {
   "id": "14.ask",
   "start": 99.2667,
   "end": 100.6667,
   "text": "\"Do you remember me?\" she asked."
  },
  {
   "id": "14.shook",
   "start": 100.6667,
   "end": 101.6667,
   "text": "I shook my head."
  },
  {
   "id": "14.teach",
   "start": 101.6667,
   "end": 104.3333,
   "text": "She handed me a piece of paper. \"I can teach you,\" she said."
  },
  {
   "id": "14.fold",
   "start": 104.3333,
   "end": 106.2667,
   "text": "We folded two boats and put them in the river."
  },
  {
   "id": "14.result",
   "start": 106.2667,
   "end": 107.8667,
   "text": "Mine sank. Hers didn't."
  },
  {
   "id": "14.laugh",
   "start": 107.8667,
   "end": 110.2333,
   "text": "She laughed. This time, I laughed too."
  },
  {
   "id": "14.sub",
   "start": 110.2333,
   "end": 112.2,
   "text": "Subscribe before my next boat sinks."
  }
 ],
