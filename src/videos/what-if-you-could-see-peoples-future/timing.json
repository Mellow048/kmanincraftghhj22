{
 "film": "what-if-you-could-see-peoples-future",
 "fps": 30,
 "duration": 115.1,
 "estimated": true,
 "tempo": 1.0,
 "wordsPerMinute": 255.5,
 "audio": null,
 "clips": [],
 "cues": [
  {
   "id": "1.what",
   "start": 0.0,
   "end": 1.5,
   "text": "What if you could see people's future?"
  },
  {
   "id": "1.me",
   "start": 1.5,
   "end": 2.6333,
   "text": "One morning, I could."
  },
  {
   "id": "2.hall",
   "start": 2.6333,
   "end": 4.8667,
   "text": "At school, a grown-up stood behind every kid."
  },
  {
   "id": "2.older",
   "start": 4.8667,
   "end": 6.4667,
   "text": "It was them, thirty years older."
  },
  {
   "id": "3.painter",
   "start": 6.4667,
   "end": 9.1333,
   "text": "Behind the boy who drew on every desk stood a painter."
  },
  {
   "id": "3.sleep",
   "start": 9.1333,
   "end": 11.8333,
   "text": "Behind the boy who slept through math, a man slept at a desk."
  },
  {
   "id": "3.pirate",
   "start": 11.8333,
   "end": 14.2,
   "text": "And behind the quietest girl in class stood a pirate."
  },
  {
   "id": "3.why",
   "start": 14.2,
   "end": 16.3333,
   "text": "It showed me who. It never told me why."
  },
  {
   "id": "4.star",
   "start": 16.3333,
   "end": 19.1,
   "text": "I got a football star to sign my shirt, thirty years early."
  },
  {
   "id": "4.small",
   "start": 19.1,
   "end": 21.3333,
   "text": "I was very nice to the smallest kid in school."
  },
  {
   "id": "4.cow",
   "start": 21.3333,
   "end": 22.8667,
   "text": "His grown-up could carry a cow."
  },
  {
   "id": "5.max",
   "start": 22.8667,
   "end": 24.7,
   "text": "Then I looked behind my best friend, Max."
  },
  {
   "id": "5.rags",
   "start": 24.7,
   "end": 27.0667,
   "text": "A thin man. A coat full of holes. No shoes."
  },
  {
   "id": "5.sense",
   "start": 27.0667,
   "end": 27.9667,
   "text": "It made no sense."
  },
  {
   "id": "5.bike",
   "start": 27.9667,
   "end": 29.9,
   "text": "Max built his own bike from three broken ones."
  },
  {
   "id": "5.ruby",
   "start": 29.9,
   "end": 31.8333,
   "text": "I had one guess. Her name was Ruby."
  },
  {
   "id": "6.asked",
   "start": 31.8333,
   "end": 33.5333,
   "text": "Max had asked her out eleven times."
  },
  {
   "id": "6.no",
   "start": 33.5333,
   "end": 35.0667,
   "text": "She had said no eleven times."
  },
  {
   "id": "6.gift",
   "start": 35.0667,
   "end": 37.4,
   "text": "After every no, he bought a bigger present."
  },
  {
   "id": "6.lost",
   "start": 37.4,
   "end": 40.2,
   "text": "After every present, the man behind him lost something."
  },
  {
   "id": "6.chain",
   "start": 40.2,
   "end": 42.5333,
   "text": "Once, while Max fixed my bike chain, that man had boots."
  },
  {
   "id": "6.light",
   "start": 42.5333,
   "end": 43.4333,
   "text": "I blamed the light."
  },
  {
   "id": "7.told",
   "start": 43.4333,
   "end": 45.8333,
   "text": "So I told him. Max, your future has no shoes."
  },
  {
   "id": "7.faster",
   "start": 45.8333,
   "end": 47.9667,
   "text": "He said, then I had better ask her faster."
  },
  {
   "id": "7.bear",
   "start": 47.9667,
   "end": 50.5333,
   "text": "He sold his tools, and bought a bear the size of a door."
  },
  {
   "id": "7.twelve",
   "start": 50.5333,
   "end": 52.1333,
   "text": "Ruby said no. That made twelve."
  },
  {
   "id": "7.coat",
   "start": 52.1333,
   "end": 53.7,
   "text": "The man behind him lost his coat."
  },
  {
   "id": "8.lie",
   "start": 53.7,
   "end": 55.9667,
   "text": "So I lied. I said Ruby had a boyfriend."
  },
  {
   "id": "8.day",
   "start": 55.9667,
   "end": 57.2333,
   "text": "It worked for one whole day."
  },
  {
   "id": "8.shoes",
   "start": 57.2333,
   "end": 58.9667,
   "text": "That man even got a pair of shoes."
  },
  {
   "id": "8.what",
   "start": 58.9667,
   "end": 61.1333,
   "text": "Then Max asked Ruby. She said, what boyfriend?"
  },
  {
   "id": "8.side",
   "start": 61.1333,
   "end": 63.2333,
   "text": "He said I was supposed to be on his side."
  },
  {
   "id": "9.ruby",
   "start": 63.2333,
   "end": 66.3667,
   "text": "Ruby found me. She said, I told him no. Make him hear it."
  },
  {
   "id": "9.suit",
   "start": 66.3667,
   "end": 68.4,
   "text": "Behind her stood a woman in a space suit."
  },
  {
   "id": "9.moon",
   "start": 68.4,
   "end": 71.0667,
   "text": "Ruby was going to the moon. She had no time for bears."
  },
  {
   "id": "10.bike",
   "start": 71.0667,
   "end": 73.5333,
   "text": "On Friday, Max sold his bike and bought a gold necklace."
  },
  {
   "id": "10.lunch",
   "start": 73.5333,
   "end": 76.4667,
   "text": "He was going to ask her at lunch, in front of everybody."
  },
  {
   "id": "10.cup",
   "start": 76.4667,
   "end": 78.8333,
   "text": "Behind him, that man sat on the ground with a cup."
  },
  {
   "id": "10.lucky",
   "start": 78.8333,
   "end": 80.6667,
   "text": "He said thirteen was his lucky number."
  },
  {
   "id": "10.table",
   "start": 80.6667,
   "end": 82.8667,
   "text": "He climbed onto a table and held up the necklace."
  },
  {
   "id": "11.no",
   "start": 82.8667,
   "end": 84.6667,
   "text": "Ruby said, no, Max. Please stop."
  },
  {
   "id": "11.worse",
   "start": 84.6667,
   "end": 86.2,
   "text": "Nobody laughed. That was worse."
  },
  {
   "id": "12.rack",
   "start": 86.2,
   "end": 88.3,
   "text": "I found him sitting where his bike used to be."
  },
  {
   "id": "12.same",
   "start": 88.3,
   "end": 90.1667,
   "text": "He and that man finally looked the same."
  },
  {
   "id": "12.boots",
   "start": 90.1667,
   "end": 91.5333,
   "text": "Then I remembered the boots."
  },
  {
   "id": "12.chain",
   "start": 91.5333,
   "end": 94.0667,
   "text": "So I pulled the chain off my bike, and wheeled it over."
  },
  {
   "id": "13.look",
   "start": 94.0667,
   "end": 95.6667,
   "text": "He looked at it for a long time."
  },
  {
   "id": "13.stood",
   "start": 95.6667,
   "end": 98.2333,
   "text": "Then he knelt down. And behind him, the man stood up."
  },
  {
   "id": "13.coat",
   "start": 98.2333,
   "end": 99.3333,
   "text": "Boots. A clean coat."
  },
  {
   "id": "13.shop",
   "start": 99.3333,
   "end": 101.1,
   "text": "A shop with his name over the door."
  },
  {
   "id": "13.money",
   "start": 101.1,
   "end": 102.4333,
   "text": "It was never the money."
  },
  {
   "id": "13.sold",
   "start": 102.4333,
   "end": 104.0333,
   "text": "It was what he sold to get it."
  },
  {
   "id": "13.hand",
   "start": 104.0333,
   "end": 106.6667,
   "text": "That man only had shoes when Max had a wrench in his hand."
  },
  {
   "id": "14.nine",
   "start": 106.6667,
   "end": 109.3667,
   "text": "A week later, Max had fixed nine bikes and bought his own back."
  },
  {
   "id": "14.ruby",
   "start": 109.3667,
   "end": 110.6,
   "text": "Then Ruby wheeled hers in."
  },
  {
   "id": "14.price",
   "start": 110.6,
   "end": 112.3,
   "text": "He fixed it, and charged her full price."
  },
  {
   "id": "14.sub",
   "start": 112.3,
   "end": 115.1,
   "text": "Subscribe. The one standing behind you already has."
  }
 ],
