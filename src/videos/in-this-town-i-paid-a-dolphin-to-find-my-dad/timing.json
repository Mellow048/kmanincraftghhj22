 "cues": [
  {
   "id": "1.pay",
   "start": 0.0,
   "end": 2.9,
   "text": "In this town, I paid a dolphin to find my dad."
  },
  {
   "id": "1.empty",
   "start": 2.9,
   "end": 5.5667,
   "text": "The storm was over. Dad still hadn't come home."
  },
  {
   "id": "1.half",
   "start": 5.5667,
   "end": 7.3667,
   "text": "Only half of his oar had washed up."
  },
  {
   "id": "1.stripe",
   "start": 7.3667,
   "end": 9.8333,
   "text": "I knew that crooked stripe. I'd painted it."
  },
  {
   "id": "1.lunch",
   "start": 9.8333,
   "end": 11.6333,
   "text": "Dad used to feed this dolphin his lunch."
  },
  {
   "id": "1.guess",
   "start": 11.6333,
   "end": 13.2333,
   "text": "I hoped it knew which way he'd gone."
  },
  {
   "id": "2.search",
   "start": 13.2333,
   "end": 15.3667,
   "text": "The search boats all headed out to sea."
  },
  {
   "id": "2.turn",
   "start": 15.3667,
   "end": 18.0,
   "text": "The dolphin turned the other way. Toward the reef."
  },
  {
   "id": "2.tie",
   "start": 18.0,
   "end": 19.6667,
   "text": "I tied my boat to an old wreck."
  },
  {
   "id": "2.dive",
   "start": 19.6667,
   "end": 21.8,
   "text": "The dolphin went under. I went after it."
  },
  {
   "id": "3.hope",
   "start": 21.8,
   "end": 23.4667,
   "text": "I thought it had spotted Dad."
  },
  {
   "id": "3.chest",
   "start": 23.4667,
   "end": 24.9667,
   "text": "It had spotted a chest."
  },
  {
   "id": "3.gold",
   "start": 24.9667,
   "end": 27.7333,
   "text": "The lid was cracked. I could see gold inside."
  },
  {
   "id": "3.leave",
   "start": 27.7333,
   "end": 29.5333,
   "text": "I'd have stopped for that any other day."
  },
  {
   "id": "4.red",
   "start": 29.5333,
   "end": 32.0667,
   "text": "Then something red slid through a gap in the deck."
  },
  {
   "id": "4.match",
   "start": 32.0667,
   "end": 34.0,
   "text": "The white stripe bent the same way as mine."
  },
  {
   "id": "4.hand",
   "start": 34.0,
   "end": 36.2,
   "text": "The oar moved again. Someone was holding it."
  },
  {
   "id": "4.dad",
   "start": 36.2,
   "end": 38.0,
   "text": "Then I heard him. “Is that you?”"
  },
  {
   "id": "4.here",
   "start": 38.0,
   "end": 39.9667,
   "text": "I stuck my hand through the gap. He grabbed it."
  },
  {
   "id": "5.reef",
   "start": 39.9667,
   "end": 41.8,
   "text": "Dad told me his boat had hit the reef."
  },
  {
   "id": "5.cabin",
   "start": 41.8,
   "end": 43.8,
   "text": "He'd climbed into the part of the wreck above water."
  },
  {
   "id": "5.beam",
   "start": 43.8,
   "end": 45.6667,
   "text": "But a beam had fallen across the hatch."
  },
  {
   "id": "5.pull",
   "start": 45.6667,
   "end": 47.9,
   "text": "I pulled till my feet slipped. Nothing."
  },
  {
   "id": "5.push",
   "start": 47.9,
   "end": 50.4,
   "text": "Dad pushed from below. It didn't move."
  },
  {
   "id": "5.boat",
   "start": 50.4,
   "end": 52.5667,
   "text": "Then I saw the half I'd left in my boat."
  },
  {
   "id": "5.under",
   "start": 52.5667,
   "end": 54.9667,
   "text": "I slid the oar under the end of the beam."
  },
  {
   "id": "5.now",
   "start": 54.9667,
   "end": 57.6667,
   "text": "“Now, Dad!” I leaned down as he pushed up."
  },
  {
   "id": "5.open",
   "start": 57.6667,
   "end": 60.2667,
   "text": "The beam rolled clear. The hatch came up."
  },
  {
   "id": "6.up",
   "start": 60.2667,
   "end": 62.9333,
   "text": "He reached out. This time I could grab his arm."
  },
  {
   "id": "6.boat",
   "start": 62.9333,
   "end": 64.6667,
   "text": "I held on till he was in the boat."
  },
  {
   "id": "6.chest",
   "start": 64.6667,
   "end": 66.5333,
   "text": "We left the gold where it was."
  },
  {
   "id": "6.home",
   "start": 66.5333,
   "end": 68.7,
   "text": "Dad opened our fish box back at the dock."
  },
  {
   "id": "6.first",
   "start": 68.7,
   "end": 70.2333,
   "text": "He held a fish out over the water."
  },
  {
   "id": "6.second",
   "start": 70.2333,
   "end": 72.1,
   "text": "Then he reached in and took out another."
  },
  {
   "id": "6.double",
   "start": 72.1,
   "end": 73.2667,
   "text": "Dad paid him double."
  },
  {
   "id": "6.close",
   "start": 73.2667,
   "end": 74.9,
   "text": "Subscribe if you'd hire him."
  }
 ],
