 "cues": [
  {
   "id": "1.what",
   "start": 0.0,
   "end": 2.1667,
   "text": "What if every block repeated the last thing it heard?"
  },
  {
   "id": "1.echo",
   "start": 2.1667,
   "end": 4.5333,
   "text": "The gym wall whispered, “I can't stay.”"
  },
  {
   "id": "2.friend",
   "start": 4.5333,
   "end": 6.5,
   "text": "My best friend Eli went quiet that morning."
  },
  {
   "id": "2.script",
   "start": 6.5,
   "end": 8.3333,
   "text": "He carried a script and never looked up."
  },
  {
   "id": "2.question",
   "start": 8.3333,
   "end": 10.0,
   "text": "I wanted to know if he was leaving."
  },
  {
   "id": "2.follow",
   "start": 10.0,
   "end": 11.9,
   "text": "So I followed the whispers through school."
  },
  {
   "id": "3.touch",
   "start": 11.9,
   "end": 13.9,
   "text": "Touching any block brought back its last phrase."
  },
  {
   "id": "3.voice",
   "start": 13.9,
   "end": 15.4333,
   "text": "It arrived as a hollow stone echo."
  },
  {
   "id": "3.name",
   "start": 15.4333,
   "end": 17.0,
   "text": "It never named the speaker or the day."
  },
  {
   "id": "3.meaning",
   "start": 17.0,
   "end": 18.4667,
   "text": "The words came back without their meaning."
  },
  {
   "id": "3.power",
   "start": 18.4667,
   "end": 19.8667,
   "text": "I heard the stone, not the speaker."
  },
  {
   "id": "4.desk",
   "start": 19.8667,
   "end": 21.7,
   "text": "The desk said, “Check beneath the lunch tray.”"
  },
  {
   "id": "4.lunch",
   "start": 21.7,
   "end": 23.4667,
   "text": "My missing sandwich sat exactly there."
  },
  {
   "id": "4.locker",
   "start": 23.4667,
   "end": 25.4667,
   "text": "The locker said, “Top shelf, left side.”"
  },
  {
   "id": "4.key",
   "start": 25.4667,
   "end": 27.1,
   "text": "I found my lost key behind a book."
  },
  {
   "id": "4.class",
   "start": 27.1,
   "end": 28.8667,
   "text": "The wall replayed our teacher's sneeze."
  },
  {
   "id": "4.laugh",
   "start": 28.8667,
   "end": 30.9,
   "text": "Three kids jumped; the class burst out laughing."
  },
  {
   "id": "5.want",
   "start": 30.9,
   "end": 32.3,
   "text": "I needed Eli to say he was staying."
  },
  {
   "id": "5.team",
   "start": 32.3,
   "end": 34.0,
   "text": "We'd built every block project side by side."
  },
  {
   "id": "5.fear",
   "start": 34.0,
   "end": 35.0667,
   "text": "I was scared to lose my teammate."
  },
  {
   "id": "6.pages",
   "start": 35.0667,
   "end": 36.9,
   "text": "His script lay open beside my desk."
  },
  {
   "id": "6.line",
   "start": 36.9,
   "end": 38.7333,
   "text": "“It's just a play,” he said."
  },
  {
   "id": "6.ignore",
   "start": 38.7333,
   "end": 41.5,
   "text": "I ignored him; the wall said, “I can't stay.”"
  },
  {
   "id": "6.words",
   "start": 41.5,
   "end": 43.0333,
   "text": "The same words were printed on his page."
  },
  {
   "id": "7.hall",
   "start": 43.0333,
   "end": 44.9333,
   "text": "The hall repeated, “I need to get away.”"
  },
  {
   "id": "7.assume",
   "start": 44.9333,
   "end": 46.2333,
   "text": "I thought he meant away from me."
  },
  {
   "id": "7.walk",
   "start": 46.2333,
   "end": 47.8333,
   "text": "I walked right past his classroom."
  },
  {
   "id": "7.empty",
   "start": 47.8333,
   "end": 49.5,
   "text": "The door stood open; he wasn't there."
  },
  {
   "id": "8.gym",
   "start": 49.5,
   "end": 51.4,
   "text": "The gym wall whispered, “Don't tell him.”"
  },
  {
   "id": "8.run",
   "start": 51.4,
   "end": 52.8333,
   "text": "I ran where the echo pointed next."
  },
  {
   "id": "8.stage",
   "start": 52.8333,
   "end": 54.3667,
   "text": "A stage light clicked on by itself."
  },
  {
   "id": "8.goodbye",
   "start": 54.3667,
   "end": 56.3667,
   "text": "The floor repeated, “Goodbye, my old friend.”"
  },
  {
   "id": "8.stone",
   "start": 56.3667,
   "end": 57.8667,
   "text": "I pictured Eli leaving without a wave."
  },
  {
   "id": "9.call",
   "start": 57.8667,
   "end": 59.8333,
   "text": "Eli called, “Wait. This isn't about you.”"
  },
  {
   "id": "9.echo",
   "start": 59.8333,
   "end": 61.4667,
   "text": "A new echo came from behind the stage."
  },
  {
   "id": "9.script",
   "start": 61.4667,
   "end": 62.8,
   "text": "He dropped his script and followed."
  },
  {
   "id": "10.dark",
   "start": 62.8,
   "end": 64.4667,
   "text": "The curtains hid the stage in darkness."
  },
  {
   "id": "10.touch",
   "start": 64.4667,
   "end": 66.0667,
   "text": "I touched the brick beside the stage."
  },
  {
   "id": "10.last",
   "start": 66.0667,
   "end": 67.8,
   "text": "It repeated, “I don't want to see him.”"
  },
  {
   "id": "10.breath",
   "start": 67.8,
   "end": 69.1667,
   "text": "I couldn't pretend I hadn't heard it."
  },
  {
   "id": "10.bell",
   "start": 69.1667,
   "end": 70.6333,
   "text": "The final school bell rang overhead."
  },
  {
   "id": "10.choice",
   "start": 70.6333,
   "end": 72.5667,
   "text": "I could ask him, or follow the echo."
  },
  {
   "id": "11.enter",
   "start": 72.5667,
   "end": 74.3667,
   "text": "I pulled the curtain and stepped through."
  },
  {
   "id": "11.find",
   "start": 74.3667,
   "end": 76.4667,
   "text": "Eli stood onstage, reading to himself."
  },
  {
   "id": "11.stop",
   "start": 76.4667,
   "end": 78.4,
   "text": "He saw me and stopped reading aloud."
  },
  {
   "id": "12.ask",
   "start": 78.4,
   "end": 79.6667,
   "text": "I asked if he was leaving me."
  },
  {
   "id": "12.script",
   "start": 79.6667,
   "end": 80.9667,
   "text": "He showed me the page in his hand."
  },
  {
   "id": "12.role",
   "start": 80.9667,
   "end": 82.4667,
   "text": "Those words belonged to the villain's goodbye."
  },
  {
   "id": "13.practice",
   "start": 82.4667,
   "end": 84.3333,
   "text": "Eli was practicing alone for auditions."
  },
  {
   "id": "13.opening",
   "start": 84.3333,
   "end": 85.9,
   "text": "The first echo was his opening line."
  },
  {
   "id": "13.heard",
   "start": 85.9,
   "end": 87.6,
   "text": "He'd rehearsed it beside every wall."
  },
  {
   "id": "13.limit",
   "start": 87.6,
   "end": 89.5667,
   "text": "The blocks kept his words, not meaning."
  },
  {
   "id": "13.mistake",
   "start": 89.5667,
   "end": 91.0333,
   "text": "I nearly lost my friend to a guess."
  },
  {
   "id": "13.reader",
   "start": 91.0333,
   "end": 92.2667,
   "text": "I asked if he wanted me to read."
  },
  {
   "id": "13.smile",
   "start": 92.2667,
   "end": 93.7,
   "text": "He smiled and handed me the script."
  },
  {
   "id": "14.scene",
   "start": 93.7,
   "end": 94.8667,
   "text": "We acted the goodbye together."
  },
  {
   "id": "14.out",
   "start": 94.8667,
   "end": 96.4,
   "text": "The final echo sounded like laughter."
  },
  {
   "id": "14.sub",
   "start": 96.4,
   "end": 98.5667,
   "text": "Subscribe. This time, I listened."
  }
 ],
