{
 "film": "in-this-town-i-killed-our-protector",
 "fps": 30,
 "duration": 97.2333,
 "estimated": true,
 "tempo": 1.0,
 "wordsPerMinute": 255.5,
 "audio": null,
 "clips": [],
 "cues": [
  {
   "id": "1.killed",
   "start": 0.0,
   "end": 1.7,
   "text": "In this town, I killed our protector."
  },
  {
   "id": "1.back",
   "start": 1.7,
   "end": 3.4333,
   "text": "The whole town rebuilt it in one night."
  },
  {
   "id": "1.what",
   "start": 3.4333,
   "end": 5.1,
   "text": "Nobody would tell me what they used."
  },
  {
   "id": "2.sleep",
   "start": 5.1,
   "end": 6.7333,
   "text": "Nobody had ever seen it sleep."
  },
  {
   "id": "2.break",
   "start": 6.7333,
   "end": 9.0333,
   "text": "Nobody had ever seen it break. Until me."
  },
  {
   "id": "2.well",
   "start": 9.0333,
   "end": 11.5333,
   "text": "And nobody would say why the well was full of flowers."
  },
  {
   "id": "2.rule",
   "start": 11.5333,
   "end": 13.6667,
   "text": "The oldest rule in town was about those flowers."
  },
  {
   "id": "2.keep",
   "start": 13.6667,
   "end": 14.5333,
   "text": "Never keep one."
  },
  {
   "id": "3.wall",
   "start": 14.5333,
   "end": 15.7667,
   "text": "It walked the wall all night."
  },
  {
   "id": "3.gate",
   "start": 15.7667,
   "end": 17.3,
   "text": "At dawn, it stood at the gate."
  },
  {
   "id": "3.take",
   "start": 17.3,
   "end": 18.9,
   "text": "Then it took one flower off the well,"
  },
  {
   "id": "3.child",
   "start": 18.9,
   "end": 20.1333,
   "text": "and gave it to a child."
  },
  {
   "id": "3.none",
   "start": 20.1333,
   "end": 22.1,
   "text": "Nobody asked how. Nobody asked why."
  },
  {
   "id": "3.lid",
   "start": 22.1,
   "end": 24.3667,
   "text": "The well had a stone lid. It was never on."
  },
  {
   "id": "3.anvil",
   "start": 24.3667,
   "end": 26.9,
   "text": "The blacksmith had an anvil. My mother had a pot."
  },
  {
   "id": "3.bucket",
   "start": 26.9,
   "end": 29.1,
   "text": "My father had a bucket with a hole in it."
  },
  {
   "id": "3.remember",
   "start": 29.1,
   "end": 31.2333,
   "text": "He said iron remembers the shape you give it."
  },
  {
   "id": "3.good",
   "start": 31.2333,
   "end": 33.8,
   "text": "It was a good life. Nobody had been hurt in years."
  },
  {
   "id": "4.protect",
   "start": 33.8,
   "end": 35.5,
   "text": "But the golem protected all of us."
  },
  {
   "id": "4.need",
   "start": 35.5,
   "end": 36.7333,
   "text": "I wanted it to need me."
  },
  {
   "id": "5.ask",
   "start": 36.7333,
   "end": 38.7667,
   "text": "So I asked the oldest woman in town why."
  },
  {
   "id": "5.say",
   "start": 38.7667,
   "end": 40.6333,
   "text": "\"Never keep a golem's flower,\" she said."
  },
  {
   "id": "5.again",
   "start": 40.6333,
   "end": 41.6667,
   "text": "I asked her again."
  },
  {
   "id": "5.walk",
   "start": 41.6667,
   "end": 42.5333,
   "text": "She walked away."
  },
  {
   "id": "6.bell",
   "start": 42.5333,
   "end": 43.8667,
   "text": "Then one night, the bell rang."
  },
  {
   "id": "6.wall",
   "start": 43.8667,
   "end": 45.2,
   "text": "Something was on the wall."
  },
  {
   "id": "7.sword",
   "start": 45.2,
   "end": 46.7,
   "text": "I grabbed my father's diamond sword."
  },
  {
   "id": "7.zombie",
   "start": 46.7,
   "end": 47.7333,
   "text": "I got the zombie."
  },
  {
   "id": "7.skeleton",
   "start": 47.7333,
   "end": 48.8667,
   "text": "I got the skeleton."
  },
  {
   "id": "7.proud",
   "start": 48.8667,
   "end": 51.7,
   "text": "I was so proud of myself that I forgot to look behind it."
  },
  {
   "id": "8.behind",
   "start": 51.7,
   "end": 53.5333,
   "text": "There was a creeper behind the golem."
  },
  {
   "id": "8.shout",
   "start": 53.5333,
   "end": 54.4,
   "text": "I should have shouted."
  },
  {
   "id": "8.stood",
   "start": 54.4,
   "end": 55.3,
   "text": "I just stood there."
  },
  {
   "id": "9.boom",
   "start": 55.3,
   "end": 56.0,
   "text": "It exploded."
  },
  {
   "id": "9.dust",
   "start": 56.0,
   "end": 57.8,
   "text": "When the dust settled, the golem was gone."
  },
  {
   "id": "10.finish",
   "start": 57.8,
   "end": 58.9667,
   "text": "We finished the monsters."
  },
  {
   "id": "10.walk",
   "start": 58.9667,
   "end": 60.2,
   "text": "I walked to where it fell."
  },
  {
   "id": "10.rose",
   "start": 60.2,
   "end": 61.4333,
   "text": "In the ash was a rose."
  },
  {
   "id": "11.pick",
   "start": 61.4333,
   "end": 63.2333,
   "text": "I picked it up. It was still warm."
  },
  {
   "id": "11.put",
   "start": 63.2333,
   "end": 65.4,
   "text": "I put it on the well, with all the others."
  },
  {
   "id": "11.letgo",
   "start": 65.4,
   "end": 67.8333,
   "text": "The rule said never keep it. So I let it go."
  },
  {
   "id": "12.home",
   "start": 67.8333,
   "end": 68.5667,
   "text": "I went home."
  },
  {
   "id": "12.bed",
   "start": 68.5667,
   "end": 70.3333,
   "text": "I lay on my bed and did not sleep."
  },
  {
   "id": "13.light",
   "start": 70.3333,
   "end": 71.9667,
   "text": "In the morning, the sun came in."
  },
  {
   "id": "13.square",
   "start": 71.9667,
   "end": 73.0333,
   "text": "I went to the square."
  },
  {
   "id": "13.there",
   "start": 73.0333,
   "end": 74.0667,
   "text": "It was standing there."
  },
  {
   "id": "14.hooks",
   "start": 74.0667,
   "end": 75.7333,
   "text": "The hooks in the smithy were empty."
  },
  {
   "id": "14.pot",
   "start": 75.7333,
   "end": 77.6,
   "text": "My mother's pot was gone from the kitchen."
  },
  {
   "id": "14.iron",
   "start": 77.6,
   "end": 80.1,
   "text": "Every piece of iron in this town was in the square."
  },
  {
   "id": "14.built",
   "start": 80.1,
   "end": 82.3667,
   "text": "In the night, the whole village had built it again."
  },
  {
   "id": "14.afraid",
   "start": 82.3667,
   "end": 84.7333,
   "text": "Not because they loved it. Because they were afraid."
  },
  {
   "id": "14.giveback",
   "start": 84.7333,
   "end": 86.9667,
   "text": "And because the well gives back what you put in it."
  },
  {
   "id": "14.flowers",
   "start": 86.9667,
   "end": 89.6667,
   "text": "Every flower on that well was somebody we had lost."
  },
  {
   "id": "14.ours",
   "start": 89.6667,
   "end": 91.8333,
   "text": "The golem had been handing us our own flowers."
  },
  {
   "id": "14.held",
   "start": 91.8333,
   "end": 93.2333,
   "text": "Then it held one out to me."
  },
  {
   "id": "14.mine",
   "start": 93.2333,
   "end": 95.5667,
   "text": "It was mine. The rose I had left on the well."
  },
  {
   "id": "14.sub",
   "start": 95.5667,
   "end": 97.2333,
   "text": "Subscribe before I keep it."
  }
 ],
