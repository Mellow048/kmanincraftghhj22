 "cues": [
  {
   "id": "1.grey",
   "start": 0.0,
   "end": 1.7333,
   "text": "This player only built with grey blocks."
  },
  {
   "id": "1.only",
   "start": 1.7333,
   "end": 3.7333,
   "text": "No wood, no brick, just grey wool."
  },
  {
   "id": "1.ugly",
   "start": 3.7333,
   "end": 5.4667,
   "text": "Everyone called his base the ugliest build."
  },
  {
   "id": "1.promise",
   "start": 5.4667,
   "end": 7.2333,
   "text": "When they learned why, they rebuilt it in color."
  },
  {
   "id": "2.rainbow",
   "start": 7.2333,
   "end": 9.3,
   "text": "Everyone else built bright, colorful castles."
  },
  {
   "id": "2.box",
   "start": 9.3,
   "end": 11.0667,
   "text": "Next to them sat Sam's grey wool box."
  },
  {
   "id": "2.sign",
   "start": 11.0667,
   "end": 13.2667,
   "text": "Players put a sign outside saying boring box."
  },
  {
   "id": "2.laugh",
   "start": 13.2667,
   "end": 14.9667,
   "text": "They laughed in chat at his grey walls."
  },
  {
   "id": "2.quiet",
   "start": 14.9667,
   "end": 16.7667,
   "text": "Sam never argued. He just kept building."
  },
  {
   "id": "3.lazy",
   "start": 16.7667,
   "end": 18.2667,
   "text": "But Sam wasn't lazy or trolling."
  },
  {
   "id": "3.blind",
   "start": 18.2667,
   "end": 19.9,
   "text": "He was born completely colorblind."
  },
  {
   "id": "3.shades",
   "start": 19.9,
   "end": 22.0,
   "text": "Red, green, and brown all looked grey."
  },
  {
   "id": "3.desk",
   "start": 22.0,
   "end": 23.6,
   "text": "At his desk, he had to guess blocks."
  },
  {
   "id": "3.school",
   "start": 23.6,
   "end": 25.2,
   "text": "Kids laughed when he drew a green sky."
  },
  {
   "id": "3.here",
   "start": 25.2,
   "end": 26.7667,
   "text": "Here, grey meant he never got it wrong."
  },
  {
   "id": "4.prank",
   "start": 26.7667,
   "end": 28.7333,
   "text": "One night, a player snuck to Sam's base."
  },
  {
   "id": "4.swap",
   "start": 28.7333,
   "end": 30.4667,
   "text": "He swapped every wall with bright pink wool."
  },
  {
   "id": "4.chat",
   "start": 30.4667,
   "end": 32.2,
   "text": "Fixed your ugly house, he laughed in chat."
  },
  {
   "id": "4.stare",
   "start": 32.2,
   "end": 34.0667,
   "text": "Next morning, Sam stared at his doorway."
  },
  {
   "id": "4.cant",
   "start": 34.0667,
   "end": 35.7333,
   "text": "He typed, I can't tell what you did."
  },
  {
   "id": "4.quiet2",
   "start": 35.7333,
   "end": 37.3,
   "text": "The whole chat went completely quiet."
  },
  {
   "id": "4.left",
   "start": 37.3,
   "end": 39.0,
   "text": "Then Sam logged off and didn't come back."
  },
  {
   "id": "5.dm",
   "start": 39.0,
   "end": 40.5667,
   "text": "So the owner messaged Sam right away."
  },
  {
   "id": "5.told",
   "start": 40.5667,
   "end": 41.8333,
   "text": "Sam told the owner everything."
  },
  {
   "id": "5.idea",
   "start": 41.8333,
   "end": 42.9667,
   "text": "And the owner knew what to do."
  },
  {
   "id": "5.texture",
   "start": 42.9667,
   "end": 44.9333,
   "text": "In Minecraft, every block has its own pattern."
  },
  {
   "id": "5.brick",
   "start": 44.9333,
   "end": 47.3667,
   "text": "Bricks have lines, logs have bark, glowstone shines."
  },
  {
   "id": "6.join",
   "start": 47.3667,
   "end": 49.1,
   "text": "That night, the whole server logged on."
  },
  {
   "id": "6.wall",
   "start": 49.1,
   "end": 51.1,
   "text": "They built a giant palette wall beside his yard."
  },
  {
   "id": "6.labels",
   "start": 51.1,
   "end": 52.8,
   "text": "Every row had a chest and color sign."
  },
  {
   "id": "6.rebuild",
   "start": 52.8,
   "end": 55.0,
   "text": "They rebuilt his home with brick, oak, and lanterns."
  },
  {
   "id": "7.return",
   "start": 55.0,
   "end": 56.8,
   "text": "When Sam logged back on, he saw the wall."
  },
  {
   "id": "7.chest",
   "start": 56.8,
   "end": 58.7,
   "text": "He opened each chest and read every sign."
  },
  {
   "id": "7.tears",
   "start": 58.7,
   "end": 60.5,
   "text": "For the first time, he saw every color."
  },
  {
   "id": "7.typed",
   "start": 60.5,
   "end": 62.4667,
   "text": "Sam smiled and typed, now I see color too."
  },
  {
   "id": "7.gallery",
   "start": 62.4667,
   "end": 64.5333,
   "text": "The boring box sign became Sam's Gallery."
  },
  {
   "id": "7.cta",
   "start": 64.5333,
   "end": 66.8333,
   "text": "Subscribe if you'd help Sam build in color, too."
  }
 ],
