 "cues": [
  {
   "id": "1.if",
   "start": 0.0,
   "end": 2.0,
   "text": "What if every door on my street opened somewhere else?"
  },
  {
   "id": "1.asked",
   "start": 2.0,
   "end": 4.0667,
   "text": "Not into the next room. Somewhere else."
  },
  {
   "id": "1.hand",
   "start": 4.0667,
   "end": 6.2667,
   "text": "I found out at my front door, at night."
  },
  {
   "id": "1.wrote",
   "start": 6.2667,
   "end": 7.8667,
   "text": "I wrote the measurements on my palm."
  },
  {
   "id": "1.one",
   "start": 7.8667,
   "end": 10.7,
   "text": "Number four is mine. Number nine has the blue door."
  },
  {
   "id": "2.fridge",
   "start": 10.7,
   "end": 12.5,
   "text": "The first one I used was the fridge."
  },
  {
   "id": "2.break",
   "start": 12.5,
   "end": 15.1,
   "text": "I wanted breakfast. I opened it and walked out into school."
  },
  {
   "id": "2.late",
   "start": 15.1,
   "end": 17.3333,
   "text": "I was twenty minutes early and I had not gone outside."
  },
  {
   "id": "2.neighbour",
   "start": 17.3333,
   "end": 19.9333,
   "text": "My neighbour came out of his own wardrobe, in a dressing gown."
  },
  {
   "id": "2.shout",
   "start": 19.9333,
   "end": 23.0,
   "text": "He shouted at the street. He did not know which door he came out of."
  },
  {
   "id": "2.pool",
   "start": 23.0,
   "end": 25.7333,
   "text": "Then a dare. The blue door at number nine."
  },
  {
   "id": "2.wet",
   "start": 25.7333,
   "end": 28.6667,
   "text": "I came out in the deep end of a swimming pool, still in my shoes."
  },
  {
   "id": "2.dad",
   "start": 28.6667,
   "end": 31.6333,
   "text": "My dad tried the back door, walked into a wall, and tried again."
  },
  {
   "id": "2.pizza",
   "start": 31.6333,
   "end": 34.1,
   "text": "A pizza arrived at number six, twenty minutes late."
  },
  {
   "id": "3.map",
   "start": 34.1,
   "end": 35.7333,
   "text": "After that I stopped walking anywhere."
  },
  {
   "id": "3.cut",
   "start": 35.7333,
   "end": 37.8667,
   "text": "School through the fridge. The shop through the cupboard."
  },
  {
   "id": "3.tally",
   "start": 37.8667,
   "end": 41.3333,
   "text": "I kept a tally on my bedroom wall, one mark for every door I had learned."
  },
  {
   "id": "3.good",
   "start": 41.3333,
   "end": 44.4333,
   "text": "Best month of my life. Never late, never seen."
  },
  {
   "id": "4.mum",
   "start": 44.4333,
   "end": 45.9,
   "text": "My mum said the kitchen door stuck."
  },
  {
   "id": "4.long",
   "start": 45.9,
   "end": 48.9333,
   "text": "She said it had stuck for years, and she did not mind the long way."
  },
  {
   "id": "4.didnt",
   "start": 48.9333,
   "end": 51.2667,
   "text": "I did not think about that. I was busy being clever."
  },
  {
   "id": "5.one",
   "start": 51.2667,
   "end": 52.9667,
   "text": "There was one door I could not get right."
  },
  {
   "id": "5.stuck",
   "start": 52.9667,
   "end": 55.7,
   "text": "Every time I opened it, it opened onto the same hallway."
  },
  {
   "id": "5.same",
   "start": 55.7,
   "end": 58.3,
   "text": "Not a different place. The same hallway every time."
  },
  {
   "id": "5.never",
   "start": 58.3,
   "end": 60.9667,
   "text": "I had never seen it from the inside. That was the worst part."
  },
  {
   "id": "6.only",
   "start": 60.9667,
   "end": 63.4667,
   "text": "I thought I was the only one who could see which door went where."
  },
  {
   "id": "7.one",
   "start": 63.4667,
   "end": 66.3333,
   "text": "Then I saw one woman at the shop, letting everybody go first."
  },
  {
   "id": "7.queue",
   "start": 66.3333,
   "end": 68.1333,
   "text": "She was at the front of the queue at nine at night."
  },
  {
   "id": "7.let",
   "start": 68.1333,
   "end": 70.6667,
   "text": "She let me go first too. She looked at me a bit too long."
  },
  {
   "id": "7.went",
   "start": 70.6667,
   "end": 72.3667,
   "text": "I opened the shop door and stepped out at home."
  },
  {
   "id": "8.wall",
   "start": 72.3667,
   "end": 74.3667,
   "text": "The hallway behind the stuck door had writing on it."
  },
  {
   "id": "8.same",
   "start": 74.3667,
   "end": 76.8667,
   "text": "The same hand as mine. The same pencil."
  },
  {
   "id": "8.higher",
   "start": 76.8667,
   "end": 78.5333,
   "text": "Higher up the wall than I could reach."
  },
  {
   "id": "8.older",
   "start": 78.5333,
   "end": 80.9,
   "text": "It was older. It was exactly the same handwriting."
  },
  {
   "id": "8.copied",
   "start": 80.9,
   "end": 83.9667,
   "text": "My mum's height. Copying my map, so she knew which door I would take."
  },
  {
   "id": "8.wait",
   "start": 83.9667,
   "end": 86.5,
   "text": "And under it, a line I had not written yet."
  },
  {
   "id": "9.back",
   "start": 86.5,
   "end": 88.7667,
   "text": "I went back past the shop at six the next evening."
  },
  {
   "id": "9.still",
   "start": 88.7667,
   "end": 89.8333,
   "text": "The queue was in the same place."
  },
  {
   "id": "9.same",
   "start": 89.8333,
   "end": 92.9667,
   "text": "The same woman, in the same coat, still letting everybody past."
  },
  {
   "id": "9.all",
   "start": 92.9667,
   "end": 96.1333,
   "text": "She had been in it all day. I had used that door four times."
  },
  {
   "id": "10.hand",
   "start": 96.1333,
   "end": 97.8667,
   "text": "I put my hand next to the writing on the wall."
  },
  {
   "id": "10.mine",
   "start": 97.8667,
   "end": 100.5,
   "text": "Every measurement, every number, exactly as I write them."
  },
  {
   "id": "11.count",
   "start": 100.5,
   "end": 102.9667,
   "text": "The tally had outgrown mine. Somebody had been counting."
  },
  {
   "id": "11.room",
   "start": 102.9667,
   "end": 105.5,
   "text": "And the room was mine. My own room, from the outside."
  },
  {
   "id": "12.mum",
   "start": 105.5,
   "end": 107.1333,
   "text": "My mum was in the kitchen when I got home."
  },
  {
   "id": "12.sat",
   "start": 107.1333,
   "end": 109.5333,
   "text": "She was sitting down. She had been walking all day."
  },
  {
   "id": "12.paid",
   "start": 109.5333,
   "end": 112.0,
   "text": "Every door I took, she walked the long way round."
  },
  {
   "id": "12.why",
   "start": 112.0,
   "end": 114.1333,
   "text": "Not to get anywhere. Just to see where I had got to."
  },
  {
   "id": "12.sub",
   "start": 114.1333,
   "end": 116.6333,
   "text": "Subscribe, and I will tell you where she walked to."
  }
 ],
