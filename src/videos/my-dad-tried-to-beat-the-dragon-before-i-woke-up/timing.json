 "cues": [
  {
   "id": "1.never",
   "start": 0.0,
   "end": 3.1667,
   "text": "My dad has never played Minecraft. Not once."
  },
  {
   "id": "1.promise",
   "start": 3.1667,
   "end": 6.0667,
   "text": "Last night he promised he'd beat the dragon before I woke up."
  },
  {
   "id": "1.down",
   "start": 6.0667,
   "end": 8.1,
   "text": "He thinks the way to the End is straight down."
  },
  {
   "id": "2.needs",
   "start": 8.1,
   "end": 10.8,
   "text": "To find the End you need twelve eyes of ender."
  },
  {
   "id": "2.pearls",
   "start": 10.8,
   "end": 13.3,
   "text": "An eye of ender is made from an ender pearl."
  },
  {
   "id": "2.look",
   "start": 13.3,
   "end": 16.1333,
   "text": "And a pearl only drops if you look one in the eye."
  },
  {
   "id": "2.wont",
   "start": 16.1333,
   "end": 18.7667,
   "text": "My dad will not look at one. Not for anything."
  },
  {
   "id": "3.slow",
   "start": 18.7667,
   "end": 21.7,
   "text": "Two years ago I told him he was too slow for this game."
  },
  {
   "id": "3.heard",
   "start": 21.7,
   "end": 24.5,
   "text": "He heard it. He just never said he'd heard it."
  },
  {
   "id": "3.midnight",
   "start": 24.5,
   "end": 27.2333,
   "text": "So he started at midnight, with a wooden sword."
  },
  {
   "id": "4.dug",
   "start": 27.2333,
   "end": 30.2333,
   "text": "And he dug. Straight down, four hundred blocks."
  },
  {
   "id": "4.torch",
   "start": 30.2333,
   "end": 32.8667,
   "text": "A torch every ten, so he wouldn't be scared."
  },
  {
   "id": "4.count",
   "start": 32.8667,
   "end": 35.0,
   "text": "He wrote the count on the wall like a calendar."
  },
  {
   "id": "5.bed",
   "start": 35.0,
   "end": 37.5,
   "text": "I used to ask him to play with me every night."
  },
  {
   "id": "5.tired",
   "start": 37.5,
   "end": 40.0333,
   "text": "He'd say tomorrow. He was always tired."
  },
  {
   "id": "5.now",
   "start": 40.0333,
   "end": 42.6333,
   "text": "Now he's the one waiting on the other side."
  },
  {
   "id": "6.lava",
   "start": 42.6333,
   "end": 45.5667,
   "text": "At four, his torch found lava."
  },
  {
   "id": "6.orange",
   "start": 45.5667,
   "end": 47.5,
   "text": "And the shaft lit orange."
  },
  {
   "id": "6.quiet",
   "start": 47.5,
   "end": 50.8667,
   "text": "Six hours of digging, and then nothing at all."
  },
  {
   "id": "6.sign",
   "start": 50.8667,
   "end": 52.9,
   "text": "He left a sign at the top and went quiet."
  },
  {
   "id": "7.read",
   "start": 52.9,
   "end": 56.1333,
   "text": "I woke up and read it. Sorry. I tried."
  },
  {
   "id": "7.said",
   "start": 56.1333,
   "end": 59.0667,
   "text": "Dad, I said. You don't dig to the End."
  },
  {
   "id": "7.look",
   "start": 59.0667,
   "end": 60.9333,
   "text": "You look at it. Just look at it."
  },
  {
   "id": "8.turned",
   "start": 60.9333,
   "end": 63.7333,
   "text": "He turned round. The enderman was right there."
  },
  {
   "id": "8.pearl",
   "start": 63.7333,
   "end": 66.1667,
   "text": "And when he looked, it dropped a pearl."
  },
  {
   "id": "8.portal",
   "start": 66.1667,
   "end": 68.9667,
   "text": "We threw twelve eyes at breakfast. Together."
  },
  {
   "id": "8.sword",
   "start": 68.9667,
   "end": 71.9,
   "text": "He hit the dragon last, with that wooden sword."
  },
  {
   "id": "8.dig",
   "start": 71.9,
   "end": 74.5667,
   "text": "If your dad would dig four hundred blocks for you."
  },
  {
   "id": "9.sub",
   "start": 74.5667,
   "end": 75.9667,
   "text": "Subscribe."
  }
 ],
