 "clips": [],
 "cues": [
  {
   "id": "1.work",
   "start": 0.0,
   "end": 2.9667,
   "text": "In this town, everybody works. Nobody has ever slept."
  },
  {
   "id": "1.bed",
   "start": 2.9667,
   "end": 4.5333,
   "text": "One bed is locked in the cellar."
  },
  {
   "id": "1.aim",
   "start": 4.5333,
   "end": 5.8,
   "text": "I want to sleep on it."
  },
  {
   "id": "2.me",
   "start": 5.8,
   "end": 7.6,
   "text": "Except me. I stop all the time."
  },
  {
   "id": "2.mum",
   "start": 7.6,
   "end": 10.0,
   "text": "My mum carries lava. My dad grows the mushrooms."
  },
  {
   "id": "2.door",
   "start": 10.0,
   "end": 12.3667,
   "text": "I asked where we came from. She pointed at the floor."
  },
  {
   "id": "2.why",
   "start": 12.3667,
   "end": 13.5333,
   "text": "Nobody would say why."
  },
  {
   "id": "3.rows",
   "start": 13.5333,
   "end": 15.5667,
   "text": "We grow mushrooms in rows under the glowstone."
  },
  {
   "id": "3.lava",
   "start": 15.5667,
   "end": 17.9333,
   "text": "We carry the lava up from the lake in buckets."
  },
  {
   "id": "3.water",
   "start": 17.9333,
   "end": 20.9,
   "text": "We have never seen water. It steamed on the stones and was gone."
  },
  {
   "id": "3.marks",
   "start": 20.9,
   "end": 23.2333,
   "text": "We count the shifts in chalk. Four thousand of them."
  },
  {
   "id": "3.lie",
   "start": 23.2333,
   "end": 25.2333,
   "text": "Nobody here has ever lain down but me."
  },
  {
   "id": "3.want",
   "start": 25.2333,
   "end": 27.1667,
   "text": "All I have ever wanted was one night's sleep."
  },
  {
   "id": "4.tried",
   "start": 27.1667,
   "end": 28.5,
   "text": "So I tried everything."
  },
  {
   "id": "4.square",
   "start": 28.5,
   "end": 31.1667,
   "text": "I lay down in the square. Four hundred people walked over me."
  },
  {
   "id": "4.lick",
   "start": 31.1667,
   "end": 32.4,
   "text": "A strider licked my face."
  },
  {
   "id": "4.wool",
   "start": 32.4,
   "end": 34.5667,
   "text": "I tried to build a bed. There are no sheep."
  },
  {
   "id": "4.fake",
   "start": 34.5667,
   "end": 36.8667,
   "text": "So I made one out of planks and a red blanket."
  },
  {
   "id": "4.safe",
   "start": 36.8667,
   "end": 38.9667,
   "text": "Nothing happened. So I thought beds were safe."
  },
  {
   "id": "5.cellar",
   "start": 38.9667,
   "end": 41.2667,
   "text": "So I took the cellar one. It was half burnt."
  },
  {
   "id": "5.crowd",
   "start": 41.2667,
   "end": 43.4,
   "text": "I carried it out in front of the whole town."
  },
  {
   "id": "5.watch",
   "start": 43.4,
   "end": 45.1,
   "text": "\"Watch,\" I said. \"This is sleeping.\""
  },
  {
   "id": "5.lie",
   "start": 45.1,
   "end": 46.3667,
   "text": "And I lay down on it."
  },
  {
   "id": "5.boom",
   "start": 46.3667,
   "end": 48.3,
   "text": "I did not know yet that beds explode here."
  },
  {
   "id": "5.roof",
   "start": 48.3,
   "end": 50.2,
   "text": "The roof went up, and the shed with it."
  },
  {
   "id": "6.ash",
   "start": 50.2,
   "end": 52.4667,
   "text": "I woke up in the ash with hands on my collar."
  },
  {
   "id": "6.soup",
   "start": 52.4667,
   "end": 54.3,
   "text": "The shed was gone. So was the soup."
  },
  {
   "id": "6.cold",
   "start": 54.3,
   "end": 56.2333,
   "text": "Two hundred people ate cold soup because of me."
  },
  {
   "id": "6.job",
   "start": 56.2333,
   "end": 58.8333,
   "text": "For a month I carried lava under the town, alone."
  },
  {
   "id": "7.frame",
   "start": 58.8333,
   "end": 61.4333,
   "text": "I found a black stone frame, and a hole shaped like a bed."
  },
  {
   "id": "7.list",
   "start": 61.4333,
   "end": 64.3,
   "text": "I said it back: the steam, the marks, the burnt bed, the door."
  },
  {
   "id": "7.wick",
   "start": 64.3,
   "end": 66.7,
   "text": "Old Wick was sitting on the floor. Nobody sits."
  },
  {
   "id": "8.boy",
   "start": 66.7,
   "end": 68.6333,
   "text": "He said this town used to have a morning."
  },
  {
   "id": "8.sky",
   "start": 68.6333,
   "end": 70.8333,
   "text": "A sky that went dark, and a door onto grass."
  },
  {
   "id": "8.out",
   "start": 70.8333,
   "end": 73.3,
   "text": "The door went out the night his father did not come back."
  },
  {
   "id": "8.short",
   "start": 73.3,
   "end": 75.2333,
   "text": "It had not been lit in four thousand shifts."
  },
  {
   "id": "8.reason",
   "start": 75.2333,
   "end": 78.1667,
   "text": "We were not a town that never slept. We had forgotten how."
  },
  {
   "id": "9.flint",
   "start": 78.1667,
   "end": 80.4333,
   "text": "He gave me his flint, kept since he was a boy."
  },
  {
   "id": "9.lit",
   "start": 80.4333,
   "end": 81.9667,
   "text": "I lit it, and I stepped through."
  },
  {
   "id": "9.sky",
   "start": 81.9667,
   "end": 85.0,
   "text": "The sky went dark on its own, without anybody doing anything."
  },
  {
   "id": "9.asleep",
   "start": 85.0,
   "end": 88.3333,
   "text": "There was a village under it, and everybody in it was asleep."
  },
  {
   "id": "9.best",
   "start": 88.3333,
   "end": 91.8333,
   "text": "Nobody was working. It was the most beautiful thing I had ever seen."
  },
  {
   "id": "10.night",
   "start": 91.8333,
   "end": 93.4667,
   "text": "That night I lay down in the street."
  },
  {
   "id": "10.wick",
   "start": 93.4667,
   "end": 94.9,
   "text": "Old Wick lay down next to me."
  },
  {
   "id": "10.mum",
   "start": 94.9,
   "end": 97.5333,
   "text": "My mum lay down too. She was still holding the bucket."
  },
  {
   "id": "10.bex",
   "start": 97.5333,
   "end": 99.3333,
   "text": "Then the baker. Then four hundred people."
  },
  {
   "id": "10.stopped",
   "start": 99.3333,
   "end": 102.2667,
   "text": "Not one of us was asleep. Every one of us had stopped."
  },
  {
   "id": "11.sub",
   "start": 102.2667,
   "end": 105.2333,
   "text": "Like and subscribe. I am not getting up for the bell."
  }
 ],
