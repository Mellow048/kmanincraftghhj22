 "cues": [
  {
   "id": "1.bitten",
   "start": 0.0,
   "end": 1.9,
   "text": "In this town, my brother got bitten."
  },
  {
   "id": "1.gone",
   "start": 1.9,
   "end": 3.1667,
   "text": "Everybody said he was gone."
  },
  {
   "id": "1.cellar",
   "start": 3.1667,
   "end": 4.0,
   "text": "He was in our cellar."
  },
  {
   "id": "1.knock",
   "start": 4.0,
   "end": 5.2,
   "text": "And he still knocked twice."
  },
  {
   "id": "2.rule",
   "start": 5.2,
   "end": 6.1667,
   "text": "We had one rule."
  },
  {
   "id": "2.gate",
   "start": 6.1667,
   "end": 8.5,
   "text": "If you got bitten, you went out of the gate before sunrise."
  },
  {
   "id": "2.watch",
   "start": 8.5,
   "end": 10.7667,
   "text": "Nobody watched. Nobody talked about it after."
  },
  {
   "id": "2.priest",
   "start": 10.7667,
   "end": 13.1333,
   "text": "The priest sold bread to some families at half price."
  },
  {
   "id": "2.why",
   "start": 13.1333,
   "end": 14.0,
   "text": "He never said why."
  },
  {
   "id": "2.hat",
   "start": 14.0,
   "end": 15.7333,
   "text": "The old lady next door never took off her hat."
  },
  {
   "id": "2.bed",
   "start": 15.7333,
   "end": 16.5,
   "text": "Not even in bed."
  },
  {
   "id": "2.bars",
   "start": 16.5,
   "end": 18.6,
   "text": "And under our house was a room with iron bars and a bed."
  },
  {
   "id": "2.bad",
   "start": 18.6,
   "end": 20.0,
   "text": "I thought it was for bad kids."
  },
  {
   "id": "3.late",
   "start": 20.0,
   "end": 22.3667,
   "text": "One evening, I stayed out too long."
  },
  {
   "id": "3.wheat",
   "start": 22.3667,
   "end": 23.9,
   "text": "Something came out of the wheat."
  },
  {
   "id": "3.pull",
   "start": 23.9,
   "end": 25.5333,
   "text": "My brother pulled me in through the door."
  },
  {
   "id": "3.arm",
   "start": 25.5333,
   "end": 26.5667,
   "text": "It got his arm."
  },
  {
   "id": "3.fine",
   "start": 26.5667,
   "end": 28.0,
   "text": "He said, \"I'm fine.\""
  },
  {
   "id": "3.notfine",
   "start": 28.0,
   "end": 28.8667,
   "text": "He was not fine."
  },
  {
   "id": "3.green",
   "start": 28.8667,
   "end": 30.4333,
   "text": "By midnight, he was green."
  },
  {
   "id": "3.dad",
   "start": 30.4333,
   "end": 32.2667,
   "text": "Dad picked him up and carried him out."
  },
  {
   "id": "3.look",
   "start": 32.2667,
   "end": 33.4333,
   "text": "He did not look at me."
  },
  {
   "id": "3.thought",
   "start": 33.4333,
   "end": 36.3,
   "text": "I thought, that is it. I do not have a brother anymore."
  },
  {
   "id": "4.bed",
   "start": 36.3,
   "end": 38.2333,
   "text": "I lay in bed and looked at his empty one."
  },
  {
   "id": "4.heard",
   "start": 38.2333,
   "end": 40.0333,
   "text": "Then I heard it. Under the floor."
  },
  {
   "id": "4.two",
   "start": 40.0333,
   "end": 41.2667,
   "text": "Knock. Knock."
  },
  {
   "id": "4.his",
   "start": 41.2667,
   "end": 43.8,
   "text": "That was his knock. He did it on my wall every night."
  },
  {
   "id": "4.lantern",
   "start": 43.8,
   "end": 45.4,
   "text": "So I took the lantern and went down."
  },
  {
   "id": "4.bars",
   "start": 45.4,
   "end": 46.7,
   "text": "He was behind the bars."
  },
  {
   "id": "4.groan",
   "start": 46.7,
   "end": 48.3,
   "text": "He looked at me, and he groaned."
  },
  {
   "id": "4.sword",
   "start": 48.3,
   "end": 50.9333,
   "text": "Then he held out my wooden sword. Handle first."
  },
  {
   "id": "4.taught",
   "start": 50.9333,
   "end": 52.3,
   "text": "He was the one who taught me that."
  },
  {
   "id": "5.fix",
   "start": 52.3,
   "end": 54.0667,
   "text": "So I decided to fix him myself."
  },
  {
   "id": "5.bread",
   "start": 54.0667,
   "end": 56.1667,
   "text": "I brought him bread. He did not want bread."
  },
  {
   "id": "5.pink",
   "start": 56.1667,
   "end": 58.3,
   "text": "I brought the pink potion we kept for when we were sick."
  },
  {
   "id": "5.worse",
   "start": 58.3,
   "end": 59.3667,
   "text": "It made him worse."
  },
  {
   "id": "5.thought",
   "start": 59.3667,
   "end": 60.8,
   "text": "I thought medicine was medicine."
  },
  {
   "id": "5.grey",
   "start": 60.8,
   "end": 63.1667,
   "text": "And in the little window, the sky was going grey."
  },
  {
   "id": "6.sat",
   "start": 63.1667,
   "end": 64.7667,
   "text": "I sat on the stairs and looked at the room."
  },
  {
   "id": "6.bars",
   "start": 64.7667,
   "end": 65.6333,
   "text": "Iron bars."
  },
  {
   "id": "6.bed",
   "start": 65.6333,
   "end": 66.3,
   "text": "A bed."
  },
  {
   "id": "6.apple",
   "start": 66.3,
   "end": 68.7667,
   "text": "A golden apple in the priest's window that was never for sale."
  },
  {
   "id": "6.half",
   "start": 68.7667,
   "end": 70.5,
   "text": "Half price, for some families."
  },
  {
   "id": "6.not",
   "start": 70.5,
   "end": 72.0,
   "text": "This was not a room for bad kids."
  },
  {
   "id": "6.built",
   "start": 72.0,
   "end": 73.7333,
   "text": "Somebody had built a room for this."
  },
  {
   "id": "7.door",
   "start": 73.7333,
   "end": 75.7333,
   "text": "Then the door opened. It was dad."
  },
  {
   "id": "7.night",
   "start": 75.7333,
   "end": 77.3,
   "text": "He had been walking all night."
  },
  {
   "id": "7.had",
   "start": 77.3,
   "end": 80.4333,
   "text": "He had the golden apple, and a bottle from the witch in the swamp."
  },
  {
   "id": "7.said",
   "start": 80.4333,
   "end": 83.4333,
   "text": "He said, \"Hold the lantern. Keep the sun off him.\""
  },
  {
   "id": "7.threw",
   "start": 83.4333,
   "end": 84.5,
   "text": "He threw the bottle."
  },
  {
   "id": "7.ate",
   "start": 84.5,
   "end": 86.6,
   "text": "He held out the apple, and my brother ate it."
  },
  {
   "id": "7.shake",
   "start": 86.6,
   "end": 88.0,
   "text": "Then my brother started to shake."
  },
  {
   "id": "7.long",
   "start": 88.0,
   "end": 89.3333,
   "text": "It went on for a long time."
  },
  {
   "id": "7.sun",
   "start": 89.3333,
   "end": 92.0,
   "text": "The sun came down the stairs. One step. Then another."
  },
  {
   "id": "7.stood",
   "start": 92.0,
   "end": 93.0333,
   "text": "So I stood in the light."
  },
  {
   "id": "7.shadow",
   "start": 93.0333,
   "end": 94.5333,
   "text": "My shadow was just big enough."
  },
  {
   "id": "8.how",
   "start": 94.5333,
   "end": 97.0333,
   "text": "I said, \"Dad, how did you know what to do?\""
  },
  {
   "id": "8.sleeve",
   "start": 97.0333,
   "end": 98.1333,
   "text": "He rolled up his sleeve."
  },
  {
   "id": "8.bite",
   "start": 98.1333,
   "end": 99.6,
   "text": "There was an old bite on his arm."
  },
  {
   "id": "8.lady",
   "start": 99.6,
   "end": 101.8333,
   "text": "The old lady next door had one too. Under the hat."
  },
  {
   "id": "8.priest",
   "start": 101.8333,
   "end": 104.7,
   "text": "The priest had one. The families who sat with him still got half price."
  },
  {
   "id": "8.town",
   "start": 104.7,
   "end": 106.4667,
   "text": "Half the town had knocked on that floor."
  },
  {
   "id": "8.rule",
   "start": 106.4667,
   "end": 108.5,
   "text": "The rule about the gate was just what they told the kids,"
  },
  {
   "id": "8.home",
   "start": 108.5,
   "end": 110.1667,
   "text": "so we would come home before dark."
  },
  {
   "id": "9.stop",
   "start": 110.1667,
   "end": 111.6,
   "text": "Then the shaking stopped."
  },
  {
   "id": "9.eyes",
   "start": 111.6,
   "end": 112.9,
   "text": "My brother opened his eyes."
  },
  {
   "id": "9.hands",
   "start": 112.9,
   "end": 114.9667,
   "text": "He looked at his hands. He looked at me."
  },
  {
   "id": "9.said",
   "start": 114.9667,
   "end": 116.5333,
   "text": "He said, \"Is there any bread?\""
  },
  {
   "id": "9.wall",
   "start": 116.5333,
   "end": 119.0,
   "text": "That night, he knocked on my wall. Twice."
  },
  {
   "id": "9.back",
   "start": 119.0,
   "end": 119.9333,
   "text": "I knocked back."
  },
  {
   "id": "9.floor",
   "start": 119.9333,
   "end": 121.9333,
   "text": "Then something under the floor knocked too."
  },
  {
   "id": "9.sub",
   "start": 121.9333,
   "end": 123.8333,
   "text": "Like and subscribe to find out who."
  }
 ],
