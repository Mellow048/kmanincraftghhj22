 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 2.2,
   "text": "This player built the same oak house thirty times."
  },
  {
   "id": "1.label",
   "start": 2.2,
   "end": 3.7667,
   "text": "So the whole server called him a griefer."
  },
  {
   "id": "1.loop",
   "start": 3.7667,
   "end": 6.2,
   "text": "When the owner learned why, everyone built a compass."
  },
  {
   "id": "2.rich",
   "start": 6.2,
   "end": 8.4667,
   "text": "Our server had giant castles and stone mansions."
  },
  {
   "id": "2.tiny",
   "start": 8.4667,
   "end": 10.6667,
   "text": "Next to them sat thirty tiny oak huts."
  },
  {
   "id": "2.same",
   "start": 10.6667,
   "end": 13.6,
   "text": "Every single hut looked the exact same."
  },
  {
   "id": "2.flower",
   "start": 13.6,
   "end": 15.9,
   "text": "With one yellow flower outside the door."
  },
  {
   "id": "2.chat",
   "start": 15.9,
   "end": 18.3333,
   "text": "Players laughed in chat at his ugly boxes."
  },
  {
   "id": "2.rex",
   "start": 18.3333,
   "end": 21.4333,
   "text": "Rex typed, \"Break them or get banned.\""
  },
  {
   "id": "3.not",
   "start": 21.4333,
   "end": 23.0,
   "text": "But Sam was not a griefer."
  },
  {
   "id": "3.gpa",
   "start": 23.0,
   "end": 24.9,
   "text": "He played every night with his old grandpa."
  },
  {
   "id": "3.age",
   "start": 24.9,
   "end": 26.6667,
   "text": "Grandpa was seventy five years old."
  },
  {
   "id": "3.irl",
   "start": 26.6667,
   "end": 29.1,
   "text": "In real life, Grandpa's memory was slowly fading."
  },
  {
   "id": "3.lost",
   "start": 29.1,
   "end": 31.3,
   "text": "In Minecraft, he kept getting lost in the woods."
  },
  {
   "id": "3.bend",
   "start": 31.3,
   "end": 33.5667,
   "text": "So Sam built their little house around every bend."
  },
  {
   "id": "3.safe",
   "start": 33.5667,
   "end": 35.8,
   "text": "One yellow flower meant Grandpa was safe."
  },
  {
   "id": "4.night",
   "start": 35.8,
   "end": 38.2,
   "text": "Then one night, Rex got sick of those huts."
  },
  {
   "id": "4.lava",
   "start": 38.2,
   "end": 40.2,
   "text": "He poured lava and burned all thirty down."
  },
  {
   "id": "4.laugh",
   "start": 40.2,
   "end": 42.8667,
   "text": "\"Cleaned up the mess,\" Rex typed, and laughed."
  },
  {
   "id": "4.dark",
   "start": 42.8667,
   "end": 45.5333,
   "text": "That night, Grandpa walked alone in the dark woods."
  },
  {
   "id": "4.look",
   "start": 45.5333,
   "end": 47.8333,
   "text": "He searched every hill for one yellow flower."
  },
  {
   "id": "4.msg",
   "start": 47.8333,
   "end": 50.9333,
   "text": "He stopped and typed, \"Sam, I cannot find home.\""
  },
  {
   "id": "4.quit",
   "start": 50.9333,
   "end": 53.9667,
   "text": "Then Grandpa logged off and never came back."
  },
  {
   "id": "5.quiet",
   "start": 53.9667,
   "end": 55.8333,
   "text": "The whole server chat went dead silent."
  },
  {
   "id": "5.owner",
   "start": 55.8333,
   "end": 57.3,
   "text": "The owner messaged Sam."
  },
  {
   "id": "5.told",
   "start": 57.3,
   "end": 59.0667,
   "text": "And Sam told him the whole story."
  },
  {
   "id": "5.idea",
   "start": 59.0667,
   "end": 61.1333,
   "text": "The owner knew one Minecraft block could help."
  },
  {
   "id": "6.rally",
   "start": 61.1333,
   "end": 63.4,
   "text": "Next morning, every player logged on at once."
  },
  {
   "id": "6.build",
   "start": 63.4,
   "end": 65.4,
   "text": "They rebuilt Grandpa's oak house right at spawn."
  },
  {
   "id": "6.path",
   "start": 65.4,
   "end": 67.8667,
   "text": "They lined every road with bright yellow flowers."
  },
  {
   "id": "6.lode",
   "start": 67.8667,
   "end": 70.2667,
   "text": "Under the porch, the owner placed a lodestone."
  },
  {
   "id": "6.fact",
   "start": 70.2667,
   "end": 73.1,
   "text": "In Minecraft, a lodestone compass points straight to it."
  },
  {
   "id": "6.chest",
   "start": 73.1,
   "end": 75.4333,
   "text": "Everyone dropped a compass named Home inside his chest."
  },
  {
   "id": "7.join",
   "start": 75.4333,
   "end": 77.1,
   "text": "That night, Grandpa logged back in."
  },
  {
   "id": "7.open",
   "start": 77.1,
   "end": 79.0667,
   "text": "He opened the chest and grabbed the compass."
  },
  {
   "id": "7.walk",
   "start": 79.0667,
   "end": 81.1667,
   "text": "He followed the needle down the yellow flowers."
  },
  {
   "id": "7.porch",
   "start": 81.1667,
   "end": 83.7,
   "text": "Right on the porch stood Sam, waving hard."
  },
  {
   "id": "7.found",
   "start": 83.7,
   "end": 85.7667,
   "text": "Grandpa smiled and typed, \"Found it.\""
  },
  {
   "id": "7.sub",
   "start": 85.7667,
   "end": 88.4,
   "text": "Subscribe if you would build Grandpa a compass too."
  }
 ],
