 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.8333,
   "text": "Rules, explained using Minecraft."
  },
  {
   "id": "1.board",
   "start": 1.8333,
   "end": 3.8,
   "text": "One board stands at spawn with one rule."
  },
  {
   "id": "1.server",
   "start": 3.8,
   "end": 5.9333,
   "text": "A brand-new server opens with a hundred players."
  },
  {
   "id": "1.griefer",
   "start": 5.9333,
   "end": 8.0333,
   "text": "One player joins named Griefer with one goal."
  },
  {
   "id": "1.break",
   "start": 8.0333,
   "end": 9.6333,
   "text": "He wants to break everything in sight."
  },
  {
   "id": "2.chest",
   "start": 9.6333,
   "end": 11.9,
   "text": "Night one: Griefer smashes the shared spawn chest."
  },
  {
   "id": "2.lose",
   "start": 11.9,
   "end": 13.9667,
   "text": "Ninety-nine players log on and lose their gear."
  },
  {
   "id": "2.same",
   "start": 13.9667,
   "end": 17.2333,
   "text": "Same server. Same chest. So what happened?"
  },
  {
   "id": "3.watch",
   "start": 17.2333,
   "end": 19.3,
   "text": "Mods cannot watch a hundred players all day."
  },
  {
   "id": "3.r1",
   "start": 19.3,
   "end": 21.2,
   "text": "So they nail up Rule One: no stealing."
  },
  {
   "id": "3.again",
   "start": 21.2,
   "end": 23.8,
   "text": "Five minutes later, Griefer smashes another chest anyway!"
  },
  {
   "id": "3.r2",
   "start": 23.8,
   "end": 25.8667,
   "text": "So mods nail up Rule Two: lock chests."
  },
  {
   "id": "3.r3",
   "start": 25.8667,
   "end": 27.9333,
   "text": "Griefer pours lava—so up goes Rule Three!"
  },
  {
   "id": "3.r100",
   "start": 27.9333,
   "end": 30.1333,
   "text": "Rule ten, rule fifty—one hundred rules total!"
  },
  {
   "id": "3.locks",
   "start": 30.1333,
   "end": 32.3333,
   "text": "Ninety-nine iron locks snap shut across every chest."
  },
  {
   "id": "4.mean",
   "start": 32.3333,
   "end": 33.9667,
   "text": "The mods are not trying to be mean."
  },
  {
   "id": "4.about",
   "start": 33.9667,
   "end": 36.3,
   "text": "Those hundred rules were never about ninety-nine players."
  },
  {
   "id": "4.one",
   "start": 36.3,
   "end": 38.4333,
   "text": "One person broke trust for ninety-nine others."
  },
  {
   "id": "4.why",
   "start": 38.4333,
   "end": 40.5,
   "text": "That is why every server ends up with rules."
  },
  {
   "id": "4.write",
   "start": 40.5,
   "end": 42.5667,
   "text": "One person ruins it, so mods write it down."
  },
  {
   "id": "5.keep",
   "start": 42.5667,
   "end": 44.4,
   "text": "So who wins, and who loses here?"
  },
  {
   "id": "5.ninety",
   "start": 44.4,
   "end": 46.3667,
   "text": "The ninety-nine players keep all their gear safe."
  },
  {
   "id": "5.ban",
   "start": 46.3667,
   "end": 48.5333,
   "text": "Griefer gets hit with a Ban Hammer immediately."
  },
  {
   "id": "5.mods",
   "start": 48.5333,
   "end": 50.9,
   "text": "Mods spend all night typing commands instead of playing."
  },
  {
   "id": "5.scale",
   "start": 50.9,
   "end": 53.0,
   "text": "One Griefer versus ninety-nine chests on the scale."
  },
  {
   "id": "6.real",
   "start": 53.0,
   "end": 55.0667,
   "text": "In real life, the server mods are teachers."
  },
  {
   "id": "6.class",
   "start": 55.0667,
   "end": 57.3,
   "text": "Ninety-nine percent of class just wants a normal day."
  },
  {
   "id": "6.kid",
   "start": 57.3,
   "end": 59.6333,
   "text": "One kid throws paper airplanes across the chalkboard."
  },
  {
   "id": "6.rule",
   "start": 59.6333,
   "end": 61.6667,
   "text": "So the teacher writes another rule on the board."
  },
  {
   "id": "6.same2",
   "start": 61.6667,
   "end": 64.4,
   "text": "Same chain reaction. Same exact rule board."
  },
  {
   "id": "7.fault",
   "start": 64.4,
   "end": 65.9,
   "text": "So whose fault is it really?"
  },
  {
   "id": "7.grief",
   "start": 65.9,
   "end": 67.3667,
   "text": "Griefer's for smashing the spawn chest first,"
  },
  {
   "id": "7.mod",
   "start": 67.3667,
   "end": 69.1333,
   "text": "or the mods' for writing a hundred rules?"
  },
  {
   "id": "7.when",
   "start": 69.1333,
   "end": 70.7333,
   "text": "Because when one player ruins it for ninety-nine,"
  },
  {
   "id": "7.loop",
   "start": 70.7333,
   "end": 72.8333,
   "text": "the board grows one rule at a time, and that's..."
  }
 ],
