 "cues": [
  {
   "id": "1.door",
   "start": 0.0,
   "end": 2.0667,
   "text": "In this town, nobody is allowed to go first."
  },
  {
   "id": "1.line",
   "start": 2.0667,
   "end": 4.3333,
   "text": "At every doorway, the whole town waits behind me."
  },
  {
   "id": "1.who",
   "start": 4.3333,
   "end": 6.1,
   "text": "Nobody knew who made that strange rule."
  },
  {
   "id": "1.what",
   "start": 6.1,
   "end": 8.0667,
   "text": "Nobody knew what happened to the first person."
  },
  {
   "id": "1.old",
   "start": 8.0667,
   "end": 9.8,
   "text": "Not even the oldest man in our village."
  },
  {
   "id": "2.house",
   "start": 9.8,
   "end": 11.7667,
   "text": "Nobody ever stepped inside a house first."
  },
  {
   "id": "2.table",
   "start": 11.7667,
   "end": 13.8333,
   "text": "Nobody ever sat down at a table first."
  },
  {
   "id": "2.bridge",
   "start": 13.8333,
   "end": 16.0333,
   "text": "Nobody ever crossed our wooden river bridge first."
  },
  {
   "id": "2.last",
   "start": 16.0333,
   "end": 18.0667,
   "text": "And the oldest man always went dead last."
  },
  {
   "id": "2.itch",
   "start": 18.0667,
   "end": 20.1333,
   "text": "It was a peaceful town, except one thing."
  },
  {
   "id": "2.cave",
   "start": 20.1333,
   "end": 22.2,
   "text": "What was hiding inside the stone cave nearby?"
  },
  {
   "id": "2.warn",
   "start": 22.2,
   "end": 24.3,
   "text": "The oldest man whispered, never go first."
  },
  {
   "id": "2.walk",
   "start": 24.3,
   "end": 26.3333,
   "text": "He gave zero reason and walked away quietly."
  },
  {
   "id": "2.decide",
   "start": 26.3333,
   "end": 29.0,
   "text": "Why was everyone terrified? I had to find out."
  },
  {
   "id": "3.try",
   "start": 29.0,
   "end": 31.1,
   "text": "I tried sprinting into the market stall first."
  },
  {
   "id": "3.shove",
   "start": 31.1,
   "end": 33.2333,
   "text": "Five neighbors shoved past me just to go second!"
  },
  {
   "id": "3.last",
   "start": 33.2333,
   "end": 35.3,
   "text": "I tumbled backward and ended up dead last."
  },
  {
   "id": "3.laugh",
   "start": 35.3,
   "end": 36.9667,
   "text": "Half the square burst out laughing at me."
  },
  {
   "id": "4.friend",
   "start": 36.9667,
   "end": 38.9667,
   "text": "Only my best friend Sam never laughed once."
  },
  {
   "id": "4.behind",
   "start": 38.9667,
   "end": 41.2,
   "text": "Sam always stood one step behind me everywhere."
  },
  {
   "id": "4.sit",
   "start": 41.2,
   "end": 43.3,
   "text": "At lunch, he always waited to sit second."
  },
  {
   "id": "4.cross",
   "start": 43.3,
   "end": 45.4667,
   "text": "At the river, he always crossed the bridge second."
  },
  {
   "id": "4.race",
   "start": 45.4667,
   "end": 47.6667,
   "text": "Even in races, Sam slowed to finish second."
  },
  {
   "id": "4.shy",
   "start": 47.6667,
   "end": 49.5333,
   "text": "I always thought Sam was just really shy."
  },
  {
   "id": "5.dusk",
   "start": 49.5333,
   "end": 51.6,
   "text": "That evening, I lit a torch and faced the cave."
  },
  {
   "id": "5.step",
   "start": 51.6,
   "end": 54.5333,
   "text": "Nobody stood ahead of me. I stepped inside first."
  },
  {
   "id": "5.dark",
   "start": 54.5333,
   "end": 56.6333,
   "text": "Cold stone echoed as my orange torch flickered."
  },
  {
   "id": "5.deep",
   "start": 56.6333,
   "end": 58.8333,
   "text": "Deep inside, my boot bumped against white bones."
  },
  {
   "id": "5.skel",
   "start": 58.8333,
   "end": 61.1333,
   "text": "A dusty skeleton sat beside a rusted pickaxe."
  },
  {
   "id": "5.carve",
   "start": 61.1333,
   "end": 62.9333,
   "text": "Carved on the wall: Don't go first."
  },
  {
   "id": "5.banner",
   "start": 62.9333,
   "end": 65.0667,
   "text": "Pinned to his chest was our founder's gold crest."
  },
  {
   "id": "5.truth",
   "start": 65.0667,
   "end": 67.1667,
   "text": "Our founder walked in first a hundred years ago."
  },
  {
   "id": "5.never",
   "start": 67.1667,
   "end": 69.9667,
   "text": "Rocks collapsed behind him. He never came back."
  },
  {
   "id": "5.fear",
   "start": 69.9667,
   "end": 72.3333,
   "text": "It was never a law—just a century of fear."
  },
  {
   "id": "6.run",
   "start": 72.3333,
   "end": 74.5667,
   "text": "I sprinted back holding the founder's gold crest."
  },
  {
   "id": "6.sam",
   "start": 74.5667,
   "end": 76.5333,
   "text": "Sam stood waiting right at the forest edge."
  },
  {
   "id": "6.list",
   "start": 76.5333,
   "end": 80.4,
   "text": "The standing behind. The sitting second. The crossing second."
  },
  {
   "id": "6.scared",
   "start": 80.4,
   "end": 82.7667,
   "text": "Sam wasn't shy—he was scared too, protecting me."
  },
  {
   "id": "6.tell",
   "start": 82.7667,
   "end": 84.7667,
   "text": "I showed the oldest man and told everyone."
  },
  {
   "id": "6.bridge2",
   "start": 84.7667,
   "end": 86.8333,
   "text": "Next morning, the whole town walked to the bridge."
  },
  {
   "id": "6.first",
   "start": 86.8333,
   "end": 90.6667,
   "text": "Nobody shoved. Nobody hid. I stepped across first."
  },
  {
   "id": "6.sam2",
   "start": 90.6667,
   "end": 93.1,
   "text": "Sam stepped beside me—not second, side by side."
  },
  {
   "id": "6.crowd",
   "start": 93.1,
   "end": 95.2,
   "text": "One by one, the whole village followed laughing."
  },
  {
   "id": "6.old2",
   "start": 95.2,
   "end": 97.2667,
   "text": "Even the oldest man smiled near the front."
  },
  {
   "id": "6.free",
   "start": 97.2667,
   "end": 99.3333,
   "text": "A hundred years of fear ended with one step."
  },
  {
   "id": "6.sub",
   "start": 99.3333,
   "end": 101.3667,
   "text": "Subscribe to go first—because in this town..."
  }
 ],
