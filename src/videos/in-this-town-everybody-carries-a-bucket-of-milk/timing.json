 "clips": [],
 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.4667,
   "text": "In this town, everybody carries a bucket of milk."
  },
  {
   "id": "1.noon",
   "start": 2.4667,
   "end": 4.5667,
   "text": "Every day at noon, the Witch flies overhead."
  },
  {
   "id": "1.splash",
   "start": 4.5667,
   "end": 6.6,
   "text": "She drops poison, slowness, and floating potions."
  },
  {
   "id": "1.sip",
   "start": 6.6,
   "end": 8.5,
   "text": "One sip of milk clears every potion fast."
  },
  {
   "id": "1.none",
   "start": 8.5,
   "end": 10.3667,
   "text": "Without milk, you float straight into the clouds."
  },
  {
   "id": "2.mayor",
   "start": 10.3667,
   "end": 12.1,
   "text": "The mayor drinks milk mid-sentence during speeches."
  },
  {
   "id": "2.post",
   "start": 12.1,
   "end": 13.8667,
   "text": "The postman straps four buckets to his coat."
  },
  {
   "id": "2.kids",
   "start": 13.8667,
   "end": 15.9333,
   "text": "Every kid keeps a milk bucket on their desk."
  },
  {
   "id": "2.baker",
   "start": 15.9333,
   "end": 17.9667,
   "text": "Our last baker tried drinking plain water instead."
  },
  {
   "id": "2.sixth",
   "start": 17.9667,
   "end": 19.8333,
   "text": "It didn't work. We're on our sixth baker."
  },
  {
   "id": "3.me",
   "start": 19.8333,
   "end": 21.6667,
   "text": "I'm Toby, and I don't own a bucket."
  },
  {
   "id": "3.moo",
   "start": 21.6667,
   "end": 23.6667,
   "text": "I just walk everywhere with my cow, Moo."
  },
  {
   "id": "3.laugh",
   "start": 23.6667,
   "end": 25.4333,
   "text": "Kids yell moo every time I walk past."
  },
  {
   "id": "3.baron",
   "start": 25.4333,
   "end": 27.3333,
   "text": "Even Baron Cream laughs outside his milk shop."
  },
  {
   "id": "3.quote",
   "start": 27.3333,
   "end": 29.1,
   "text": "A cow takes ten seconds to milk, kid."
  },
  {
   "id": "3.float1",
   "start": 29.1,
   "end": 30.8667,
   "text": "You'll float away before you fill a cup."
  },
  {
   "id": "4.shop",
   "start": 30.8667,
   "end": 32.7667,
   "text": "Baron Cream owns every milk stall in town."
  },
  {
   "id": "4.ten",
   "start": 32.7667,
   "end": 34.8,
   "text": "Ten emeralds a bucket on a normal day."
  },
  {
   "id": "4.hundred",
   "start": 34.8,
   "end": 36.6333,
   "text": "When the Witch shows up, one hundred emeralds."
  },
  {
   "id": "4.throne",
   "start": 36.6333,
   "end": 38.6667,
   "text": "He sits on nine thousand emeralds counting coins."
  },
  {
   "id": "4.forty8",
   "start": 38.6667,
   "end": 40.4333,
   "text": "Forty eight people couldn't pay and floated away."
  },
  {
   "id": "4.dad",
   "start": 40.4333,
   "end": 42.6,
   "text": "One was my dad, right after gifting Moo's collar."
  },
  {
   "id": "5.storm",
   "start": 42.6,
   "end": 44.3333,
   "text": "Then today at noon, the sky turned purple."
  },
  {
   "id": "5.witch",
   "start": 44.3333,
   "end": 46.2333,
   "text": "The Witch returned with a basket of potions."
  },
  {
   "id": "5.lock",
   "start": 46.2333,
   "end": 48.0667,
   "text": "Baron Cream slammed his door and charged two hundred."
  },
  {
   "id": "5.hit",
   "start": 48.0667,
   "end": 49.9667,
   "text": "A purple potion smashed beside my neighbor's boots."
  },
  {
   "id": "5.rise",
   "start": 49.9667,
   "end": 52.2,
   "text": "She floated up. Five blocks. Ten blocks. Fifteen."
  },
  {
   "id": "5.empty",
   "start": 52.2,
   "end": 54.5667,
   "text": "Everyone's buckets were empty, and nobody could pay."
  },
  {
   "id": "6.rule",
   "start": 54.5667,
   "end": 56.7,
   "text": "Then I remembered one Minecraft rule they forgot."
  },
  {
   "id": "6.once",
   "start": 56.7,
   "end": 58.5,
   "text": "A milk bucket only works one single time."
  },
  {
   "id": "6.infinite",
   "start": 58.5,
   "end": 60.2667,
   "text": "A cow gives infinite milk, forever."
  },
  {
   "id": "6.grab",
   "start": 60.2667,
   "end": 62.1333,
   "text": "I yelled, throw me your empty buckets now!"
  },
  {
   "id": "6.milk",
   "start": 62.1333,
   "end": 64.0333,
   "text": "I milked Moo fast, ten buckets in a row."
  },
  {
   "id": "6.chain",
   "start": 64.0333,
   "end": 65.7,
   "text": "The whole street tossed full buckets straight up."
  },
  {
   "id": "6.catch",
   "start": 65.7,
   "end": 67.6333,
   "text": "My neighbor caught one at twenty blocks and landed!"
  },
  {
   "id": "7.karma",
   "start": 67.6333,
   "end": 69.6667,
   "text": "Baron Cream marched out yelling, cow milk doesn't count!"
  },
  {
   "id": "7.splash2",
   "start": 69.6667,
   "end": 71.4333,
   "text": "Then a stray potion hit his shiny boots."
  },
  {
   "id": "7.refuse",
   "start": 71.4333,
   "end": 73.2,
   "text": "He refused to touch Moo and floated away."
  },
  {
   "id": "7.rescue",
   "start": 73.2,
   "end": 75.2667,
   "text": "We cast forty eight buckets up on fishing lines."
  },
  {
   "id": "7.return",
   "start": 75.2667,
   "end": 77.1,
   "text": "All forty eight people drank and floated back down."
  },
  {
   "id": "7.dadback",
   "start": 77.1,
   "end": 78.8667,
   "text": "The very last person down was my dad."
  },
  {
   "id": "7.hug",
   "start": 78.8667,
   "end": 80.4,
   "text": "Dad hugged me and Moo in the square."
  },
  {
   "id": "7.closed",
   "start": 80.4,
   "end": 81.9,
   "text": "Baron Cream's shop shut down for good."
  },
  {
   "id": "7.cows",
   "start": 81.9,
   "end": 83.9,
   "text": "Now nobody pays a hundred emeralds for milk."
  },
  {
   "id": "7.cta",
   "start": 83.9,
   "end": 86.2,
   "text": "Subscribe if you'd keep Moo by your side, too!"
  }
 ],
