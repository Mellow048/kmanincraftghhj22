 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.6667,
   "text": "Monopolies, explained using Minecraft."
  },
  {
   "id": "1.three",
   "start": 1.6667,
   "end": 3.1,
   "text": "Three bakers sell bread in the square."
  },
  {
   "id": "1.two",
   "start": 3.1,
   "end": 4.7,
   "text": "Every loaf costs just two emeralds."
  },
  {
   "id": "1.save",
   "start": 4.7,
   "end": 6.2333,
   "text": "Miles buys bread here every single day."
  },
  {
   "id": "1.best",
   "start": 6.2333,
   "end": 7.8,
   "text": "If one raises prices, Miles walks next door."
  },
  {
   "id": "2.rich",
   "start": 7.8,
   "end": 9.3667,
   "text": "Then Sterling shows up with a full chest."
  },
  {
   "id": "2.buy1",
   "start": 9.3667,
   "end": 11.0667,
   "text": "He buys the first bakery and shuts it."
  },
  {
   "id": "2.buy2",
   "start": 11.0667,
   "end": 12.8,
   "text": "He buys the second stall and knocks it down."
  },
  {
   "id": "2.one",
   "start": 12.8,
   "end": 14.5333,
   "text": "By morning, only Sterling's shop is left."
  },
  {
   "id": "3.walk",
   "start": 14.5333,
   "end": 15.9667,
   "text": "Miles walks up hungry for a loaf."
  },
  {
   "id": "3.flip",
   "start": 15.9667,
   "end": 17.5667,
   "text": "The price sign flips from two to fifteen."
  },
  {
   "id": "3.same",
   "start": 17.5667,
   "end": 19.4333,
   "text": "Same bread. Same square. Fifteen emeralds."
  },
  {
   "id": "3.what",
   "start": 19.4333,
   "end": 20.2,
   "text": "So what happened?"
  },
  {
   "id": "3.choice",
   "start": 20.2,
   "end": 22.3667,
   "text": "Yesterday Miles had three choices. Today he has one."
  },
  {
   "id": "4.pay",
   "start": 22.3667,
   "end": 24.0333,
   "text": "If Miles wants bread, he pays Sterling's price."
  },
  {
   "id": "4.cheap",
   "start": 24.0333,
   "end": 26.0,
   "text": "Worse, Sterling stops baking fresh bread altogether."
  },
  {
   "id": "4.stale",
   "start": 26.0,
   "end": 27.6,
   "text": "He sells dry crumbs instead of warm loaves."
  },
  {
   "id": "4.why",
   "start": 27.6,
   "end": 29.1333,
   "text": "Why try hard when nobody can leave?"
  },
  {
   "id": "4.price",
   "start": 29.1333,
   "end": 30.8333,
   "text": "Prices shoot up while quality hits the floor."
  },
  {
   "id": "5.name",
   "start": 30.8333,
   "end": 31.8333,
   "text": "That's a monopoly."
  },
  {
   "id": "5.rule",
   "start": 31.8333,
   "end": 33.5,
   "text": "One seller owns the whole market alone."
  },
  {
   "id": "5.gone",
   "start": 33.5,
   "end": 35.1,
   "text": "Competition disappears completely."
  },
  {
   "id": "5.scale",
   "start": 35.1,
   "end": 36.9,
   "text": "Fifteen emeralds used to buy seven loaves."
  },
  {
   "id": "5.half",
   "start": 36.9,
   "end": 38.5333,
   "text": "Now those fifteen emeralds buy just one."
  },
  {
   "id": "5.vault",
   "start": 38.5333,
   "end": 40.5333,
   "text": "Meanwhile, emeralds rain straight into Sterling's vault."
  },
  {
   "id": "6.real",
   "start": 40.5333,
   "end": 42.4333,
   "text": "In real life, Sterling is a giant company."
  },
  {
   "id": "6.rivals",
   "start": 42.4333,
   "end": 44.2,
   "text": "One company with zero real rivals left."
  },
  {
   "id": "6.power",
   "start": 44.2,
   "end": 45.9667,
   "text": "Like the only power company in town."
  },
  {
   "id": "6.ticket",
   "start": 45.9667,
   "end": 47.6667,
   "text": "Or the only ticket site or app store."
  },
  {
   "id": "6.stuck",
   "start": 47.6667,
   "end": 49.5667,
   "text": "With nowhere else to shop, you pay anything."
  },
  {
   "id": "6.new",
   "start": 49.5667,
   "end": 51.9,
   "text": "Even if a new baker opens up, Sterling crushes them."
  },
  {
   "id": "6.trap",
   "start": 51.9,
   "end": 53.8667,
   "text": "He drops prices to one emerald until they quit."
  },
  {
   "id": "7.fault",
   "start": 53.8667,
   "end": 55.4667,
   "text": "So should the mods break up Sterling's shop?"
  },
  {
   "id": "7.or",
   "start": 55.4667,
   "end": 57.0333,
   "text": "Or did Sterling just win fair and square?"
  },
  {
   "id": "7.loop",
   "start": 57.0333,
   "end": 57.9,
   "text": "And that's"
  }
 ],
