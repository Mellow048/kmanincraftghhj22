 "cues": [
  {
   "id": "1.vote",
   "start": 0.0,
   "end": 2.0333,
   "text": "In this town, everybody lost a vote."
  },
  {
   "id": "1.cow",
   "start": 2.0333,
   "end": 3.4333,
   "text": "I am a cow with flowers on."
  },
  {
   "id": "1.squid",
   "start": 3.4333,
   "end": 4.4667,
   "text": "I lost to a squid."
  },
  {
   "id": "1.glow",
   "start": 4.4667,
   "end": 6.3333,
   "text": "It glows. That is all it does."
  },
  {
   "id": "1.how",
   "start": 6.3333,
   "end": 8.4333,
   "text": "Every year, three of us stood on a stage."
  },
  {
   "id": "1.pick",
   "start": 8.4333,
   "end": 10.7,
   "text": "The players picked one. That one became real."
  },
  {
   "id": "1.rest",
   "start": 10.7,
   "end": 11.9333,
   "text": "The other two moved in here."
  },
  {
   "id": "2.ice",
   "start": 11.9333,
   "end": 14.5667,
   "text": "That is the ice thrower. He lost to the same squid."
  },
  {
   "id": "2.talk",
   "start": 14.5667,
   "end": 16.2,
   "text": "We do not talk about the squid."
  },
  {
   "id": "2.bush",
   "start": 16.2,
   "end": 18.8667,
   "text": "The grumpy bush. He was grumpy before the vote."
  },
  {
   "id": "2.hide",
   "start": 18.8667,
   "end": 21.8,
   "text": "This one plays hide and seek. Nobody has found him since."
  },
  {
   "id": "2.stone",
   "start": 21.8,
   "end": 24.9333,
   "text": "The little stone one holds things. He is holding my flowers."
  },
  {
   "id": "2.new",
   "start": 24.9333,
   "end": 27.7333,
   "text": "The crab and the penguin are new. They lost to an armadillo."
  },
  {
   "id": "2.mail",
   "start": 27.7333,
   "end": 29.3,
   "text": "They still check the mail every morning."
  },
  {
   "id": "2.all",
   "start": 29.3,
   "end": 31.3333,
   "text": "So do I. So does everybody."
  },
  {
   "id": "3.why",
   "start": 31.3333,
   "end": 33.4667,
   "text": "Because one time, a letter came."
  },
  {
   "id": "3.friend",
   "start": 33.4667,
   "end": 36.3,
   "text": "My best friend was a copper golem. He pressed buttons. Any button."
  },
  {
   "id": "3.wait",
   "start": 36.3,
   "end": 38.9667,
   "text": "He waited four years. He stood so still, he went green."
  },
  {
   "id": "3.thought",
   "start": 38.9667,
   "end": 40.1333,
   "text": "We thought that was the end of him."
  },
  {
   "id": "3.flag",
   "start": 40.1333,
   "end": 41.5667,
   "text": "Then one morning, his flag was up."
  },
  {
   "id": "3.read",
   "start": 41.5667,
   "end": 43.5333,
   "text": "The letter said, \"you are in\"."
  },
  {
   "id": "3.gate",
   "start": 43.5333,
   "end": 45.1333,
   "text": "The whole town walked him to the gate."
  },
  {
   "id": "3.button",
   "start": 45.1333,
   "end": 46.4667,
   "text": "He pressed the button himself."
  },
  {
   "id": "3.dot",
   "start": 46.4667,
   "end": 47.9667,
   "text": "He waved until he was a dot."
  },
  {
   "id": "3.can",
   "start": 47.9667,
   "end": 50.1,
   "text": "So it can happen. I told everybody."
  },
  {
   "id": "4.tried",
   "start": 50.1,
   "end": 51.9667,
   "text": "After that, I tried to look real."
  },
  {
   "id": "4.flowers",
   "start": 51.9667,
   "end": 53.3333,
   "text": "I grew flowers on everything."
  },
  {
   "id": "4.useful",
   "start": 53.3333,
   "end": 55.1333,
   "text": "I stood at the gate and looked useful."
  },
  {
   "id": "4.wrote",
   "start": 55.1333,
   "end": 57.5667,
   "text": "I wrote to the players. It was mostly a hoof print."
  },
  {
   "id": "4.nothing",
   "start": 57.5667,
   "end": 58.5,
   "text": "Nothing came."
  },
  {
   "id": "5.stage",
   "start": 58.5,
   "end": 60.4,
   "text": "Then one night, they took the stage away."
  },
  {
   "id": "5.no",
   "start": 60.4,
   "end": 62.2,
   "text": "No more votes. Not ever."
  },
  {
   "id": "5.forgot",
   "start": 62.2,
   "end": 64.2667,
   "text": "That stage was the only time anybody looked at us."
  },
  {
   "id": "5.dark",
   "start": 64.2667,
   "end": 66.6,
   "text": "In the morning, nobody checked the mail."
  },
  {
   "id": "6.press",
   "start": 66.6,
   "end": 69.1667,
   "text": "That night, somebody pressed the button on the gate."
  },
  {
   "id": "6.him",
   "start": 69.1667,
   "end": 72.1,
   "text": "It was him. Orange again. Carrying a chest."
  },
  {
   "id": "6.job",
   "start": 72.1,
   "end": 75.1333,
   "text": "That is his job out there. He carries things from one chest to another."
  },
  {
   "id": "6.for",
   "start": 75.1333,
   "end": 76.2,
   "text": "This chest was for us."
  },
  {
   "id": "6.open",
   "start": 76.2,
   "end": 78.6667,
   "text": "It was full of paper. Thousands of little papers."
  },
  {
   "id": "6.votes",
   "start": 78.6667,
   "end": 80.5333,
   "text": "They were votes. Ours."
  },
  {
   "id": "6.mine",
   "start": 80.5333,
   "end": 83.9667,
   "text": "This many players looked at a squid, and at a cow with flowers on, and picked the cow."
  },
  {
   "id": "6.lost",
   "start": 83.9667,
   "end": 85.8333,
   "text": "We did not lose because nobody wanted us."
  },
  {
   "id": "6.one",
   "start": 85.8333,
   "end": 86.9,
   "text": "They could only pick one."
  },
  {
   "id": "6.hold",
   "start": 86.9,
   "end": 89.9333,
   "text": "The stone one is holding all of them. He has never been happier."
  },
  {
   "id": "6.left",
   "start": 89.9333,
   "end": 92.6333,
   "text": "He had to go back. He pressed the button on the way out."
  },
  {
   "id": "7.morning",
   "start": 92.6333,
   "end": 95.2333,
   "text": "This morning, I checked the mail. Like every morning."
  },
  {
   "id": "7.flag",
   "start": 95.2333,
   "end": 96.1667,
   "text": "My flag was up."
  },
  {
   "id": "7.sub",
   "start": 96.1667,
   "end": 99.1333,
   "text": "Like and subscribe for part two. I have not opened it yet."
  }
 ],
