 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 1.8333,
   "text": "What if I could hear every sentence you decided not to say?"
  },
  {
   "id": "1.mouth",
   "start": 1.8333,
   "end": 4.7667,
   "text": "My dad has said the same thing to me every night for six years. He has never opened his mouth."
  },
  {
   "id": "1.rule",
   "start": 4.7667,
   "end": 7.0333,
   "text": "Since I was nine, I hear every sentence a person decides not to say."
  },
  {
   "id": "1.only",
   "start": 7.0333,
   "end": 8.5333,
   "text": "Only the person it was meant for can hear it."
  },
  {
   "id": "2.first",
   "start": 8.5333,
   "end": 10.0667,
   "text": "The first one was my teacher."
  },
  {
   "id": "2.maths",
   "start": 10.0667,
   "end": 12.2333,
   "text": "She looked at my test and decided not to say it."
  },
  {
   "id": "2.heard",
   "start": 12.2333,
   "end": 14.9,
   "text": "I heard it anyway. \"This kid is going to fail.\""
  },
  {
   "id": "2.said",
   "start": 14.9,
   "end": 16.4667,
   "text": "I said nothing. I was nine."
  },
  {
   "id": "3.friend",
   "start": 16.4667,
   "end": 18.7,
   "text": "My best friend almost said something in the hall."
  },
  {
   "id": "3.almost",
   "start": 18.7,
   "end": 20.1333,
   "text": "\"Don't sit with me today.\""
  },
  {
   "id": "3.heard",
   "start": 20.1333,
   "end": 22.0333,
   "text": "I heard it before he had finished deciding."
  },
  {
   "id": "3.why",
   "start": 22.0333,
   "end": 24.1667,
   "text": "He never said it. So he thought I already knew."
  },
  {
   "id": "4.mum",
   "start": 24.1667,
   "end": 25.4333,
   "text": "My mum does it in the kitchen."
  },
  {
   "id": "4.money",
   "start": 25.4333,
   "end": 28.4,
   "text": "Every month she decides not to say, \"we can't afford it.\""
  },
  {
   "id": "4.smile",
   "start": 28.4,
   "end": 30.6667,
   "text": "Then she smiles and says the food is ready."
  },
  {
   "id": "4.keep",
   "start": 30.6667,
   "end": 31.9,
   "text": "I never told her I heard."
  },
  {
   "id": "5.dad",
   "start": 31.9,
   "end": 33.6667,
   "text": "My dad's one is quieter than hers."
  },
  {
   "id": "5.door",
   "start": 33.6667,
   "end": 36.8333,
   "text": "Every night he stands in my doorway and decides not to say it."
  },
  {
   "id": "5.words",
   "start": 36.8333,
   "end": 40.2,
   "text": "The same four words. Every night. Six years."
  },
  {
   "id": "5.assume",
   "start": 40.2,
   "end": 41.6667,
   "text": "I always assumed I knew what they were."
  },
  {
   "id": "6.use",
   "start": 41.6667,
   "end": 43.1333,
   "text": "So I learned to stay quiet."
  },
  {
   "id": "6.quiet",
   "start": 43.1333,
   "end": 45.7667,
   "text": "When I say nothing, other people start deciding."
  },
  {
   "id": "6.hunt",
   "start": 45.7667,
   "end": 48.0667,
   "text": "I stood in the corridor and collected them like coins."
  },
  {
   "id": "6.cheap",
   "start": 48.0667,
   "end": 50.0333,
   "text": "It felt like getting everyone's secrets for free."
  },
  {
   "id": "7.cost",
   "start": 50.0333,
   "end": 52.8333,
   "text": "It isn't free. You hear what people almost think of you."
  },
  {
   "id": "7.weird",
   "start": 52.8333,
   "end": 55.8667,
   "text": "\"He's weird.\" \"He's not the same since his dad got quiet.\""
  },
  {
   "id": "7.move",
   "start": 55.8667,
   "end": 58.6333,
   "text": "And the day my best friend moved, I heard his."
  },
  {
   "id": "7.late",
   "start": 58.6333,
   "end": 61.9333,
   "text": "\"I should have sat with him.\" Four hundred miles away, too late."
  },
  {
   "id": "8.turn",
   "start": 61.9333,
   "end": 63.9,
   "text": "Last month I stood closer than usual."
  },
  {
   "id": "8.close",
   "start": 63.9,
   "end": 67.0667,
   "text": "Close enough to hear all of it, not just the first word."
  },
  {
   "id": "8.four",
   "start": 67.0667,
   "end": 69.3,
   "text": "The four words were not \"I'm proud of you.\""
  },
  {
   "id": "8.real",
   "start": 69.3,
   "end": 71.0333,
   "text": "They were, \"do you still need me?\""
  },
  {
   "id": "9.night",
   "start": 71.0333,
   "end": 73.3,
   "text": "He stood in my door and decided not to say it again."
  },
  {
   "id": "9.say",
   "start": 73.3,
   "end": 76.6333,
   "text": "So I said it first. Out loud. \"I still need you.\""
  },
  {
   "id": "9.after",
   "start": 76.6333,
   "end": 79.7,
   "text": "And the sentence he had carried for six years was never decided again."
  },
  {
   "id": "9.sub",
   "start": 79.7,
   "end": 81.2333,
   "text": "Subscribe if you would answer out loud."
  }
 ],
