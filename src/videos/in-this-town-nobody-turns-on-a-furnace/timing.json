 "clips": [],
 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.2333,
   "text": "In this town, nobody ever turns on a furnace."
  },
  {
   "id": "1.trail",
   "start": 2.2333,
   "end": 4.0,
   "text": "Every morning, my parents walk outside"
  },
  {
   "id": "1.snow",
   "start": 4.0,
   "end": 5.7333,
   "text": "and leave white snow trails across our green lawn."
  },
  {
   "id": "2.cold",
   "start": 5.7333,
   "end": 7.7667,
   "text": "Inside our house, there are zero glowing furnaces,"
  },
  {
   "id": "2.dark",
   "start": 7.7667,
   "end": 9.7667,
   "text": "zero torches, and zero fireplaces anywhere."
  },
  {
   "id": "2.potato",
   "start": 9.7667,
   "end": 11.8,
   "text": "Other kids unpack warm baked potatoes for lunch."
  },
  {
   "id": "2.food",
   "start": 11.8,
   "end": 13.6667,
   "text": "My lunchbox is always frozen sweet berries."
  },
  {
   "id": "3.school",
   "start": 13.6667,
   "end": 15.7333,
   "text": "At school, kids joke that my jacket smells like ice."
  },
  {
   "id": "3.chill",
   "start": 15.7333,
   "end": 17.6333,
   "text": "Frost literally shakes off my sleeves in class."
  },
  {
   "id": "3.sneeze",
   "start": 17.6333,
   "end": 18.8333,
   "text": "And whenever my dad sneezes,"
  },
  {
   "id": "3.ball",
   "start": 18.8333,
   "end": 21.0667,
   "text": "he accidentally launches a snowball across the yard."
  },
  {
   "id": "4.dad",
   "start": 21.0667,
   "end": 23.2,
   "text": "Every other dad smiles for family photos."
  },
  {
   "id": "4.mask",
   "start": 23.2,
   "end": 24.8667,
   "text": "Mine wears a carved orange pumpkin all day,"
  },
  {
   "id": "4.photo",
   "start": 24.8667,
   "end": 26.5,
   "text": "though I caught his goofy snow grin once."
  },
  {
   "id": "4.mum",
   "start": 26.5,
   "end": 28.1333,
   "text": "Whenever I beg for a warm campfire,"
  },
  {
   "id": "4.lock",
   "start": 28.1333,
   "end": 29.6333,
   "text": "Mum quietly locks the flint chest shut."
  },
  {
   "id": "5.forge",
   "start": 29.6333,
   "end": 31.3333,
   "text": "One morning, Dad walked past the blacksmith shop"
  },
  {
   "id": "5.near",
   "start": 31.3333,
   "end": 33.2333,
   "text": "and stepped way too close to the glowing furnace."
  },
  {
   "id": "5.hurt",
   "start": 33.2333,
   "end": 34.6333,
   "text": "His snow hissed white steam right away,"
  },
  {
   "id": "5.jump",
   "start": 34.6333,
   "end": 36.1667,
   "text": "dropping hearts before he jumped backward."
  },
  {
   "id": "5.heat",
   "start": 36.1667,
   "end": 37.7,
   "text": "Then the hottest summer week hits town,"
  },
  {
   "id": "5.dry",
   "start": 37.7,
   "end": 39.4333,
   "text": "turning every green oak leaf bone dry."
  },
  {
   "id": "6.cake",
   "start": 39.4333,
   "end": 41.1333,
   "text": "A passing player cranks the bakery furnace"
  },
  {
   "id": "6.over",
   "start": 41.1333,
   "end": 42.7333,
   "text": "straight to full blast for giant wedding cakes."
  },
  {
   "id": "6.spark",
   "start": 42.7333,
   "end": 44.8667,
   "text": "He ignores every warning sign above the ovens"
  },
  {
   "id": "6.roof",
   "start": 44.8667,
   "end": 47.0333,
   "text": "until a bright spark leaps onto the dry timber roof."
  },
  {
   "id": "6.fire",
   "start": 47.0333,
   "end": 49.5667,
   "text": "In two seconds, the bakery explodes into roaring flames."
  },
  {
   "id": "6.trap",
   "start": 49.5667,
   "end": 51.5333,
   "text": "Me and three other kids crouch behind the counter,"
  },
  {
   "id": "6.smoke",
   "start": 51.5333,
   "end": 53.2667,
   "text": "trapped inside as orange embers rain down."
  },
  {
   "id": "7.run",
   "start": 53.2667,
   "end": 55.3333,
   "text": "Villagers drop their buckets and run from the heat."
  },
  {
   "id": "7.charge",
   "start": 55.3333,
   "end": 57.5,
   "text": "But my Snow Golem dad never even hesitates."
  },
  {
   "id": "7.dad",
   "start": 57.5,
   "end": 59.2667,
   "text": "He sprints straight through the burning oak doorway."
  },
  {
   "id": "7.melt",
   "start": 59.2667,
   "end": 61.2667,
   "text": "His snow melts block by block inside the furnace heat,"
  },
  {
   "id": "7.hearts",
   "start": 61.2667,
   "end": 63.1667,
   "text": "ticking down heart after heart across his chest."
  },
  {
   "id": "7.shield",
   "start": 63.1667,
   "end": 65.4333,
   "text": "He steps over fallen beams and shoves us out safely,"
  },
  {
   "id": "7.throw",
   "start": 65.4333,
   "end": 67.7667,
   "text": "then hurls snowball after snowball up at the blazing rafters"
  },
  {
   "id": "7.arms",
   "start": 67.7667,
   "end": 69.8,
   "text": "until both stick arms nearly vanish completely."
  },
  {
   "id": "8.clear",
   "start": 69.8,
   "end": 71.3333,
   "text": "The last flame hisses out in thin smoke."
  },
  {
   "id": "8.kids",
   "start": 71.3333,
   "end": 73.5333,
   "text": "All four kids scramble onto the cool cobblestones outside."
  },
  {
   "id": "8.puddle",
   "start": 73.5333,
   "end": 75.1333,
   "text": "I look back inside the quiet doorway."
  },
  {
   "id": "8.left",
   "start": 75.1333,
   "end": 77.6333,
   "text": "Only his carved pumpkin and one tiny melting slab remain."
  },
  {
   "id": "9.cry",
   "start": 77.6333,
   "end": 79.7667,
   "text": "I run straight back inside, scoop fresh snow off our lawn,"
  },
  {
   "id": "9.save",
   "start": 79.7667,
   "end": 82.0,
   "text": "and stack my dad back together block by melting block."
  },
  {
   "id": "9.love",
   "start": 82.0,
   "end": 83.5,
   "text": "Now he grins without his pumpkin mask,"
  },
  {
   "id": "9.home",
   "start": 83.5,
   "end": 85.2333,
   "text": "and I finally love our freezing house."
  },
  {
   "id": "10.sub",
   "start": 85.2333,
   "end": 87.8333,
   "text": "Subscribe if you didn't expect a snowman to beat fire."
  }
 ],
