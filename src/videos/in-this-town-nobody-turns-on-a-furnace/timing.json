 "audio": null,
 "clips": [],
 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.2333,
   "text": "In this town, nobody ever turns on a furnace."
  },
  {
   "id": "1.trail",
   "start": 2.2333,
   "end": 5.3,
   "text": "Every morning, my parents leave fresh white snow trails across our green lawn."
  },
  {
   "id": "2.cold",
   "start": 5.3,
   "end": 8.5333,
   "text": "Inside our house, there are zero torches, zero stoves, and zero fireplaces."
  },
  {
   "id": "2.food",
   "start": 8.5333,
   "end": 11.5667,
   "text": "While other kids eat warm baked potatoes, my lunchbox is frozen berries."
  },
  {
   "id": "3.school",
   "start": 11.5667,
   "end": 13.9667,
   "text": "At school, kids joke that my jacket smells like an ice biome."
  },
  {
   "id": "3.sneeze",
   "start": 13.9667,
   "end": 17.4333,
   "text": "And whenever my dad sneezes, he accidentally launches a snowball across the yard."
  },
  {
   "id": "4.dad",
   "start": 17.4333,
   "end": 19.5333,
   "text": "Every other dad smiles for family photos."
  },
  {
   "id": "4.photo",
   "start": 19.5333,
   "end": 22.4333,
   "text": "Mine wears a carved pumpkin all day, though I caught his goofy grin once."
  },
  {
   "id": "4.mum",
   "start": 22.4333,
   "end": 25.3333,
   "text": "Whenever I beg for a campfire, Mum quietly locks the flint away."
  },
  {
   "id": "5.forge",
   "start": 25.3333,
   "end": 27.9667,
   "text": "One morning, Dad walked too close to the blacksmith's glowing furnace."
  },
  {
   "id": "5.hurt",
   "start": 27.9667,
   "end": 30.4667,
   "text": "His snow hissed right away, dropping hearts before he jumped back."
  },
  {
   "id": "5.heat",
   "start": 30.4667,
   "end": 33.4,
   "text": "Then the hottest summer week hits town, and every oak leaf dries out."
  },
  {
   "id": "6.cake",
   "start": 33.4,
   "end": 36.3,
   "text": "A passing player cranks the bakery furnace to full blast for giant cakes."
  },
  {
   "id": "6.spark",
   "start": 36.3,
   "end": 39.7,
   "text": "He ignores every warning sign until a bright spark leaps onto the timber roof."
  },
  {
   "id": "6.fire",
   "start": 39.7,
   "end": 42.5667,
   "text": "In two seconds, the whole oak bakery explodes into roaring flames."
  },
  {
   "id": "6.trap",
   "start": 42.5667,
   "end": 45.4,
   "text": "Me and three other kids get trapped behind the burning wooden counter."
  },
  {
   "id": "7.run",
   "start": 45.4,
   "end": 48.2333,
   "text": "The villagers drop their buckets and back away from the blinding heat."
  },
  {
   "id": "7.dad",
   "start": 48.2333,
   "end": 50.6333,
   "text": "Then my Snow Golem dad sprints straight through the burning doorway."
  },
  {
   "id": "7.melt",
   "start": 50.6333,
   "end": 53.6333,
   "text": "His white snow starts melting immediately, ticking down heart after heart."
  },
  {
   "id": "7.shield",
   "start": 53.6333,
   "end": 56.8,
   "text": "He steps in front of falling embers and keeps pushing us toward the exit."
  },
  {
   "id": "7.throw",
   "start": 56.8,
   "end": 60.2,
   "text": "Then he slings snowball after snowball at the rafters until his arms nearly vanish."
  },
  {
   "id": "8.clear",
   "start": 60.2,
   "end": 63.4,
   "text": "The last flame dies in a hiss of smoke, and all four kids scramble out safely."
  },
  {
   "id": "8.puddle",
   "start": 63.4,
   "end": 66.8333,
   "text": "I look back through the doorway, and only his pumpkin and one tiny block remain."
  },
  {
   "id": "9.cry",
   "start": 66.8333,
   "end": 68.9667,
   "text": "I run straight back inside, scoop fresh snow off our lawn,"
  },
  {
   "id": "9.save",
   "start": 68.9667,
   "end": 71.2,
   "text": "and stack my dad back together block by melting block."
  },
  {
   "id": "9.love",
   "start": 71.2,
   "end": 74.8667,
   "text": "Now he grins without the pumpkin, and I finally understand why our home stays freezing."
  },
  {
   "id": "10.sub",
   "start": 74.8667,
   "end": 77.4667,
   "text": "Subscribe if you didn't expect a snowman to beat fire."
  }
 ],
