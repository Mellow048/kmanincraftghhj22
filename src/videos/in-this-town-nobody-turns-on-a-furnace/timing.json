 "clips": [],
 "cues": [
  {
   "id": "1.town",
   "start": 0.0,
   "end": 2.3,
   "text": "In this town, nobody ever turns on a furnace."
  },
  {
   "id": "1.trail",
   "start": 2.3,
   "end": 5.3333,
   "text": "Every morning, my parents leave white snow trails across our front lawn."
  },
  {
   "id": "2.cold",
   "start": 5.3333,
   "end": 8.6333,
   "text": "Inside our house, there are zero torches, zero stoves, and zero fireplaces."
  },
  {
   "id": "2.food",
   "start": 8.6333,
   "end": 11.9667,
   "text": "While other kids eat warm baked potatoes, we eat frozen berries for dinner."
  },
  {
   "id": "3.school",
   "start": 11.9667,
   "end": 14.4333,
   "text": "At school, kids laugh when my jacket is covered in frost."
  },
  {
   "id": "3.why",
   "start": 14.4333,
   "end": 16.9333,
   "text": "Why can't we have one warm room like every normal house?"
  },
  {
   "id": "4.dad",
   "start": 16.9333,
   "end": 19.7667,
   "text": "My dad wears a carved pumpkin all day and barely says a word."
  },
  {
   "id": "4.mum",
   "start": 19.7667,
   "end": 22.9667,
   "text": "Whenever I ask for a campfire, my mum quietly locks the flint away."
  },
  {
   "id": "5.heat",
   "start": 22.9667,
   "end": 26.1333,
   "text": "Then the hottest summer week hits our village, and every leaf turns dry."
  },
  {
   "id": "5.spark",
   "start": 26.1333,
   "end": 29.0,
   "text": "A player cranks the bakery furnace to full blast for a giant cake."
  },
  {
   "id": "6.fire",
   "start": 29.0,
   "end": 31.9333,
   "text": "One spark jumps onto the oak roof, and the whole bakery catches fire."
  },
  {
   "id": "6.trap",
   "start": 31.9333,
   "end": 34.8333,
   "text": "Me and three other kids are trapped behind the burning wooden counter."
  },
  {
   "id": "7.run",
   "start": 34.8333,
   "end": 37.7667,
   "text": "The villagers drop their buckets and back away from the blazing heat."
  },
  {
   "id": "7.dad",
   "start": 37.7667,
   "end": 40.2667,
   "text": "Then my Snow Golem dad sprints straight through the burning doorway."
  },
  {
   "id": "7.melt",
   "start": 40.2667,
   "end": 43.3333,
   "text": "His snow starts melting the second he steps inside, dropping block by block."
  },
  {
   "id": "7.throw",
   "start": 43.3333,
   "end": 46.5667,
   "text": "He throws snowball after snowball at the flames until his arms nearly vanish."
  },
  {
   "id": "8.clear",
   "start": 46.5667,
   "end": 49.5,
   "text": "The last flame goes out, and all four of us scramble safely outside."
  },
  {
   "id": "8.puddle",
   "start": 49.5,
   "end": 52.5667,
   "text": "When I look back, only his pumpkin and one tiny snow block remain."
  },
  {
   "id": "9.save",
   "start": 52.5667,
   "end": 55.3,
   "text": "I grab snow off the ground and stack him right back up beside me."
  },
  {
   "id": "9.love",
   "start": 55.3,
   "end": 57.8667,
   "text": "He kept our house freezing just to stay strong enough for us."
  },
  {
   "id": "10.sub",
   "start": 57.8667,
   "end": 60.5333,
   "text": "Subscribe if you didn't expect a snowman to beat fire."
  }
 ],
