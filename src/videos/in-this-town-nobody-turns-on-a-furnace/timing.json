{
 "film": "in-this-town-nobody-turns-on-a-furnace",
 "fps": 30,
 "duration": 87.8333,
 "estimated": true,
 "wordTiming": "estimated",
 "tempo": 1.0,
 "wordsPerMinute": 255.6,
