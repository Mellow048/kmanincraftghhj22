 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 3.2667,
   "text": "Every night on this server, Toby built half a bridge and stopped."
  },
  {
   "id": "1.stat",
   "start": 3.2667,
   "end": 6.4333,
   "text": "Over the canyon, he halted one block shy of the center."
  },
  {
   "id": "1.mock",
   "start": 6.4333,
   "end": 10.0333,
   "text": "Players mocked his zero scoreboard, calling him too scared to cross."
  },
  {
   "id": "1.loop",
   "start": 10.0333,
   "end": 13.1,
   "text": "Until the Owner read one sign, and everybody grabbed oak planks."
  },
  {
   "id": "2.board",
   "start": 13.1,
   "end": 16.3,
   "text": "At spawn, Toby's bridge scoreboard stayed stuck at zero."
  },
  {
   "id": "2.chat",
   "start": 16.3,
   "end": 19.3667,
   "text": "Every evening, chat laughed as he backed away from the drop."
  },
  {
   "id": "2.sign",
   "start": 19.3667,
   "end": 22.2333,
   "text": "Beside the gap stood one oak sign: Wait For Me."
  },
  {
   "id": "2.chest",
   "start": 22.2333,
   "end": 25.0,
   "text": "Inside his chest sat just two oak planks, saved neatly."
  },
  {
   "id": "3.cut",
   "start": 25.0,
   "end": 28.1333,
   "text": "What nobody saw was Toby's bedroom desk after school."
  },
  {
   "id": "3.sister",
   "start": 28.1333,
   "end": 31.5333,
   "text": "His little sister Maya only stayed at Dad's house on weekends."
  },
  {
   "id": "3.desk",
   "start": 31.5333,
   "end": 35.0667,
   "text": "Across town, her dark desk sat empty while Toby played alone."
  },
  {
   "id": "3.promise",
   "start": 35.0667,
   "end": 38.2667,
   "text": "So they swore neither would cross without placing that middle block together."
  },
  {
   "id": "4.tnt",
   "start": 38.2667,
   "end": 41.6667,
   "text": "Then Thursday night, a bully lit TNT on Toby's half."
  },
  {
   "id": "4.blast",
   "start": 41.6667,
   "end": 45.4,
   "text": "Planks shattered into the canyon, leaving smoking black craters behind."
  },
  {
   "id": "4.cry",
   "start": 45.4,
   "end": 48.9,
   "text": "Toby logged in, read the crater, and typed: she'll think I quit."
  },
  {
   "id": "4.quit",
   "start": 48.9,
   "end": 51.1667,
   "text": "Moments later, Toby left the game."
  },
  {
   "id": "5.owner",
   "start": 51.1667,
   "end": 54.3667,
   "text": "Next morning, the Owner walked up to the smoky ledge alone."
  },
  {
   "id": "5.clue",
   "start": 54.3667,
   "end": 57.2667,
   "text": "Under the ash, he read the unbroken sign, Wait For Me."
  },
  {
   "id": "6.ping",
   "start": 57.2667,
   "end": 59.5667,
   "text": "One ping went out to the whole server."
  },
  {
   "id": "6.flood",
   "start": 59.5667,
   "end": 63.5667,
   "text": "Twelve friends flooded spawn, sprinting down the path with timber and lamps."
  },
  {
   "id": "6.build",
   "start": 63.5667,
   "end": 67.6333,
   "text": "They rebuilt both bridge halves, wiring golden redstone lamps down every rail."
  },
  {
   "id": "6.gap",
   "start": 67.6333,
   "end": 70.5667,
   "text": "Right at the center, everyone stopped and left one block open."
  },
  {
   "id": "7.friday",
   "start": 70.5667,
   "end": 73.5,
   "text": "At six Friday night, Maya finally joined the game."
  },
  {
   "id": "7.join",
   "start": 73.5,
   "end": 76.5667,
   "text": "Toby spawned in crying as the whole server lined the cliffs."
  },
  {
   "id": "7.place",
   "start": 76.5667,
   "end": 79.8,
   "text": "Together, they placed their two oak planks into the center gap."
  },
  {
   "id": "7.glow",
   "start": 79.8,
   "end": 83.8667,
   "text": "Gold lamps blazed across the canyon, hearts rose, and his scoreboard hit one."
  },
  {
   "id": "7.cta",
   "start": 83.8667,
   "end": 86.5,
   "text": "Subscribe if you'd wait at the edge for your player two."
  }
 ],
