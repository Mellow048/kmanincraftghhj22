 "cues": [
  {
   "id": "1.mums",
   "start": 0.0,
   "end": 1.9,
   "text": "In this town, every kid had a mum."
  },
  {
   "id": "1.chicken",
   "start": 1.9,
   "end": 2.8333,
   "text": "Mine was a chicken."
  },
  {
   "id": "1.doors",
   "start": 2.8333,
   "end": 4.7,
   "text": "All the other mums could break down wooden doors."
  },
  {
   "id": "1.egg",
   "start": 4.7,
   "end": 6.4667,
   "text": "Mine just sat in the mud and laid an egg."
  },
  {
   "id": "1.corner",
   "start": 6.4667,
   "end": 8.5667,
   "text": "So every morning, I asked her to stop at the corner."
  },
  {
   "id": "1.horse",
   "start": 8.5667,
   "end": 11.4333,
   "text": "I told the other kids she was a very small horse."
  },
  {
   "id": "2.school",
   "start": 11.4333,
   "end": 13.7,
   "text": "At school, she still followed me to the window."
  },
  {
   "id": "2.cluck",
   "start": 13.7,
   "end": 14.9333,
   "text": "She clucked at my teacher."
  },
  {
   "id": "2.homework",
   "start": 14.9333,
   "end": 16.7333,
   "text": "She ate my homework right off the desk."
  },
  {
   "id": "2.sleep",
   "start": 16.7333,
   "end": 19.2,
   "text": "And on parents night, she fell asleep on my chair."
  },
  {
   "id": "2.roof",
   "start": 19.2,
   "end": 21.7,
   "text": "At home, our nest was on top of the highest roof."
  },
  {
   "id": "2.view",
   "start": 21.7,
   "end": 22.9667,
   "text": "I thought she just liked the view."
  },
  {
   "id": "2.under",
   "start": 22.9667,
   "end": 26.2667,
   "text": "Whenever I climbed a tree, she ran straight under me and stared."
  },
  {
   "id": "2.asked",
   "start": 26.2667,
   "end": 27.9667,
   "text": "I asked her once where I came from."
  },
  {
   "id": "2.egg",
   "start": 27.9667,
   "end": 31.2,
   "text": "She looked at a white egg in the straw, then at me."
  },
  {
   "id": "2.quiet",
   "start": 31.2,
   "end": 32.8333,
   "text": "We never talked about it again."
  },
  {
   "id": "3.normal",
   "start": 32.8333,
   "end": 35.8,
   "text": "I just wanted a normal mum. One who did not flap when she sneezed."
  },
  {
   "id": "3.walk",
   "start": 35.8,
   "end": 37.5,
   "text": "So I tried walking to school on my own."
  },
  {
   "id": "3.short",
   "start": 37.5,
   "end": 39.7667,
   "text": "Zombie legs are short. I was late every day."
  },
  {
   "id": "3.crates",
   "start": 39.7667,
   "end": 42.5667,
   "text": "I stacked wooden crates so I looked tall enough to walk in alone."
  },
  {
   "id": "3.broke",
   "start": 42.5667,
   "end": 44.5333,
   "text": "The crates broke. I should have hit the stones."
  },
  {
   "id": "3.caught",
   "start": 44.5333,
   "end": 46.5667,
   "text": "Somehow, she was already underneath me."
  },
  {
   "id": "4.trip",
   "start": 46.5667,
   "end": 48.7333,
   "text": "Then came the night trip up the mountain road."
  },
  {
   "id": "4.forest",
   "start": 48.7333,
   "end": 50.7,
   "text": "We stayed out in the dark trees too long."
  },
  {
   "id": "4.orange",
   "start": 50.7,
   "end": 53.0333,
   "text": "Then the sky behind the hills turned orange."
  },
  {
   "id": "4.burn",
   "start": 53.0333,
   "end": 56.0333,
   "text": "Zombies burn in the sun. Every single one of us."
  },
  {
   "id": "4.bridge",
   "start": 56.0333,
   "end": 58.3667,
   "text": "The whole class ran for the wooden bridge home."
  },
  {
   "id": "4.crack",
   "start": 58.3667,
   "end": 60.4667,
   "text": "Halfway across, the old planks snapped."
  },
  {
   "id": "4.heavy",
   "start": 60.4667,
   "end": 62.9,
   "text": "The big mums tried to jump the gap. They were too heavy."
  },
  {
   "id": "4.wings",
   "start": 62.9,
   "end": 66.4667,
   "text": "Nobody had wings. And the first sunbeam was already touching the trees."
  },
  {
   "id": "5.edge",
   "start": 66.4667,
   "end": 69.0667,
   "text": "Then my tiny mum walked straight to the broken edge."
  },
  {
   "id": "5.mind",
   "start": 69.0667,
   "end": 70.6333,
   "text": "I thought she had lost her mind."
  },
  {
   "id": "5.climb",
   "start": 70.6333,
   "end": 73.4,
   "text": "She crouched down in the dirt. So I climbed onto her back."
  },
  {
   "id": "5.step",
   "start": 73.4,
   "end": 75.2333,
   "text": "And she stepped off the cliff."
  },
  {
   "id": "6.float",
   "start": 75.2333,
   "end": 78.3333,
   "text": "She opened her wings. And we did not fall."
  },
  {
   "id": "6.safe",
   "start": 78.3333,
   "end": 81.8667,
   "text": "Chickens float. And if you ride one, neither of you gets hurt."
  },
  {
   "id": "6.eleven",
   "start": 81.8667,
   "end": 84.5333,
   "text": "She ran back up the rock. She carried Timmy down."
  },
  {
   "id": "6.more",
   "start": 84.5333,
   "end": 87.4,
   "text": "Then Mia. Eleven kids, one by one."
  },
  {
   "id": "6.sun",
   "start": 87.4,
   "end": 89.3,
   "text": "Just before the sun hit the stone."
  },
  {
   "id": "7.knew",
   "start": 89.3,
   "end": 91.2667,
   "text": "Now I knew why our nest was on the roof."
  },
  {
   "id": "7.under",
   "start": 91.2667,
   "end": 93.1667,
   "text": "Why she always stood underneath me."
  },
  {
   "id": "7.wait",
   "start": 93.1667,
   "end": 95.8667,
   "text": "She was never a small horse. She was waiting to catch me."
  },
  {
   "id": "7.next",
   "start": 95.8667,
   "end": 98.8333,
   "text": "The next night at the gate, eleven kids asked my mum for a ride to school."
  },
  {
   "id": "7.own",
   "start": 98.8333,
   "end": 100.1,
   "text": "I told them to get their own mum."
  },
  {
   "id": "7.egg",
   "start": 100.1,
   "end": 102.8333,
   "text": "Wait. Why is that white egg in our nest shaking?"
  },
  {
   "id": "8.sub",
   "start": 102.8333,
   "end": 105.0667,
   "text": "Subscribe before it hatches."
  }
 ],
