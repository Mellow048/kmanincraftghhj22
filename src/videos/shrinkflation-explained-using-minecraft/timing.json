 "cues": [
  {
   "id": "1.hook",
   "start": 0.0,
   "end": 2.0,
   "text": "Shrinkflation, explained using Minecraft."
  },
  {
   "id": "1.box",
   "start": 2.0,
   "end": 4.0667,
   "text": "Felint lifts the lid off a giant cake box."
  },
  {
   "id": "1.slice",
   "start": 4.0667,
   "end": 6.5333,
   "text": "Inside sits one tiny slice surrounded by empty air."
  },
  {
   "id": "1.price",
   "start": 6.5333,
   "end": 9.4333,
   "text": "Same five-emerald price. Same bright bakery counter."
  },
  {
   "id": "2.day1",
   "start": 9.4333,
   "end": 11.7333,
   "text": "Day one: Sterling sold a full seven-slice cake."
  },
  {
   "id": "2.five",
   "start": 11.7333,
   "end": 14.2,
   "text": "The billboard outside read five emeralds, fair and square."
  },
  {
   "id": "2.buy",
   "start": 14.2,
   "end": 16.6333,
   "text": "Every Friday, Felint walked in and paid five emeralds."
  },
  {
   "id": "2.share",
   "start": 16.6333,
   "end": 18.6667,
   "text": "He carried that cake home and shared seven slices."
  },
  {
   "id": "3.costs",
   "start": 18.6667,
   "end": 20.9,
   "text": "Then wheat, sugar, and milk tripled in price."
  },
  {
   "id": "3.farm",
   "start": 20.9,
   "end": 23.2667,
   "text": "Sterling watched farm costs climb from one to three."
  },
  {
   "id": "3.raise",
   "start": 23.2667,
   "end": 25.4,
   "text": "So Sterling raised his cake sign to eight emeralds."
  },
  {
   "id": "3.walk",
   "start": 25.4,
   "end": 27.5667,
   "text": "The entire crowd turned around and walked away."
  },
  {
   "id": "3.zero",
   "start": 27.5667,
   "end": 29.3667,
   "text": "Daily sales crashed straight down to zero."
  },
  {
   "id": "4.slam",
   "start": 29.3667,
   "end": 31.4,
   "text": "So Sterling slammed his sign back down to five!"
  },
  {
   "id": "4.cheer",
   "start": 31.4,
   "end": 33.8,
   "text": "Instantly, every customer cheered and sprinted back."
  },
  {
   "id": "4.back",
   "start": 33.8,
   "end": 36.1333,
   "text": "Behind the curtain, Sterling stepped into his workshop."
  },
  {
   "id": "4.cut",
   "start": 36.1333,
   "end": 38.0667,
   "text": "He sliced two pieces clean off every cake."
  },
  {
   "id": "4.tall",
   "start": 38.0667,
   "end": 40.4333,
   "text": "He slid it inside an even taller, flashier box."
  },
  {
   "id": "4.new",
   "start": 40.4333,
   "end": 42.4667,
   "text": "He stamped New Look across the front for five."
  },
  {
   "id": "4.pile",
   "start": 42.4667,
   "end": 45.0,
   "text": "Stolen slices stacked into bonus cakes for another five!"
  },
  {
   "id": "4.w1",
   "start": 45.0,
   "end": 47.3667,
   "text": "Week one: seven full slices for five emeralds."
  },
  {
   "id": "4.w2",
   "start": 47.3667,
   "end": 49.4667,
   "text": "Week two: five slices for five emeralds."
  },
  {
   "id": "4.w3",
   "start": 49.4667,
   "end": 51.6333,
   "text": "Week three: three slices for five emeralds."
  },
  {
   "id": "4.w4",
   "start": 51.6333,
   "end": 54.0,
   "text": "Week four: one slice—while five never budged once."
  },
  {
   "id": "5.chests",
   "start": 54.0,
   "end": 55.7667,
   "text": "Look at both chests side by side."
  },
  {
   "id": "5.before",
   "start": 55.7667,
   "end": 58.1667,
   "text": "Before, one full cake cost Felint five emeralds."
  },
  {
   "id": "5.after",
   "start": 58.1667,
   "end": 60.5,
   "text": "Now, one full cake costs him fifteen emeralds!"
  },
  {
   "id": "5.scale",
   "start": 60.5,
   "end": 62.6667,
   "text": "Felint's five emeralds tip lighter on the scale."
  },
  {
   "id": "5.punch1",
   "start": 62.6667,
   "end": 64.2333,
   "text": "The price tag never went up."
  },
  {
   "id": "5.punch2",
   "start": 64.2333,
   "end": 65.7667,
   "text": "Your emeralds never shrank."
  },
  {
   "id": "5.punch3",
   "start": 65.7667,
   "end": 68.0333,
   "text": "The cake did. That is shrinkflation."
  },
  {
   "id": "6.real",
   "start": 68.0333,
   "end": 70.2333,
   "text": "Walk down any grocery aisle—same exact trick."
  },
  {
   "id": "6.chips",
   "start": 70.2333,
   "end": 73.0333,
   "text": "Half-empty chip bags, thinner bars, smaller cereal boxes."
  },
  {
   "id": "6.hide",
   "start": 73.0333,
   "end": 75.2333,
   "text": "Companies know you spot a bigger price tag fast."
  },
  {
   "id": "6.inside",
   "start": 75.2333,
   "end": 77.2333,
   "text": "So they hide the hike quietly inside the box."
  },
  {
   "id": "7.felint",
   "start": 77.2333,
   "end": 78.8333,
   "text": "So who is really to blame here?"
  },
  {
   "id": "7.sterling",
   "start": 78.8333,
   "end": 80.4333,
   "text": "Sterling for shrinking the cake behind the box,"
  },
  {
   "id": "7.check",
   "start": 80.4333,
   "end": 82.2667,
   "text": "or Felint for only checking the price tag?"
  },
  {
   "id": "7.stay",
   "start": 82.2667,
   "end": 83.6333,
   "text": "Because when the price stays five emeralds,"
  },
  {
   "id": "7.loop",
   "start": 83.6333,
   "end": 85.8,
   "text": "and the cake turns into one tiny slice, that's..."
  }
 ],
